/* 商品详情 */
.page {
  background-color: #F5F5F5;
}

/* 商品图轮播 */
.gallery {
  width: 100%;
  height: 560rpx;
  background-color: #fff;
}
.gallery-img {
  width: 100%;
  height: 560rpx;
}

/* 价格区 */
.price-card {
  background-color: #fff;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}
.now-price {
  font-size: 48rpx;
  color: #FF3B30;
  font-weight: bold;
}
.old-price {
  font-size: 26rpx;
  color: #bbb;
  text-decoration: line-through;
  margin-left: 16rpx;
}
.discount-tag {
  font-size: 20rpx;
  color: #fff;
  background-color: #FF3B30;
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
  margin-left: 16rpx;
}
.prod-name {
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: bold;
  margin-top: 16rpx;
}
.prod-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}
.meta-line {
  margin-top: 20rpx;
}

.spec-divider {
  margin: 24rpx 0;
}

/* 评价 */
.review {
  display: flex;
  flex-direction: column;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.review-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
}
.review-name {
  font-size: 26rpx;
  color: #333;
  margin-left: 16rpx;
}
.stars {
  margin-left: 16rpx;
}
.review-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
  margin-top: 12rpx;
}

/* 图文详情 */
.rich {
  margin-top: 16rpx;
}
.detail-img {
  width: 100%;
  border-radius: 12rpx;
  margin-top: 16rpx;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 108rpx;
  background-color: #fff;
  border-top: 1rpx solid #EDEDED;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
  z-index: 500;
}
.action-icon {
  width: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.action-icon-text {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}
.cart-badge {
  position: absolute;
  right: 16rpx;
  top: -6rpx;
  font-size: 18rpx;
  color: #fff;
  background-color: #FF3B30;
  border-radius: 16rpx;
  padding: 2rpx 8rpx;
}
.action-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}
.add-cart {
  background-color: #FFF0EA;
}
.add-cart .action-btn-text {
  color: #FF6B35;
}
.buy-now {
  background: linear-gradient(90deg, #FF6B35, #FF3B30);
}
.buy-now .action-btn-text {
  color: #fff;
}
.action-btn-text {
  font-size: 28rpx;
  font-weight: bold;
}

/* 规格弹层 */
.spec-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx 40rpx 24rpx;
  z-index: 1000;
  display: flex;
  flex-direction: column;
}
.spec-row {
  flex-wrap: wrap;
  margin-top: 24rpx;
}
.qty-line {
  margin-top: 28rpx;
}
.qty-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background-color: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
}
.qty-plus {
  background-color: #FF6B35;
}
.qty-num {
  font-size: 30rpx;
  color: #333;
  min-width: 72rpx;
  text-align: center;
}
.spec-confirm {
  margin-top: 32rpx;
  border-radius: 44rpx;
}
