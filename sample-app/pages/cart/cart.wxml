<view class="page">
  <!-- 标题 -->
  <view class="header">
    <text class="header-title">🛒 购物车</text>
    <text class="header-count" wx:if="{{cartItems.length > 0}}">共 {{cartItems.length}} 种商品</text>
  </view>

  <!-- 空购物车 -->
  <view class="empty-box" wx:if="{{cartItems.length == 0}}">
    <icon type="info" size="64" color="#ddd"></icon>
    <text class="empty-tip">购物车还是空的</text>
    <button type="primary" bindtap="goShopping">去逛逛</button>
  </view>

  <!-- 购物车列表 -->
  <view class="cart-list" wx:if="{{cartItems.length > 0}}">
    <view class="cart-item anim-fade-up" wx:for="{{cartItems}}" wx:key="id">
      <checkbox checked="{{item.selected}}" bindtap="onToggleSelect" data-index="{{index}}" color="#FF6B35"></checkbox>
      <view class="item-icon" bindtap="onItemTap" data-id="{{item.id}}">
        <image class="item-img" src="{{item.image}}" mode="aspectFill"></image>
      </view>
      <view class="item-info">
        <text class="item-name">{{item.name}}</text>
        <text class="item-spec">规格：{{item.spec}}</text>
        <view class="item-row">
          <text class="item-price">¥{{item.price}}</text>
          <view class="qty-box">
            <view class="qty-btn" bindtap="onDecrease" data-index="{{index}}">
              <icon type="minus" size="12" color="#666"></icon>
            </view>
            <text class="qty-num">{{item.quantity}}</text>
            <view class="qty-btn" bindtap="onIncrease" data-index="{{index}}">
              <icon type="plus" size="12" color="#666"></icon>
            </view>
          </view>
        </view>
      </view>
      <view class="del-btn" catchtap="onDelete" data-index="{{index}}">
        <icon type="cancel" size="18" color="#cccccc"></icon>
      </view>
    </view>
  </view>

  <view class="bottom-space" wx:if="{{cartItems.length > 0}}"></view>

  <!-- 结算栏 -->
  <view class="checkout" wx:if="{{cartItems.length > 0}}">
    <view class="checkout-left" bindtap="onToggleAll">
      <checkbox checked="{{allSelected}}" color="#FF6B35"></checkbox>
      <text class="select-text">全选</text>
    </view>
    <view class="checkout-right">
      <view class="total-col">
        <text class="total-text">合计</text>
        <text class="total-price">¥{{totalPrice}}</text>
      </view>
      <button class="checkout-btn" type="primary" bindtap="onCheckout">结算({{selectedCount}})</button>
    </view>
  </view>
</view>
