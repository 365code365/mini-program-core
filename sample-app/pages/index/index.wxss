.page {
  background-color: #F5F5F5;
}

/* 搜索栏 */
.search-bar {
  background-color: #FF6B35;
  padding: 20rpx;
}

.search-input {
  background-color: #fff;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
}

/* Banner */
.banner {
  background-color: #FF6B35;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.banner-tag {
  background-color: #fff;
  color: #FF6B35;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.banner-title {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  margin-top: 16rpx;
}

.banner-desc {
  display: block;
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 分类 */
.category-section {
  background-color: #fff;
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.category-row {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}

.category-name {
  font-size: 24rpx;
  color: #333;
  margin-top: 12rpx;
}

/* 区块 */
.section {
  background-color: #fff;
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.section-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  width: 100%;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 26rpx;
  color: #999;
}

/* 商品网格 */
.product-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-card {
  width: 48%;
  background-color: #FAFAFA;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.product-img {
  width: 100%;
  height: 180rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-name {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-top: 12rpx;
}

.product-price-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  width: 100%;
}

.product-price {
  font-size: 32rpx;
  color: #FF6B35;
  font-weight: bold;
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  background-color: #FF6B35;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn-text {
  color: #fff;
  font-size: 32rpx;
}

/* 商品列表 */
.product-list {
  display: flex;
  flex-direction: column;
}

.list-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

.list-img {
  width: 120rpx;
  height: 120rpx;
  background-color: #f0f0f0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.list-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}

.list-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.list-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.list-price {
  display: block;
  font-size: 30rpx;
  color: #FF6B35;
  font-weight: bold;
  margin-top: 8rpx;
}

.list-btn {
  background-color: #FF6B35;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.bottom-space {
  height: 20rpx;
}

/* 首页优惠券弹窗 */
.coupon-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.coupon-dialog {
  position: relative;
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.coupon-dialog-head {
  align-items: center;
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}
.coupon-dialog-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF3B30;
}
.coupon-dialog-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.coupon-list-pop {
  width: 100%;
  display: flex;
  flex-direction: column;
}
.coupon-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: linear-gradient(90deg, #FF6B35, #FF3B30);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.coupon-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
  border-right: 1rpx dashed rgba(255,255,255,0.6);
}
.coupon-amount {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}
.coupon-cond {
  font-size: 20rpx;
  color: rgba(255,255,255,0.9);
}
.coupon-right {
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}
.coupon-name {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}
.coupon-tip {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 6rpx;
}
.coupon-claim-btn {
  margin-top: 16rpx;
  width: 100%;
  background: #FF3B30;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}
.coupon-close {
  position: absolute;
  top: -64rpx;
  right: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255,255,255,0.8);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 商品真实图片 */
.product-img-el { width: 100%; height: 100%; border-radius: 8rpx; display: block; }
.list-img-el { width: 100%; height: 100%; border-radius: 8rpx; display: block; }
