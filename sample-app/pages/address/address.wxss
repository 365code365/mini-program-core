.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.addr-list {
  display: flex;
  flex-direction: column;
}
.addr-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
}
.addr-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.addr-radio.on {
  border-color: #FF6B35;
  background: #FF6B35;
  box-shadow: inset 0 0 0 6rpx #fff;
}
.addr-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.addr-head {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.addr-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.addr-phone {
  font-size: 26rpx;
  color: #666;
  margin-left: 20rpx;
}
.addr-default {
  font-size: 20rpx;
  color: #fff;
  background: #FF6B35;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 16rpx;
}
.addr-detail {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}
.addr-del {
  font-size: 26rpx;
  color: #FF3B30;
  padding-left: 16rpx;
}

.empty {
  padding: 60rpx 0;
  align-items: center;
  display: flex;
  flex-direction: column;
}
.empty-text {
  font-size: 26rpx;
  color: #999;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
}
.form-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}
.form-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 90rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #333;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.switch-row {
  justify-content: space-between;
}
.save-btn {
  margin-top: 24rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.preview {
  margin-top: 16rpx;
  background: #fff8f2;
  border: 1rpx solid #ffd8bf;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}
.preview-line {
  font-size: 24rpx;
  color: #b35;
  line-height: 1.8;
}
