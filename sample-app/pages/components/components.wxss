.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  padding: 30rpx 0;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

/* Swiper */
.swiper {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
}

.swiper-item {
  display: flex;
  justify-content: center;
  align-items: center;
}

.swiper-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}

/* Picker */
.picker-item {
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
}

.picker-item text {
  font-size: 28rpx;
  color: #333;
}

/* Rich-text */
.rich-text-box {
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  min-height: 80rpx;
}

/* Checkbox & Radio */
.checkbox-item,
.radio-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 0;
}

.checkbox-item text,
.radio-item text {
  font-size: 28rpx;
  color: #333;
  margin-left: 16rpx;
}

/* Back button */
.back-btn {
  margin-top: 40rpx;
  padding: 24rpx;
  background-color: #07c160;
  border-radius: 12rpx;
  text-align: center;
}

.back-text {
  font-size: 28rpx;
  color: #fff;
}

/* CSS 动画演示 */
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes pulse { 0%,100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.3); opacity: .6; } }
@keyframes bounce { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-16rpx); } }
@keyframes fadeIn { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }

.anim-row {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  padding: 20rpx 0;
}
.anim-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.anim-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
}
.loader {
  width: 64rpx;
  height: 64rpx;
  border: 8rpx solid #f0f0f0;
  border-top-color: #FF6B35;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}
.pulse {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #07c160;
  animation: pulse 1.2s ease-in-out infinite;
}
.bounce {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #FF3B30;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: bounce 0.8s ease-in-out infinite;
}
.fade-in-box {
  margin-top: 20rpx;
  padding: 24rpx;
  background: linear-gradient(90deg, #FF6B35, #FF3B30);
  border-radius: 12rpx;
  animation: fadeIn 0.6s ease-out;
}
.fade-text {
  color: #fff;
  font-size: 26rpx;
}
.trans-btn {
  margin-top: 20rpx;
  padding: 20rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333;
  transition: background 0.25s ease, transform 0.15s ease, color 0.25s ease;
}
.trans-btn:active {
  background: #FF6B35;
  color: #fff;
  transform: scale(0.96);
}
