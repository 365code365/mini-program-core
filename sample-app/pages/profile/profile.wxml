<view class="page">
  <!-- 用户信息 -->
  <view class="user-header" bindtap="onUserTap">
    <image class="avatar-img" src="/assets/avatar1.jpg" mode="aspectFill"></image>
    <view class="user-info">
      <text class="user-name">{{userName}}</text>
      <text class="user-level">{{loggedIn ? '普通会员 · 积分 ' + points : '点击登录 / 注册'}}</text>
    </view>
    <icon type="arrow_right" size="16" color="#ffffff"></icon>
  </view>

  <!-- 订单统计 -->
  <view class="order-section">
    <view class="row-between">
      <text class="order-title">我的订单</text>
      <view class="row" bindtap="onAllOrders">
        <text class="muted">全部订单</text>
        <icon type="arrow_right" size="12" color="#999"></icon>
      </view>
    </view>
    <view class="order-row">
      <view class="order-item" wx:for="{{orderStats}}" wx:key="key"
            bindtap="onOrderTap" data-type="{{item.key}}">
        <text class="order-num">{{item.count}}</text>
        <text class="order-label">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" wx:for="{{menus}}" wx:key="key" bindtap="onMenuTap" data-key="{{item.key}}">
      <view class="menu-icon" style="background-color:{{item.color}}">
        <icon type="{{item.icon}}" size="18" color="#ffffff"></icon>
      </view>
      <text class="menu-text">{{item.name}}</text>
      <text wx:if="{{item.value}}" class="menu-value">{{item.value}}</text>
      <icon type="arrow_right" size="14" color="#cccccc"></icon>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="onLogout">{{loggedIn ? '退出登录' : '立即登录'}}</button>
  </view>
  <view class="bottom-space"></view>
</view>
