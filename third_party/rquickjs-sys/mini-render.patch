+
+static void *js_pool_alloc(JSRuntime *rt, size_t size, bool zero)
+{
+    size_t u = js_pool_round(size);
+    uint8_t *base;
+    if (u <= JS_POOL_MAX) {
+        int c = (int)(u >> 4) - 1;
+        void *p = rt->pool_free[c];
+        if (likely(p)) {
+            rt->pool_free[c] = *(void **)p;
+            rt->pool_nfree[c]--;
+            if (zero)
+                memset(p, 0, u);
+            return p;
+        }
+    }
+    if (zero)
+        base = rt->mf.js_calloc(rt->malloc_state.opaque, 1, u + JS_POOL_HDR);
+    else
+        base = rt->mf.js_malloc(rt->malloc_state.opaque, u + JS_POOL_HDR);
+    if (unlikely(!base))
+        return NULL;
+    *(size_t *)base = u;
+    return base + JS_POOL_HDR;
+}
