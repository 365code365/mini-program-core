+    for(c = 0; c < JS_POOL_NCLASS; c++) {
+        void *p = rt->pool_free[c];
+        while (p) {
+            void *next = *(void **)p;
+            rt->mf.js_free(rt->malloc_state.opaque, (uint8_t *)p - JS_POOL_HDR);
+            p = next;
+        }
+        rt->pool_free[c] = NULL;
+        rt->pool_nfree[c] = 0;
+    }
+}
