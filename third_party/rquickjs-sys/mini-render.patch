+static void js_pool_release(JSRuntime *rt, void *ptr)
+{
+    size_t u = js_pool_usable(ptr);
+    if (u <= JS_POOL_MAX) {
+        int c = (int)(u >> 4) - 1;
+        if (likely(rt->pool_nfree[c] < JS_POOL_MAX_FREE)) {
+            *(void **)ptr = rt->pool_free[c];
+            rt->pool_free[c] = ptr;
+            rt->pool_nfree[c]++;
+            return;
+        }
+    }
+    rt->mf.js_free(rt->malloc_state.opaque, (uint8_t *)ptr - JS_POOL_HDR);
+}
