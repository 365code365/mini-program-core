.article {
  background-color: #fff;
  padding: 28rpx 24rpx 24rpx;
}

.article-title {
  display: block;
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.author-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 24rpx;
}

.author-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background-color: #EFEFEF;
  flex-shrink: 0;
}

.author-info {
  flex: 1;
  margin-left: 16rpx;
}

.author-name {
  display: block;
  font-size: 28rpx;
  color: #2A2A2A;
  font-weight: bold;
}

.author-time {
  display: block;
  font-size: 22rpx;
  color: #9A9A9A;
  margin-top: 6rpx;
}

.follow-btn {
  border: 1rpx solid #D43C33;
  border-radius: 28rpx;
  padding: 8rpx 24rpx;
  flex-shrink: 0;
}

.follow-btn.followed {
  border-color: #D9D9D9;
  background-color: #F5F5F5;
}

.follow-text {
  font-size: 24rpx;
  color: #D43C33;
}

.followed .follow-text {
  color: #9A9A9A;
}

.article-cover {
  width: 100%;
  height: 380rpx;
  border-radius: 10rpx;
  margin-top: 24rpx;
  background-color: #F0F0F0;
}

.article-body {
  display: block;
  font-size: 30rpx;
  line-height: 52rpx;
  color: #333;
  margin-top: 24rpx;
}

.tag-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

/* 相关阅读 / 评论 */
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.related {
  background-color: #fff;
  margin-top: 16rpx;
  padding: 24rpx;
}

.related-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F2F2F2;
}

.related-title {
  display: block;
  font-size: 28rpx;
  color: #2A2A2A;
  line-height: 40rpx;
}

.related-meta {
  display: block;
  font-size: 22rpx;
  color: #9A9A9A;
  margin-top: 8rpx;
}

.comments {
  background-color: #fff;
  margin-top: 16rpx;
  padding: 24rpx;
}

.comment-item {
  display: flex;
  flex-direction: row;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.comment-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #EFEFEF;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
  margin-left: 16rpx;
}

.comment-user {
  display: block;
  font-size: 24rpx;
  color: #5A6B8C;
  font-weight: bold;
}

.comment-text {
  display: block;
  font-size: 28rpx;
  color: #2A2A2A;
  line-height: 40rpx;
  margin-top: 8rpx;
}

.comment-foot {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}

.comment-time {
  font-size: 22rpx;
  color: #B5B5B5;
}

.comment-like {
  font-size: 22rpx;
  color: #8A8A8A;
}

.bottom-space {
  height: 120rpx;
}

/* 底部固定操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background-color: #fff;
  border-top: 1rpx solid #E6E6E6;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 20rpx;
}

.comment-input {
  flex: 1;
  height: 64rpx;
  background-color: #F2F3F5;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  margin-right: 20rpx;
}

.comment-input-text {
  font-size: 26rpx;
  color: #9A9A9A;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
}

.action-count {
  font-size: 20rpx;
  color: #8A8A8A;
  margin-top: 4rpx;
}
