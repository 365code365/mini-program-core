.user-header {
  background-color: #D43C33;
  padding: 44rpx 28rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.user-avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.35);
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
}

.user-name {
  display: block;
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.user-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 10rpx;
}

.user-arrow {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 统计 */
.stat-card {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 14rpx;
  padding: 26rpx 0;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
}

.stat-value {
  font-size: 38rpx;
  color: #1A1A1A;
  font-weight: bold;
}

.stat-label {
  font-size: 22rpx;
  color: #9A9A9A;
  margin-top: 8rpx;
}

/* 菜单 */
.menu-card {
  background-color: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: 14rpx;
  padding: 8rpx 24rpx 4rpx;
}

.menu-head {
  display: block;
  font-size: 26rpx;
  color: #9A9A9A;
  padding: 16rpx 0 8rpx;
}

.menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #2A2A2A;
  margin-left: 18rpx;
}

.menu-badge {
  font-size: 20rpx;
  color: #fff;
  background-color: #D43C33;
  border-radius: 18rpx;
  padding: 2rpx 12rpx;
  margin-right: 12rpx;
}

.menu-arrow {
  font-size: 26rpx;
  color: #C8C8C8;
}

/* 开关 / 滑块 */
.switch-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.switch-label {
  font-size: 30rpx;
  color: #2A2A2A;
}

.slider-row {
  padding: 22rpx 0 8rpx;
}

.logout-wrap {
  padding: 20rpx;
}

.logout-btn {
  background-color: #fff;
  color: #D43C33;
  border-radius: 46rpx;
  font-size: 30rpx;
}

.bottom-space {
  height: 110rpx;
}
