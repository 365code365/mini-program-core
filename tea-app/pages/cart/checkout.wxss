@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}
/* 凤凰云岫设计令牌：参考稿的暖米白、茶褐、低饱和金与书卷感排版 */
.page {
  flex: 1;
  background-color: #f7f3ec;
}
.scroll {
  flex: 1;
}
.addr {
  flex-direction: row;
  align-items: center;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
}
.addr-pin {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}
.addr-info {
  flex: 1;
}
.addr-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #4a3020;
}
.addr-detail {
  font-size: 24rpx;
  color: #8a8478;
  margin-top: 6rpx;
}
.addr-empty {
  flex: 1;
  font-size: 28rpx;
  color: #82786c;
}
.addr-arrow {
  font-size: 36rpx;
  color: #c4bdb0;
}
.card {
  background-color: #ffffff;
  border-radius: 20rpx;
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
}
.goods {
  flex-direction: row;
  align-items: center;
  padding: 10rpx 0;
}
.goods-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
}
.goods-info {
  flex: 1;
  margin-left: 16rpx;
}
.goods-name {
  font-size: 28rpx;
  color: #4a3020;
}
.goods-right {
  align-items: flex-end;
}
.goods-price {
  font-size: 28rpx;
  color: #4a3020;
}
.goods-qty {
  font-size: 22rpx;
  color: #82786c;
}
.row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
}
.row-t {
  font-size: 28rpx;
  color: #5a5248;
}
.coupon-right {
  flex-direction: row;
  align-items: center;
}
.coupon-val {
  font-size: 26rpx;
  color: #82786c;
  margin-right: 8rpx;
}
.coupon-on {
  color: #a87536;
  font-weight: bold;
}
.cb {
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.25);
  align-items: center;
  justify-content: center;
}
.cb-on {
  background-color: #a87536;
  border-color: #a87536;
}
.cb-t {
  width: 22rpx;
  height: 22rpx;
}
.line {
  height: 2rpx;
  background-color: rgba(0, 0, 0, 0.06);
}
.kv {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}
.k {
  font-size: 28rpx;
  color: #5a5248;
}
.k-strong {
  font-size: 28rpx;
  color: #4a3020;
}
.v {
  font-size: 28rpx;
  color: #4a3020;
}
.v-muted {
  font-size: 28rpx;
  color: #82786c;
}
.v-red {
  font-size: 28rpx;
  color: #c0392b;
}
.v-gold {
  font-size: 36rpx;
  font-weight: bold;
  color: #a87536;
}
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: #ffffff;
  padding: 20rpx 32rpx;
  border-top: 2rpx solid rgba(0, 0, 0, 0.05);
}
.bar-left {
  flex-direction: column;
}
.bar-label {
  font-size: 22rpx;
  color: #82786c;
}
.bar-total {
  font-size: 44rpx;
  font-weight: bold;
  color: #a87536;
}
.btn {
  background-color: #a87536;
  border-radius: 44rpx;
  padding: 22rpx 64rpx;
}
.btn-off {
  opacity: 0.5;
}
.btn-t {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
}
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  justify-content: flex-end;
}
.sheet {
  background-color: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 28rpx;
  max-height: 70%;
}
.sheet-head {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4a3020;
}
.sheet-x {
  width: 36rpx;
  height: 36rpx;
}
.cp-list {
  margin-top: 16rpx;
}
.cp {
  flex-direction: row;
  align-items: center;
  background-color: #faf8f4;
  border-radius: 16rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 16rpx;
}
.cp.none {
  justify-content: space-between;
}
.cp-none-t {
  font-size: 28rpx;
  color: #5a5248;
}
.cp-left {
  width: 180rpx;
  align-items: center;
}
.cp-money {
  font-size: 40rpx;
  font-weight: bold;
  color: #a87536;
}
.cp-cond {
  font-size: 20rpx;
  color: #82786c;
  margin-top: 4rpx;
}
.cp-mid {
  flex: 1;
  margin-left: 16rpx;
}
.cp-name {
  font-size: 28rpx;
  color: #4a3020;
}
.cp-exp {
  font-size: 22rpx;
  color: #82786c;
  margin-top: 6rpx;
}
.cp-empty {
  padding: 40rpx 0;
  align-items: center;
}
.cp-empty-t {
  font-size: 26rpx;
  color: #82786c;
}