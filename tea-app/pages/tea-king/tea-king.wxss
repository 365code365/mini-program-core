@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}
/* 凤凰云岫设计令牌：参考稿的暖米白、茶褐、低饱和金与书卷感排版 */
.page {
  flex: 1;
  background-color: #f7f3ec;
}
.banner {
  background-color: #4b3415;
  border-radius: 24rpx;
  margin: 24rpx;
  padding: 36rpx;
}
.banner-gold {
  font-size: 56rpx;
  font-weight: bold;
  color: #e7d2a6;
  letter-spacing: 6rpx;
}
.banner-t {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
  margin-top: 12rpx;
}
.banner-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
}
.list {
  padding: 0 24rpx;
}
.card {
  flex-direction: row;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.card-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 18rpx;
}
.card-info {
  flex: 1;
  margin-left: 20rpx;
}
.award {
  flex-direction: row;
  align-items: center;
  background-color: rgba(199, 154, 82, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  align-self: flex-start;
}
.award-ic {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}
.award-t {
  font-size: 20rpx;
  color: #a87536;
}
.name {
  font-size: 30rpx;
  font-weight: bold;
  color: #4a3020;
  margin-top: 12rpx;
}
.desc {
  font-size: 24rpx;
  color: #8a8478;
  margin-top: 6rpx;
}
.bottom {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.price {
  font-size: 36rpx;
  font-weight: bold;
  color: #a87536;
}
.buy {
  background-color: #a87536;
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
}
.buy-t {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
}