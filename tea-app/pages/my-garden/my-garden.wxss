@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}
/* 凤凰云岫设计令牌：参考稿的暖米白、茶褐、低饱和金与书卷感排版 */
.page {
  flex: 1;
  background-color: #f7f3ec;
}
.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  margin: 24rpx;
  overflow: hidden;
}
.cover-wrap {
  position: relative;
}
.cover {
  width: 100%;
}
.tag {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  background-color: rgba(47, 79, 79, 0.85);
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.body {
  padding: 28rpx;
}
.name {
  font-size: 34rpx;
  font-weight: bold;
  color: #4a3020;
}
.grid {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.meta {
  width: 50%;
  font-size: 24rpx;
  color: #7a746a;
  padding: 6rpx 0;
}
.meta-link {
  color: #a87536;
  font-weight: bold;
}
.plaque {
  background-color: #f7f0e1;
  border: 2rpx solid #e3d8c0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  align-items: center;
}
.plaque-h {
  font-size: 22rpx;
  color: #9a8458;
}
.plaque-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #3a2c18;
  margin-top: 8rpx;
}
.plaque-msg {
  font-size: 24rpx;
  color: #7a6a47;
  margin-top: 8rpx;
}
.actions {
  flex-direction: row;
  margin-top: 24rpx;
}
.act {
  flex: 1;
  border: 2rpx solid rgba(0, 0, 0, 0.1);
  border-radius: 44rpx;
  padding: 20rpx 0;
  align-items: center;
  margin: 0 8rpx;
}
.act-t {
  font-size: 28rpx;
  color: #4a3020;
}
.act-gold {
  border-color: #a87536;
  background-color: rgba(199, 154, 82, 0.1);
}
.act-t-gold {
  font-size: 28rpx;
  color: #a87536;
  font-weight: bold;
}
.sk-cover {
  width: 100%;
  height: 300rpx;
  background-color: #eee9e0;
}
.sk-line {
  height: 28rpx;
  background-color: #eee9e0;
  border-radius: 8rpx;
  margin-top: 16rpx;
}
.sk-line.short {
  width: 50%;
}
.empty {
  align-items: center;
  padding-top: 160rpx;
}
.empty-t {
  font-size: 28rpx;
  color: #82786c;
}
.empty-btn {
  background-color: #a87536;
  border-radius: 40rpx;
  padding: 16rpx 40rpx;
  margin-top: 24rpx;
}
.empty-btn-t {
  color: #ffffff;
  font-size: 26rpx;
}