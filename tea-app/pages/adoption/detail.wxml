<view style="{{'--status-bar-height:' + t + ';' + (virtualHostStyle || '')}}" id="{{s}}" change:eS="{{uV.sS}}" eS="{{$eS[s]}}" change:eA="{{uV.sA}}" eA="{{$eA[s]}}" class="{{['page', v]}}" hidden="{{virtualHostHidden || false}}"><scroll-view class="scroll" scroll-y="true" enable-flex="true" enhanced="true"><view class="cover-wrap"><image class="cover" src="{{a}}" mode="widthFix"></image><view class="monitor" bindtap="{{c}}"><image class="monitor-ic" src="{{b}}"></image><text class="monitor-t">实时监控</text></view></view><view class="body"><view class="tags"><text class="tag tag-gold">{{d}}</text><text class="tag tag-muted">{{e}}</text></view><text class="name">{{f}}</text><view class="stats"><view class="stat"><text class="stat-v">{{g}}m</text><text class="stat-k">海拔</text></view><view class="stat"><text class="stat-v">{{h}}年</text><text class="stat-k">平均树龄</text></view><view class="stat"><text class="stat-v">{{i}}亩</text><text class="stat-k">种植面积</text></view></view><text class="sec">单份认养权益</text><view class="benefits"><view wx:for="{{j}}" wx:for-item="b" wx:key="b" class="ben"><image class="ben-dot" src="{{k}}"></image><text class="ben-t">{{b.a}}</text></view></view><text class="sec">选择认养份额</text><view class="picker"><text class="picker-t">认养份额（剩余 {{l}} 份）</text><view class="stepper"><text class="step-btn" bindtap="{{m}}">−</text><text class="step-n">{{n}}</text><text class="step-btn" bindtap="{{o}}">+</text></view></view></view><view style="height:160rpx"></view></scroll-view><view class="bar"><view class="bar-left"><text class="bar-label">合计</text><text class="bar-total">¥{{p}}</text></view><view wx:if="{{q}}" class="btn-disabled"><text class="btn-t">已售罄</text></view><view wx:else class="btn" bindtap="{{r}}"><text class="btn-t">立即认养</text></view></view></view><wxs src="/common/uniView.wxs" module="uV"/>
