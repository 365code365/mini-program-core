<scroll-view scroll-y="true" style="{{'--status-bar-height:' + q + ';' + (virtualHostStyle || '')}}" enable-flex="true" enhanced="true" id="{{p}}" change:eS="{{uV.sS}}" eS="{{$eS[p]}}" change:eA="{{uV.sA}}" eA="{{$eA[p]}}" class="{{['page', r]}}" hidden="{{virtualHostHidden || false}}"><view class="summary-card"><view class="summary-icon"><image class="summary-img" src="{{a}}"></image></view><view class="summary-copy"><text class="summary-label">根据你的需求</text><text class="summary">{{b}}</text></view></view><view wx:if="{{c}}" class="loading"><view class="loading-dot"></view><text class="loading-text">正在从当前在售好茶中认真筛选…</text></view><view wx:elif="{{d}}" class="empty"><text class="empty-title">暂时没有匹配到合适商品</text><text class="empty-desc">可以换一种需求描述，或请人工选茶师帮你挑选。</text><view class="retry" bindtap="{{e}}"><text class="retry-text">重新推荐</text></view></view><view wx:else class="results"><view wx:for="{{f}}" wx:for-item="item" wx:key="l" class="product"><view class="main-row"><image class="product-image" src="{{item.a}}" mode="aspectFill"></image><view class="product-mid"><view class="name-row"><text class="product-name">{{item.b}}</text><view class="rank"><text class="rank-t">{{item.c}}</text></view></view><text class="product-sub">{{item.d}}</text><view class="detail-row"><image class="detail-icon" src="{{g}}"></image><view class="detail-copy"><text class="detail-title">适合谁</text><text class="detail-text">{{item.e}}</text></view></view><view class="detail-row"><image class="detail-icon" src="{{h}}"></image><view class="detail-copy"><text class="detail-title">为什么推荐</text><text class="detail-text">{{item.f}}</text></view></view><view class="detail-row"><image class="detail-icon" src="{{i}}"></image><view class="detail-copy"><text class="detail-title">不一定适合谁</text><text class="detail-text">{{item.g}}</text></view></view></view><view class="actions"><view class="primary-btn" bindtap="{{item.h}}"><text class="primary-text">查看商品 ›</text></view><view class="ghost-btn" bindtap="{{item.i}}"><text class="ghost-text">咨询选茶师</text></view></view></view><view wx:if="{{item.j}}" class="tags"><text class="taste-label">口感关键词</text><text wx:for="{{item.k}}" wx:for-item="tag" wx:key="b" class="tag">{{tag.a}}</text></view></view></view><view class="advice"><view class="advice-head"><image class="advice-leaf" src="{{j}}"></image><text class="advice-title">选茶建议</text></view><view class="tips"><view wx:for="{{k}}" wx:for-item="item" wx:key="d" class="tip"><image class="tip-icon" src="{{item.a}}"></image><text class="tip-title">{{item.b}}</text><text class="tip-desc">{{item.c}}</text></view></view><text wx:if="{{l}}" class="skill-tip">本次推荐已应用：{{m}}</text></view><view class="chat-more" bindtap="{{o}}"><image class="chat-more-icon" src="{{n}}"></image><text class="chat-more-text">有任何疑问，随时找我聊茶。</text></view><view class="bottom-space"></view></scroll-view><wxs src="/common/uniView.wxs" module="uV"/>
