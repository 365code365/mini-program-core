.wi { position: relative; }
.sun { position: absolute; border-radius: 50%; background: linear-gradient(135deg, #ffe873 0%, #ffc531 50%, #ffa31a 100%); box-shadow: 0 0 24rpx rgba(255, 196, 40, 0.75); }
.sun-full { left: 18%; top: 18%; width: 64%; height: 64%; }
.sun-part { left: 36%; top: 8%; width: 48%; height: 48%; }
.moon { position: absolute; left: 22%; top: 18%; width: 56%; height: 56%; border-radius: 50%; background: linear-gradient(135deg, #fffbe6 0%, #f3e3a1 60%, #e3c96a 100%); box-shadow: 0 0 20rpx rgba(255, 240, 180, 0.6); }
.cloud { position: absolute; left: 8%; top: 30%; width: 84%; height: 50%; }
.puff { position: absolute; border-radius: 50%; background: #ffffff; }
.p1 { left: 12%; top: 26%; width: 40%; height: 56%; }
.p2 { left: 34%; top: 0; width: 50%; height: 72%; }
.base { position: absolute; left: 0; top: 46%; width: 100%; height: 54%; border-radius: 999rpx; background: #ffffff; }
.cloud-dark .puff, .cloud-dark .base { background: #e6ebf2; }
.drop { position: absolute; top: 76%; width: 5%; height: 16%; border-radius: 999rpx; background: #9fd0ff; transform: rotate(18deg); }
.d1 { left: 30%; }
.d2 { left: 48%; top: 80%; }
.d3 { left: 66%; }
.bolt { position: absolute; left: 47%; top: 66%; width: 8%; height: 26%; background: #ffd23f; transform: skewX(-18deg); border-radius: 4rpx; }
.flake { position: absolute; top: 80%; width: 9%; height: 9%; border-radius: 50%; background: #ffffff; box-shadow: 0 0 6rpx rgba(255, 255, 255, 0.9); }
.f1 { left: 28%; }
.f2 { left: 47%; top: 86%; }
.f3 { left: 66%; }
