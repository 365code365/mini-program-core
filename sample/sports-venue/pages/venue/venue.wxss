.gallery { position: relative; }
.sw { height: 420rpx; }
.sw-img { width: 100%; height: 420rpx; }
.sw-n { position: absolute; right: 24rpx; bottom: 24rpx; background: rgba(0, 0, 0, 0.45); color: #ffffff; font-size: 22rpx; border-radius: 20rpx; padding: 4rpx 16rpx; }
.head { margin-top: -30rpx; position: relative; }
.name { font-size: 34rpx; font-weight: bold; }
.head-l { margin-top: 12rpx; }
.rate { color: #ff7a1a; font-size: 26rpx; font-weight: bold; }
.gap { margin-left: 14rpx; }
.link { color: #13b37b; font-size: 24rpx; }
.addr { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #f0f2f1; }
.addr-t { font-size: 26rpx; }
.addr-d { margin-top: 6rpx; }
.call { margin-left: 20rpx; width: 96rpx; height: 64rpx; border-radius: 32rpx; background: #e7f8f1; display: flex; align-items: center; justify-content: center; }
.call-t { color: #13b37b; font-size: 24rpx; }
.prices { margin-top: 20rpx; }
.pr { background: #f6f8f7; border-radius: 14rpx; padding: 20rpx; margin-right: 16rpx; }
.pr-peak { margin-right: 0; background: #fff4ec; }
.pr-l { font-size: 24rpx; color: #5a5d66; }
.pr-v { font-size: 36rpx; font-weight: bold; color: #13b37b; }
.peak { color: #ff7a1a; }
.pr-s { margin-top: 6rpx; font-size: 20rpx; }
.facs { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 16rpx; }
.fac { font-size: 24rpx; color: #3a3d46; background: #f3f5f4; border-radius: 8rpx; padding: 8rpx 16rpx; margin: 0 12rpx 12rpx 0; }
.wall { margin-top: 16rpx; }
.wi { position: relative; border-radius: 12rpx; overflow: hidden; }
.wi-img { width: 100%; display: block; }
.wi-t { position: absolute; left: 12rpx; bottom: 10rpx; color: #ffffff; font-size: 22rpx; background: rgba(0, 0, 0, 0.4); border-radius: 6rpx; padding: 2rpx 10rpx; }
.notice { margin-top: 12rpx; }
.notice-t { font-size: 24rpx; color: #5a5d66; line-height: 40rpx; }
.share { padding: 0; margin: 0; border: none; background: transparent; width: 100rpx; line-height: 1.2; display: flex; flex-direction: column; align-items: center; }
.share-ic { font-size: 34rpx; color: #5a5d66; }
.share-t { font-size: 20rpx; color: #5a5d66; }
.foot-p { margin-left: 12rpx; }
.big { font-size: 38rpx; }
.bk { width: 260rpx; }
