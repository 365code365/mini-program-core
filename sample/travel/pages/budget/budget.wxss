.sum-card { margin: 24rpx 24rpx 0 24rpx; border-radius: 24rpx; padding: 32rpx; background: linear-gradient(150deg, #1e78ff, #22b5d6); display: flex; flex-direction: column; }
.sum-over { background: linear-gradient(150deg, #f5222d, #ff7a45); }
.sum-s { color: rgba(255,255,255,0.9); font-size: 24rpx; }
.sum-v { color: #ffffff; font-size: 64rpx; font-weight: bold; margin: 8rpx 0 20rpx 0; white-space: nowrap; }
.stack { height: 16rpx; border-radius: 8rpx; background: rgba(255,255,255,0.3); display: flex; flex-direction: row; }
.seg { height: 16rpx; border-right: 2rpx solid rgba(255,255,255,0.8); box-sizing: border-box; }
.sum-foot { margin-top: 18rpx; }
.total-row { margin-top: 20rpx; display: flex; flex-direction: row; align-items: center; height: 96rpx; border-bottom: 2rpx solid #edf0f5; }
.total-over { border-bottom-color: #f5222d; }
.yen { font-size: 40rpx; font-weight: bold; margin-right: 12rpx; }
.total-in { flex: 1; height: 96rpx; font-size: 44rpx; font-weight: bold; }
.quicks { display: flex; flex-direction: row; margin-top: 20rpx; }
.qk { padding: 8rpx 24rpx; border-radius: 24rpx; background: #f4f6fa; margin-right: 16rpx; font-size: 24rpx; color: #4e5566; }
.it { margin-top: 28rpx; }
.dot { width: 18rpx; height: 18rpx; border-radius: 9rpx; margin-right: 14rpx; }
.it-t { width: 90rpx; font-size: 28rpx; }
.it-in-wrap { flex: 1; height: 68rpx; background: #f4f6fa; border-radius: 12rpx; padding: 0 20rpx; display: flex; flex-direction: row; align-items: center; }
.it-in { flex: 1; height: 68rpx; font-size: 30rpx; text-align: right; }
.it-share { width: 80rpx; text-align: right; }
.it-track { margin-top: 14rpx; height: 8rpx; }
.it-track .fill { height: 8rpx; }
.space { height: 180rpx; }
.bottom { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 32rpx 32rpx 32rpx; background: #ffffff; border-top: 1rpx solid #edf0f5; }
.rec-add { height: 56rpx; line-height: 56rpx; padding: 0 26rpx; border-radius: 28rpx; background: #1e78ff; color: #ffffff; font-size: 24rpx; font-weight: bold; white-space: nowrap; }
.spent-row { align-items: flex-end; margin-top: 18rpx; }
.spent-v { font-size: 48rpx; font-weight: bold; white-space: nowrap; }
.spent-s { margin-left: 16rpx; margin-bottom: 8rpx; }
.acts-grid { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 20rpx; }
.ac { width: 200rpx; margin: 0 15rpx 15rpx 0; padding: 18rpx; box-sizing: border-box; border-radius: 14rpx; background: #f7f8fb; display: flex; flex-direction: column; }
.ac-t { font-size: 24rpx; color: #4e5566; }
.ac-v { font-size: 30rpx; font-weight: bold; margin: 8rpx 0 4rpx 0; white-space: nowrap; }
.rec-empty { padding: 32rpx 0; display: flex; flex-direction: row; justify-content: center; }
.rec { display: flex; flex-direction: row; align-items: center; padding: 22rpx 0; border-top: 1rpx solid #f2f3f5; }
.rec-info { flex: 1; display: flex; flex-direction: column; }
.rec-t { font-size: 28rpx; margin-bottom: 4rpx; }
.rec-v { font-size: 30rpx; font-weight: bold; white-space: nowrap; }
.rec-del { padding: 10rpx 0 10rpx 24rpx; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #ffffff; border-radius: 28rpx 28rpx 0 0; padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)) 32rpx; }
.sheet-t { display: block; font-size: 32rpx; font-weight: bold; text-align: center; margin-bottom: 24rpx; }
.cats { display: flex; flex-direction: row; flex-wrap: wrap; }
.cat { height: 60rpx; line-height: 60rpx; padding: 0 28rpx; border-radius: 30rpx; background: #f4f6fa; color: #4e5566; font-size: 26rpx; margin: 0 16rpx 16rpx 0; white-space: nowrap; }
.cat-on { background: #1e78ff; color: #ffffff; }
.f-row { display: flex; flex-direction: row; align-items: center; height: 96rpx; border-bottom: 1rpx solid #f2f3f5; }
.f-l { width: 110rpx; font-size: 28rpx; color: #4e5566; }
.f-in { flex: 1; height: 96rpx; font-size: 30rpx; }
.f-v { flex: 1; font-size: 30rpx; }
.rec-ok { margin-top: 32rpx; }
