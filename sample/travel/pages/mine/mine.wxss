.head { background: linear-gradient(150deg, #1e78ff, #22b5d6); padding: 48rpx 32rpx 80rpx 32rpx; }
.avatar { width: 112rpx; height: 112rpx; border-radius: 56rpx; background: #ffffff; display: flex; flex-direction: row; align-items: center; justify-content: center; margin-right: 24rpx; }
.avatar-t { font-size: 48rpx; color: #1e78ff; font-weight: bold; }
.name { font-size: 36rpx; font-weight: bold; color: #ffffff; }
.head-s { font-size: 24rpx; color: rgba(255,255,255,0.9); margin-top: 8rpx; }
.stats { display: flex; flex-direction: row; margin-top: -48rpx; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-v { font-size: 40rpx; font-weight: bold; margin-bottom: 6rpx; }
.cell { height: 96rpx; display: flex; flex-direction: row; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #f2f3f5; }
.cell-last { border-bottom: 0; }
.foot { display: block; text-align: center; margin-top: 40rpx; }
