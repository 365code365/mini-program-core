.top { background: #ffffff; padding: 32rpx; }
.top-v { font-size: 56rpx; font-weight: bold; color: #1c2230; }
.top-of { font-size: 30rpx; color: #8a91a0; font-weight: normal; }
.ring { width: 112rpx; height: 112rpx; border-radius: 56rpx; border: 8rpx solid #1e78ff; box-sizing: border-box; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.ring-done { border-color: #2fb380; }
.ring-t { font-size: 26rpx; font-weight: bold; }
.top-track { margin-top: 24rpx; }
.fill-green { background: #2fb380; }
.acts { margin-top: 24rpx; }
.act { padding: 12rpx 32rpx; border-radius: 32rpx; background: #f4f6fa; margin-right: 20rpx; font-size: 26rpx; color: #4e5566; }
.act-main { background: #1e78ff; color: #ffffff; font-weight: bold; }
.grp { padding: 8rpx 28rpx; }
.grp-head { display: flex; flex-direction: row; align-items: center; height: 92rpx; }
.grp-name { flex: 1; display: flex; flex-direction: row; align-items: center; margin-left: 20rpx; height: 92rpx; }
.grp-t { font-size: 30rpx; font-weight: bold; margin-right: 14rpx; }
.fold-arrow { margin-left: auto; width: 14rpx; height: 14rpx; border-right: 3rpx solid #8a91a0; border-bottom: 3rpx solid #8a91a0; transform: rotate(45deg); margin-right: 8rpx; }
.fold-closed { transform: rotate(-45deg); }
.it { display: flex; flex-direction: row; align-items: center; height: 84rpx; border-top: 1rpx solid #f2f3f5; padding-left: 40rpx; }
/* 文字不设 flex:1：引擎的 line-through 按文字盒子宽度画，盒子拉满时线会贯穿整行，用 .grow 占位 */
.it-t { margin-left: 20rpx; font-size: 28rpx; }
.grow { flex: 1; }
.it-done { color: #b4b9c4; text-decoration: line-through; }
.rm { padding: 8rpx 0 8rpx 20rpx; }
.add { display: flex; flex-direction: row; align-items: center; padding: 0 0 0 24rpx; height: 96rpx; }
.add-g { display: flex; flex-direction: row; align-items: center; padding-right: 20rpx; border-right: 1rpx solid #edf0f5; font-size: 28rpx; color: #1e78ff; }
.dn { width: 10rpx; height: 10rpx; border-right: 3rpx solid #1e78ff; border-bottom: 3rpx solid #1e78ff; transform: rotate(45deg); margin-left: 12rpx; margin-bottom: 6rpx; }
.add-in { flex: 1; height: 96rpx; margin-left: 20rpx; font-size: 28rpx; }
.add-btn { width: 120rpx; height: 96rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; color: #1e78ff; font-weight: bold; }
.add-off { color: #b4b9c4; }
.space { height: 80rpx; }
