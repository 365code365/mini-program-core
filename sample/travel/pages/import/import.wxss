.paste { height: 56rpx; line-height: 56rpx; padding: 0 24rpx; border-radius: 28rpx; background: #eaf2ff; color: #1e78ff; font-size: 24rpx; font-weight: bold; white-space: nowrap; }
.txt { width: 100%; height: 300rpx; margin-top: 20rpx; padding: 20rpx; box-sizing: border-box; border-radius: 16rpx; background: #f4f6fa; font-size: 26rpx; line-height: 40rpx; }
.err { display: block; color: #f5222d; font-size: 24rpx; margin-top: 14rpx; }
.pv-s { display: block; margin: 10rpx 0 12rpx 0; }
.pv-day { display: flex; flex-direction: row; padding: 14rpx 0; border-top: 1rpx solid #f2f3f5; }
.pv-d { width: 120rpx; flex-shrink: 0; font-size: 26rpx; font-weight: bold; color: #1e78ff; }
.pv-n { flex: 1; font-size: 26rpx; color: #4e5566; }
.pv-b { display: block; margin-top: 14rpx; }
.space { height: 180rpx; }
.bottom { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)) 32rpx; background: #ffffff; border-top: 1rpx solid #edf0f5; }
