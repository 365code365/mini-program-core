<view class="tags">
  <view wx:for="{{tags}}" wx:key="*this" class="tg {{tag === item ? 'tg-on' : ''}}" data-t="{{item}}" bindtap="onTag"><text>{{item}}</text></view>
</view>
<view class="grid">
  <view wx:for="{{list}}" wx:key="name" class="city" data-name="{{item.name}}" bindtap="plan">
    <view class="cover" style="background: linear-gradient(160deg, {{item.color}}, #1c2230);">
      <text class="c-name">{{item.name}}</text>
      <text class="c-prov">{{item.prov}} · {{item.tag}}</text>
      <view class="planned" wx:if="{{planned[item.name]}}"><text>已规划</text></view>
      <view class="planned wished" wx:elif="{{wish[item.name]}}"><text>想去</text></view>
    </view>
    <text class="c-desc">{{item.desc}}</text>
  </view>
</view>
<view class="empty" wx:if="{{!list.length}}">
  <text class="sub">{{tag === '想去' ? '还没有想去的城市，点城市进攻略页标记「想去」' : '这个分类下暂时没有城市'}}</text>
</view>
<view class="tab-space"></view>
