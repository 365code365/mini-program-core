.top { position: fixed; left: 0; right: 0; top: 0; z-index: 5; background: #ffffff; padding: 20rpx 0 16rpx 0; }
.search { margin: 0 24rpx; height: 76rpx; border-radius: 38rpx; background: #f4f6fa; display: flex; flex-direction: row; align-items: center; padding: 0 24rpx; }
.lens { position: relative; width: 30rpx; height: 30rpx; margin-right: 14rpx; }
.lens-c { width: 20rpx; height: 20rpx; border-radius: 12rpx; border: 4rpx solid #8a91a0; }
.lens-h { position: absolute; left: 20rpx; top: 22rpx; width: 10rpx; height: 4rpx; background: #8a91a0; transform: rotate(45deg); }
.search-in { flex: 1; height: 76rpx; font-size: 28rpx; }
.types { margin-top: 16rpx; white-space: nowrap; }
.types-in { display: flex; flex-direction: row; padding: 0 24rpx; }
.ty { padding: 8rpx 26rpx; border-radius: 28rpx; margin-right: 14rpx; font-size: 26rpx; color: #4e5566; background: #f4f6fa; flex-shrink: 0; }
.ty-on { background: #1e78ff; color: #ffffff; }
.list { padding-top: 190rpx; }
.custom { margin: 0 24rpx 16rpx 24rpx; display: flex; flex-direction: row; align-items: center; background: #ffffff; border-radius: 16rpx; padding: 0 0 0 24rpx; height: 88rpx; }
.custom-in { flex: 1; height: 88rpx; font-size: 28rpx; }
.custom-btn { width: 120rpx; height: 88rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; color: #1e78ff; font-weight: bold; font-size: 28rpx; }
.custom-off { color: #b4b9c4; }
.sp { margin: 0 24rpx 16rpx 24rpx; background: #ffffff; border-radius: 16rpx; padding: 24rpx; display: flex; flex-direction: row; align-items: center; }
.sp-taken { opacity: 0.6; }
.sp-ic { width: 84rpx; height: 84rpx; border-radius: 16rpx; background: #eaf2ff; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.sp-ic-t { color: #1e78ff; font-size: 24rpx; font-weight: bold; }
.sp-info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; }
.sp-t { font-size: 30rpx; font-weight: bold; margin-bottom: 6rpx; }
.empty { padding: 60rpx 0; display: flex; flex-direction: row; justify-content: center; }
.space { height: 160rpx; }
.bottom { position: fixed; left: 0; right: 0; bottom: 0; height: 128rpx; background: #ffffff; border-top: 1rpx solid #edf0f5; display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 32rpx; }
.ok { width: 280rpx; height: 80rpx; }
