.head { background: linear-gradient(150deg, #1e78ff, #22b5d6); padding: 40rpx 32rpx 120rpx 32rpx; display: flex; flex-direction: column; }
.head-t { color: #ffffff; font-size: 44rpx; font-weight: bold; }
.head-s { color: rgba(255,255,255,0.88); font-size: 26rpx; margin-top: 10rpx; }
.new-btn {
  position: absolute; right: 32rpx; top: 52rpx; height: 72rpx; padding: 0 28rpx; border-radius: 36rpx; background: #ffffff;
  display: flex; flex-direction: row; align-items: center;
}
.plus { position: relative; width: 24rpx; height: 24rpx; margin-right: 10rpx; }
.plus-h { position: absolute; left: 0; top: 10rpx; width: 24rpx; height: 4rpx; background: #1e78ff; border-radius: 2rpx; }
.plus-v2 { position: absolute; left: 10rpx; top: 0; width: 4rpx; height: 24rpx; background: #1e78ff; border-radius: 2rpx; }
.new-t { color: #1e78ff; font-size: 26rpx; font-weight: bold; }
.list { margin-top: -88rpx; padding: 0 24rpx; }
.cell { position: relative; margin-bottom: 24rpx; height: 236rpx; }
.ops { position: absolute; right: 0; top: 0; bottom: 0; display: flex; flex-direction: row; }
.op { width: 150rpx; height: 236rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; color: #ffffff; font-size: 26rpx; }
.op-pin { background: #ffa940; border-radius: 20rpx 0 0 20rpx; }
.op-del { background: #f5222d; border-radius: 0 20rpx 20rpx 0; }
.trip {
  position: absolute; left: 0; top: 0; right: 0; height: 236rpx; background: #ffffff; border-radius: 20rpx;
  display: flex; flex-direction: row; padding: 24rpx; box-sizing: border-box; border: 2rpx solid #ffffff;
}
.trip-hl { border-color: #1e78ff; background: #f3f8ff; }
.cover { width: 168rpx; height: 188rpx; border-radius: 16rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.cover-t { color: #ffffff; font-size: 40rpx; font-weight: bold; }
.cover-s { color: rgba(255,255,255,0.85); font-size: 22rpx; margin-top: 6rpx; }
.info { flex: 1; margin-left: 24rpx; display: flex; flex-direction: column; }
.trip-t { font-size: 32rpx; font-weight: bold; }
.pin { background: #fff4e5; color: #fa8c16; font-size: 20rpx; border-radius: 6rpx; padding: 2rpx 10rpx; }
.mt { margin-top: 12rpx; }
.chip { background: #eaf2ff; color: #1e78ff; font-size: 22rpx; border-radius: 8rpx; padding: 4rpx 12rpx; margin-right: 12rpx; }
.badge { color: #1e78ff; font-size: 26rpx; font-weight: bold; margin-top: 14rpx; }
.empty { background: #ffffff; border-radius: 20rpx; padding: 80rpx 0; display: flex; flex-direction: column; align-items: center; }
.hint { display: block; text-align: center; margin-top: 8rpx; }
.tab-space { height: 140rpx; }
