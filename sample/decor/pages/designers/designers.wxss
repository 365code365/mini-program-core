.styles { width: 100%; white-space: nowrap; margin-bottom: 16rpx; }
.sorts { margin-bottom: 20rpx; padding: 0 4rpx; }
.sort { font-size: 26rpx; color: #8a847c; margin-right: 36rpx; padding: 6rpx 0; }
.sort-on { color: #3a7d6c; font-weight: bold; border-bottom: 4rpx solid #3a7d6c; }
.ds { padding: 26rpx; }
.av { width: 108rpx; height: 108rpx; border-radius: 54rpx; margin-right: 20rpx; }
.name { font-size: 32rpx; font-weight: bold; margin-right: 12rpx; }
.meta { margin-top: 8rpx; }
.fee { font-size: 24rpx; color: #b8763e; margin-left: 20rpx; }
.works { margin-top: 20rpx; }
.work { flex: 1; height: 150rpx; border-radius: 12rpx; margin-right: 10rpx; }
.work:last-child { margin-right: 0; }
.ops { margin-top: 18rpx; align-items: flex-start; }
.ops .muted { line-height: 1.5; margin-right: 20rpx; max-height: 72rpx; overflow: hidden; }
.book { background: #3a7d6c; color: #ffffff; font-size: 24rpx; padding: 12rpx 30rpx; border-radius: 30rpx; flex-shrink: 0; }
