.head { display: flex; flex-direction: row; align-items: center; padding: 36rpx 28rpx; border-radius: 24rpx; margin-bottom: 24rpx; background: linear-gradient(135deg, #2f6b5d 0%, #5c9a89 100%); }
.h-av { width: 108rpx; height: 108rpx; border-radius: 54rpx; background: #f6e6d6; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; }
.h-av-t { font-size: 44rpx; color: #b8763e; font-weight: bold; }
.h-n { font-size: 36rpx; color: #ffffff; font-weight: bold; }
.h-s { font-size: 24rpx; color: rgba(255, 255, 255, 0.85); margin-top: 8rpx; }
.stats { display: flex; flex-direction: row; padding: 24rpx 0; }
.st { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 6rpx 0; }
.st-v { font-size: 38rpx; font-weight: bold; color: #3a7d6c; margin-bottom: 4rpx; }
.small { padding: 30rpx 0 10rpx; }
.favs { width: 100%; white-space: nowrap; margin-top: 20rpx; }
.fav { width: 240rpx; margin-right: 16rpx; flex-shrink: 0; }
.fav-img { width: 240rpx; height: 170rpx; border-radius: 12rpx; }
.fav-t { font-size: 22rpx; line-height: 1.4; margin-top: 8rpx; white-space: normal; }
.menu { padding: 0 28rpx; }
.mi { display: flex; flex-direction: row; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f1ede7; font-size: 28rpx; }
.mi-t { font-size: 28rpx; margin-bottom: 4rpx; }
.mi-av { width: 56rpx; height: 56rpx; border-radius: 28rpx; margin-right: 16rpx; }
.danger { color: #d9534f; }
.fav-row { align-items: flex-start; }
