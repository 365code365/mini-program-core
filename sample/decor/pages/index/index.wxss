.hero { border-radius: 24rpx; padding: 36rpx 32rpx; margin-bottom: 24rpx; background: linear-gradient(135deg, #2f6b5d 0%, #4f9483 100%); display: flex; flex-direction: column; }
.hero-t { color: #ffffff; font-size: 38rpx; font-weight: bold; }
.hero-s { color: rgba(255, 255, 255, 0.85); font-size: 24rpx; margin-top: 10rpx; }
.hero-btn { width: 280rpx; height: 72rpx; font-size: 26rpx; margin-top: 28rpx; }
.entries { display: flex; flex-direction: row; margin-bottom: 24rpx; }
.entry { flex: 1; background: #ffffff; border-radius: 20rpx; margin-right: 16rpx; padding: 24rpx 0; display: flex; flex-direction: column; align-items: center; }
.entry:last-child { margin-right: 0; }
.e-ic { width: 60rpx; height: 60rpx; }
.e-t { font-size: 28rpx; font-weight: bold; margin: 8rpx 0 4rpx; }
.going { display: flex; flex-direction: row; align-items: center; }
.going-t { font-size: 28rpx; font-weight: bold; margin-bottom: 6rpx; }
.going-bar { margin-top: 16rpx; }
.going-pc { font-size: 36rpx; font-weight: bold; color: #3a7d6c; margin-left: 24rpx; }
.head { padding: 8rpx 4rpx 16rpx; }
.styles { width: 100%; white-space: nowrap; margin-bottom: 20rpx; }
.fall { display: flex; flex-direction: row; align-items: flex-start; }
.col-l { flex: 1; margin-right: 16rpx; }
.col-r { flex: 1; }
.case { background: #ffffff; border-radius: 18rpx; overflow: hidden; margin-bottom: 16rpx; opacity: 0; transform: translateY(24rpx); transition: opacity 0.45s ease-out, transform 0.45s ease-out; }
.case-in { opacity: 1; transform: translateY(0); }
.cover { width: 100%; display: block; }
.info { padding: 16rpx 18rpx 18rpx; }
.c-title { font-size: 26rpx; font-weight: bold; line-height: 1.45; }
.c-tags { margin: 10rpx 0 12rpx; }
.c-av { width: 36rpx; height: 36rpx; border-radius: 18rpx; margin-right: 8rpx; }
.faved { color: #c8894f; }
