.top { padding: 12rpx 8rpx 28rpx; display: flex; flex-direction: column; }
.top-t { font-size: 40rpx; font-weight: bold; color: #2f6b5d; }
.top-s { font-size: 24rpx; color: #8a847c; margin-top: 8rpx; }
.from { display: flex; flex-direction: row; align-items: center; padding: 22rpx 28rpx; }
.from-t { font-size: 26rpx; color: #3a7d6c; }
.slot-box { display: flex; flex-direction: row; align-items: flex-start; padding: 24rpx 0; border-bottom: 1rpx solid #f1ede7; }
.slot-box .field-label { line-height: 48rpx; }
.slot { font-size: 26rpx; margin-bottom: 12rpx; }
.remark { width: 100%; height: 150rpx; margin-top: 20rpx; font-size: 26rpx; line-height: 1.6; background: #f8f6f2; border-radius: 12rpx; padding: 16rpx; box-sizing: border-box; }
.agree { display: flex; flex-direction: row; align-items: center; padding: 0 8rpx 20rpx; }
.link { font-size: 24rpx; color: #3a7d6c; }
.err0 { padding: 0 8rpx 16rpx; display: block; }
.submit { margin-top: 8rpx; }
