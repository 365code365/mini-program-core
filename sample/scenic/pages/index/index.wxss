.search { background: #ffffff; border-radius: 40rpx; height: 76rpx; padding: 0 28rpx; margin-bottom: 24rpx; }
.s-ic { font-size: 26rpx; margin-right: 12rpx; }
.s-in { flex: 1; height: 76rpx; font-size: 26rpx; }
.s-x { font-size: 26rpx; color: #a0a6b0; padding: 10rpx; }
.banner { height: 330rpx; border-radius: 24rpx; overflow: hidden; margin-bottom: 24rpx; }
.bn { position: relative; width: 100%; height: 330rpx; }
.bn-img { width: 100%; height: 330rpx; }
.bn-mask { position: absolute; left: 0; right: 0; bottom: 0; padding: 60rpx 28rpx 40rpx; background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.45)); display: flex; flex-direction: column; }
.bn-name { font-size: 36rpx; font-weight: bold; color: #ffffff; }
.bn-slogan { font-size: 24rpx; color: rgba(255, 255, 255, 0.9); margin-top: 6rpx; }
.up { background: #fff4ec; border-radius: 20rpx; padding: 20rpx 24rpx; margin-bottom: 24rpx; }
.up-ic { width: 64rpx; height: 64rpx; border-radius: 16rpx; background: #ff7a45; display: flex; align-items: center; justify-content: center; }
.up-ic-tx { color: #ffffff; font-size: 28rpx; font-weight: bold; }
.up-main { flex: 1; margin-left: 20rpx; }
.up-t { font-size: 28rpx; font-weight: bold; margin-bottom: 4rpx; }
.cats { white-space: nowrap; margin-bottom: 20rpx; }
.cats-in { padding-bottom: 4rpx; }
.cat { padding: 10rpx 30rpx; border-radius: 30rpx; background: #ffffff; margin-right: 16rpx; font-size: 26rpx; color: #4a544f; }
.cat-on { background: #13a07b; color: #ffffff; }
.item { background: #ffffff; border-radius: 24rpx; overflow: hidden; margin-bottom: 24rpx; }
.it-img { width: 100%; height: 300rpx; }
.it-body { padding: 22rpx 26rpx 26rpx; }
.lv { font-size: 22rpx; color: #ffffff; background: #ff7a45; border-radius: 8rpx; padding: 4rpx 10rpx; margin-right: 10rpx; }
.it-city { display: block; margin: 8rpx 0 14rpx; }
.score { font-size: 26rpx; color: #ff9b2f; }
.price { font-size: 36rpx; }
