page { background: #f3f6f5; color: #1d2722; font-size: 28rpx; }
.wrap { padding: 24rpx 28rpx 40rpx; }
.card { background: #ffffff; border-radius: 24rpx; padding: 28rpx; margin-bottom: 24rpx; }
.row { display: flex; flex-direction: row; align-items: center; }
.between { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.h1 { font-size: 40rpx; font-weight: bold; }
.h2 { font-size: 32rpx; font-weight: bold; }
.muted { font-size: 24rpx; color: #86908b; }
.brand { color: #13a07b; }
.price { color: #ff6a3d; font-weight: bold; }
.btn { height: 88rpx; line-height: 88rpx; border-radius: 44rpx; text-align: center; font-size: 30rpx; background: #13a07b; color: #ffffff; }
.btn-ghost { height: 88rpx; line-height: 88rpx; border-radius: 44rpx; text-align: center; font-size: 30rpx; background: #e3f4ee; color: #13a07b; }
.btn-warm { height: 88rpx; line-height: 88rpx; border-radius: 44rpx; text-align: center; font-size: 30rpx; background: #ff7a45; color: #ffffff; }
.press { opacity: 0.75; }
.tag { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; background: #e3f4ee; color: #13a07b; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 100rpx 40rpx; }
.empty-ic { width: 140rpx; height: 140rpx; border-radius: 70rpx; background: #e3f4ee; display: flex; align-items: center; justify-content: center; font-size: 56rpx; color: #13a07b; margin-bottom: 24rpx; }
.empty-tx { font-size: 28rpx; color: #86908b; margin-bottom: 32rpx; }
.sec-title { font-size: 30rpx; font-weight: bold; margin-bottom: 16rpx; }
.line { height: 1rpx; background: #edf1ef; margin: 20rpx 0; }
.err { font-size: 24rpx; color: #e5484d; margin-top: 8rpx; }
