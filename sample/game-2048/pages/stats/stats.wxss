.grid {
  margin-top: 24rpx;
  flex-wrap: wrap;
}
.kpi {
  width: 50%;
  padding: 16rpx 0;
  text-align: center;
}
.kv {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #776e65;
}
.line {
  padding: 16rpx 0;
}
.best-v {
  font-weight: bold;
  color: #8f7a66;
}
.bar-row {
  padding: 12rpx 0;
}
.bar-label {
  width: 90rpx;
  font-weight: bold;
}
.bar-track {
  height: 24rpx;
  border-radius: 12rpx;
  background: #f3eee8;
}
.bar {
  height: 24rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f2b179, #edc22e);
}
.bar-n {
  width: 90rpx;
  text-align: right;
  font-size: 24rpx;
}
