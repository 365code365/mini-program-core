.hero {
  padding: 40rpx 0 30rpx;
  text-align: center;
}
.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}
.demo {
  justify-content: center;
}
.d {
  width: 96rpx;
  height: 96rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: bold;
}
.t2 { background: #eee4da; }
.t4 { background: #ede0c8; }
.op {
  margin: 0 20rpx;
  font-size: 40rpx;
}
.sec {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0ebe4;
}
.sec-title {
  font-weight: bold;
}
.sec-body {
  display: block;
  margin-top: 12rpx;
  line-height: 1.7;
  color: #8f7a66;
  font-size: 26rpx;
}
