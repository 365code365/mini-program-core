.page {
  padding: 24rpx 30rpx 40rpx;
}
.head {
  margin-bottom: 16rpx;
}
.logo {
  width: 170rpx;
  height: 170rpx;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}
.score-box {
  position: relative;
  min-width: 150rpx;
  margin-left: 16rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: #bbada0;
  text-align: center;
}
.score-label {
  display: block;
  color: #eee4da;
  font-size: 22rpx;
}
.score-num {
  display: block;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
}
.plus {
  position: absolute;
  right: 8rpx;
  top: -30rpx;
  color: #8f7a66;
  font-size: 24rpx;
  font-weight: bold;
}
.tip {
  margin-bottom: 20rpx;
}
.em {
  color: #776e65;
  font-weight: bold;
}
.ops {
  margin-bottom: 24rpx;
}
.op {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
}
.btn-new {
  margin-right: 20rpx;
}
.btn-undo {
  background: #a39489;
}
.btn-undo.disabled {
  background: #d8d0c8;
  color: #f4efe9;
}
.board {
  width: 690rpx;
  height: 690rpx;
  box-sizing: border-box;
  padding: 20rpx 0 0 20rpx;
  border-radius: 16rpx;
}
.brow {
  display: flex;
  flex-direction: row;
  margin-bottom: 20rpx;
}
.cell {
  margin-right: 20rpx;
  border-radius: 10rpx;
}
.tile {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  color: #776e65;
}
.tile.pop {
  animation: pop 0.18s ease-out;
}
@keyframes pop {
  from { transform: scale(0.6); }
  to { transform: scale(1); }
}
.t2 { background: #eee4da; }
.t4 { background: #ede0c8; }
.t8 { background: #f2b179; color: #f9f6f2; }
.t16 { background: #f59563; color: #f9f6f2; }
.t32 { background: #f67c5f; color: #f9f6f2; }
.t64 { background: #f65e3b; color: #f9f6f2; }
.t128 { background: #edcf72; color: #f9f6f2; }
.t256 { background: #edcc61; color: #f9f6f2; }
.t512 { background: #edc850; color: #f9f6f2; }
.t1024 { background: #edc53f; color: #f9f6f2; }
.t2048 { background: #edc22e; color: #f9f6f2; }
.tsuper { background: #3c3a32; color: #f9f6f2; }
.state {
  margin-top: 20rpx;
  text-align: center;
  color: #edc22e;
  font-weight: bold;
}
.nav {
  margin-top: 28rpx;
}
.nav-item {
  flex: 1;
  margin: 0 8rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 36rpx;
  background: #ffffff;
  color: #776e65;
  font-size: 26rpx;
}
