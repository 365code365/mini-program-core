<view class="steps">
  <text class="stp on">① 提交处方 / 问诊</text><text class="arr">›</text><text class="stp">② 药师审核</text><text class="arr">›</text><text class="stp">③ 下单发货</text>
</view>

<view class="card">
  <text class="h">{{pick ? '选择要开具的处方药' : '需要审方的药品'}}</text>
  <view class="dg" wx:for="{{drugs}}" wx:key="id" data-i="{{index}}" bindtap="onPick">
    <view wx:if="{{pick}}" class="ck {{item.on ? 'ck-on' : ''}}">{{item.on ? '✓' : ''}}</view>
    <image class="dg-img" src="{{item.img}}" mode="aspectFill"></image>
    <view class="dg-b"><view class="dg-n"><text class="rx">处方药</text><text class="dg-nt">{{item.brand}} {{item.name}}</text></view><text class="muted">{{item.specs[0].s}}</text></view>
  </view>
  <text wx:if="{{errs.drugs}}" class="err">{{errs.drugs}}</text>
</view>

<view class="card">
  <text class="h">用药人信息</text>
  <view class="fld"><text class="fl">姓名</text><input class="ipt" placeholder="与就诊人一致" value="{{name}}" data-f="name" bindinput="onField" maxlength="10"/></view>
  <text wx:if="{{errs.name}}" class="err">{{errs.name}}</text>
  <view class="fld"><text class="fl">年龄</text><input class="ipt" type="number" placeholder="周岁" value="{{age}}" data-f="age" bindinput="onField" maxlength="3"/></view>
  <text wx:if="{{errs.age}}" class="err">{{errs.age}}</text>
  <view class="fld"><text class="fl">性别</text>
    <view class="chips"><text wx:for="{{genders}}" wx:key="*this" class="chip {{gender === item ? 'chip-on' : ''}}" data-v="{{item}}" bindtap="onGender">{{item}}</text></view>
  </view>
  <text wx:if="{{errs.gender}}" class="err">{{errs.gender}}</text>
</view>

<view class="tabs">
  <view class="t {{tab === 0 ? 't-on' : ''}}" data-t="0" bindtap="onTab">上传处方</view>
  <view class="t {{tab === 1 ? 't-on' : ''}}" data-t="1" bindtap="onTab">在线问诊（复诊）</view>
</view>

<view wx:if="{{tab === 0}}" class="card">
  <text class="muted">请上传 7 天内医院开具的处方，需清晰可见医院印章、医师签名、药品名称与用量</text>
  <view class="imgs">
    <view class="im" wx:for="{{imgs}}" wx:key="*this">
      <image class="im-img" src="{{item}}" mode="aspectFill" data-i="{{index}}" bindtap="preview"></image>
      <text class="im-del" data-i="{{index}}" catchtap="delImg">×</text>
    </view>
    <view wx:if="{{imgs.length < 3}}" class="im im-add" bindtap="addImg"><text class="im-plus">＋</text><text class="muted">拍照 / 相册</text></view>
  </view>
  <text wx:if="{{errs.imgs}}" class="err">{{errs.imgs}}</text>
  <text class="sample" bindtap="useSample">手边没有处方照片？使用示例处方单（仅演示）</text>
</view>

<view wx:else class="card">
  <text class="h">已确诊疾病（可多选）</text>
  <view class="chips wrap"><text wx:for="{{diseases}}" wx:key="t" class="chip {{item.on ? 'chip-on' : ''}}" data-i="{{index}}" bindtap="onDisease">{{item.t}}</text></view>
  <text wx:if="{{errs.disease}}" class="err">{{errs.disease}}</text>
  <text class="h h2">是否已在线下医院确诊并用过该药</text>
  <view class="chips"><text wx:for="{{yesno}}" wx:key="*this" class="chip {{diag === item ? 'chip-on' : ''}}" data-v="{{item}}" bindtap="onDiag">{{item}}</text></view>
  <text wx:if="{{errs.diag}}" class="err">{{errs.diag}}</text>
  <text class="h h2">过敏史</text>
  <view class="chips"><text wx:for="{{noyes}}" wx:key="*this" class="chip {{allergy === item ? 'chip-on' : ''}}" data-v="{{item}}" bindtap="onAllergy">{{item}}</text></view>
  <input wx:if="{{allergy === '有'}}" class="ipt2" placeholder="如：青霉素、磺胺类" value="{{allergyText}}" data-f="allergyText" bindinput="onField"/>
  <text wx:if="{{errs.allergyText}}" class="err">{{errs.allergyText}}</text>
  <text class="h h2">病情描述（选填）</text>
  <textarea class="ta" placeholder="近期血压 / 血糖控制情况、正在服用的其他药物等" value="{{desc}}" data-f="desc" bindinput="onField" maxlength="200"></textarea>
</view>

<view class="promise">
  <checkbox-group bindchange="onPromise">
    <label class="pr-l"><checkbox value="ok" checked="{{promise}}" color="#12a37f"/><text class="pr-t">我承诺以上信息真实，并已了解处方药须遵医嘱使用</text></label>
  </checkbox-group>
  <text wx:if="{{errs.promise}}" class="err">{{errs.promise}}</text>
</view>
<view class="foot"><view class="btn" bindtap="submit">提交审核</view></view>
