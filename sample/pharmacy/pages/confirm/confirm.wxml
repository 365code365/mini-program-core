<view wx:if="{{!items.length}}" class="empty">
  <view class="empty-ic">单</view><text class="empty-t">没有要结算的商品</text>
  <view class="btn empty-btn" bindtap="goShop">去选购</view>
</view>
<block wx:else>
  <view class="card addr">
    <block wx:if="{{!editAddr}}">
      <view class="ad-b">
        <view class="ad-r"><text class="ad-n">{{addr.name}}</text><text class="ad-p">{{addr.phone}}</text></view>
        <text class="ad-d">{{addr.region[0]}}{{addr.region[1]}}{{addr.region[2]}} {{addr.detail}}</text>
      </view>
      <text class="ad-e" bindtap="editAddress">修改</text>
    </block>
    <view wx:else class="ad-f">
      <text class="h">收货地址</text>
      <view class="fld"><text class="fl">收货人</text><input class="ipt" placeholder="姓名" value="{{addr.name}}" data-f="name" bindinput="onAddr" maxlength="12"/></view>
      <text wx:if="{{errs.name}}" class="err">{{errs.name}}</text>
      <view class="fld"><text class="fl">手机号</text><input class="ipt" type="number" placeholder="11 位手机号" value="{{addr.phone}}" data-f="phone" bindinput="onAddr" maxlength="11"/></view>
      <text wx:if="{{errs.phone}}" class="err">{{errs.phone}}</text>
      <picker mode="region" value="{{addr.region}}" bindchange="onRegion">
        <view class="fld"><text class="fl">所在地区</text><text class="ipt-t">{{addr.region[0]}} {{addr.region[1]}} {{addr.region[2]}}</text><text class="arrow">›</text></view>
      </picker>
      <view class="fld"><text class="fl">详细地址</text><input class="ipt" placeholder="街道、小区、楼栋门牌号" value="{{addr.detail}}" data-f="detail" bindinput="onAddr" maxlength="60"/></view>
      <text wx:if="{{errs.detail}}" class="err">{{errs.detail}}</text>
    </view>
  </view>

  <view class="card">
    <text class="h">配送方式</text>
    <radio-group bindchange="onDv">
      <label wx:for="{{delivery}}" wx:key="id" class="dv">
        <radio value="{{item.id}}" checked="{{dv === item.id}}" color="#12a37f"/>
        <view class="dv-b"><text class="dv-t">{{item.t}} · {{item.s}}</text><text class="muted">运费 ¥{{item.fee}}，满 {{item.free}} 元免运费</text></view>
      </label>
    </radio-group>
  </view>

  <view wx:if="{{rx || rxNeed.length}}" class="card rxs {{rxNeed.length ? 'rxs-bad' : ''}}">
    <block wx:if="{{rxNeed.length}}">
      <text class="rxs-t">处方药未审方</text>
      <text class="rxs-s">请先上传处方或在线问诊，审核通过后才能支付</text>
      <view class="btn-o rxs-b" bindtap="goRx">去审方</view>
    </block>
    <block wx:else>
      <text class="rxs-t">✓ 处方已审核 · {{rx.no}}</text>
      <text class="rxs-s">{{rx.method}} · {{rx.pharmacist}} · 用药人 {{rx.patient}}</text>
    </block>
  </view>

  <view class="card">
    <text class="h">商品清单（{{items.length}} 种）</text>
    <view class="it" wx:for="{{items}}" wx:key="key">
      <image class="it-img" src="{{item.img}}" mode="aspectFill"></image>
      <view class="it-b">
        <view class="it-n"><text wx:if="{{item.type === 'RX'}}" class="rx">处方药</text><text class="it-nt">{{item.brand}} {{item.name}}</text></view>
        <text class="muted">{{item.spec}}</text>
      </view>
      <view class="it-r"><text class="it-p">¥{{item.priceText}}</text><text class="muted">×{{item.qty}}</text></view>
    </view>
    <view class="kv"><text>商品金额</text><text>¥{{sum.goods}}</text></view>
    <view class="kv"><text>运费（{{sum.tip}}）</text><text>¥{{sum.freight}}</text></view>
    <view class="kv"><text>满 99 减 10</text><text class="red">-¥{{sum.discount}}</text></view>
    <view class="fld"><text class="fl">备注</text><input class="ipt" placeholder="如：放门口、电话联系" value="{{remark}}" bindinput="onRemark" maxlength="50"/></view>
  </view>
  <view class="gap"></view>

  <view class="bar">
    <view class="bar-s"><text>应付 </text><text class="price bar-p">¥{{sum.pay}}</text></view>
    <view class="pay {{paying || rxNeed.length ? 'pay-dis' : ''}}" bindtap="submit">提交订单</view>
  </view>
</block>
