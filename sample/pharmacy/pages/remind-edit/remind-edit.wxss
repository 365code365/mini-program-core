.h { display: block; font-size: 28rpx; font-weight: bold; margin-bottom: 12rpx; }
.h0 { font-size: 28rpx; font-weight: bold; }
.ipt { height: 80rpx; font-size: 27rpx; background: #f3f6f5; border-radius: 10rpx; padding: 0 20rpx; }
.err { display: block; color: #f04a3e; font-size: 22rpx; margin-top: 6rpx; }
.chips { display: flex; flex-direction: row; align-items: center; margin-top: 12rpx; }
.wrap { flex-wrap: wrap; }
.lb { margin: 0 8rpx 12rpx 0; }
.chip { font-size: 24rpx; padding: 6rpx 22rpx; border-radius: 28rpx; background: #f3f6f5; color: #33423e; margin: 0 14rpx 12rpx 0; border: 2rpx solid #f3f6f5; }
.chip-on { background: #e3f3ee; color: #12a37f; border-color: #12a37f; }
.row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.add { font-size: 24rpx; color: #12a37f; }
.tm { display: flex; flex-direction: row; align-items: center; border-bottom: 1rpx solid #eef2f1; }
.tm picker { flex: 1; }
.tm-v { display: flex; flex-direction: row; align-items: center; justify-content: space-between; height: 96rpx; padding-right: 20rpx; }
.tm-t { font-size: 40rpx; font-weight: bold; color: #12a37f; }
.tm-del { font-size: 24rpx; color: #f04a3e; padding: 10rpx 0 10rpx 20rpx; }
.qk { display: flex; flex-direction: row; }
.q { font-size: 22rpx; color: #12a37f; border: 2rpx solid #bfe3d7; border-radius: 22rpx; padding: 2rpx 16rpx; margin-left: 12rpx; }
.wk { display: flex; flex-direction: row; justify-content: space-between; margin-top: 20rpx; }
.wd { display: flex; flex-direction: column; align-items: center; }
.wd-t { font-size: 24rpx; margin-top: 6rpx; color: #55625e; }
.wd-on .wd-t { color: #12a37f; font-weight: bold; }
.cal { margin-top: 24rpx; }
.cal-b { display: flex; flex-direction: column; }
.foot { padding: 40rpx 24rpx 80rpx; }
.del { text-align: center; color: #f04a3e; font-size: 26rpx; margin-top: 30rpx; }
