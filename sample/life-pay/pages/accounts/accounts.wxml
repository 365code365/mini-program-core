<block wx:if="{{!adding}}">
  <view class="head row between"><text class="muted">已绑定 {{list.length}} 个户号</text><text class="muted">长按或点「···」管理</text></view>
  <view class="card acc row" wx:for="{{list}}" wx:key="id" bindlongpress="more" data-id="{{item.id}}">
    <view class="ic" style="background: {{item.bg}};"><text>{{item.ch}}</text></view>
    <view class="a-main">
      <view class="row"><text class="a-t">{{item.tname}}</text><text class="a-tag" style="color: {{item.color}}; background: {{item.light}};">{{item.tag}}</text></view>
      <text class="a-no">{{item.noTx}}</text>
      <text class="muted a-unit">{{item.unit}}</text>
    </view>
    <view class="a-right">
      <view class="more" data-id="{{item.id}}" catchtap="more"><view class="md"></view><view class="md"></view><view class="md"></view></view>
      <text class="{{item.owe > 0 ? 'owe' : 'a-ok'}} a-st">{{item.owe > 0 ? '欠 ¥' + item.oweTx : '无欠费'}}</text>
    </view>
  </view>
  <view class="add-btn" bindtap="openAdd"><text>+ 添加户号</text></view>
</block>

<block wx:else>
  <view class="card form">
    <text class="sec-title">缴费类型</text>
    <view class="types row">
      <view class="tp {{typeIdx === index ? 'on' : ''}}" wx:for="{{payTypes}}" wx:key="k" data-i="{{index}}" bindtap="onType">
        <view class="ic tp-ic" style="background: {{typeIdx === index ? item.bg : '#e6e9ee'}};"><text>{{item.ch}}</text></view>
        <text class="tp-tx">{{item.name}}</text>
      </view>
    </view>
    <picker mode="selector" range="{{cities}}" value="{{cityIdx}}" bindchange="onCity">
      <view class="fi row"><text class="fl">所在城市</text><text class="fv">{{cities[cityIdx]}}</text><view class="chev"></view></view>
    </picker>
    <picker mode="selector" range="{{unitList}}" value="{{unitIdx}}" bindchange="onUnit">
      <view class="fi row"><text class="fl">缴费单位</text><text class="fv">{{unitList[unitIdx]}}</text><view class="chev"></view></view>
    </picker>
    <view class="fi row">
      <text class="fl">户号</text>
      <input class="fin" type="number" maxlength="12" value="{{no}}" placeholder="请输入 8~12 位户号" bindinput="onNo" />
      <text class="help" bindtap="help">如何查找</text>
    </view>
    <view class="fi row last">
      <text class="fl">分组</text>
      <view class="tags row"><view class="tg {{tag === item ? 'on' : ''}}" wx:for="{{tags}}" wx:key="*this" data-t="{{item}}" bindtap="onTag"><text>{{item}}</text></view></view>
    </view>
  </view>
  <view class="card row between">
    <view class="sw-main"><text class="sw-t">设为常用户号</text><text class="muted">首页优先展示，出账后提醒缴费</text></view>
    <switch checked="{{setDefault}}" color="#14a06f" bindchange="onDefault" />
  </view>
  <view class="actions">
    <view class="btn-primary {{no.length >= 8 ? '' : 'off'}}" bindtap="submit"><text>查询并添加</text></view>
    <view class="cancel" bindtap="closeAdd"><text>取消</text></view>
  </view>
</block>
