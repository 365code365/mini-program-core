<view class="head row between"><text class="muted">共 {{list.length}} 笔订单</text><text class="muted">累计实付 ¥{{sum}}</text></view>
<view wx:if="{{!list.length}}" class="empty"><text>还没有订单</text></view>
<view wx:for="{{list}}" wx:key="id" class="card od">
  <view class="row between od-top"><text class="muted">{{item.time}}</text><text class="st {{item.status}}">{{item.st}}</text></view>
  <view class="row od-body" data-cid="{{item.cid}}" bindtap="detail">
    <view class="cv" style="background: {{item.cover}};"><text>{{item.mark}}</text></view>
    <view class="od-main">
      <text class="od-title">{{item.title}}</text>
      <text class="muted od-sub">订单号 {{item.id}}</text>
      <text wx:if="{{item.cut}}" class="muted od-sub">优惠券减 ¥{{item.cut}}</text>
    </view>
    <text class="od-pay">¥{{item.pay}}</text>
  </view>
  <view class="row od-acts">
    <view wx:if="{{item.canRefund}}" class="op" data-id="{{item.id}}" bindtap="refund"><text>申请退款</text></view>
    <view wx:if="{{item.owned}}" class="op op-main" data-cid="{{item.cid}}" bindtap="study"><text>去学习</text></view>
    <view wx:elif="{{item.status === 'refunded'}}" class="op" data-cid="{{item.cid}}" bindtap="detail"><text>重新购买</text></view>
  </view>
</view>
<view class="gap"></view>
