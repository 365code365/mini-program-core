<block wx:if="{{!paid}}">
  <view class="card row course">
    <view class="cv" style="background: {{c.cover}};"><text>{{c.mark}}</text></view>
    <view class="c-main">
      <text class="c-title">{{c.title}}</text>
      <text class="muted">{{c.teacher}} · {{c.lessons}} 节 · {{c.hours}} 小时 · 永久有效</text>
    </view>
  </view>
  <view class="card">
    <view class="kv row between"><text class="k">课程原价</text><text class="v">¥{{c.origin}}</text></view>
    <view class="kv row between"><text class="k">限时优惠</text><text class="v red">-¥{{discount}}</text></view>
    <view class="kv row between cp" bindtap="pickCoupon">
      <text class="k">优惠券</text>
      <view class="row">
        <text wx:if="{{coupon}}" class="v red">{{coupon.name}} -¥{{coupon.cut}}</text>
        <text wx:elif="{{coupons.length}}" class="v gray">{{coupons.length}} 张可用，未使用</text>
        <text wx:else class="v gray">暂无可用</text>
        <view class="chev"></view>
      </view>
    </view>
    <view class="kv row between total"><text class="k">实付</text><text class="pay">¥{{pay}}</text></view>
  </view>
  <text class="tip">虚拟课程购买后 7 天内、付费课时学习不足 3 节可申请退款</text>
  <view class="foot-gap"></view>
  <view class="foot row">
    <view class="f-sum row"><text class="muted">合计</text><text class="pay f-pay">¥{{pay}}</text></view>
    <view class="f-btn" bindtap="submit"><text>{{pay === 0 ? '免费领取' : '立即支付'}}</text></view>
  </view>
</block>
<block wx:else>
  <view class="ok-top">
    <view class="ok"><view class="tick"></view></view>
    <text class="ok-t">{{order.pay ? '支付成功' : '领取成功'}}</text>
    <text class="muted">「{{order.title}}」已加入学习中心</text>
  </view>
  <view class="card">
    <view class="kv row between"><text class="k">订单号</text><text class="v">{{order.id}}</text></view>
    <view class="kv row between"><text class="k">实付</text><text class="v">¥{{order.pay}}</text></view>
    <view class="kv row between"><text class="k">下单时间</text><text class="v">{{order.time}}</text></view>
  </view>
  <view class="btns row">
    <view class="ghost" bindtap="orders"><text>查看订单</text></view>
    <view class="btn-primary go" bindtap="study"><text>开始学习</text></view>
  </view>
</block>
