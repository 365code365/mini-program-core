.top { background: linear-gradient(160deg, #5b8cff, #3d6cf6); padding: 40rpx 32rpx 36rpx; }
.me-av { width: 120rpx; height: 120rpx; border-radius: 60rpx; background: linear-gradient(135deg, #ffd27a, #ff9a3d); border: 4rpx solid rgba(255, 255, 255, 0.7); font-size: 48rpx; }
.me { margin-left: 24rpx; display: flex; flex-direction: column; }
.me-name { font-size: 38rpx; font-weight: bold; color: #ffffff; }
.vip { margin-left: 14rpx; font-size: 20rpx; color: #7a4a00; background: linear-gradient(90deg, #ffe7a8, #ffc85c); padding: 4rpx 14rpx; border-radius: 20rpx; }
.me-sub { margin-top: 10rpx; font-size: 22rpx; color: rgba(255, 255, 255, 0.8); }
.stat { margin-top: 40rpx; background: rgba(255, 255, 255, 0.14); border-radius: 20rpx; padding: 24rpx 0; }
.st { flex: 1; display: flex; flex-direction: column; align-items: center; }
.st-n { font-size: 36rpx; font-weight: bold; color: #ffffff; }
.st-l { margin-top: 4rpx; font-size: 20rpx; color: rgba(255, 255, 255, 0.85); }
.fav-empty { margin-top: 20rpx; padding: 32rpx; background: #f6f8fc; border-radius: 16rpx; font-size: 24rpx; color: #9aa0ab; text-align: center; }
.favs { margin-top: 20rpx; white-space: nowrap; }
.fav { display: inline-flex; flex-direction: column; width: 220rpx; margin-right: 18rpx; }
.fav-cv { width: 220rpx; height: 140rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; color: #ffffff; font-size: 44rpx; font-weight: bold; }
.fav-t { margin-top: 10rpx; font-size: 24rpx; color: #2b3140; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.menu { padding: 8rpx 28rpx; }
.mi { padding: 24rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.mi-ic { width: 60rpx; height: 60rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: bold; }
.mi-t { flex: 1; margin-left: 20rpx; font-size: 28rpx; }
.mi-x { font-size: 24rpx; color: #9aa0ab; }
.ver { display: block; text-align: center; margin-top: 32rpx; font-size: 22rpx; color: #b3b8c2; }
