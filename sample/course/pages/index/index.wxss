.hero { background: #3d6cf6; padding: 12rpx 24rpx 24rpx; }
.search { height: 72rpx; background: #ffffff; border-radius: 36rpx; display: flex; flex-direction: row; align-items: center; padding: 0 24rpx; }
.s-ic { width: 22rpx; height: 22rpx; border: 4rpx solid #9aa0ab; border-radius: 50%; margin-right: 14rpx; flex-shrink: 0; }
.s-input { flex: 1; height: 72rpx; font-size: 26rpx; color: #1f2430; }
.s-ph { color: #a7adb8; }
.s-clear { width: 36rpx; height: 36rpx; border-radius: 18rpx; background: #c9ced8; color: #ffffff; font-size: 28rpx; line-height: 34rpx; text-align: center; flex-shrink: 0; }
.cats { white-space: nowrap; background: #ffffff; padding: 20rpx 0 20rpx 24rpx; }
.cat { display: inline-block; height: 56rpx; line-height: 56rpx; padding: 0 26rpx; margin-right: 16rpx; border-radius: 28rpx; background: #f2f4f8; color: #5b6272; font-size: 26rpx; }
.cat.on { background: #edf2ff; color: #3d6cf6; font-weight: bold; }
.banner-wrap { margin: 24rpx 24rpx 0; height: 240rpx; border-radius: 20rpx; overflow: hidden; }
.banner { height: 240rpx; }
.b-item { height: 240rpx; padding: 36rpx 36rpx; box-sizing: border-box; position: relative; overflow: hidden; display: flex; flex-direction: column; }
.b-title { font-size: 36rpx; font-weight: bold; color: #ffffff; }
.b-sub { margin-top: 10rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.85); }
.b-btn { margin-top: 24rpx; width: 168rpx; height: 54rpx; border-radius: 27rpx; background: #ffffff; color: #3d4ff0; font-size: 24rpx; font-weight: bold; display: flex; align-items: center; justify-content: center; }
.b-deco1 { position: absolute; right: -40rpx; top: -50rpx; width: 220rpx; height: 220rpx; border-radius: 110rpx; background: rgba(255, 255, 255, 0.14); }
.b-deco2 { position: absolute; right: 70rpx; bottom: -70rpx; width: 160rpx; height: 160rpx; border-radius: 80rpx; background: rgba(255, 255, 255, 0.12); }
.quick { display: flex; flex-direction: row; padding: 28rpx 8rpx; }
.q-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.q-ic { width: 88rpx; height: 88rpx; border-radius: 28rpx; display: flex; align-items: center; justify-content: center; color: #ffffff; font-size: 36rpx; font-weight: bold; }
.q-tx { margin-top: 12rpx; font-size: 24rpx; color: #3a4152; }
.teachers { margin-top: 24rpx; white-space: nowrap; }
.teacher { display: inline-flex; flex-direction: column; align-items: center; width: 200rpx; padding: 26rpx 0 22rpx; margin-right: 18rpx; background: #f6f8fc; border-radius: 20rpx; }
.t-av { width: 96rpx; height: 96rpx; border-radius: 48rpx; }
.t-name { margin-top: 14rpx; font-size: 28rpx; font-weight: bold; color: #1f2430; }
.t-title { margin-top: 6rpx; font-size: 20rpx; color: #3d6cf6; }
.t-fans { margin-top: 6rpx; font-size: 20rpx; color: #9aa0ab; }
.list-card { padding-bottom: 8rpx; }
.course { display: flex; flex-direction: row; padding: 28rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.course:last-child { border-bottom: none; }
.cover { width: 220rpx; height: 164rpx; border-radius: 16rpx; position: relative; flex-shrink: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.cover-mark { font-size: 56rpx; font-weight: bold; color: rgba(255, 255, 255, 0.95); }
.cover-ls { position: absolute; right: 10rpx; bottom: 8rpx; font-size: 20rpx; color: #ffffff; background: rgba(0, 0, 0, 0.25); padding: 2rpx 10rpx; border-radius: 8rpx; }
.hot { position: absolute; left: 0; top: 0; background: linear-gradient(90deg, #ff8a3d, #ff5a3d); color: #ffffff; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 16rpx 0 16rpx 0; }
.c-main { flex: 1; margin-left: 22rpx; display: flex; flex-direction: column; min-width: 0; }
.c-title { font-size: 28rpx; font-weight: bold; color: #1f2430; line-height: 38rpx; }
.c-sub { margin-top: 8rpx; font-size: 22rpx; color: #8b92a1; }
.c-tags { margin-top: 10rpx; }
.c-foot { margin-top: 10rpx; }
.price-row { align-items: baseline; }
.yen { font-size: 22rpx; color: #ff5a3d; font-weight: bold; }
.price { font-size: 34rpx; color: #ff5a3d; font-weight: bold; }
.origin { font-size: 22rpx; color: #b3b8c2; text-decoration: line-through; margin-left: 10rpx; }
.stu { font-size: 22rpx; color: #9aa0ab; }
