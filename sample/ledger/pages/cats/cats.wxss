.seg-wrap { display: flex; flex-direction: row; justify-content: center; }
.seg { margin: 24rpx 0 0; width: 400rpx; height: 68rpx; border-radius: 34rpx; background: #ebecf0; display: flex; flex-direction: row; padding: 6rpx; box-sizing: border-box; }
.seg-item { flex: 1; height: 56rpx; line-height: 56rpx; text-align: center; border-radius: 28rpx; font-size: 28rpx; color: #5c6066; white-space: nowrap; }
.seg-on { background: #ffffff; color: #f57c34; font-weight: bold; }
.new-row { margin-top: 24rpx; }
.add-input { margin: 0 20rpx; height: 76rpx; padding: 0 20rpx; background: #f5f6f8; border-radius: 14rpx; font-size: 28rpx; }
.ph { color: #b8bcc4; }
.add-btn { height: 68rpx; line-height: 68rpx; padding: 0 32rpx; border-radius: 34rpx; background: linear-gradient(90deg, #ffa94d, #f5733b); color: #ffffff; font-size: 28rpx; font-weight: bold; white-space: nowrap; }
.add-hover { opacity: 0.8; }
.colors { margin-top: 24rpx; justify-content: space-between; }
/* 选中的颜色外面套一圈环：直接给色块加白边会在圆边露出一道细线 */
.color { width: 64rpx; height: 64rpx; border-radius: 32rpx; box-sizing: border-box; border: 4rpx solid #ffffff; padding: 4rpx; }
.color-on { border: 4rpx solid #1f2329; }
.dot { width: 48rpx; height: 48rpx; border-radius: 24rpx; }
.list { padding: 0 28rpx; }
.cat { height: 104rpx; border-bottom: 1rpx solid #f0f1f4; }
.last { border-bottom: none; }
.small { width: 60rpx; height: 60rpx; border-radius: 30rpx; font-size: 26rpx; }
.cat-name { margin-left: 20rpx; font-size: 28rpx; }
.cat-count { margin-right: 20rpx; }
.del { font-size: 24rpx; color: #f04848; background: #fff2f2; padding: 6rpx 22rpx; border-radius: 24rpx; white-space: nowrap; }
.del-hover { opacity: 0.6; }
.sys { font-size: 22rpx; color: #b8bcc4; width: 88rpx; text-align: center; }
.foot { text-align: center; margin: 32rpx 40rpx 60rpx; }
