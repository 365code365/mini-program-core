.result { padding: 32rpx; }
.level-tag { color: #ffffff; font-size: 24rpx; padding: 6rpx 20rpx; border-radius: 20rpx; font-weight: bold; }
.bmi { font-size: 112rpx; font-weight: bold; margin-top: 4rpx; }
.scale { position: relative; display: flex; flex-direction: row; height: 16rpx; border-radius: 8rpx; overflow: visible; margin-top: 16rpx; }
.seg-bar { height: 16rpx; }
.seg-bar:first-child { border-radius: 8rpx 0 0 8rpx; }
.seg-bar:nth-child(4) { border-radius: 0 8rpx 8rpx 0; }
.marker { position: absolute; top: -10rpx; width: 12rpx; height: 36rpx; margin-left: -6rpx; border-radius: 6rpx; background: #1f2329; border: 4rpx solid #ffffff; box-sizing: border-box; }
.scale-labels { position: relative; height: 40rpx; }
.sl { position: absolute; top: 8rpx; font-size: 20rpx; color: #8a8d96; margin-left: -20rpx; }
.tip { margin-top: 16rpx; font-size: 28rpx; line-height: 1.6; color: #3d4047; }
.ideal { margin-top: 12rpx; }
.gender { margin-bottom: 8rpx; }
.g { width: 120rpx; height: 60rpx; line-height: 60rpx; text-align: center; border-radius: 30rpx; background: #f5f6f8; color: #5c6066; margin-right: 16rpx; }
.g-on { background: #eef1ff; color: #4056ee; font-weight: bold; }
.label-row { margin-top: 28rpx; }
.lbl { font-size: 30rpx; font-weight: bold; }
.num { width: 200rpx; display: flex; flex-direction: row; justify-content: center; align-items: baseline; font-size: 40rpx; font-weight: bold; color: #4056ee; white-space: nowrap; }
.u { font-size: 24rpx; color: #8a8d96; font-weight: normal; margin-left: 6rpx; }
.step { width: 56rpx; height: 56rpx; line-height: 52rpx; text-align: center; border-radius: 28rpx; background: #eef1ff; color: #4056ee; font-size: 36rpx; font-weight: bold; }
.trow { height: 80rpx; border-bottom: 1rpx solid #f2f3f5; }
.trow:last-child { border-bottom: none; }
.dot { width: 16rpx; height: 16rpx; border-radius: 8rpx; margin-right: 16rpx; }
.space { height: 48rpx; }
