.tabs-wrap { padding: 24rpx 24rpx 0; }
.input-card { padding: 28rpx 32rpx; }
.unit-pick { padding-bottom: 12rpx; }
.from-n { font-size: 32rpx; font-weight: bold; }
.from-s { font-size: 26rpx; color: #8a8d96; margin: 0 12rpx; }
/* 下拉箭头：引擎不画「零宽高 + 透明边框」的 CSS 三角，改用旋转的折线 */
.caret { width: 14rpx; height: 14rpx; border-right: 4rpx solid #4056ee; border-bottom: 4rpx solid #4056ee; transform: rotate(45deg); margin: -8rpx 8rpx 0; }
.val-input { height: 112rpx; font-size: 72rpx; font-weight: bold; color: #4056ee; }
.list { padding: 20rpx 28rpx 4rpx; }
.list-head { padding-bottom: 8rpx; }
.item { height: 104rpx; border-bottom: 1rpx solid #f2f3f5; }
.item:last-child { border-bottom: none; }
.item-hover { opacity: 0.6; }
.badge { min-width: 72rpx; height: 48rpx; line-height: 48rpx; padding: 0 12rpx; box-sizing: border-box; text-align: center; border-radius: 12rpx; background: #eef1ff; color: #4056ee; font-size: 22rpx; font-weight: bold; margin-right: 20rpx; }
.name { font-size: 28rpx; }
.v { font-size: 32rpx; font-weight: bold; margin-left: 12rpx; }
.tip-t { font-size: 28rpx; font-weight: bold; margin-bottom: 8rpx; }
.tip .muted { line-height: 1.7; }
.space { height: 48rpx; }
