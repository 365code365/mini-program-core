.banner {
  position: relative;
  overflow: hidden;
  padding: 44rpx 40rpx 120rpx;
  background: linear-gradient(160deg, #4f73f8 0%, #3a52e0 100%);
  color: #ffffff;
}
.banner-hi { font-size: 40rpx; font-weight: bold; }
.banner-sub { font-size: 24rpx; opacity: 0.85; margin-top: 12rpx; }
.bubble { position: absolute; border-radius: 50%; background: rgba(255, 255, 255, 0.1); }
.b1 { width: 260rpx; height: 260rpx; right: -60rpx; top: -80rpx; }
.b2 { width: 140rpx; height: 140rpx; right: 150rpx; top: 110rpx; }
.grid-card { margin-top: -88rpx; position: relative; padding: 16rpx 8rpx; }
.grid { display: flex; flex-direction: row; flex-wrap: wrap; }
.tool { width: 33.33%; display: flex; flex-direction: column; align-items: center; padding: 28rpx 0; }
.tool-hover { opacity: 0.6; }
.tool-icon {
  width: 96rpx; height: 96rpx; border-radius: 28rpx; color: #ffffff; font-size: 40rpx; font-weight: bold;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 18rpx rgba(64, 86, 238, 0.18);
}
.tool-name { font-size: 28rpx; font-weight: bold; margin-top: 16rpx; white-space: nowrap; }
.tool-desc { font-size: 22rpx; color: #8a8d96; margin-top: 6rpx; }
.recent { flex-wrap: wrap; margin-top: 16rpx; }
.chip { padding: 12rpx 24rpx; background: #f5f6f8; border-radius: 30rpx; margin: 8rpx 16rpx 8rpx 0; font-size: 26rpx; }
.chip-dot { width: 12rpx; height: 12rpx; border-radius: 6rpx; margin-right: 10rpx; }
.tip-icon {
  width: 72rpx; height: 72rpx; border-radius: 20rpx; background: #eef1ff; color: #4056ee; font-weight: bold; font-size: 30rpx;
  display: flex; align-items: center; justify-content: center; margin-right: 20rpx;
}
.tip-t { font-size: 30rpx; font-weight: bold; margin-bottom: 4rpx; }
.foot { text-align: center; margin: 40rpx 0; }
