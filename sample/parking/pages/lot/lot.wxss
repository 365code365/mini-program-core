.head { margin-top: 20rpx; }
.h-name { display: block; font-size: 36rpx; font-weight: bold; }
.h-line { margin-top: 8rpx; }
.h-addr { margin-right: 12rpx; }
.h-op { font-size: 22rpx; color: #1677ff; border: 2rpx solid #b7d3ff; border-radius: 20rpx; padding: 2rpx 16rpx; margin-left: 12rpx; white-space: nowrap; }
.month { margin-bottom: 60rpx; }
.m-ic { width: 64rpx; height: 64rpx; border-radius: 16rpx; background: #1d4ed8; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; }
.m-ic-t { color: #ffffff; font-size: 30rpx; font-weight: bold; }
.m-mid { display: flex; flex-direction: column; }
.m-t { font-size: 28rpx; font-weight: bold; margin-bottom: 4rpx; }
.m-go { font-size: 26rpx; color: #1677ff; }
.stat { margin-top: 24rpx; }
.stat-i { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-n { font-size: 40rpx; font-weight: bold; }
.free-n { color: #19a974; }
.gray { color: #c4c9d2; }
.rule { margin-top: 12rpx; }
.rule-dot { width: 10rpx; height: 10rpx; border-radius: 5rpx; background: #1677ff; margin-right: 16rpx; }
.dot-open { background: #19a974; }
.rule-t { font-size: 26rpx; color: #5c6370; }
.cells { padding: 20rpx 24rpx 0; }
.sec { display: block; margin-bottom: 4rpx; }
.fee { font-size: 34rpx; font-weight: bold; color: #ff7a1f; }
.err { display: block; color: #f2453d; font-size: 24rpx; text-align: center; }
.foot { padding: 20rpx 32rpx 28rpx; }
.btn-off { background: #c4c9d2; }
