page { background: #f2f5fa; color: #1d2433; font-size: 28rpx; }
.row { display: flex; flex-direction: row; align-items: center; }
.col { display: flex; flex-direction: column; }
.between { justify-content: space-between; }
.flex1 { flex: 1; }
.card { background: #ffffff; border-radius: 20rpx; margin: 20rpx 24rpx 0; padding: 28rpx; }
.card-title { font-size: 30rpx; font-weight: bold; color: #1d2433; }
.muted { color: #8a93a6; font-size: 24rpx; }
.small { font-size: 22rpx; }
.price { color: #ff6a00; font-weight: bold; }
.price-sym { color: #ff6a00; font-size: 22rpx; }
.blue { color: #1f6fff; }
.red { color: #f04438; }
.green { color: #12b76a; }
.tag { font-size: 20rpx; color: #1f6fff; background: #eaf1ff; border-radius: 6rpx; padding: 2rpx 10rpx; margin-right: 10rpx; }
.tag-orange { color: #ff6a00; background: #fff1e6; }
.btn { background: #1f6fff; color: #ffffff; border-radius: 44rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; }
.btn-orange { background: #ff7a1a; }
.btn-ghost { background: #ffffff; color: #1f6fff; border: 2rpx solid #1f6fff; }
.btn-hover { opacity: 0.8; }
.line { height: 1rpx; background: #eef1f6; margin: 20rpx 0; }
.empty { padding: 120rpx 40rpx; display: flex; flex-direction: column; align-items: center; }
.empty-ic { width: 120rpx; height: 120rpx; opacity: 0.4; margin-bottom: 24rpx; }
.loading { padding: 80rpx 0; display: flex; flex-direction: row; justify-content: center; }
.err { color: #f04438; font-size: 22rpx; margin-top: 8rpx; }
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.5); z-index: 50; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #ffffff; border-radius: 28rpx 28rpx 0 0; z-index: 51; padding: 32rpx 32rpx 48rpx; }
.tab-space { height: 140rpx; }
.bar-space { height: 160rpx; }
