<view wx:if="{{!o}}" class="empty">
  <text class="e-ic">✈</text>
  <text class="muted">订单不存在或已删除</text>
  <view class="btn e-btn" bindtap="rebook"><text>去订机票</text></view>
</view>
<block wx:else>
  <view class="st st-{{o.status}} col">
    <text class="st-t">{{o.statusText}}</text>
    <view wx:if="{{o.status === 'unpaid'}}" class="row"><text class="st-s">请在 </text><text class="st-s st-left">{{left}}</text><text class="st-s"> 内完成支付，超时自动取消</text></view>
    <text wx:elif="{{o.status === 'refunded'}}" class="st-s">退票手续费 ¥{{o.refund.fee}}，退款 ¥{{o.refund.back}} 将原路退回</text>
    <text wx:elif="{{o.status === 'changed'}}" class="st-s">改期成功，已付改期费 ¥{{o.changeFee}}，新客票已生效</text>
    <text wx:elif="{{o.status === 'paid'}}" class="st-s">出票成功，请携带有效证件提前 2 小时到达机场</text>
    <text wx:else class="st-s">订单已取消，座位已释放</text>
  </view>

  <view class="card" wx:for="{{legs}}" wx:key="k">
    <view class="row">
      <text class="tag">{{item.tag}}</text>
      <text class="lg-d flex1">{{item.dateText}}</text>
      <text class="muted small">{{item.f.airlineName}}{{item.f.no}}</text>
    </view>
    <view class="row lg-mid">
      <view class="col"><text class="lg-t">{{item.f.depText}}</text><text class="muted small">{{item.f.depAirport}}</text></view>
      <view class="col lg-c"><text class="muted small">{{item.f.durText}}</text><view class="lg-line"></view><text class="muted small">{{item.f.aircraft}}</text></view>
      <view class="col lg-r"><text class="lg-t">{{item.f.arrText}}</text><text class="muted small">{{item.f.arrAirport}}</text></view>
    </view>
    <text class="small">{{item.c.name}} · {{item.c.bag}}</text>
  </view>

  <view class="card">
    <text class="card-title">乘机人</text>
    <view wx:for="{{pax}}" wx:key="name" class="px col">
      <view class="row"><text class="px-n">{{item.name}}</text><text class="tag">{{item.age}}</text></view>
      <text class="muted small">{{item.idText}}</text>
      <text wx:if="{{item.ticket}}" class="small blue">电子客票号 {{item.ticket}}</text>
    </view>
    <view class="line"></view>
    <view class="row between kv"><text class="muted">联系人</text><text>{{o.contact.name}} {{o.contact.phone}}</text></view>
    <view class="row between kv"><text class="muted">出行保障</text><text>{{o.ins}}</text></view>
  </view>

  <view class="card">
    <view class="row between"><text class="card-title">费用</text><text class="price">¥{{o.total}}</text></view>
    <view wx:for="{{o.rows}}" wx:key="k" class="row between kv"><text class="muted small">{{item.label}}</text><text class="small">¥{{item.value}} × {{item.n}}</text></view>
  </view>

  <view class="card">
    <text class="card-title">电子行程单</text>
    <view class="row between kv"><text class="muted">订单号</text><view class="row"><text>{{o.id}}</text><text class="blue small cp" bindtap="copyId">复制</text></view></view>
    <view class="row between kv"><text class="muted">下单时间</text><text>{{o.created}}</text></view>
    <view class="row between kv"><text class="muted">报销凭证</text><text class="small">{{o.status === 'paid' || o.status === 'changed' ? '行程结束后可在此开具电子发票（航空运输电子客票行程单）' : '出票后可开具'}}</text></view>
    <view class="row kv-btns">
      <view class="mini-btn" bindtap="copyTrip"><text>复制行程</text></view>
      <view wx:if="{{o.status === 'paid' || o.status === 'changed'}}" class="mini-btn" bindtap="addCal"><text>添加到日历</text></view>
    </view>
  </view>

  <view class="card">
    <text class="card-title">订单进度</text>
    <view wx:for="{{log}}" wx:key="k" class="lg row">
      <view class="dot {{index === 0 ? 'dot-on' : ''}}"></view>
      <view class="col flex1"><text class="small">{{item.text}}</text><text class="muted small">{{item.t}}</text></view>
    </view>
  </view>
  <view class="bar-space"></view>

  <view class="foot row">
    <block wx:if="{{o.status === 'unpaid'}}">
      <view class="fb" bindtap="cancel"><text>取消订单</text></view>
      <view class="fb fb-main" bindtap="pay"><text>去支付 ¥{{o.total}}</text></view>
    </block>
    <block wx:elif="{{o.status === 'paid' || o.status === 'changed'}}">
      <view class="fb" bindtap="refund"><text>退票</text></view>
      <view class="fb fb-main" bindtap="change"><text>改期</text></view>
    </block>
    <block wx:else>
      <view class="fb" bindtap="remove"><text>删除订单</text></view>
      <view class="fb fb-main" bindtap="rebook"><text>再订一张</text></view>
    </block>
  </view>
  <cashier show="{{cashier}}" order-id="{{o.id}}" amount="{{o.total}}" expire-at="{{o.expireAt}}" reason="{{payReason}}"
           bind:paid="onPaid" bind:close="onCashierClose" bind:timeout="onTimeout"></cashier>
</block>
