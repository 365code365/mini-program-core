.first { background: #fff7ed; padding: 16rpx 24rpx; }
.days { background: #ffffff; white-space: nowrap; height: 112rpx; }
.day { width: 150rpx; height: 112rpx; align-items: center; justify-content: center; }
.day-md { font-size: 22rpx; color: #5b6478; }
.day-p { font-size: 26rpx; color: #ff6a00; margin-top: 4rpx; }
.day-on { background: #1f6fff; }
.day-on .day-md, .day-on .day-p { color: #ffffff; }
.trend { background: #ffffff; margin: 16rpx 24rpx 0; border-radius: 16rpx; padding: 16rpx 20rpx 6rpx; }
.trend-t { font-size: 26rpx; font-weight: bold; }
.trend-c { width: 662rpx; height: 200rpx; }
.meta { padding: 20rpx 28rpx 4rpx; }
.spin { width: 48rpx; height: 48rpx; border-radius: 24rpx; border: 6rpx solid #d5e2ff; border-top-color: #1f6fff; margin-bottom: 16rpx; animation: spin 0.8s linear infinite; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.loading { align-items: center; }
.fl { background: #ffffff; margin: 16rpx 24rpx 0; border-radius: 16rpx; padding: 24rpx; }
.fl-hover { background: #f6f8fb; }
.t-box { width: 160rpx; }
.t { font-size: 40rpx; font-weight: bold; }
.cross { font-size: 18rpx; color: #ff6a00; margin-left: 4rpx; }
.mid { width: 150rpx; align-items: center; margin-right: 16rpx; }
.arrow { width: 120rpx; height: 2rpx; background: #c6ccd8; margin: 8rpx 0; }
.stop { font-size: 20rpx; color: #ff6a00; }
.p-box { flex: 1; align-items: flex-end; }
.p { font-size: 40rpx; }
.seats { font-size: 20rpx; color: #f04438; margin-top: 2rpx; }
.fl-foot { margin-top: 16rpx; }
.logo { width: 32rpx; height: 32rpx; margin-right: 10rpx; }
.empty-btn { width: 300rpx; margin-top: 30rpx; height: 72rpx; font-size: 28rpx; }
.bottom { position: fixed; left: 160rpx; right: 160rpx; bottom: 40rpx; height: 100rpx; background: #ffffff; border-radius: 50rpx; box-shadow: 0 6rpx 24rpx rgba(31, 60, 120, 0.18); }
.b-item { flex: 1; align-items: center; }
.b-ic { font-size: 26rpx; font-weight: bold; color: #5b6478; }
.b-tx { font-size: 20rpx; color: #5b6478; margin-top: 2rpx; }
.fp { padding: 32rpx 32rpx 48rpx; }
.fp-head { margin-bottom: 16rpx; }
.fp-t { font-size: 26rpx; color: #5b6478; margin-top: 20rpx; }
.chips { flex-wrap: wrap; margin-top: 14rpx; }
.chip { padding: 12rpx 22rpx; border-radius: 10rpx; background: #f2f5fa; margin: 0 16rpx 16rpx 0; font-size: 24rpx; border: 2rpx solid #f2f5fa; }
.chip-on { background: #eaf1ff; color: #1f6fff; border-color: #1f6fff; }
.fp-direct { margin-top: 20rpx; }
.fp-btns { margin-top: 36rpx; }
.fp-ok { margin-left: 24rpx; }
