<view class="tb">
  <view class="tb-item" wx:for="{{list}}" wx:key="path" data-index="{{index}}" data-path="{{item.path}}" bindtap="switchTab">
    <image class="tb-ic" src="{{selected === index ? item.iconOn : item.icon}}"></image>
    <text class="tb-tx" style="color: {{selected === index ? selectedColor : color}};">{{item.text}}</text>
    <view wx:if="{{index === 1 && unpaid > 0}}" class="tb-badge"><text class="tb-badge-tx">{{unpaid}}</text></view>
  </view>
</view>
