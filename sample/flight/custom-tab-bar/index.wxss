.tb { height: calc(100rpx + env(safe-area-inset-bottom)); background: #ffffff; display: flex; flex-direction: row; border-top: 1rpx solid #e6eaf0; padding-bottom: env(safe-area-inset-bottom); }
.tb-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; }
.tb-ic { width: 46rpx; height: 46rpx; }
.tb-tx { font-size: 20rpx; margin-top: 4rpx; }
.tb-badge { position: absolute; top: 8rpx; left: 136rpx; min-width: 30rpx; height: 30rpx; padding: 0 8rpx; border-radius: 15rpx; background: #ff4d4f; display: flex; align-items: center; justify-content: center; }
.tb-badge-tx { color: #ffffff; font-size: 18rpx; }
