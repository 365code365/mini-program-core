.banner { position: relative; overflow: hidden; padding: 40rpx 32rpx 80rpx; }
.deco { position: absolute; border-radius: 50%; background: rgba(255, 255, 255, 0.1); }
.d1 { width: 360rpx; height: 360rpx; right: -120rpx; top: -140rpx; }
.d2 { width: 200rpx; height: 200rpx; left: -60rpx; bottom: -100rpx; }
.b-row { position: relative; }
.b-logo { width: 112rpx; height: 112rpx; border-radius: 24rpx; background: #fff; display: flex; flex-direction: row; align-items: center; justify-content: center; margin-right: 24rpx; }
.b-logo-t { font-size: 52rpx; font-weight: bold; color: #2E6BFF; }
.b-name { color: #fff; font-size: 40rpx; font-weight: bold; }
.b-sub { color: rgba(255, 255, 255, 0.85); font-size: 24rpx; margin-top: 8rpx; }
.follow { background: #fff; border-radius: 30rpx; padding: 10rpx 24rpx; }
.follow.on { background: rgba(255, 255, 255, 0.25); }
.follow-t { font-size: 24rpx; color: #2E6BFF; font-weight: bold; }
.follow.on .follow-t { color: #fff; }
.stats { margin-top: 40rpx; position: relative; }
.stat { flex: 1; align-items: center; }
.stat-n { color: #fff; font-size: 28rpx; font-weight: bold; white-space: nowrap; }
.stat-l { color: rgba(255, 255, 255, 0.8); font-size: 22rpx; margin-top: 6rpx; }
.lift { margin-top: -40rpx; position: relative; }
.section-title { display: block; }
.intro { font-size: 26rpx; color: #3a3f47; line-height: 44rpx; }
.welfare { display: flex; flex-direction: row; flex-wrap: wrap; }
.w-item { width: 50%; margin-bottom: 18rpx; }
.w-dot { width: 12rpx; height: 12rpx; border-radius: 6rpx; background: #2E6BFF; margin-right: 14rpx; }
.w-t { font-size: 26rpx; color: #3a3f47; }
.list-title { display: block; font-size: 30rpx; font-weight: bold; margin: 12rpx 32rpx 20rpx; }
.job-title { font-size: 30rpx; font-weight: bold; margin-bottom: 10rpx; }
