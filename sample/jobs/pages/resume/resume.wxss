.progress { margin-top: 20rpx; }
.p-title { font-size: 30rpx; font-weight: bold; }
.bar-bg { height: 14rpx; border-radius: 7rpx; background: #eef1f5; margin-top: 20rpx; overflow: hidden; }
.bar-fg { height: 14rpx; border-radius: 7rpx; background: linear-gradient(90deg, #6FA0FF, #2E6BFF); }
.form { padding-bottom: 8rpx; }
.section-title { display: block; margin-bottom: 4rpx; }
.field { min-height: 96rpx; border-bottom: 1rpx solid #f0f1f3; }
.field.last { border-bottom: none; }
.label { width: 160rpx; font-size: 28rpx; color: #5c6370; }
.val { font-size: 28rpx; color: #1f2329; text-align: right; height: 96rpx; line-height: 96rpx; }
.intro { width: 100%; height: 220rpx; font-size: 26rpx; line-height: 42rpx; background: #f7f8fa; border-radius: 12rpx; padding: 20rpx; box-sizing: border-box; margin: 12rpx 0 20rpx; }
.save-wrap { padding: 20rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); }
/* input 的 font-size 恰好 14px(28rpx) 时引擎当成「没写」改用 16px，所以写 27rpx */
.ival { font-size: 27rpx; color: #1f2329; text-align: right; height: 96rpx; margin-right: 26rpx; }
