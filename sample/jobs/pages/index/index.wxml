<view class="hero">
  <view class="row between">
    <view class="row">
      <text class="intent">{{intent}}</text>
      <view class="intent-add" bindtap="onIntent"><text class="intent-add-t">切换</text></view>
    </view>
    <picker class="city-picker" mode="selector" range="{{cities}}" value="{{cityIdx}}" bindchange="onCity">
      <view class="row city">
        <text class="city-t">{{cities[cityIdx]}}</text>
        <view class="tri"></view>
      </view>
    </picker>
  </view>
  <view class="search row">
    <view class="search-icon"></view>
    <input class="search-input flex1" placeholder="搜索职位 / 公司 / 技能" placeholder-class="ph" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
    <view wx:if="{{keyword}}" class="clear" bindtap="onClear"><text class="clear-t">清除</text></view>
  </view>
</view>

<view class="tabs row">
  <view wx:for="{{tabs}}" wx:key="*this" class="tab {{tabIdx === index ? 'on' : ''}}" data-idx="{{index}}" bindtap="onTab">
    <text class="tab-t">{{item}}</text>
    <view class="tab-line" wx:if="{{tabIdx === index}}"></view>
  </view>
  <view class="flex1"></view>
  <view class="filter-btn row {{fCount ? 'on' : ''}}" bindtap="onOpenFilter">
    <text class="filter-t">筛选{{fCount ? ' · ' + fCount : ''}}</text>
  </view>
</view>
<view class="count row">
  <text class="sub">共 {{list.length}} 个职位{{blockedCount ? '（已屏蔽 ' + blockedCount + ' 个）' : ''}}</text>
</view>

<view class="list">
  <view wx:for="{{list}}" wx:key="id" class="card job" data-id="{{item.id}}" bindtap="onJob">
    <view class="row between">
      <text class="job-title flex1">{{item.title}}</text>
      <text class="mark" wx:if="{{item.applied}}">已投递</text>
      <text class="salary">{{item.salary}}</text>
    </view>
    <view class="row co-line">
      <text class="co-name">{{item.co.name}}</text>
      <text class="match" wx:if="{{item.match}}">匹配意向</text>
      <text class="sub co-meta">{{item.co.stage}}·{{item.co.size}}</text>
    </view>
    <view class="tags">
      <text class="tag">{{item.exp}}</text>
      <text class="tag">{{item.edu}}</text>
      <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
    </view>
    <view class="row between hr-line">
      <view class="row">
        <view class="avatar" style="background: {{item.hrInfo.bg}}"><text>{{item.hrInfo.ch}}</text></view>
        <text class="hr-name">{{item.hrInfo.name}}·{{item.hrInfo.title}}</text>
        <view class="online" wx:if="{{item.hrInfo.online}}"></view>
      </view>
      <text class="sub">{{item.area}} {{item.distText}}</text>
    </view>
  </view>
  <view wx:if="{{list.length === 0}}" class="empty">
    <view class="empty-circle"></view>
    <text class="sub">{{keyword ? '没有找到「' + keyword + '」相关的职位' : '没有符合筛选条件的职位'}}</text>
    <view class="empty-btn" wx:if="{{keyword || fCount}}" bindtap="onClearFilter"><text>清空条件</text></view>
  </view>
</view>
<view class="tabbar-space"></view>
<view class="mask" wx:if="{{showFilter}}" bindtap="onCloseFilter"></view>
<!-- 从顶部落下：tab 页底部是 tabBar，底部面板会和它叠在一起（引擎里点面板底部的按钮会点到 tabBar） -->
<view class="sheet drop" wx:if="{{showFilter}}" catchtap="noop">
  <text class="sheet-title">筛选职位</text>
  <text class="f-h">工作经验</text>
  <view class="opts">
    <view class="opt {{draft.exp === index ? 'on' : ''}}" wx:for="{{exps}}" wx:key="*this" data-k="exp" data-i="{{index}}" bindtap="onPickOpt"><text class="opt-t">{{item}}</text></view>
  </view>
  <text class="f-h">学历要求</text>
  <view class="opts">
    <view class="opt {{draft.edu === index ? 'on' : ''}}" wx:for="{{edus}}" wx:key="*this" data-k="edu" data-i="{{index}}" bindtap="onPickOpt"><text class="opt-t">{{item}}</text></view>
  </view>
  <text class="f-h">月薪</text>
  <view class="opts">
    <view class="opt {{draft.sal === index ? 'on' : ''}}" wx:for="{{salaries}}" wx:key="text" data-k="sal" data-i="{{index}}" bindtap="onPickOpt"><text class="opt-t">{{item.text}}</text></view>
  </view>
  <view class="row f-btns">
    <view class="f-reset" bindtap="onResetFilter"><text>重置</text></view>
    <view class="btn-primary flex1 f-ok" bindtap="onApplyFilter">确定</view>
  </view>
</view>
