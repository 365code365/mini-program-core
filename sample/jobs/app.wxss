/* 注意：引擎里 display:flex 不写 flex-direction 时按 column 排，下面一律写明方向 */
page { background: #f5f6f8; color: #1f2329; font-size: 28rpx; }
.row { display: flex; flex-direction: row; align-items: center; }
.col { display: flex; flex-direction: column; }
.between { justify-content: space-between; }
.flex1 { flex: 1; }
.card { background: #fff; border-radius: 20rpx; margin: 0 24rpx 20rpx; padding: 28rpx; box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.04); }
.title { font-size: 34rpx; font-weight: bold; }
.sub { font-size: 24rpx; color: #8a9099; }
.blue { color: #2E6BFF; }
.salary { color: #2E6BFF; font-size: 30rpx; font-weight: bold; white-space: nowrap; }
.tag { font-size: 22rpx; color: #5c6370; background: #f2f4f7; padding: 6rpx 16rpx; border-radius: 8rpx; margin: 0 12rpx 12rpx 0; }
.tags { display: flex; flex-direction: row; flex-wrap: wrap; }
.avatar { width: 64rpx; height: 64rpx; border-radius: 32rpx; color: #fff; font-size: 28rpx; font-weight: bold; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.logo { width: 88rpx; height: 88rpx; border-radius: 20rpx; color: #fff; font-size: 40rpx; font-weight: bold; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.btn-primary { background: linear-gradient(90deg, #4C86FF, #2E6BFF); color: #fff; font-size: 30rpx; font-weight: bold; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 44rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; }
/* 右箭头用 border 画：引擎字体里 › 会落到错误字形 */
.chev { width: 14rpx; height: 14rpx; border-top: 3rpx solid #c4c7cc; border-right: 3rpx solid #c4c7cc; transform: rotate(45deg); margin-left: 12rpx; }
/* 引擎把 input padding 全 0 当成没写，套默认内边距，所以写 1rpx */
input { padding: 0 0 0 1rpx; }
.tabbar-space { height: calc(120rpx + env(safe-area-inset-bottom)); }
/* 通用：分段、表单行、小按钮、面板、空态（投递记录 / 面试 / 收藏 / 设置等页共用） */
.seg { margin: 20rpx 24rpx; background: #e9ecf2; border-radius: 16rpx; padding: 6rpx; }
.seg-item { flex: 1; height: 60rpx; line-height: 60rpx; text-align: center; border-radius: 12rpx; font-size: 25rpx; color: #5c6370; white-space: nowrap; }
.seg-item.on { background: #fff; color: #2E6BFF; font-weight: bold; }
.op { font-size: 24rpx; color: #3a3f47; background: #f2f4f7; padding: 8rpx 22rpx; border-radius: 28rpx; margin-left: 14rpx; white-space: nowrap; }
.op.main { color: #fff; background: #2E6BFF; }
.op.line { color: #2E6BFF; background: #eef3ff; }
.empty-box { padding: 100rpx 0 60rpx; display: flex; flex-direction: column; align-items: center; }
.empty-btn { margin-top: 28rpx; padding: 14rpx 48rpx; border-radius: 36rpx; border: 2rpx solid #2E6BFF; color: #2E6BFF; font-size: 26rpx; }
.field { min-height: 96rpx; border-bottom: 1rpx solid #f0f1f3; }
.field.last { border-bottom: none; }
.label { width: 160rpx; font-size: 28rpx; color: #5c6370; flex-shrink: 0; }
.val { font-size: 28rpx; color: #1f2329; }
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0, 0, 0, 0.45); }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); }
.sheet-title { font-size: 32rpx; font-weight: bold; text-align: center; margin-bottom: 20rpx; }
.state { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; white-space: nowrap; }
.st-blue { color: #2E6BFF; background: #eef3ff; }
.st-orange { color: #FF8A00; background: #fff4e6; }
.st-green { color: #19BE6B; background: #e8f8ef; }
.st-gray { color: #9aa0a6; background: #f2f3f5; }
.safe-bottom { height: calc(40rpx + env(safe-area-inset-bottom)); }
