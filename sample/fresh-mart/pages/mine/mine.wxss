.head {
  background: linear-gradient(170deg, #12b76a, #36d389);
  padding: 32rpx 28rpx 76rpx;
  color: #ffffff;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 58rpx;
  background: linear-gradient(135deg, #ffd36b, #ff9a1a);
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  font-size: 46rpx;
  color: #ffffff;
  margin-right: 22rpx;
}

.nick {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  line-height: 52rpx;
}

.plus-tag {
  font-size: 20rpx;
  line-height: 34rpx;
  padding: 0 14rpx;
  border-radius: 17rpx;
  background: #1f2329;
  color: #ffd36b;
  margin-right: 12rpx;
  font-weight: bold;
}

.phone {
  font-size: 24rpx;
  opacity: 0.9;
}

.sign {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 24rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.assets {
  margin-top: 36rpx;
}

.asset {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.asset-num {
  font-size: 36rpx;
  font-weight: bold;
  line-height: 50rpx;
}

.asset-name {
  font-size: 22rpx;
  opacity: 0.9;
}

.plus {
  margin: -44rpx 24rpx 0;
  padding: 24rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(110deg, #26292f, #43403a);
}

.plus-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #ffe2b0, #e8b45a);
  color: #4a3410;
  font-size: 32rpx;
  line-height: 1;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.plus-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #ffe2b0;
  line-height: 40rpx;
}

.plus-desc {
  display: block;
  font-size: 20rpx;
  color: #c8b89a;
}

.plus-btn {
  width: 180rpx;
  text-align: center;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 26rpx;
  background: linear-gradient(90deg, #ffe2b0, #f5b75a);
  color: #4a3410;
  font-size: 22rpx;
  font-weight: bold;
  white-space: nowrap;
  flex-shrink: 0;
}

.orders {
  margin-top: 24rpx;
}

.order-entry {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.oe-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  font-size: 30rpx;
}

.oe-name {
  font-size: 24rpx;
  color: #3a3f47;
  margin-top: 10rpx;
}

.oe-badge {
  position: absolute;
  top: -6rpx;
  left: 50%;
  margin-left: 22rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  text-align: center;
  background: #ff4d2d;
  color: #ffffff;
  font-size: 20rpx;
}

.menu {
  padding-top: 4rpx;
  padding-bottom: 4rpx;
}

.menu-item {
  height: 100rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.no-border {
  border-bottom: 0;
}

.menu-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #ffffff;
  margin-right: 20rpx;
}

.foot {
  text-align: center;
  font-size: 22rpx;
  color: #b0b4bc;
  padding: 36rpx 0;
}
