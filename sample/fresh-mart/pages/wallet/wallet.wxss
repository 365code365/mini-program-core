.bal {
  margin: 20rpx 24rpx 0;
  padding: 36rpx 32rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #12b76a, #0b8f52);
  color: #ffffff;
}

.bal-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.bal-rule {
  font-size: 22rpx;
  padding: 0 16rpx;
  line-height: 40rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.bal-num {
  display: block;
  font-size: 72rpx;
  line-height: 100rpx;
  font-weight: bold;
  margin-top: 8rpx;
}

.bal-tip {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.opts {
  margin-top: 20rpx;
}

.opt {
  flex: 1;
  height: 140rpx;
  margin-right: 18rpx;
  border-radius: 18rpx;
  border: 2rpx solid #e3e6eb;
  background: #f7f8fa;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.opt:last-child {
  margin-right: 0;
}

.opt-on {
  border-color: #12b76a;
  background: #e6f8ee;
}

.opt-pay {
  font-size: 40rpx;
  font-weight: bold;
  color: #1f2329;
}

.opt-bonus {
  font-size: 22rpx;
  color: #ff5a1f;
  margin-top: 4rpx;
}

.go {
  margin-top: 28rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
}

.log {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.log-type {
  width: 72rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 20rpx;
  margin-right: 18rpx;
  background: #fff1ea;
  color: #ff5a1f;
}

.log-recharge {
  background: #e6f8ee;
  color: #12b76a;
}

.log-refund {
  background: #e8f3fe;
  color: #2a8cf0;
}

.log-title {
  display: block;
  font-size: 26rpx;
}

.log-amt {
  font-size: 30rpx;
  font-weight: bold;
  margin-left: 16rpx;
}

.log-in {
  color: #12b76a;
}

.none {
  padding: 40rpx 0;
  text-align: center;
}

.gap {
  height: 48rpx;
}
