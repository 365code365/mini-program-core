.addr {
  height: 88rpx;
  padding: 0 28rpx;
  background: #ffffff;
  font-size: 26rpx;
}

.addr-k {
  color: #8a8f99;
  margin-right: 12rpx;
}

.addr-v {
  font-weight: bold;
}

.edit {
  color: #3a3f47;
  margin-left: 24rpx;
}

.free {
  padding: 18rpx 24rpx;
}

.free-tag {
  font-size: 20rpx;
  line-height: 32rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  background: #e6f8ee;
  color: #12b76a;
  margin-right: 14rpx;
}

.free-text {
  font-size: 24rpx;
  color: #3a3f47;
}

.free-go {
  font-size: 24rpx;
  color: #ff5a1f;
  font-weight: bold;
}

.shop {
  padding: 24rpx 24rpx 4rpx;
}

.shop-head {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.shop-name {
  font-size: 28rpx;
  font-weight: bold;
  margin-left: 18rpx;
}

.shop-tip {
  font-size: 20rpx;
  line-height: 32rpx;
  padding: 0 10rpx;
  margin-left: 12rpx;
  border-radius: 6rpx;
  background: #12b76a;
  color: #ffffff;
}

.item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.item:last-child {
  border-bottom: 0;
}

.item-img {
  width: 168rpx;
  height: 168rpx;
  border-radius: 14rpx;
  margin: 0 18rpx;
  flex-shrink: 0;
}

.item-name {
  font-size: 28rpx;
  line-height: 40rpx;
}

.item-spec {
  display: block;
  margin-top: 6rpx;
  align-self: flex-start;
  font-size: 22rpx;
  color: #8a8f99;
  line-height: 34rpx;
}

.flash-tag {
  display: flex;
  align-self: flex-start;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  background: #fff1ea;
  color: #ff5a1f;
}

.item-info {
  display: flex;
  flex-direction: column;
}

.item-foot {
  margin-top: 10rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0 40rpx;
}

.empty-cart {
  width: 180rpx;
  height: 180rpx;
  border-radius: 90rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-img {
  width: 96rpx;
  height: 96rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.empty-btn {
  margin-top: 30rpx;
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}

.rec-title {
  justify-content: center;
  margin: 40rpx 0 8rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #3a3f47;
}

.rec-line {
  width: 60rpx;
  height: 2rpx;
  background: #d4d7dd;
  margin: 0 20rpx;
}

.recs {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 0 14rpx;
}

.rec {
  width: 335rpx;
  margin: 16rpx 10rpx 0;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #ffffff;
}

.rec-img {
  width: 303rpx;
  height: 260rpx;
  border-radius: 14rpx;
}

.rec-name {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  margin: 10rpx 0 6rpx;
  line-height: 38rpx;
}

.rec-num {
  font-size: 30rpx;
}

.bottom-gap {
  height: 160rpx;
}

.settle {
  position: fixed;
  left: 0;
  right: 0;
  height: 104rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #eef0f3;
}

.all-text {
  font-size: 26rpx;
  margin-left: 14rpx;
}

.sum {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-right: 20rpx;
}

.sum-line {
  align-items: flex-end;
}

.sum-k {
  font-size: 26rpx;
  padding-bottom: 4rpx;
}

.sum-sym {
  font-size: 24rpx;
  color: #ff5a1f;
  font-weight: bold;
  margin-left: 6rpx;
  padding-bottom: 4rpx;
}

.sum-num {
  font-size: 38rpx;
  line-height: 1.15;
  color: #ff5a1f;
  font-weight: bold;
}

.sum-save {
  font-size: 20rpx;
  color: #ff5a1f;
}

.settle-btn {
  width: 210rpx;
  text-align: center;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  background: linear-gradient(90deg, #3ddc84, #12b76a);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  white-space: nowrap;
  flex-shrink: 0;
}

.settle-off {
  background: #c8ccd4;
}

.del-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 36rpx;
  border-radius: 36rpx;
  border: 2rpx solid #ff4d2d;
  color: #ff4d2d;
  font-size: 26rpx;
}
