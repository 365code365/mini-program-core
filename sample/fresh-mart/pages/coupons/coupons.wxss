.tabs {
  height: 88rpx;
  background: #ffffff;
}

.tab {
  position: relative;
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  color: #5c6370;
}

.tab-on {
  color: #12b76a;
  font-weight: bold;
}

.tab-line {
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  border-radius: 3rpx;
  background: #12b76a;
}

.list {
  padding: 4rpx 0 40rpx;
}

.coupon {
  position: relative;
  margin: 20rpx 24rpx 0;
  height: 180rpx;
  border-radius: 20rpx;
  background: #ffffff;
  overflow: hidden;
}

.c-left {
  width: 200rpx;
  height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #fff1ea, #ffd9c4);
  border-right: 2rpx dashed #ffd0b8;
  box-sizing: border-box;
}

.c-ship {
  background: linear-gradient(160deg, #e6f8ee, #bdeccf);
  border-right-color: #a6e3c2;
}

.c-amount-row {
  align-items: flex-end;
  color: #ff5a1f;
}

.c-ship .c-amount-row,
.c-ship .c-cond {
  color: #0b8f52;
}

.c-sym {
  font-size: 26rpx;
  font-weight: bold;
  padding-bottom: 10rpx;
}

.c-amount {
  font-size: 60rpx;
  font-weight: bold;
  line-height: 1.1;
}

.c-cond {
  font-size: 20rpx;
  color: #ff5a1f;
  margin-top: 6rpx;
}

.c-right {
  padding: 0 24rpx;
}

.c-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  line-height: 44rpx;
}

.c-desc {
  display: block;
  font-size: 22rpx;
  color: #8a8f99;
  line-height: 34rpx;
}

.c-foot {
  margin-top: 14rpx;
}

.c-expire {
  font-size: 20rpx;
  color: #b0b4bc;
}

.c-use {
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #3ddc84, #12b76a);
  color: #ffffff;
  font-size: 22rpx;
  white-space: nowrap;
}

.coupon-off .c-left {
  background: #f3f4f6;
  border-right-color: #e3e6eb;
}

.coupon-off .c-amount-row,
.coupon-off .c-cond,
.coupon-off .c-title {
  color: #b0b4bc;
}

.stamp {
  position: absolute;
  right: 24rpx;
  top: 20rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  border: 3rpx solid #d4d7dd;
  color: #b0b4bc;
  font-size: 22rpx;
  transform: rotate(-20deg);
}

.empty {
  text-align: center;
  padding-top: 120rpx;
}
