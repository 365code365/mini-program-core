<view wx:if="{{lines.length}}">
  <view class="card addr row" bindtap="onAddr">
    <view class="a-dot"></view>
    <view class="flex1" wx:if="{{addr}}">
      <view class="row">
        <text wx:if="{{addr.tag}}" class="a-tag">{{addr.tag}}</text>
        <text class="a-text">{{addr.text}}</text>
      </view>
      <text class="sub a-who">{{addr.name}} {{addr.phoneMask}}</text>
      <text wx:if="{{!addr.inRange}}" class="a-warn">超出前置仓配送范围（仅送北京市内），请更换地址</text>
    </view>
    <text wx:else class="flex1 a-empty">请添加收货地址</text>
    <view class="arrow"></view>
  </view>

  <view class="card slot-card">
    <picker mode="selector" range="{{slotLabels}}" value="{{slotIdx}}" bindchange="onSlot">
      <view class="row between slot-row">
        <text>送达时间</text>
        <view class="row"><text class="slot-v">{{slotLabels[slotIdx]}}</text><view class="arrow"></view></view>
      </view>
    </picker>
  </view>

  <view class="card">
    <view class="row between">
      <text class="title">鲜到家 · 望京前置仓</text>
      <text class="sub">共 {{count}} 件</text>
    </view>
    <view class="g-row row" wx:for="{{lines}}" wx:key="key">
      <image class="g-img" src="{{item.img}}" mode="aspectFill"></image>
      <view class="flex1 g-info">
        <text class="g-name ellipsis">{{item.name}}</text>
        <view class="row">
          <text class="sub">{{item.spec}} ×{{item.qty}}</text>
          <text wx:if="{{item.flash}}" class="flash-tag">秒杀价</text>
        </view>
      </view>
      <text class="g-total">¥{{item.total}}</text>
    </view>
  </view>

  <view class="card fees">
    <view class="fee-row row between"><text>商品金额</text><text>¥{{goods}}</text></view>
    <view class="fee-row row between">
      <text>运费</text>
      <text>{{fee ? '¥' + fee + '（满 39 免）' : '免运费'}}</text>
    </view>
    <view class="fee-row row between coupon-row" bindtap="onCoupon">
      <view class="row"><text class="badge">券</text><text>优惠券</text></view>
      <view class="row"><text class="{{couponCut ? 'cut' : 'sub'}}">{{couponText}}</text><view class="arrow"></view></view>
    </view>
    <view class="fee-row row between">
      <text wx:if="{{beansNum}}">用 {{beansNum}} 鲜豆抵 ¥{{beansNum / 100}}</text>
      <text wx:else class="sub">鲜豆 {{beans}}，满 100 可抵 1 元</text>
      <switch checked="{{useBeans}}" disabled="{{!beansNum}}" color="#12b76a" bindchange="onBeans" />
    </view>
    <view class="fee-row row between no-border">
      <text>备注</text>
      <input class="remark" placeholder="例如：放门口、电话联系" placeholder-class="ph" value="{{remark}}" maxlength="30" bindinput="onRemark" />
    </view>
  </view>

  <view class="card">
    <text class="title">支付方式</text>
    <view class="pay-way row" data-by="wechat" bindtap="onPayBy">
      <view class="way-icon glyph way-wx">微</view>
      <text class="flex1">微信支付</text>
      <view class="radio {{payBy === 'wechat' ? 'radio-on' : ''}}"><view class="radio-in"></view></view>
    </view>
    <view class="pay-way row no-border" data-by="wallet" bindtap="onPayBy">
      <view class="way-icon glyph way-wallet">余</view>
      <view class="flex1">
        <text class="way-name">余额支付</text>
        <text class="way-sub {{balance < pay ? 'way-low' : ''}}">可用 ¥{{balance}}{{balance < pay ? '，余额不足去充值' : ''}}</text>
      </view>
      <view class="radio {{payBy === 'wallet' ? 'radio-on' : ''}}"><view class="radio-in"></view></view>
    </view>
  </view>
  <view class="bottom-gap"></view>

  <view class="pay-bar row">
    <view class="flex1 row pay-left">
      <text class="pay-label">实付</text>
      <text class="pay-sym">¥</text>
      <text class="pay-num">{{pay}}</text>
      <text wx:if="{{saved}}" class="pay-off">已优惠 ¥{{saved}}</text>
    </view>
    <view class="submit" bindtap="onSubmit">提交订单</view>
  </view>
</view>
<view wx:else class="empty">
  <text class="sub">没有要结算的商品</text>
  <view class="btn empty-btn" bindtap="onBack">返回购物车</view>
</view>
