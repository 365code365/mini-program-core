.header {
  background: linear-gradient(180deg, #12b76a, #2fcf82 75%, #f5f6f8);
  padding: 12rpx 24rpx 36rpx;
}

.addr {
  height: 56rpx;
  color: #ffffff;
}

.addr-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-right: 10rpx;
}

.addr-text {
  font-size: 30rpx;
  font-weight: bold;
  max-width: 380rpx;
}

.addr-arrow {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(45deg);
  margin: -8rpx 0 0 14rpx;
}

.eta {
  font-size: 22rpx;
  line-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.22);
}

.search {
  margin-top: 16rpx;
  height: 76rpx;
  padding: 0 8rpx 0 26rpx;
  border-radius: 38rpx;
  background: #ffffff;
}

.s-icon {
  position: relative;
  width: 26rpx;
  height: 26rpx;
  border-radius: 13rpx;
  border: 4rpx solid #12b76a;
  box-sizing: border-box;
  margin-right: 18rpx;
}

.s-handle {
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  width: 4rpx;
  height: 10rpx;
  background: #12b76a;
  transform: rotate(-45deg);
}

.s-ph {
  font-size: 26rpx;
  color: #b0b4bc;
}

.s-btn {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(90deg, #3ddc84, #12b76a);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
}

.promises {
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 0 6rpx;
}

.promise {
  font-size: 22rpx;
  color: #ffffff;
}

.cates {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin: -12rpx 24rpx 0;
  padding: 24rpx 1rpx 4rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.cate {
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.cate-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 46rpx;
  font-size: 38rpx;
}

.cate-name {
  font-size: 22rpx;
  color: #3a3f47;
  margin-top: 10rpx;
}

.flash {
  margin: 20rpx 24rpx 0;
  padding: 24rpx 0 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #fff1ea, #ffffff 40%);
}

.flash-head {
  padding: 0 24rpx;
}

.flash-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4d2d;
}

.flash-slot {
  font-size: 22rpx;
  color: #5c6370;
  margin: 0 12rpx 0 14rpx;
}

.clock-num {
  min-width: 40rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 8rpx;
  background: #ff4d2d;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
  text-align: center;
}

.clock-sep {
  font-size: 22rpx;
  color: #ff4d2d;
  margin: 0 4rpx;
  font-weight: bold;
}

.flash-more {
  font-size: 24rpx;
  color: #8a8f99;
}

.flash-list {
  margin-top: 20rpx;
  white-space: nowrap;
}

.flash-inner {
  padding: 0 24rpx;
}

.f-item {
  width: 180rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
}

.f-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 14rpx;
}

.f-bar {
  position: relative;
  height: 28rpx;
  border-radius: 14rpx;
  background: #ffe1d6;
  margin-top: 10rpx;
  overflow: hidden;
}

.f-bar-in {
  height: 28rpx;
  border-radius: 14rpx;
  background: linear-gradient(90deg, #ff9a6b, #ff4d2d);
}

.f-bar-text {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  line-height: 28rpx;
  text-align: center;
  font-size: 18rpx;
  color: #ffffff;
}

.f-price {
  margin-top: 6rpx;
}

.f-origin {
  align-self: flex-start;
  font-size: 20rpx;
  color: #b0b4bc;
  text-decoration: line-through;
  line-height: 28rpx;
}

.feed-head {
  margin: 28rpx 24rpx 0;
}

.feed-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feed-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #3a3f47;
  line-height: 44rpx;
}

.feed-desc {
  font-size: 20rpx;
  line-height: 34rpx;
  padding: 0 14rpx;
  border-radius: 17rpx;
  color: #8a8f99;
}

.feed-on .feed-name {
  color: #12b76a;
}

.feed-on .feed-desc {
  background: #12b76a;
  color: #ffffff;
}

.falls {
  align-items: flex-start;
  padding: 20rpx 24rpx 0;
}

.col {
  flex: 1;
  min-width: 0;
}

.col:first-child {
  margin-right: 18rpx;
}

.goods {
  border-radius: 20rpx;
  background: #ffffff;
  overflow: hidden;
  margin-bottom: 18rpx;
}

.g-img {
  width: 100%;
  display: block;
  border-radius: 20rpx 20rpx 0 0;
}

.g-body {
  padding: 16rpx 18rpx 18rpx;
}

.g-name {
  font-size: 28rpx;
  font-weight: bold;
  line-height: 40rpx;
}

.g-tags {
  margin-top: 8rpx;
}

.g-spec {
  display: block;
  font-size: 22rpx;
  color: #8a8f99;
  margin-top: 8rpx;
  line-height: 32rpx;
}

.g-foot {
  margin-top: 10rpx;
}

.end {
  text-align: center;
  font-size: 22rpx;
  color: #b0b4bc;
  padding: 20rpx 0 40rpx;
}
