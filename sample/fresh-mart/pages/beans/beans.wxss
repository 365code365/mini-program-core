.top {
  margin: 20rpx 24rpx 0;
  padding: 36rpx 32rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f6b73c, #f08c1a);
  color: #ffffff;
}
.top-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}
.top-rule {
  font-size: 22rpx;
  padding: 0 16rpx;
  line-height: 40rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}
.top-num {
  display: block;
  font-size: 72rpx;
  line-height: 100rpx;
  font-weight: bold;
  margin-top: 8rpx;
}
.top-tip {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}
.top-ops {
  margin-top: 28rpx;
}
.top-btn {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  background: #ffffff;
  color: #f08c1a;
  font-size: 26rpx;
  font-weight: bold;
  text-align: center;
  margin-right: 20rpx;
}
.top-btn:last-child {
  margin-right: 0;
}
.top-btn-off {
  background: rgba(255, 255, 255, 0.35);
  color: #ffffff;
}
.top-btn-ghost {
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  color: #ffffff;
  box-sizing: border-box;
}
.log {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}
.log-title {
  display: block;
  font-size: 26rpx;
}
.log-amt {
  font-size: 30rpx;
  font-weight: bold;
  margin-left: 16rpx;
  color: #8a8f99;
}
.log-in {
  color: #f08c1a;
}
.none {
  padding: 40rpx 0;
  text-align: center;
}
.gap {
  height: 48rpx;
}
