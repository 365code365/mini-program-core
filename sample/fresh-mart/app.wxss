page {
  background: #f5f6f8;
  color: #1f2329;
  font-size: 28rpx;
  line-height: 1.5;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
}

.sub {
  font-size: 24rpx;
  color: #8a8f99;
}

.price-row {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  color: #ff5a1f;
  font-weight: bold;
}

.p-sym {
  font-size: 22rpx;
  padding-bottom: 4rpx;
}

.p-num {
  font-size: 34rpx;
  line-height: 1.2;
}

.p-origin {
  font-size: 22rpx;
  color: #b0b4bc;
  font-weight: normal;
  text-decoration: line-through;
  margin-left: 8rpx;
  padding-bottom: 4rpx;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.glyph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.tag {
  font-size: 20rpx;
  line-height: 30rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  color: #12b76a;
  border: 1rpx solid #9fe0c0;
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #3ddc84, #12b76a);
  color: #ffffff;
  font-size: 36rpx;
  line-height: 44rpx;
  text-align: center;
  flex-shrink: 0;
}

.btn {
  background: linear-gradient(90deg, #3ddc84, #12b76a);
  color: #ffffff;
  border-radius: 44rpx;
  text-align: center;
  font-weight: bold;
}

/* 右箭头：字体里的 › 在引擎里画不出来，用边框画 */
.arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #b0b4bc;
  border-right: 3rpx solid #b0b4bc;
  transform: rotate(45deg);
  margin-left: 12rpx;
  margin-right: 4rpx;
  flex-shrink: 0;
}

.stepper {
  display: flex;
  flex-direction: row;
  align-items: center;
  border: 1rpx solid #e3e6eb;
  border-radius: 8rpx;
  height: 52rpx;
}

.step-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bar-h {
  width: 20rpx;
  height: 3rpx;
  background: #3a3f47;
}

.bar-v {
  position: absolute;
  width: 3rpx;
  height: 20rpx;
  background: #3a3f47;
}

.step-plus {
  position: relative;
}

.step-num {
  min-width: 60rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 26rpx;
  border-left: 1rpx solid #e3e6eb;
  border-right: 1rpx solid #e3e6eb;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  border: 2rpx solid #c8ccd4;
  box-sizing: border-box;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-on {
  border: 0;
  background: #12b76a;
}

/* 勾：转 45° 的 L 形边框（✓ 字形引擎画不出来） */
.check-mark {
  width: 10rpx;
  height: 18rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(45deg);
  margin-top: -6rpx;
}
