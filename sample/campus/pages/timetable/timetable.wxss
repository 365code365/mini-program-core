.tt-bar { display: flex; flex-direction: row; align-items: center; background: #ffffff; padding: 12rpx 24rpx; }
.tt-arrow { width: 72rpx; height: 72rpx; border-radius: 36rpx; background: #f3f6f5; font-size: 44rpx; color: #14937f; display: flex; align-items: center; justify-content: center; }
.tt-press { opacity: 0.6; }
.tt-title { flex: 1; display: flex; flex-direction: column; align-items: center; }
.tt-w { font-size: 32rpx; font-weight: bold; }
.tt-sub { font-size: 22rpx; color: #14937f; margin-top: 4rpx; }
.tt-sw { background: #ffffff; }
.tt-grid { position: relative; margin-left: 4px; }
.tt-corner { position: absolute; display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #a0a6ae; }
.tt-head { position: absolute; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.tt-line { position: absolute; left: 34px; right: 0; height: 1rpx; background: #f1f2f4; }
.tt-head.today { background: #e4f5f1; border-radius: 8rpx; }
.tt-hd { font-size: 22rpx; color: #3d434d; font-weight: bold; }
.tt-hm { font-size: 18rpx; color: #a0a6ae; }
.tt-head.today .tt-hd, .tt-head.today .tt-hm { color: #14937f; }
.tt-sec { position: absolute; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.tt-sn { font-size: 22rpx; color: #5c6370; }
.tt-st { font-size: 16rpx; color: #b0b6be; }
.tt-c { position: absolute; box-sizing: border-box; border-radius: 6px; padding: 4px; overflow: hidden; display: flex; flex-direction: column; }
.tt-cn { font-size: 20rpx; color: #ffffff; font-weight: bold; line-height: 1.3; }
.tt-cr { font-size: 18rpx; color: rgba(255, 255, 255, 0.9); margin-top: 4rpx; line-height: 1.3; }
.tt-dot { width: 20rpx; height: 20rpx; border-radius: 10rpx; margin-right: 12rpx; margin-bottom: 24rpx; }
.tt-dn { text-align: left; }
