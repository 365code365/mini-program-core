.me-head { display: flex; flex-direction: row; align-items: center; padding: 40rpx 32rpx 90rpx; background: linear-gradient(135deg, #3fb4a0, #16766a); }
.me-av { width: 120rpx; height: 120rpx; border-radius: 60rpx; border: 4rpx solid rgba(255, 255, 255, 0.8); }
.me-info { margin-left: 24rpx; display: flex; flex-direction: column; flex: 1; min-width: 0; }
.me-name { color: #ffffff; font-size: 36rpx; font-weight: bold; }
.me-sub { color: rgba(255, 255, 255, 0.85); font-size: 22rpx; margin-top: 8rpx; }
.me-sum { margin-top: -60rpx; }
.me-si { flex: 1; display: flex; flex-direction: column; align-items: center; }
.me-n { font-size: 34rpx; font-weight: bold; margin-bottom: 6rpx; }
.me-dev { display: block; text-align: center; font-size: 20rpx; color: #b0b6be; margin-top: 24rpx; }
