page { background: #f4f6fb; color: #1f2430; font-size: 28rpx; }
.wrap { padding: 24rpx 28rpx 40rpx; }
.card { background: #ffffff; border-radius: 24rpx; padding: 28rpx; margin-bottom: 24rpx; }
.row { display: flex; flex-direction: row; align-items: center; }
.between { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.h1 { font-size: 40rpx; font-weight: bold; color: #1f2430; }
.h2 { font-size: 32rpx; font-weight: bold; color: #1f2430; }
.muted { font-size: 24rpx; color: #8a90a0; }
.brand { color: #4f6bed; }
.btn { height: 88rpx; line-height: 88rpx; border-radius: 44rpx; text-align: center; font-size: 30rpx; background: #4f6bed; color: #ffffff; }
.btn-ghost { height: 88rpx; line-height: 88rpx; border-radius: 44rpx; text-align: center; font-size: 30rpx; background: #e9edfd; color: #4f6bed; }
.btn-press { opacity: 0.75; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 100rpx 40rpx; }
.empty-ic { width: 140rpx; height: 140rpx; border-radius: 70rpx; background: #e9edfd; display: flex; align-items: center; justify-content: center; font-size: 60rpx; color: #4f6bed; margin-bottom: 24rpx; }
.empty-tx { font-size: 28rpx; color: #8a90a0; margin-bottom: 32rpx; }
.tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; background: #e9edfd; color: #4f6bed; }
.ph { font-size: 26rpx; color: #8a90a0; }
.speaker { width: 56rpx; height: 56rpx; border-radius: 28rpx; background: #e9edfd; color: #4f6bed; font-size: 26rpx; display: flex; align-items: center; justify-content: center; margin-left: 16rpx; }
