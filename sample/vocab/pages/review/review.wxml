<view class="wrap">
  <block wx:if="{{running}}">
    <view class="between top">
      <text class="muted">第 {{i + 1}} / {{list.length}} 个 · 记得 {{ok}} · 忘记 {{bad}}</text>
      <text class="quit" bindtap="onQuit">结束</text>
    </view>
    <progress percent="{{i * 100 / list.length}}" stroke-width="6" activeColor="#22b07d" backgroundColor="#e6eaf7" border-radius="3"></progress>
    <view class="rcard">
      <text class="tag">{{stageText[cur.stage] || '第 1 轮'}}复习</text>
      <text class="word">{{cur.w}}</text>
      <view class="row">
        <text class="ph">{{cur.ph}}</text>
        <view class="speaker" hover-class="btn-press" bindtap="onSpeak"><text>🔊</text></view>
      </view>
      <view class="ans" wx:if="{{revealed}}">
        <text class="mean">{{cur.mean}}</text>
        <text class="ex">{{cur.ex}}</text>
        <text class="ex-zh">{{cur.exZh}}</text>
      </view>
      <view class="peek" wx:else hover-class="btn-press" bindtap="onReveal"><text class="peek-tx">想好了，看答案</text></view>
    </view>
    <view class="ops row" wx:if="{{revealed}}">
      <view class="op op-bad" hover-class="btn-press" bindtap="onForget"><text class="op-tx">忘记了</text></view>
      <view class="op op-ok" hover-class="btn-press" bindtap="onRemember"><text class="op-tx">记得</text></view>
    </view>
  </block>

  <block wx:else>
    <view class="card done" wx:if="{{finished}}">
      <text class="h2">本次复习完成</text>
      <text class="muted done-sub">记得 {{ok}} 个，忘记 {{bad}} 个（已退回明天复习并收进生词本）</text>
    </view>

    <view class="card head">
      <view class="between">
        <view class="col">
          <text class="muted">今日待复习</text>
          <view class="row"><text class="big">{{list.length}}</text><text class="muted unit">个</text></view>
        </view>
        <view class="btn start {{list.length ? '' : 'start-off'}}" hover-class="btn-press" bindtap="onStart">{{list.length ? '开始复习' : '已复习完'}}</view>
      </view>
      <text class="muted rule">间隔规则：学完后第 {{intervals[0]}}、{{intervals[1]}}、{{intervals[2]}}、{{intervals[3]}}、{{intervals[4]}} 天各复习一次，五轮都记得即为已掌握</text>
    </view>

    <view class="card" wx:if="{{list.length}}">
      <text class="h2">待复习单词</text>
      <view class="item between" wx:for="{{list}}" wx:key="w" data-w="{{item.w}}" bindtap="goWord" hover-class="btn-press">
        <view class="col"><text class="iw">{{item.w}}</text><text class="muted">{{item.mean}}</text></view>
        <text class="tag">{{stageText[item.stage]}}</text>
      </view>
    </view>
    <view class="card empty" wx:else>
      <view class="empty-ic"><text>✓</text></view>
      <text class="empty-tx">今天没有要复习的单词了</text>
      <view class="row">
        <view class="btn-ghost e-btn" hover-class="btn-press" bindtap="goLearn">学新词</view>
        <view class="btn-ghost e-btn" hover-class="btn-press" bindtap="goQuiz">做测验</view>
      </view>
    </view>

    <view class="card">
      <text class="h2">未来 7 天复习量</text>
      <view class="up row">
        <view class="up-col" wx:for="{{upcoming}}" wx:key="day">
          <text class="up-n">{{item.count}}</text>
          <view class="up-bar" style="height: {{item.count * 120 / maxUp + 6}}rpx;"></view>
          <text class="up-lb">{{item.label}}</text>
        </view>
      </view>
    </view>
  </block>
  <view style="height: 120rpx;"></view>
</view>
