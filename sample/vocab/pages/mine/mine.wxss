.user { padding: 16rpx 8rpx 32rpx; }
.ava { width: 112rpx; height: 112rpx; border-radius: 56rpx; background: linear-gradient(135deg, #7b8cff, #4f6bed); display: flex; align-items: center; justify-content: center; }
.ava-tx { color: #ffffff; font-size: 44rpx; font-weight: bold; }
.u-info { margin-left: 24rpx; }
.nums { justify-content: space-between; }
.num { width: 25%; display: flex; flex-direction: column; align-items: center; }
.num-v { font-size: 40rpx; font-weight: bold; margin-bottom: 4rpx; }
.plan-v { font-size: 30rpx; font-weight: bold; }
.set { padding: 0 28rpx; }
.set-row { height: 100rpx; border-bottom: 1rpx solid #eef0f5; font-size: 28rpx; }
.danger { color: #f0566a; }
.foot { display: block; text-align: center; margin-top: 12rpx; }
