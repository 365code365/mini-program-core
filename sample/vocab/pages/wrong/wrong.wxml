<view class="wrap">
  <block wx:if="{{list.length}}">
    <view class="between bar">
      <text class="muted">共 {{list.length}} 个错题 · 按出错次数排序</text>
      <text class="clear" bindtap="onClear">清空</text>
    </view>
    <view class="card list">
      <view class="item row" wx:for="{{list}}" wx:key="w">
        <view class="col main" data-w="{{item.w}}" bindtap="goWord" hover-class="btn-press">
          <view class="row"><text class="w">{{item.w}}</text><text class="times">错 {{item.times}} 次</text></view>
          <text class="mean">{{item.mean}}</text>
          <text class="muted">最近一次 {{item.last}}</text>
        </view>
        <view class="ok" data-w="{{item.w}}" catchtap="onRemove"><text class="ok-tx">已掌握</text></view>
      </view>
    </view>
    <view class="btn" hover-class="btn-press" bindtap="onRedo">重做错题（答对即移出）</view>
  </block>
  <view class="empty" wx:else>
    <view class="empty-ic"><text>✓</text></view>
    <text class="empty-tx">错题本是空的，测验里答错的词会出现在这里</text>
    <view class="btn e-btn" hover-class="btn-press" bindtap="goQuiz">去做测验</view>
  </view>
</view>
