<view class="tabs row">
  <view wx:for="{{tabs}}" wx:key="id" class="tab {{tab === item.id ? 'tab-on' : ''}}" data-id="{{item.id}}" bindtap="pick">
    <text>{{item.name}}</text>
    <text wx:if="{{counts[item.id]}}" class="tab-n">{{counts[item.id]}}</text>
  </view>
</view>
<view wx:if="{{list.length}}">
  <view wx:for="{{list}}" wx:key="id" class="od" data-id="{{item.id}}" bindtap="open">
    <view class="row od-head">
      <text class="muted flex1">订单号 {{item.id}}</text>
      <text class="od-st od-{{item.status}}">{{item.statusText}}</text>
    </view>
    <view class="row od-body">
      <image class="od-img" src="{{item.poster}}" mode="aspectFill"></image>
      <view class="col flex1 od-info">
        <text class="od-t">{{item.title}}</text>
        <text class="muted od-l">{{item.ses}}</text>
        <text class="muted od-l">{{item.venue}}</text>
        <view class="row od-l"><text class="muted flex1">{{item.n}} 张</text><text class="price">¥{{item.amount}}</text></view>
      </view>
    </view>
    <view wx:if="{{item.status === 'paid'}}" class="od-act row"><view class="flex1"></view><text class="od-btn">出示电子票</text></view>
    <view wx:if="{{item.status === 'unpaid'}}" class="od-act row"><view class="flex1"></view><text class="od-btn od-btn-pay">去支付</text></view>
  </view>
</view>
<view wx:else class="empty">
  <view class="empty-ic"><text class="empty-ic-t">票</text></view>
  <text class="empty-t">这里还没有票，去挑一场喜欢的演出吧</text>
  <view class="btn-ghost empty-btn" bindtap="goHome"><text>去看演出</text></view>
</view>
<view class="tabbar-space"></view>
