.st { padding: 36rpx 32rpx; }
.st-unpaid { background: linear-gradient(90deg, #ff9f43, #ff6b4a); }
.st-paid { background: linear-gradient(90deg, #ff5e7e, #ff3b5c); }
.st-refunded, .st-cancelled { background: #8a8d96; }
.st-t { color: #ffffff; font-size: 36rpx; font-weight: bold; }
.st-s { color: #ffffff; font-size: 24rpx; margin-top: 10rpx; }
.tk { margin: -10rpx 24rpx 0; background: #ffffff; border-radius: 20rpx; padding: 24rpx 28rpx 32rpx; display: flex; flex-direction: column; align-items: center; }
.tk-bright { box-shadow: 0 0 0 8rpx #ffe066; }
.tk-head { width: 100%; }
.tk-idx { text-align: center; font-size: 26rpx; color: #5a5d66; }
.nav { width: 56rpx; height: 56rpx; border-radius: 28rpx; background: #f5f5f7; display: flex; align-items: center; justify-content: center; font-size: 36rpx; }
.nav-dis { color: #d6d7dc; }
.qr-wrap { position: relative; margin-top: 20rpx; }
.qr { display: block; }
.qr-void { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; }
.qr-void-t { font-size: 40rpx; color: #e5352b; border: 4rpx solid #e5352b; border-radius: 12rpx; padding: 8rpx 24rpx; background: rgba(255, 255, 255, 0.85); }
.tk-no { margin-top: 16rpx; font-size: 24rpx; color: #5a5d66; letter-spacing: 2rpx; }
.tk-info { width: 100%; margin-top: 24rpx; padding-top: 20rpx; border-top: 2rpx dashed #ececf0; }
.tk-v { font-size: 26rpx; margin-top: 6rpx; }
.bright-btn { margin-top: 28rpx; width: 100%; height: 80rpx; border-radius: 40rpx; background: #1d1d22; color: #ffe066; display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.bright-on { background: #ffe066; color: #1d1d22; }
.kv { margin-top: 16rpx; align-items: flex-start; }
.k { width: 150rpx; color: #8a8d96; font-size: 24rpx; flex-shrink: 0; }
.v { flex: 1; font-size: 24rpx; }
.gap { margin-left: 16rpx; }
.pay { width: 240rpx; height: 64rpx; line-height: 64rpx; font-size: 26rpx; }
