<view class="head">
  <image class="head-bg" src="{{show.poster}}" mode="aspectFill"></image>
  <view class="head-mask"></view>
  <view class="head-in row">
    <image class="poster" src="{{show.poster}}" mode="aspectFill"></image>
    <view class="head-info col">
      <text class="title">{{show.title}}</text>
      <text class="artist">{{show.artist}}</text>
      <view class="row head-tags">
        <text class="htag" wx:for="{{show.tags}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="row want-n">
        <text class="want-big">{{wantText}}</text>
        <text class="want-s">人想看</text>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{!onSale}}" class="cd row">
  <view class="col flex1">
    <text class="cd-l">距开售（{{saleText}}）</text>
    <view class="row cd-nums">
      <text wx:if="{{cd.d > 0}}" class="cd-n">{{cd.d}}</text>
      <text wx:if="{{cd.d > 0}}" class="cd-u">天</text>
      <text class="cd-n">{{cd.h}}</text><text class="cd-u">:</text>
      <text class="cd-n">{{cd.m}}</text><text class="cd-u">:</text>
      <text class="cd-n">{{cd.s}}</text>
    </view>
  </view>
  <view class="cd-btn {{reminded ? 'cd-btn-on' : ''}}" bindtap="remind"><text>{{reminded ? '已设提醒' : '开售提醒'}}</text></view>
</view>

<!-- 吸顶 tab：position: sticky；引擎不支持 sticky 时滚过原位后显示 fixed 的那一份 -->
<view id="tabs" class="tabs row">
  <view wx:for="{{tabs}}" wx:key="*this" class="tab {{active === index ? 'tab-on' : ''}}" data-i="{{index}}" bindtap="jump"><text>{{item}}</text></view>
</view>
<view wx:if="{{fixedTabs}}" class="tabs tabs-fixed row">
  <view wx:for="{{tabs}}" wx:key="*this" class="tab {{active === index ? 'tab-on' : ''}}" data-i="{{index}}" bindtap="jump"><text>{{item}}</text></view>
</view>

<view id="sec-0" class="sec card" data-i="0">
  <text class="sec-title">选择场次</text>
  <view class="chips">
    <view wx:for="{{show.sessions}}" wx:key="id" class="chip {{ses === index ? 'chip-on' : ''}}" data-i="{{index}}" bindtap="pickSes">
      <text class="chip-t">{{item.date}} {{item.week}} {{item.time}}</text>
    </view>
  </view>
  <view class="row tier-head">
    <text class="sec-title">{{show.seat ? '票档（选座时按区域选择）' : '选择票档'}}</text>
  </view>
  <view class="chips">
    <view wx:for="{{show.tiers}}" wx:key="id" class="chip tier {{tier === index ? 'chip-on' : ''}} {{item.soldOut ? 'chip-out' : ''}}" data-i="{{index}}" bindtap="pickTier">
      <view class="tier-dot" style="background: {{item.color}};"></view>
      <text class="chip-t">{{item.name}} ¥{{item.price}}</text>
      <text wx:if="{{item.soldOut}}" class="out-t">售罄</text>
    </view>
  </view>
  <view wx:if="{{!show.seat}}" class="row qty">
    <text class="flex1">购买数量（每单限 4 张）</text>
    <view class="step row">
      <view class="step-b {{qty <= 1 ? 'step-dis' : ''}}" bindtap="minus"><text>−</text></view>
      <text class="step-n">{{qty}}</text>
      <view class="step-b {{qty >= 4 ? 'step-dis' : ''}}" bindtap="plus"><text>＋</text></view>
    </view>
  </view>
</view>

<view id="sec-1" class="sec card" data-i="1">
  <text class="sec-title">演出介绍</text>
  <view class="intro"><text class="intro-t">{{show.intro}}</text></view>
  <view class="kv row"><text class="k">演出时长</text><text class="v">{{show.duration}}</text></view>
  <view class="kv row"><text class="k">主要演出</text><text class="v">{{show.artist}}</text></view>
</view>

<view id="sec-2" class="sec card" data-i="2">
  <text class="sec-title">购票须知</text>
  <view wx:for="{{notice}}" wx:key="k" class="nt">
    <text class="nt-k">{{item.k}}</text>
    <view class="nt-v"><text>{{item.v}}</text></view>
  </view>
  <view class="nt">
    <text class="nt-k">退票说明</text>
    <view class="nt-v"><text>{{show.refundable ? show.tags[2] + '，退票收取票面 20% 手续费。' : '本场演出不支持退票，请确认后再购买。'}}</text></view>
  </view>
</view>

<view id="sec-3" class="sec card" data-i="3">
  <text class="sec-title">场馆</text>
  <view class="row venue" bindtap="venueMore">
    <view class="col flex1">
      <text class="venue-n">{{show.venue}}</text>
      <text class="muted venue-a">{{show.addr}}</text>
    </view>
    <text class="venue-more">更多 ›</text>
  </view>
</view>
<view class="bottom-space"></view>

<view class="foot">
  <view class="foot-ic col" bindtap="toggleWant">
    <text class="foot-heart {{want ? 'heart-on' : ''}}">{{want ? '♥' : '♡'}}</text>
    <text class="foot-l">想看</text>
  </view>
  <button class="foot-ic share-btn col" open-type="share" plain>
    <text class="foot-share">↗</text>
    <text class="foot-l">分享</text>
  </button>
  <view class="flex1 cta-wrap">
    <view wx:if="{{soldOut}}" class="btn-main btn-dis"><text>已售罄</text></view>
    <view wx:elif="{{!onSale}}" class="btn-main {{reminded ? 'btn-soft' : 'breath'}}" bindtap="remind"><text>{{reminded ? '已设开售提醒' : '开售提醒我'}}</text></view>
    <view wx:elif="{{show.seat}}" class="btn-main breath" bindtap="buy"><text>选座购买</text></view>
    <view wx:else class="btn-main breath" bindtap="buy"><text>立即购买 ¥{{total}}</text></view>
  </view>
</view>
