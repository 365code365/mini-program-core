page { background: #ffffff; }
.info { padding: 20rpx 28rpx 8rpx; display: flex; flex-direction: column; }
.info-t { font-size: 28rpx; font-weight: bold; }
.info-s { margin-top: 6rpx; }
.legend { flex-wrap: wrap; padding: 8rpx 28rpx 16rpx; }
.lg { margin: 8rpx 22rpx 0 0; }
.lg-box { width: 24rpx; height: 24rpx; border-radius: 6rpx; margin-right: 8rpx; }
.lg-sold { background: #4a4c5c; }
.lg-on { background: #ff3b5c; border: 2rpx solid #b3002a; }
.lg-t { font-size: 22rpx; color: #5a5d66; }

.area { width: 100%; background: #1f2030; overflow: hidden; position: relative; }
.map { background: #262838; border-radius: 12px; }
.stage { margin: 12px 0 16px 20%; width: 60%; height: 28px; border-radius: 0 0 40px 40px; background: linear-gradient(180deg, #8b8fa8, #4d5068); display: flex; align-items: center; justify-content: center; }
.stage-t { color: #ffffff; font-size: 12px; letter-spacing: 6px; }
.srow { padding-left: 4px; }
.rno { display: flex; align-items: center; justify-content: center; }
.rno-t { color: #8b8fa8; font-size: 10px; }
.cell { display: flex; align-items: center; justify-content: center; }
.seat { width: 78%; height: 78%; border-radius: 3px; opacity: 0.85; }
.sold { background: #4a4c5c; opacity: 1; }
.on { background: #ff3b5c; opacity: 1; border: 2px solid #ffffff; }
.zoom { position: absolute; right: 12px; bottom: 12px; }
.zb { width: 36px; height: 36px; border-radius: 18px; background: rgba(255, 255, 255, 0.92); margin-top: 8px; display: flex; align-items: center; justify-content: center; font-size: 18px; color: #1d1d22; }
.zb-s { font-size: 11px; }
.zoom-t { position: absolute; right: 12px; top: 10px; background: rgba(0, 0, 0, 0.45); border-radius: 10px; padding: 2px 10px; color: #ffffff; font-size: 11px; }
.tip { padding: 12rpx 28rpx; }

.panel { position: fixed; left: 0; right: 0; bottom: 0; background: #ffffff; border-top: 1rpx solid #ececf0; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); }
.picked { flex-wrap: wrap; }
.pk { position: relative; background: #fff0f3; border-radius: 12rpx; padding: 10rpx 40rpx 10rpx 16rpx; margin: 0 12rpx 12rpx 0; }
.pk-l { font-size: 24rpx; color: #ff3b5c; font-weight: bold; }
.pk-p { font-size: 20rpx; color: #ff6b81; margin-top: 2rpx; }
.pk-x { position: absolute; right: 10rpx; top: 6rpx; font-size: 26rpx; color: #ff3b5c; }
.picked-none { padding: 10rpx 0 20rpx; }
.panel-foot { margin-top: 4rpx; }
.total { font-size: 34rpx; }
.confirm { width: 240rpx; }
