.page { padding-top: 88rpx; padding-bottom: 150rpx; }
.tabs-bar { position: fixed; top: 0; left: 0; right: 0; height: 88rpx; background: #ffffff; z-index: 10; border-bottom: 1rpx solid #f0f1f4; }
.tabs { height: 88rpx; white-space: nowrap; }
.tabs-row { display: flex; flex-direction: row; height: 88rpx; padding: 0 12rpx; }
.tab { position: relative; height: 88rpx; padding: 0 24rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.tab-text { font-size: 28rpx; color: #86909c; white-space: nowrap; }
.tab-text-on { font-size: 32rpx; color: #1d2129; font-weight: bold; }
.tab-line { position: absolute; bottom: 10rpx; left: 50%; margin-left: -18rpx; width: 36rpx; height: 6rpx; border-radius: 3rpx; background: #FF6B3D; }
.banner { margin: 16rpx 24rpx 0; padding: 14rpx 0; border-radius: 12rpx; background: #fff3ed; display: flex; flex-direction: row; justify-content: center; }
.banner-text { color: #FF6B3D; font-size: 24rpx; }
.list { padding-top: 20rpx; }
.empty { display: flex; flex-direction: row; justify-content: center; padding: 120rpx 0; }
.more { display: flex; flex-direction: row; align-items: center; justify-content: center; padding: 24rpx 0 12rpx; }
.more-text { font-size: 24rpx; color: #a9aeb8; }
.spinner { width: 28rpx; height: 28rpx; border-radius: 14rpx; border: 4rpx solid #ffd9cc; border-top-color: #FF6B3D; margin-right: 12rpx; animation: spin 0.8s linear infinite; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.fab { position: fixed; right: 36rpx; bottom: 150rpx; width: 104rpx; height: 104rpx; border-radius: 52rpx; background: #FF6B3D; box-shadow: 0 8rpx 24rpx rgba(255, 107, 61, 0.4); z-index: 20; }
.fab-hover { background: #f05a2b; }
.fab-h { position: absolute; left: 32rpx; top: 49rpx; width: 40rpx; height: 6rpx; border-radius: 3rpx; background: #ffffff; }
.fab-v { position: absolute; left: 49rpx; top: 32rpx; width: 6rpx; height: 40rpx; border-radius: 3rpx; background: #ffffff; }
