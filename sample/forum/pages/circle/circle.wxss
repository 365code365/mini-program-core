.page { padding-bottom: 60rpx; }
.hero { padding: 40rpx 32rpx 48rpx; }
.hero-row { display: flex; flex-direction: row; align-items: center; }
.icon { width: 116rpx; height: 116rpx; border-radius: 30rpx; background: #ffffff; display: flex; flex-direction: row; align-items: center; justify-content: center; margin-right: 24rpx; }
.icon-text { font-size: 50rpx; font-weight: bold; }
.hero-main { flex: 1; display: flex; flex-direction: column; }
.name { font-size: 38rpx; font-weight: bold; color: #ffffff; }
.desc { font-size: 24rpx; color: rgba(255, 255, 255, 0.9); margin-top: 6rpx; }
.meta { font-size: 22rpx; color: rgba(255, 255, 255, 0.8); margin-top: 6rpx; }
.join { width: 136rpx; height: 60rpx; border-radius: 30rpx; background: #ffffff; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.joined { background: rgba(255, 255, 255, 0.25); }
.join-text { font-size: 26rpx; font-weight: bold; white-space: nowrap; }
.sorts { display: flex; flex-direction: row; padding: 24rpx 24rpx 16rpx; }
.sort { padding: 8rpx 28rpx; border-radius: 28rpx; margin-right: 16rpx; background: #ffffff; }
.sort-on { background: #1d2129; }
.sort-text { font-size: 26rpx; color: #4e5969; }
.sort-text-on { color: #ffffff; }
.empty { display: flex; flex-direction: row; justify-content: center; padding: 100rpx 0; }
