<view class="tabs">
  <view wx:for="{{tabs}}" wx:key="key" class="tab {{tab === item.key ? 'tab-on' : ''}}" data-key="{{item.key}}" bindtap="onTab">
    <text>{{item.name}}</text>
    <view class="tab-line" wx:if="{{tab === item.key}}"></view>
  </view>
</view>
<view wx:if="{{!list.length}}" class="empty">
  <view class="empty-ico"><view class="empty-roof"></view><view class="empty-box"></view></view>
  <text class="empty-t">暂无相关订单</text>
  <view class="empty-btn" bindtap="onGo">去逛逛</view>
</view>
<view class="order card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
  <view class="row between o-head">
    <text class="o-type">酒店</text>
    <text class="o-status st-{{item.status}}">{{statusText[item.status]}}</text>
  </view>
  <view class="row o-main">
    <image class="o-img" src="{{item.img}}" mode="aspectFill"></image>
    <view class="flex1 o-info">
      <text class="o-name">{{item.hotel}}</text>
      <text class="sub o-line">{{item.inShort}} - {{item.outShort}} · {{item.nights}}晚 · {{item.count}}间</text>
      <text class="sub o-line">{{item.room}}</text>
      <text class="sub o-line">入住人：{{item.guests}}</text>
    </view>
  </view>
  <view class="row o-foot">
    <text class="sub">实付</text><text class="o-total">¥{{item.total}}</text>
    <view class="flex1"></view>
    <view wx:if="{{item.status === 'wait'}}" class="o-btn" data-id="{{item.id}}" catchtap="onCancel">取消订单</view>
    <view wx:if="{{item.status === 'wait'}}" class="o-btn primary" data-id="{{item.id}}" catchtap="onContact">联系酒店</view>
    <view wx:if="{{item.status !== 'wait'}}" class="o-btn primary" data-hid="{{item.hid}}" catchtap="onRebook">再次预订</view>
  </view>
</view>
<view class="gap"></view>
