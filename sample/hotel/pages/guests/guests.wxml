<view class="tip"><text class="sub">{{select ? '每间房填 1 位入住人，最多选 ' + max + ' 位' : '入住人姓名需与证件一致，预订时可一键选择'}}</text></view>
<view class="card g row" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onPick">
  <view wx:if="{{select}}" class="ck {{item.on ? 'ck-on' : ''}}"><view wx:if="{{item.on}}" class="ck-in"></view></view>
  <view class="g-av"><text>{{item.av}}</text></view>
  <view class="flex1">
    <text class="g-name">{{item.name}}</text>
    <text class="sub">{{item.phoneMask}}</text>
  </view>
  <view class="edit" data-id="{{item.id}}" catchtap="onEdit"><text>编辑</text></view>
</view>
<view wx:if="{{!list.length}}" class="empty-tip"><text>还没有常用入住人</text></view>
<view class="fbar-gap"></view>
<view class="fbar row">
  <view class="btn-ghost f-add" bindtap="onAdd"><text>新增入住人</text></view>
  <view wx:if="{{select}}" class="btn-primary f-ok" bindtap="onConfirm">确定（{{picked.length}}/{{max}}）</view>
</view>

<block wx:if="{{panel}}">
  <view class="mask" bindtap="close"></view>
  <view class="sheet" catchtap="noop">
    <text class="sheet-title">{{form.id ? '编辑入住人' : '新增入住人'}}</text>
    <view class="f-row row"><text class="f-label">姓名</text><input id="gn{{seq}}" class="f-input g-name-in" placeholder="与证件一致" value="{{form.name}}" maxlength="20" bindinput="onName" /></view>
    <view class="f-row row"><text class="f-label">手机号</text><input id="gp{{seq}}" class="f-input g-phone-in" type="number" maxlength="11" placeholder="选填，用于接收入住短信" value="{{form.phone}}" bindinput="onPhone" /></view>
    <view class="btn-primary g-save" bindtap="onSave">保存</view>
    <view wx:if="{{form.id}}" class="g-del" bindtap="onDel"><text>删除入住人</text></view>
  </view>
</block>
