<view class="head">
  <text class="h-name">{{h.name}}</text>
  <view wx:if="{{!hourly}}" class="row h-dates">
    <text class="h-d">{{inShort}} {{inWeek}}</text><text class="h-sep">—</text><text class="h-d">{{outShort}} {{outWeek}}</text>
    <text class="h-n">共{{nights}}晚</text>
  </view>
  <view wx:else class="row h-dates">
    <text class="h-d">{{inShort}} {{inWeek}}</text><text class="h-n">钟点房 4 小时</text>
  </view>
  <text class="h-room">{{room.name}} · {{room.bed}} · {{room.breakfast}} · {{room.size}} · 可住{{room.max}}人</text>
  <view class="h-policy"><text class="h-policy-t">{{hourly ? '开始时间前可免费取消' : '入住前一天 18:00 前可免费取消'}}</text></view>
</view>
<view class="card form first">
  <view class="f-row">
    <text class="f-label">房间数</text>
    <view class="flex1"></view>
    <view class="row">
      <view class="stp {{count <= minCount ? 'stp-off' : ''}}" bindtap="onMinus"><view class="stp-h"></view></view>
      <text class="stp-n">{{count}}间</text>
      <view class="stp {{count >= room.left ? 'stp-off' : ''}}" bindtap="onPlus"><view class="stp-h"></view><view class="stp-v"></view></view>
    </view>
  </view>
  <view class="f-row" wx:for="{{guests}}" wx:key="*this">
    <text class="f-label">住客{{guests.length > 1 ? index + 1 : ''}}</text>
    <input id="g{{guestSeq}}-{{index}}" class="f-input guest-in" placeholder="姓名，与证件一致" value="{{item}}" data-idx="{{index}}" bindinput="onGuest" />
    <text wx:if="{{index === 0}}" class="pick-link" bindtap="onPickGuests">常用入住人</text>
  </view>
  <view class="f-row">
    <text class="f-label">联系手机</text>
    <input class="f-input phone-in" type="number" maxlength="11" placeholder="用于接收订单短信" value="{{phone}}" bindinput="onPhone" />
  </view>
  <picker wx:if="{{!hourly}}" mode="selector" range="{{arrivals}}" value="{{arrival}}" bindchange="onArrival">
    <view class="f-row">
      <text class="f-label">预计到店</text>
      <text class="f-val flex1">{{arrivals[arrival]}}</text>
      <view class="chev"></view>
    </view>
  </picker>
  <picker wx:elif="{{starts.length}}" mode="selector" range="{{starts}}" value="{{startIdx}}" bindchange="onStart">
    <view class="f-row">
      <text class="f-label">开始时间</text>
      <text class="f-val flex1">{{starts[startIdx]}} 起，4 小时</text>
      <view class="chev"></view>
    </view>
  </picker>
  <view wx:else class="f-row"><text class="f-label">开始时间</text><text class="f-val f-warn">今天已无可订时段，请改订明天</text></view>
  <view class="f-tip"><text>{{hourly ? '请在开始时间前到店，超时 30 分钟未到店视为放弃' : '房间将整晚保留，20:00 后到店请提前联系酒店'}}</text></view>
</view>
<view class="card form">
  <view class="f-row">
    <text class="f-label">需要发票</text>
    <view class="flex1"></view>
    <switch class="inv-sw" checked="{{invoice}}" color="#1E6FFF" bindchange="onInvoice" />
  </view>
  <block wx:if="{{invoice}}">
    <view class="inv-types row">
      <view wx:for="{{invTypes}}" wx:key="*this" class="inv-type {{invType === index ? 'inv-on' : ''}}" data-idx="{{index}}" bindtap="onInvType"><text>{{item}}</text></view>
      <view class="flex1"></view>
      <text class="pick-link" bindtap="onPickInvoice">常用抬头</text>
    </view>
    <view class="f-row">
      <text class="f-label">发票抬头</text>
      <input id="it{{invSeq}}" class="f-input inv-title" placeholder="{{invType === 0 ? '个人姓名' : '公司全称'}}" value="{{invTitle}}" bindinput="onInvTitle" />
    </view>
    <view class="f-row" wx:if="{{invType === 1}}">
      <text class="f-label">税号</text>
      <input id="tx{{invSeq}}" class="f-input tax-in" placeholder="纳税人识别号" value="{{taxNo}}" bindinput="onTaxNo" />
    </view>
  </block>
  <view class="f-row no-border" bindtap="onNeeds">
    <text class="f-label">特殊要求</text>
    <text class="f-val flex1 {{needs.length ? '' : 'f-ph'}}">{{needs.length ? needs : '高楼层、无烟房、安静房…'}}</text>
    <view class="chev"></view>
  </view>
</view>
<view class="card">
  <text class="block-title">费用明细</text>
  <view class="fee row between"><text>{{hourly ? '房费（' + count + '间 × 4小时）' : '房费（' + count + '间 × ' + nights + '晚）'}}</text><text>¥{{p.roomFee}}</text></view>
  <view class="fee row between"><text>金卡会员 9.5 折</text><text class="price-color">-¥{{p.memberCut}}</text></view>
  <view class="fee row between coupon-row" bindtap="onCoupon">
    <text>优惠券</text>
    <view class="row"><text class="{{p.couponCut ? 'price-color' : 'sub'}}">{{couponText}}</text><view class="chev"></view></view>
  </view>
  <view class="fee row between">
    <view><text>积分抵扣</text><text class="sub pts">{{p.pointsMax ? '可用 ' + p.pointsMax * 100 + ' 积分抵 ¥' + p.pointsMax : '积分 ' + points + '，不足抵扣'}}</text></view>
    <switch class="pts-sw" checked="{{usePoints}}" disabled="{{!p.pointsMax}}" color="#1E6FFF" bindchange="onPoints" />
  </view>
  <view class="fee row between"><text>税费及服务费</text><text>已包含</text></view>
</view>
<view class="bottom-space"></view>
<view class="bar">
  <view class="flex1">
    <view class="row total-row"><text class="sub">在线付 </text><text class="price-color yen">¥</text><text class="price-color total">{{p.total}}</text></view>
    <text class="sub">已优惠 ¥{{p.saved}}</text>
  </view>
  <view class="submit" bindtap="onSubmit"><text>提交订单</text></view>
</view>
