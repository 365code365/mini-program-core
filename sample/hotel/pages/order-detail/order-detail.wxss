.head { margin: 24rpx 24rpx 24rpx; padding: 32rpx; border-radius: 24rpx; background: linear-gradient(150deg, #3D8BFF, #1E5BFF); color: #fff; }
.head-in { background: linear-gradient(150deg, #5FD99A, #1E9E6A); }
.head-done { background: linear-gradient(150deg, #FFB35C, #F08A24); }
.head-cancel { background: linear-gradient(150deg, #b5b9bf, #8a9099); }
.h-status { display: block; font-size: 40rpx; font-weight: bold; }
.h-tip { display: block; margin-top: 8rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.9); }
.h-acts { margin-top: 28rpx; flex-wrap: wrap; }
.h-op { height: 56rpx; padding: 0 24rpx; margin: 0 14rpx 10rpx 0; border-radius: 28rpx; border: 2rpx solid rgba(255, 255, 255, 0.7); font-size: 24rpx; display: flex; flex-direction: row; align-items: center; }
.h-op-main { background: #fff; border-color: #fff; color: #1E5BFF; font-weight: bold; }
.block-title { display: block; font-size: 30rpx; font-weight: bold; margin-bottom: 8rpx; }
.stars { margin-top: 12rpx; }
.score-text { font-size: 26rpx; color: #F08A24; margin-left: 8rpx; }
.r-tags { flex-wrap: wrap; margin-top: 12rpx; }
.r-tag { height: 52rpx; line-height: 52rpx; padding: 0 20rpx; margin: 0 14rpx 14rpx 0; border-radius: 26rpx; background: #f5f6f8; border: 2rpx solid #f5f6f8; font-size: 24rpx; color: #4e5969; }
.r-tag-on { background: #EAF2FF; border-color: #A9C8FF; color: #1E6FFF; }
.rate-input { width: 100%; height: 150rpx; margin-top: 6rpx; padding: 16rpx 20rpx; box-sizing: border-box; border-radius: 14rpx; background: #f5f6f8; font-size: 26rpx; }
.rate-btn { margin-top: 24rpx; height: 80rpx; line-height: 80rpx; font-size: 28rpx; }
.r-text { display: block; margin-top: 10rpx; font-size: 26rpx; color: #4e5969; line-height: 40rpx; }
.ho-img { width: 120rpx; height: 120rpx; border-radius: 14rpx; flex-shrink: 0; }
.ho-info { margin-left: 20rpx; display: flex; flex-direction: column; }
.ho-name { font-size: 30rpx; font-weight: bold; margin-bottom: 6rpx; }
.ho-addr { margin-bottom: 4rpx; }
.ho-nav { display: flex; flex-direction: column; align-items: center; padding-left: 20rpx; flex-shrink: 0; }
.pin { width: 24rpx; height: 24rpx; border-radius: 12rpx; border: 5rpx solid #1E6FFF; }
.ho-nav-t { font-size: 20rpx; color: #1E6FFF; margin-top: 4rpx; }
.kv { min-height: 64rpx; font-size: 26rpx; }
.k { width: 150rpx; color: #8a9099; flex-shrink: 0; }
.v { color: #1f2329; }
.arrival { border-radius: 10rpx; }
.edit-t { font-size: 24rpx; color: #1E6FFF; }
.ln { min-height: 58rpx; font-size: 26rpx; }
.ln-n { font-size: 26rpx; }
.paid { min-height: 70rpx; }
.paid-v { font-size: 36rpx; font-weight: bold; }
.refund { color: #1E9E6A; font-weight: bold; }
.copy { margin-left: 16rpx; font-size: 22rpx; color: #1E6FFF; padding: 0 14rpx; line-height: 36rpx; border-radius: 18rpx; border: 2rpx solid #A9C8FF; }
.gap { height: 40rpx; }
.miss-btn { margin: 40rpx 120rpx 0; }
