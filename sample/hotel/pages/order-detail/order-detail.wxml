<view wx:if="{{o}}">
  <view class="head head-{{st.key}}">
    <text class="h-status">{{st.text}}</text>
    <text class="h-tip">{{st.tip}}</text>
    <view class="row h-acts">
      <view wx:if="{{st.canCancel}}" class="h-op h-cancel" bindtap="onCancel"><text>取消订单</text></view>
      <view wx:if="{{st.key !== 'cancel' && st.key !== 'done'}}" class="h-op h-call" bindtap="onCall"><text>联系酒店</text></view>
      <view wx:if="{{st.key !== 'cancel' && st.key !== 'done'}}" class="h-op h-nav" bindtap="onNav"><text>导航到店</text></view>
      <view class="h-op h-op-main h-rebook" bindtap="onRebook"><text>再次预订</text></view>
    </view>
  </view>

  <view wx:if="{{st.key === 'done'}}" class="card rate">
    <block wx:if="{{o.rating}}">
      <view class="row between"><text class="block-title">我的点评</text><text class="sub">{{o.rating.time}}</text></view>
      <view class="row stars"><text wx:for="{{starList}}" wx:key="*this" class="rate-star {{item <= o.rating.score ? 'rate-on' : ''}}">★</text></view>
      <view wx:if="{{o.rating.tags.length}}" class="row r-tags"><text wx:for="{{o.rating.tags}}" wx:key="*this" class="r-tag r-tag-on">{{item}}</text></view>
      <text wx:if="{{o.rating.text}}" class="r-text">{{o.rating.text}}</text>
    </block>
    <block wx:else>
      <text class="block-title">点评这次入住 · 得 50 积分</text>
      <view class="row stars">
        <text wx:for="{{starList}}" wx:key="*this" class="rate-star {{item <= score ? 'rate-on' : ''}}" data-n="{{item}}" bindtap="onStar">★</text>
        <text class="score-text">{{scoreText}}</text>
      </view>
      <view class="row r-tags">
        <text wx:for="{{tags}}" wx:key="n" class="r-tag {{item.on ? 'r-tag-on' : ''}}" data-i="{{index}}" bindtap="onTag">{{item.n}}</text>
      </view>
      <textarea class="rate-input" placeholder="房间、服务、位置怎么样？（选填）" maxlength="200" value="{{rateText}}" bindinput="onRateText" />
      <view class="btn-primary rate-btn" bindtap="onSubmitRate">提交点评</view>
    </block>
  </view>

  <view class="card hotel row">
    <image class="ho-img" src="{{h.img}}" mode="aspectFill" />
    <view class="flex1 ho-info">
      <text class="ho-name">{{h.name}}</text>
      <text class="sub ho-addr">{{h.city}}{{h.addr}}</text>
      <text class="sub">电话 {{h.phone}}</text>
    </view>
    <view class="ho-nav" bindtap="onNav"><view class="pin"></view><text class="ho-nav-t">地图</text></view>
  </view>

  <view class="card">
    <text class="block-title">入住信息</text>
    <view class="kv row"><text class="k">入住时间</text><text class="v flex1">{{stay}}</text></view>
    <view class="kv row"><text class="k">房型</text><text class="v flex1">{{room.name}} × {{o.count}}间</text></view>
    <view class="kv row"><text class="k">入住人</text><text class="v flex1">{{guestsText}}</text></view>
    <view class="kv row"><text class="k">联系手机</text><text class="v flex1">{{o.phone}}</text></view>
    <picker wx:if="{{st.canArrival}}" mode="selector" range="{{arrivals}}" value="{{arrivalIdx}}" bindchange="onArrival">
      <view class="kv row arrival"><text class="k">预计到店</text><text class="v flex1">{{o.arrival}}</text><text class="edit-t">修改</text><view class="chev"></view></view>
    </picker>
    <view wx:elif="{{!o.hourly}}" class="kv row"><text class="k">预计到店</text><text class="v flex1">{{o.arrival}}</text></view>
    <view class="kv row"><text class="k">特殊要求</text><text class="v flex1">{{o.needs || '无'}}</text></view>
  </view>

  <view wx:if="{{o.invoice}}" class="card">
    <text class="block-title">发票</text>
    <view class="kv row"><text class="k">抬头</text><text class="v flex1">{{o.invoice.title}}（{{o.invoice.type === 1 ? '企业' : '个人'}}）</text></view>
    <view wx:if="{{o.invoice.taxNo}}" class="kv row"><text class="k">税号</text><text class="v flex1">{{o.invoice.taxNo}}</text></view>
    <text class="sub">{{st.key === 'cancel' ? '订单已取消，不再开具发票' : '离店后由酒店开具电子发票，发送到预订手机号'}}</text>
  </view>

  <view class="card">
    <text class="block-title">费用</text>
    <view class="ln row between" wx:for="{{lines}}" wx:key="n"><text class="sub ln-n">{{item.n}}</text><text class="{{item.cut ? 'price-color' : ''}}">{{item.v}}</text></view>
    <view class="ln row between paid"><text>实付</text><text class="price-color paid-v">¥{{o.total}}</text></view>
    <view wx:if="{{st.key === 'cancel'}}" class="ln row between"><text class="sub ln-n">已退款（原路退回）</text><text class="refund">¥{{refund}}</text></view>
  </view>

  <view class="card">
    <view class="kv row between"><text class="k">订单号</text><view class="row"><text class="v">{{o.id}}</text><text class="copy" bindtap="onCopy">复制</text></view></view>
    <view class="kv row between"><text class="k">支付方式</text><text class="v">微信支付</text></view>
  </view>
  <view class="gap"></view>
</view>
<view wx:else class="empty-tip">
  <text>订单不存在或已被清理</text>
  <view class="btn-primary miss-btn" bindtap="onGoOrders">查看全部订单</view>
</view>
