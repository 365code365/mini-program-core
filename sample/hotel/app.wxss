page { background: #f5f6f8; color: #1f2329; font-size: 28rpx; }
.card { background: #fff; border-radius: 20rpx; margin: 0 24rpx 24rpx; padding: 28rpx; }
.row { display: flex; flex-direction: row; align-items: center; }
.between { justify-content: space-between; }
.flex1 { flex: 1; min-width: 0; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.sub { font-size: 24rpx; color: #8a9099; }
.blue { color: #1E6FFF; }
.price-color { color: #FF5A36; }
.title { font-size: 34rpx; font-weight: bold; }
.btn-primary { background: linear-gradient(90deg, #3D8BFF, #1E5BFF); color: #fff; font-size: 32rpx; font-weight: bold; height: 92rpx; line-height: 92rpx; text-align: center; border-radius: 46rpx; }
.btn-ghost { border: 2rpx solid #1E6FFF; color: #1E6FFF; background: #fff; font-size: 30rpx; height: 88rpx; border-radius: 44rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; box-sizing: border-box; }
.tag { font-size: 20rpx; color: #1E6FFF; background: #EAF2FF; padding: 4rpx 12rpx; border-radius: 8rpx; margin-right: 10rpx; }
.tag.orange { color: #E8743B; background: #FFF1E6; }
.tag.green { color: #1E9E6A; background: #E6F7EF; }
.score { background: #1E6FFF; color: #fff; font-size: 22rpx; font-weight: bold; padding: 2rpx 10rpx; border-radius: 8rpx 8rpx 8rpx 0; }
.chev { width: 14rpx; height: 14rpx; border-top: 3rpx solid #c4c7cc; border-right: 3rpx solid #c4c7cc; transform: rotate(45deg); margin-left: 10rpx; flex-shrink: 0; }
.section-title { font-size: 32rpx; font-weight: bold; margin: 8rpx 24rpx 20rpx; }
.empty-tip { padding: 120rpx 0; text-align: center; color: #9aa0a6; font-size: 26rpx; }
/* 引擎的 input 只要 padding 全为 0 就套用默认 8px/12px 内边距（微信里 input 无内边距），给 1rpx 让它认作自定义 */
input { padding: 0 0 0 1rpx; }
/* 底部固定操作条（非 tab 页） */
.fbar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06); }
.fbar-gap { height: calc(150rpx + env(safe-area-inset-bottom)); }
/* 底部弹出面板：遮罩与面板是兄弟节点，面板上 catchtap 兜底 */
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.45); }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 32rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); }
.sheet-title { display: block; font-size: 32rpx; font-weight: bold; text-align: center; margin-bottom: 20rpx; }
/* 加减号：「−」(U+2212) 画不出来，用 CSS 画 */
.stp { position: relative; width: 56rpx; height: 56rpx; border-radius: 28rpx; border: 2rpx solid #1E6FFF; box-sizing: border-box; flex-shrink: 0; }
.stp-h { position: absolute; left: 14rpx; top: 24rpx; width: 24rpx; height: 4rpx; border-radius: 2rpx; background: #1E6FFF; }
.stp-v { position: absolute; left: 24rpx; top: 14rpx; width: 4rpx; height: 24rpx; border-radius: 2rpx; background: #1E6FFF; }
.stp-off { border-color: #d5d8dc; }
.stp-off .stp-h, .stp-off .stp-v { background: #d5d8dc; }
.stp-n { width: 88rpx; text-align: center; font-size: 28rpx; font-weight: bold; }
.rate-star { font-size: 44rpx; line-height: 56rpx; color: #e3e5e8; margin-right: 10rpx; }
.rate-on { color: #FFB020; }
