.hero {
  display: flex;
  flex-direction: row;
  padding: 40rpx 32rpx 56rpx;
}
.hero-cover {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
}
.hero-main {
  display: flex;
  flex-direction: column;
  margin-left: 28rpx;
  flex: 1;
}
.hero-name {
  color: #ffffff;
  font-size: 38rpx;
  font-weight: bold;
}
.hero-desc {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-top: 12rpx;
}
.bar {
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  margin-top: -28rpx;
  padding: 24rpx 32rpx;
}
.play-all {
  flex: 1;
}
.play-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: #ff3a5c;
  display: flex;
  align-items: center;
  justify-content: center;
}
.play-dot-text {
  color: #ffffff;
  font-size: 22rpx;
}
.play-all-text {
  font-size: 30rpx;
  font-weight: bold;
  margin-left: 16rpx;
}
.pl-song {
  border-bottom: 1rpx solid #f0f1f5;
}
.song-no.on {
  color: #ff3a5c;
}
