.banner {
  margin: 24rpx 32rpx 0;
  padding: 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ff6a88, #ff3a5c);
  display: flex;
  flex-direction: column;
}
.banner-greet {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
}
.banner-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: bold;
  margin-top: 12rpx;
}
.banner-btn {
  margin-top: 24rpx;
  width: 180rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.banner-btn-text {
  color: #ff3a5c;
  font-size: 26rpx;
}
.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 0 20rpx;
}
.pl {
  width: 33.33%;
  padding: 0 12rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.pl-cover {
  height: 200rpx;
  position: relative;
}
.pl-plays {
  position: absolute;
  right: 12rpx;
  top: 8rpx;
  font-size: 20rpx;
  color: #ffffff;
}
.pl-name {
  font-size: 24rpx;
  margin-top: 10rpx;
  height: 64rpx;
  overflow: hidden;
}
.list {
  margin: 0 32rpx;
  border-radius: 20rpx;
  overflow: hidden;
}
.list .song {
  padding: 18rpx 24rpx;
}
