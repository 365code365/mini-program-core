/* 引擎里 display:flex 不写 flex-direction 时按 column 排，下面一律写明方向 */
page { background: #f4f3fb; color: #1f2140; font-size: 28rpx; }
.row { display: flex; flex-direction: row; align-items: center; }
.col { display: flex; flex-direction: column; }
.between { justify-content: space-between; }
.flex1 { flex: 1; }
.card { background: #fff; border-radius: 24rpx; margin: 0 24rpx 20rpx; padding: 28rpx; box-shadow: 0 6rpx 24rpx rgba(60, 40, 180, 0.06); }
.title { font-size: 32rpx; font-weight: bold; }
.sub { font-size: 24rpx; color: #8b8fa8; }
.brand { color: #5B4BF5; }
.btn-primary { background: linear-gradient(90deg, #7C6CFF, #4A3AE8); color: #fff; font-size: 32rpx; font-weight: bold; height: 96rpx; line-height: 96rpx; text-align: center; border-radius: 48rpx; }
.btn-disabled { background: #c9c4f5; }
.btn-ghost { border: 2rpx solid #5B4BF5; color: #5B4BF5; font-size: 28rpx; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 44rpx; }
.glyph { width: 80rpx; height: 80rpx; border-radius: 20rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.glyph-t { color: #fff; font-size: 34rpx; font-weight: bold; }
.chev { width: 14rpx; height: 14rpx; border-top: 3rpx solid #c4c7cc; border-right: 3rpx solid #c4c7cc; transform: rotate(45deg); margin-left: 12rpx; }
.nowrap { white-space: nowrap; }
.tabbar-space { height: calc(130rpx + env(safe-area-inset-bottom)); }
.empty { padding: 140rpx 0; display: flex; flex-direction: column; align-items: center; }
.empty-ring { width: 120rpx; height: 120rpx; border-radius: 60rpx; border: 6rpx solid #e3e1f5; margin-bottom: 24rpx; }
