<view class="head">
  <view class="row">
    <view class="avatar"><text class="avatar-t">林</text></view>
    <view class="col">
      <text class="name">林晓岚</text>
      <text class="head-s">工号 HW20318 · 研发中心</text>
    </view>
  </view>
  <view class="wallet">
    <view class="col wallet-info" bindtap="openCard">
      <text class="sub">饭卡余额（元）</text>
      <text class="bal">{{balanceText}}</text>
    </view>
    <view class="btn rc-btn" bindtap="openCard"><text>充值</text></view>
  </view>
</view>

<view class="card stats">
  <view class="stat" bindtap="goOrders"><text class="stat-v">{{orders}}</text><text class="sub">有效订单</text></view>
  <view class="stat" bindtap="openCard"><text class="stat-v">{{spentText}}</text><text class="sub">累计消费</text></view>
  <view class="stat" bindtap="onSaved"><text class="stat-v brand">{{savedText}}</text><text class="sub">满减省下</text></view>
</view>

<view class="card">
  <view class="cell"><text>最常点</text><text class="sub">{{topDish}}</text></view>
  <view class="cell" bindtap="changeTable"><text>当前桌号</text><view class="row"><text class="sub">{{table || '未选择'}}</text><view class="arrow"></view></view></view>
  <view class="cell cell-last" bindtap="leaveTable"><text>离开餐桌</text><view class="arrow"></view></view>
</view>

<view class="card">
  <view class="cell cell-card" bindtap="openCard"><text>饭卡明细</text><view class="row"><text class="sub">充值 · 消费 · 退款</text><view class="arrow"></view></view></view>
  <view class="cell cell-help" bindtap="openHelp"><text>帮助与反馈</text><view class="row"><text class="sub">{{feedback ? '已反馈 ' + feedback + ' 条' : '常见问题 · 意见反馈'}}</text><view class="arrow"></view></view></view>
  <view class="cell cell-call" bindtap="callCanteen"><text>联系食堂</text><view class="row"><text class="sub">{{phone}}</text><view class="arrow"></view></view></view>
  <view class="cell cell-last" bindtap="clearAll"><text class="danger">清除本地数据</text><view class="arrow"></view></view>
</view>
<text class="foot sub">禾味食堂 · 营业时间 10:30-14:00 / 17:00-20:30</text>
<view class="tab-space"></view>
