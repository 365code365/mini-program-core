.head { background: linear-gradient(160deg, #ff7a3a, #ff9f45); padding: 40rpx 32rpx 32rpx 32rpx; }
.avatar { width: 112rpx; height: 112rpx; border-radius: 56rpx; background: #ffffff; display: flex; flex-direction: row; align-items: center; justify-content: center; margin-right: 24rpx; }
.avatar-t { font-size: 48rpx; color: #ff6a2b; font-weight: bold; }
.name { font-size: 36rpx; font-weight: bold; color: #ffffff; }
.head-s { font-size: 24rpx; color: rgba(255,255,255,0.88); margin-top: 6rpx; }
.wallet { margin-top: 32rpx; background: #ffffff; border-radius: 20rpx; padding: 28rpx; display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.bal { font-size: 52rpx; font-weight: bold; color: #1f2329; margin-top: 6rpx; }
.rc-btn { width: 160rpx; height: 68rpx; font-size: 28rpx; }
.stats { display: flex; flex-direction: row; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-v { font-size: 36rpx; font-weight: bold; margin-bottom: 6rpx; white-space: nowrap; }
.cell { height: 96rpx; display: flex; flex-direction: row; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #f5f6f8; }
.arrow { width: 14rpx; height: 14rpx; border-top: 3rpx solid #b4b8bf; border-right: 3rpx solid #b4b8bf; transform: rotate(45deg); margin-left: 12rpx; }
.danger { color: #f5222d; }
.foot { display: block; text-align: center; margin-top: 40rpx; }
.cell-last { border-bottom: 0; }
.wallet-info { flex: 1; }
.tab-space { height: 140rpx; }
