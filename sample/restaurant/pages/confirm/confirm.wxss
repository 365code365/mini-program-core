.table-card { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.tno { font-size: 48rpx; font-weight: bold; color: #ff6a2b; margin-top: 4rpx; }
.seg { display: flex; flex-direction: row; background: #f5f6f8; border-radius: 32rpx; padding: 6rpx; }
.seg-i { width: 120rpx; height: 60rpx; border-radius: 30rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; font-size: 26rpx; color: #5c6370; }
.seg-on { background: #ff6a2b; color: #ffffff; font-weight: bold; }
.it { display: flex; flex-direction: row; align-items: center; margin-top: 28rpx; }
.it-thumb { width: 88rpx; height: 88rpx; border-radius: 12rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.it-thumb-t { color: #ffffff; font-size: 36rpx; font-weight: bold; }
.it-info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; }
.it-name { font-size: 28rpx; font-weight: bold; }
.it-qty { width: 60rpx; }
.it-price { width: 120rpx; text-align: right; font-size: 28rpx; font-weight: bold; white-space: nowrap; }
.line { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-top: 24rpx; }
.total { border-top: 1rpx solid #f0f1f3; padding-top: 24rpx; }
.total-p { font-size: 36rpx; }
.minus-tag { background: #ff4d1a; color: #ffffff; font-size: 20rpx; border-radius: 6rpx; padding: 0 8rpx; margin-right: 10rpx; }
.clr { margin-left: 20rpx; color: #ff6a2b; }
.remark { width: 100%; height: 160rpx; background: #f5f6f8; border-radius: 16rpx; padding: 20rpx; margin-top: 20rpx; font-size: 28rpx; box-sizing: border-box; }
.tags { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 8rpx; }
.tag { padding: 10rpx 22rpx; border-radius: 28rpx; border: 2rpx solid #e3e5e8; font-size: 24rpx; color: #5c6370; margin: 16rpx 16rpx 0 0; }
.tag-on { border-color: #ff6a2b; color: #ff6a2b; background: #fff1ea; }
.ware-sub { margin-top: 6rpx; }
.space { height: 200rpx; }
.bottom {
  position: fixed; left: 0; right: 0; bottom: 0; height: 120rpx; background: #ffffff; padding: 0 32rpx;
  display: flex; flex-direction: row; align-items: center; justify-content: space-between; border-top: 1rpx solid #eeeff1;
  padding-bottom: env(safe-area-inset-bottom);
}
.bottom-p { font-size: 40rpx; }
.submit { width: 260rpx; height: 84rpx; }
