.page { padding-bottom: 40rpx; }
.hero {
  background: linear-gradient(160deg, #ff7a3a, #ff9f45);
  padding: 32rpx 32rpx 36rpx 32rpx;
  border-radius: 0 0 40rpx 40rpx;
}
.hero-title { font-size: 38rpx; font-weight: bold; color: #ffffff; }
.hero-sub { font-size: 24rpx; color: rgba(255,255,255,0.85); margin-top: 8rpx; }
.hero-badge { background: rgba(255,255,255,0.25); border-radius: 24rpx; padding: 8rpx 20rpx; }
.hero-badge-t { color: #ffffff; font-size: 24rpx; }
.seat-card {
  display: flex; flex-direction: row; align-items: center; justify-content: space-between;
  background: #ffffff; border-radius: 20rpx; padding: 24rpx 28rpx; margin-top: 28rpx;
}
.seat-no { font-size: 44rpx; font-weight: bold; color: #ff6a2b; margin-top: 4rpx; }
.seat-go { width: 200rpx; height: 68rpx; font-size: 26rpx; }
.scan-btn {
  display: flex; flex-direction: row; align-items: center;
  background: rgba(255,255,255,0.18); border-radius: 20rpx; padding: 28rpx; margin-top: 24rpx;
}
.scan-frame { position: relative; width: 96rpx; height: 96rpx; margin-right: 28rpx; }
.corner { position: absolute; width: 24rpx; height: 24rpx; border-color: #ffffff; border-style: solid; border-width: 0; }
.c1 { left: 0; top: 0; border-left-width: 6rpx; border-top-width: 6rpx; }
.c2 { right: 0; top: 0; border-right-width: 6rpx; border-top-width: 6rpx; }
.c3 { left: 0; bottom: 0; border-left-width: 6rpx; border-bottom-width: 6rpx; }
.c4 { right: 0; bottom: 0; border-right-width: 6rpx; border-bottom-width: 6rpx; }
.scan-dot { position: absolute; left: 30rpx; top: 30rpx; width: 36rpx; height: 36rpx; border-radius: 8rpx; background: #ffffff; }
.scan-t { font-size: 34rpx; font-weight: bold; color: #ffffff; }
.scan-s { font-size: 24rpx; color: rgba(255,255,255,0.85); margin-top: 6rpx; }
.input-row { display: flex; flex-direction: row; align-items: center; margin-top: 24rpx; }
.input {
  flex: 1; height: 84rpx; background: #f5f6f8; border-radius: 16rpx; padding: 0 24rpx;
  font-size: 32rpx; letter-spacing: 4rpx;
}
.small-btn { width: 140rpx; height: 84rpx; border-radius: 16rpx; margin-left: 20rpx; font-size: 28rpx; }
.error { display: block; color: #f5222d; font-size: 24rpx; margin-top: 16rpx; }
.tip { display: block; margin-top: 16rpx; }
.legend { align-items: center; }
.lg { width: 20rpx; height: 20rpx; border-radius: 6rpx; margin-left: 16rpx; margin-right: 8rpx; }
.lg-free { background: #ffffff; border: 2rpx solid #d9dce1; }
.lg-busy { background: #e9eaed; }
.zones { display: flex; flex-direction: row; margin-top: 24rpx; }
.zone {
  padding: 12rpx 28rpx; border-radius: 32rpx; background: #f5f6f8; margin-right: 16rpx;
  font-size: 26rpx; color: #5c6370;
}
.zone-on { background: #fff1ea; color: #ff6a2b; font-weight: bold; }
.grid { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 20rpx; }
.tb {
  width: 146rpx; height: 108rpx; margin: 8rpx 6rpx; border-radius: 16rpx; border: 2rpx solid #e3e5e8;
  display: flex; flex-direction: column; align-items: center; justify-content: center; background: #ffffff;
}
.tb-busy { background: #f0f1f3; border-color: #f0f1f3; }
.tb-on { border-color: #ff6a2b; background: #fff1ea; }
.tb-code { font-size: 30rpx; font-weight: bold; color: #1f2329; }
.tb-busy .tb-code { color: #b4b8bf; }
.tb-on .tb-code { color: #ff6a2b; }
.tb-seat { font-size: 22rpx; color: #8a8f99; margin-top: 4rpx; }
.foot-space { height: 260rpx; }
.bottom {
  position: fixed; left: 0; right: 0; bottom: 100rpx; padding: 20rpx 32rpx;
  background: #ffffff; border-top: 1rpx solid #eeeff1;
}
.scan-layer {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(10, 12, 16, 0.92);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.scan-box { position: relative; width: 460rpx; height: 460rpx; }
.scan-box .corner { width: 60rpx; height: 60rpx; border-color: #ff8a3d; }
.scan-line {
  position: absolute; left: 20rpx; right: 20rpx; top: 20rpx; height: 6rpx; border-radius: 3rpx;
  background: linear-gradient(90deg, rgba(255,138,61,0), #ff8a3d, rgba(255,138,61,0));
  animation: sweep 1.6s ease-in-out infinite;
}
@keyframes sweep { 0% { top: 20rpx; } 50% { top: 430rpx; } 100% { top: 20rpx; } }
.scan-hint { color: #ffffff; font-size: 28rpx; margin-top: 48rpx; }
.scan-cancel {
  margin-top: 60rpx; padding: 16rpx 64rpx; border-radius: 40rpx; border: 2rpx solid rgba(255,255,255,0.6);
  color: #ffffff; font-size: 28rpx;
}
