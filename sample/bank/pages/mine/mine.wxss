.top { background: linear-gradient(160deg, #F0534A, #C8162E); padding: 40rpx 32rpx 36rpx; margin-bottom: 20rpx; }
.avatar { width: 104rpx; height: 104rpx; border-radius: 52rpx; background: #fff; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.avatar-t { color: #C8162E; font-size: 44rpx; font-weight: bold; }
.who { margin-left: 24rpx; }
.who-n { color: #fff; font-size: 34rpx; font-weight: bold; margin-bottom: 10rpx; }
.lv { color: #8a5a00; background: linear-gradient(90deg, #FFE7A3, #F6C95B); font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 6rpx; margin-right: 12rpx; }
.who-s { color: rgba(255, 255, 255, 0.85); font-size: 22rpx; }
.stats { margin-top: 36rpx; }
.st-v { color: #fff; font-size: 34rpx; font-weight: bold; }
.st-k { color: rgba(255, 255, 255, 0.8); font-size: 22rpx; margin-top: 4rpx; }
.st-n { width: 130rpx; }
.head { margin-bottom: 8rpx; }
.h { padding: 22rpx 0; border-bottom: 1rpx solid #f1f2f4; }
.h-n { font-size: 28rpx; font-weight: bold; margin-bottom: 4rpx; }
.h-r { align-items: flex-end; }
.h-v { font-size: 28rpx; font-weight: bold; }
.h-inc { font-size: 22rpx; color: #E8541E; margin-top: 4rpx; }
.none { padding: 32rpx 0 12rpx; text-align: center; }
.item { padding: 26rpx 0; border-bottom: 1rpx solid #f1f2f4; }
.item-last { border-bottom: 0; }
.item-t { font-size: 28rpx; margin-bottom: 4rpx; }
.sbtn { background: #D7263D; border-radius: 28rpx; padding: 10rpx 24rpx; }
.sbtn-off { background: #e5e7eb; }
.sbtn-t { color: #fff; font-size: 24rpx; }
.ver { display: block; text-align: center; color: #b5b9c0; font-size: 22rpx; margin-top: 12rpx; }
