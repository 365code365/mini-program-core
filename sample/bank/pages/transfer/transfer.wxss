.payer { margin-top: 20rpx; }
.lock-bar { background: #fff4e5; padding: 18rpx 32rpx; }
.lock-t { color: #c2410c; font-size: 24rpx; }
.payer-mid { margin-left: 20rpx; }
.payer-name { font-size: 30rpx; font-weight: bold; margin-bottom: 4rpx; }
.link { padding: 6rpx 0 6rpx 20rpx; }
.chev-red { border-color: #D7263D; }
.recent { margin-top: 20rpx; white-space: nowrap; }
.recent-row { padding-bottom: 4rpx; }
.chip { padding: 10rpx 22rpx; border-radius: 28rpx; background: #f4f5f7; margin-right: 16rpx; border: 2rpx solid #f4f5f7; }
.chip-on { background: #fdecee; border-color: #D7263D; }
.chip-t { font-size: 24rpx; color: #374151; white-space: nowrap; }
.field { height: 100rpx; border-bottom: 1rpx solid #f1f2f4; }
.field-last { border-bottom: 0; }
.label { width: 120rpx; font-size: 28rpx; color: #374151; }
.ipt { font-size: 30rpx; height: 100rpx; }
.ipt-card { letter-spacing: 1rpx; }
.ph { color: #b5b9c0; font-size: 30rpx; }
.val { color: #1f2329; font-size: 30rpx; }
.err { display: block; color: #D7263D; font-size: 22rpx; margin: 4rpx 0 8rpx 120rpx; }
.clear { width: 40rpx; height: 40rpx; border-radius: 20rpx; background: #d1d5db; position: relative; margin-left: 12rpx; }
.x1, .x2 { position: absolute; left: 10rpx; top: 18rpx; width: 20rpx; height: 4rpx; background: #fff; border-radius: 2rpx; }
.x1 { transform: rotate(45deg); }
.x2 { transform: rotate(-45deg); }
.amt-row { margin-top: 24rpx; height: 110rpx; border-bottom: 1rpx solid #f1f2f4; }
.yen { font-size: 52rpx; font-weight: bold; margin-right: 12rpx; }
.amt-ipt { font-size: 56rpx; font-weight: bold; height: 110rpx; }
.upper-box { background: #fdf6f6; border-radius: 12rpx; padding: 14rpx 20rpx; margin-top: 16rpx; }
.upper { color: #b91c1c; font-size: 26rpx; }
.quick { margin-top: 20rpx; }
.q { padding: 8rpx 26rpx; border: 2rpx solid #e5e7eb; border-radius: 24rpx; margin-right: 16rpx; }
.q-t { font-size: 24rpx; color: #4b5563; }
.remark { margin-top: 12rpx; border-top: 1rpx solid #f1f2f4; }
.submit-wrap { padding: 20rpx 32rpx 60rpx; }
.tip { display: block; text-align: center; color: #9aa0a6; font-size: 22rpx; margin-top: 20rpx; }

.pad { position: absolute; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 24rpx 24rpx 0 0; padding-bottom: env(safe-area-inset-bottom); }
.pad-head { height: 100rpx; padding: 0 24rpx; }
.pad-close { width: 48rpx; height: 48rpx; position: relative; }
.x-dark { background: #6b7280; left: 8rpx; top: 22rpx; width: 32rpx; }
.pad-title { text-align: center; font-size: 32rpx; font-weight: bold; }
.pad-amt { display: block; text-align: center; font-size: 56rpx; font-weight: bold; margin-top: 8rpx; }
.pad-to { display: block; text-align: center; margin-top: 8rpx; }
.boxes { margin: 36rpx 48rpx 0; border: 2rpx solid #d1d5db; border-radius: 12rpx; height: 96rpx; }
.box { flex: 1; height: 96rpx; border-right: 2rpx solid #e5e7eb; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.dot { width: 24rpx; height: 24rpx; border-radius: 12rpx; background: #1f2329; }
.shake { animation: shake 0.4s linear; }
@keyframes shake {
  0% { transform: translateX(0); }
  20% { transform: translateX(-16rpx); }
  40% { transform: translateX(16rpx); }
  60% { transform: translateX(-10rpx); }
  80% { transform: translateX(10rpx); }
  100% { transform: translateX(0); }
}
.pad-err { display: block; text-align: center; color: #D7263D; font-size: 24rpx; margin: 20rpx 0 28rpx; }
.pad-hint { display: block; text-align: center; color: #9aa0a6; font-size: 24rpx; margin: 20rpx 0 28rpx; }
.keys { display: flex; flex-direction: row; flex-wrap: wrap; background: #f1f2f4; border-top: 1rpx solid #e5e7eb; }
.key { width: 33.33%; height: 108rpx; background: #fff; border-right: 1rpx solid #e5e7eb; border-bottom: 1rpx solid #e5e7eb; display: flex; flex-direction: row; align-items: center; justify-content: center; box-sizing: border-box; }
.key-blank, .key-fn { background: #f1f2f4; }
.key-down { background: #e5e7eb; }
.key-t { font-size: 44rpx; color: #1f2329; }
.del { width: 56rpx; height: 36rpx; border: 3rpx solid #374151; border-radius: 6rpx; position: relative; }
.del-x1, .del-x2 { position: absolute; left: 16rpx; top: 15rpx; width: 22rpx; height: 3rpx; background: #374151; }
.del-x1 { transform: rotate(45deg); }
.del-x2 { transform: rotate(-45deg); }
