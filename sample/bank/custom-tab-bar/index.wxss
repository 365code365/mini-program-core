.tab-bar { display: flex; flex-direction: row; height: 100rpx; padding-bottom: env(safe-area-inset-bottom); background: #ffffff; border-top: 1rpx solid #eeeff1; }
.tab-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.tab-icon { width: 48rpx; height: 48rpx; }
.tab-text { font-size: 20rpx; margin-top: 4rpx; }
