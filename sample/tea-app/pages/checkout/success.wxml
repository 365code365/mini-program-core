<scroll-view scroll-y="true" style="{{'--status-bar-height:' + w + ';' + (virtualHostStyle || '')}}" enable-flex="true" enhanced="true" id="{{v}}" change:eS="{{uV.sS}}" eS="{{$eS[v]}}" change:eA="{{uV.sA}}" eA="{{$eA[v]}}" class="{{['page', x]}}" hidden="{{virtualHostHidden || false}}"><view class="top"><view class="check"><image class="check-t" src="{{a}}"></image></view><text class="title">认养成功</text><text class="sub">您已成为「{{b}}」的茶园主</text></view><view class="cert"><view class="cert-head"><text class="cert-title">数字认养证</text><text class="cert-no">编号 {{c}}</text></view><view class="cert-body"><view class="kv"><text class="k">认养茶园</text><text class="v">{{d}}</text></view><view class="kv"><text class="k">认养份额</text><text class="v">{{e}} 份（约 {{f}}g/年）</text></view><view class="kv"><text class="k">认养周期</text><text class="v">1 年</text></view><view class="kv"><text class="k">订单编号</text><text class="v">{{g}}</text></view></view><view class="hash"><text class="hash-t">区块链哈希：0x{{h}}…（已存证）</text></view><image wx:if="{{i}}" class="cert-png" src="{{j}}" mode="widthFix" bindtap="{{k}}"></image><text wx:if="{{l}}" class="cert-tip">点击放大 · 可长按保存数字认养证</text></view><text class="sec">填写挂牌信息</text><view wx:if="{{m}}" class="form"><text class="label">挂牌昵称</text><input class="input" placeholder="将刻于您的专属木牌" value="{{n}}" bindinput="{{o}}"/><text class="label">寄语</text><block wx:if="{{r0}}"><textarea class="textarea" placeholder="留一句话，与这棵树一同生长" value="{{p}}" bindinput="{{q}}"></textarea></block><view class="{{['btn', r]}}" bindtap="{{s}}"><text class="btn-t">提交挂牌信息</text></view></view><view wx:else class="done"><text class="done-t">挂牌信息已提交</text><text class="done-sub">基地将在 7 日内完成挂牌并上传 3 张实拍照片</text><view class="btn" bindtap="{{t}}"><text class="btn-t">前往我的茶园</text></view></view><view style="height:40rpx"></view></scroll-view><wxs src="/common/uniView.wxs" module="uV"/>
