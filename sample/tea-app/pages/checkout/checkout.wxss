@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}
/* 凤凰云岫设计令牌：参考稿的暖米白、茶褐、低饱和金与书卷感排版 */
/* 字体栈第一位必须是 App.uvue 里 loadFontFace 注册过的 family，否则安卓机没有本机宋体，
   会整站掉到系统黑体。Yunxiu Serif = Noto Serif SC Regular(正文)，Source Han Serif SC = Heavy(标题)。 */
.page {
  flex: 1;
  background-color: #f7f3ec;
}
.scroll {
  flex: 1;
}
.card {
  background-color: #ffffff;
  border-radius: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
}
.g-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #4a3020;
}
.g-meta {
  font-size: 24rpx;
  color: #8a8478;
  margin-top: 8rpx;
}
.line {
  height: 2rpx;
  background-color: rgba(0, 0, 0, 0.08);
  margin: 20rpx 0;
}
.kv {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0;
}
.k {
  font-size: 28rpx;
  color: #5a5248;
}
.k-strong {
  font-size: 28rpx;
  color: #4a3020;
}
.v {
  font-size: 28rpx;
  color: #4a3020;
}
.v-red {
  font-size: 28rpx;
  color: #c0392b;
}
.v-gold {
  font-size: 36rpx;
  font-weight: bold;
  color: #a87536;
}
.agree {
  flex-direction: row;
  align-items: flex-start;
}
.cb {
  width: 38rpx;
  height: 38rpx;
  border-radius: 19rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.25);
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
}
.cb-on {
  background-color: #a87536;
  border-color: #a87536;
}
.cb-t {
  width: 24rpx;
  height: 24rpx;
}
.agree-t {
  flex: 1;
  font-size: 28rpx;
  color: #5a5248;
  margin-left: 16rpx;
  line-height: 42rpx;
}
.link {
  color: #a87536;
}
.pay-title {
  font-size: 22rpx;
  color: #82786c;
}
.pay-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}
.pay-left {
  flex-direction: column;
  flex: 1;
}
.pay-t {
  font-size: 28rpx;
  color: #5a5248;
}
.pay-hint {
  font-size: 22rpx;
  color: #a87536;
  margin-top: 6rpx;
}
.pay-v {
  font-size: 28rpx;
  color: #4a3020;
}
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: #ffffff;
  padding: 20rpx 32rpx;
  border-top: 2rpx solid rgba(0, 0, 0, 0.05);
}
.bar-left {
  flex-direction: column;
}
.bar-label {
  font-size: 22rpx;
  color: #82786c;
}
.bar-total {
  font-size: 44rpx;
  font-weight: bold;
  color: #a87536;
}
.btn {
  background-color: #a87536;
  border-radius: 44rpx;
  padding: 22rpx 64rpx;
}
.btn-off {
  opacity: 0.4;
}
.btn-t {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
}
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  justify-content: flex-end;
}
.sheet {
  background-color: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  max-height: 80%;
}
.sheet-head {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.05);
}
.sheet-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4a3020;
}
.sheet-x {
  width: 36rpx;
  height: 36rpx;
}
.sheet-body {
  padding: 28rpx;
  max-height: 700rpx;
}
.ag-h {
  font-size: 28rpx;
  font-weight: bold;
  color: #4a3020;
  margin-top: 16rpx;
}
.ag-p {
  font-size: 26rpx;
  color: #5a5248;
  line-height: 42rpx;
  margin-top: 8rpx;
}
.sheet-foot {
  padding: 24rpx 28rpx;
}
.sheet-ok {
  background-color: #a87536;
  border-radius: 44rpx;
  padding: 22rpx 0;
  align-items: center;
}