@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}
/* 凤凰云岫设计令牌：参考稿的暖米白、茶褐、低饱和金与书卷感排版 */
.page {
  flex: 1;
  background-color: #f7f3ec;
}
.balance {
  background-color: #536254;
  border-radius: 24rpx;
  margin: 24rpx;
  padding: 32rpx;
}
.balance-k {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}
.balance-v {
  font-size: 56rpx;
  font-weight: bold;
  color: #ffffff;
  margin-top: 8rpx;
}
.sec {
  font-size: 32rpx;
  font-weight: bold;
  color: #4a3020;
  margin: 16rpx 32rpx;
}
.grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx;
}
.cell {
  width: 218rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 0;
  align-items: center;
  margin-bottom: 20rpx;
  border: 2rpx solid #ffffff;
}
.cell-on {
  background-color: rgba(199, 154, 82, 0.1);
  border-color: #c5a46d;
}
.cell-amt {
  font-size: 40rpx;
  font-weight: bold;
  color: #4a3020;
}
.cell-bonus {
  font-size: 20rpx;
  color: #a87536;
  margin-top: 8rpx;
}
.tip {
  font-size: 22rpx;
  color: #82786c;
  margin: 0 32rpx;
}
.custom-box {
  flex-direction: row;
  align-items: center;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin: 0 24rpx 8rpx;
  padding: 8rpx 28rpx;
  border: 2rpx solid #c5a46d;
}
.custom-cny {
  font-size: 40rpx;
  font-weight: bold;
  color: #4a3020;
  margin-right: 12rpx;
}
.custom-input {
  flex: 1;
  height: 88rpx;
  font-size: 40rpx;
  font-weight: bold;
  color: #4a3020;
}
.custom-ph {
  color: #82786c;
  font-size: 28rpx;
  font-weight: normal;
}
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: #ffffff;
  padding: 20rpx 32rpx;
  border-top: 2rpx solid rgba(0, 0, 0, 0.05);
}
.bar-left {
  flex-direction: column;
}
.bar-label {
  font-size: 22rpx;
  color: #82786c;
}
.bar-total {
  font-size: 44rpx;
  font-weight: bold;
  color: #a87536;
}
.btn {
  background-color: #a87536;
  border-radius: 44rpx;
  padding: 22rpx 56rpx;
}
.btn-off {
  opacity: 0.5;
}
.btn-t {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
}