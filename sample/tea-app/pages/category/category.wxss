@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}
/* 凤凰云岫设计令牌：参考稿的暖米白、茶褐、低饱和金与书卷感排版 */
/* 字体栈第一位必须是 App.uvue 里 loadFontFace 注册过的 family，否则安卓机没有本机宋体，
   会整站掉到系统黑体。Yunxiu Serif = Noto Serif SC Regular(正文)，Source Han Serif SC = Heavy(标题)。 */
.root {
  flex: 1;
  background-color: #f7f3ec;
}
.page {
  flex: 1;
  background-color: #f7f3ec;
}
.brand-cn, .tea-name {
  font-family: "Source Han Serif SC", "Yunxiu Serif", "Songti SC", "STSong", "Noto Serif CJK SC", serif;
}
.brand-en {
  font-family: "Playfair Display", "Times New Roman", serif;
}
.header {
  padding-left: 34rpx;
  padding-right: 34rpx;
  padding-bottom: 22rpx;
  position: relative;
  overflow: hidden;
}
.header-mountain {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  width: 100%;
  height: 230rpx;
  opacity: 0.1;
}
.back {
  position: absolute;
  left: 22rpx;
  z-index: 2;
  width: 58rpx;
  height: 58rpx;
  border-radius: 30rpx;
  border: 2rpx solid rgba(139, 108, 68, 0.22);
  background-color: rgba(255, 255, 255, 0.6);
  align-items: center;
  justify-content: center;
}
.back-icon {
  color: #4a3020;
  font-size: 43rpx;
  line-height: 48rpx;
  margin-top: -5rpx;
}
.brand {
  position: relative;
  z-index: 1;
  align-items: center;
  justify-content: center;
  padding-bottom: 28rpx;
}
.brand-cn {
  font-size: 43rpx;
  font-weight: 900;
  color: #4a3020;
  letter-spacing: 8rpx;
  font-family: "Source Han Serif SC", "Yunxiu Serif", "Songti SC", "STSong", "Noto Serif CJK SC", serif;
}
.brand-en {
  font-size: 14rpx;
  color: #8d795c;
  letter-spacing: 5rpx;
  margin-top: 3rpx;
  font-family: "Playfair Display", "Times New Roman", serif;
}
.search {
  position: relative;
  z-index: 1;
  height: 72rpx;
  border-radius: 37rpx;
  border: 2rpx solid rgba(166, 136, 94, 0.22);
  background-color: rgba(255, 255, 255, 0.5);
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
}
.search-icon {
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
}
.search-input {
  flex: 1;
  color: #2d251e;
  font-size: 24rpx;
}
.catalog {
  flex-direction: row;
  align-items: flex-start;
  padding-left: 8rpx;
  padding-right: 10rpx;
}
.side-nav {
  width: 178rpx;
  min-height: 696rpx;
  border-radius: 0 12rpx 12rpx 0;
  background-color: rgba(255, 255, 255, 0.5);
  overflow: hidden;
}
.side-item {
  height: 112rpx;
  flex-direction: row;
  align-items: center;
  padding-left: 23rpx;
  position: relative;
}
.side-item-on {
  background-color: #f1e8dc;
}
.side-line {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 7rpx;
  background-color: #9d7645;
}
.side-icon {
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
}
.side-text {
  color: #655e55;
  font-size: 23rpx;
}
.side-text-on {
  color: #896637;
  font-weight: 900;
}
.card-list {
  flex: 1;
  margin-left: 18rpx;
}
.tea-card {
  height: 162rpx;
  border-radius: 17rpx;
  overflow: hidden;
  position: relative;
  background-color: #eae4da;
  margin-bottom: 12rpx;
  border: 2rpx solid rgba(158, 127, 83, 0.1);
}
.tea-image {
  position: absolute;
  width: 100%;
  height: 100%;
}
.tea-wash {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 57%;
  background-color: #f8f5ef;
}
.tea-fade {
  position: absolute;
  left: 57%;
  top: 0;
  bottom: 0;
  width: 20%;
  background-color: rgba(248, 245, 239, 0.55);
}
.tea-copy {
  position: absolute;
  left: 36rpx;
  top: 22rpx;
  right: 12rpx;
}
.tea-name {
  color: #2d2924;
  font-size: 37rpx;
  line-height: 45rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}
.tea-sub {
  color: #696259;
  font-size: 20rpx;
  margin-top: 4rpx;
}
.tea-arrow {
  width: 38rpx;
  height: 38rpx;
  border-radius: 20rpx;
  border: 2rpx solid #ad8c5d;
  align-items: center;
  justify-content: center;
  margin-top: 11rpx;
}
.tea-arrow-text {
  color: #967446;
  font-size: 23rpx;
}
.trust {
  margin: 56rpx 24rpx 0 90rpx;
  height: 132rpx;
  border: 2rpx solid rgba(158, 127, 83, 0.12);
  border-radius: 18rpx;
  background-color: rgba(255, 255, 255, 0.46);
  flex-direction: row;
  align-items: center;
  padding: 0;
}
.trust-item {
  flex: 1;
  height: 94rpx;
  align-items: center;
  justify-content: center;
  border-right: 2rpx solid rgba(141, 120, 90, 0.1);
}
.trust-icon {
  width: 38rpx;
  height: 38rpx;
}
.trust-title {
  color: #6e5c43;
  font-size: 19rpx;
  margin-top: 5rpx;
}
.trust-sub {
  color: #82786c;
  font-size: 15rpx;
  margin-top: 1rpx;
}
.tabbar-space {
  height: calc(164rpx + env(safe-area-inset-bottom));
}