<scroll-view scroll-y="true" style="{{'--status-bar-height:' + K + ';' + (virtualHostStyle || '')}}" enable-flex="true" enhanced="true" id="{{J}}" change:eS="{{uV.sS}}" eS="{{$eS[J]}}" change:eA="{{uV.sA}}" eA="{{$eA[J]}}" class="{{['page', L]}}" hidden="{{virtualHostHidden || false}}"><view class="summary-card"><view class="summary-icon"><image class="summary-img" src="{{a}}"></image></view><view class="summary-copy"><text class="summary-label">根据你的需求</text><text class="summary">{{b}}</text></view></view><view class="think"><view class="think-head" bindtap="{{e}}"><image class="think-icon" src="{{c}}"></image><text class="think-title">选茶师的思考过程</text><text class="think-toggle">{{d}}</text></view><view wx:if="{{f}}" class="think-body"><view class="step"><view class="dot dot-done"></view><view class="step-copy"><text class="step-name">读懂你的需求</text><text wx:if="{{g}}" class="step-text">你说：{{h}}</text><view class="chips"><text wx:for="{{i}}" wx:for-item="item" wx:key="b" class="chip">{{item.a}}</text></view></view></view><view class="step"><view class="{{['dot', j]}}"></view><view class="step-copy"><text class="step-name">在在售好茶里筛选</text><text class="step-text">按香型、饮茶阶段与场景关键词检索在售商品，再按你的预算过滤。</text><text class="step-text">选茶规则：{{k}}</text></view></view><view class="step"><view class="{{['dot', l]}}"></view><view class="step-copy"><text class="step-name">排序与取舍</text><text wx:if="{{m}}" class="step-text">等筛选结果出来后给出排序理由。</text><text wx:elif="{{n}}" class="step-text">这一轮没有匹配到合适的在售商品。</text><text wx:else class="step-text">按契合度选出 {{o}} 款，排序如下。</text><text wx:if="{{p}}" class="step-text">共同理由：{{q}}</text><view wx:for="{{r}}" wx:for-item="item" wx:key="e" class="rank-line"><text class="rank-no">第{{item.a}}位</text><text wx:if="{{s}}" class="rank-why">{{item.b}}</text><text wx:else class="rank-why">{{item.c}} — {{item.d}}</text></view><text wx:if="{{t}}" class="step-text step-caveat">保留意见：{{v}}</text></view></view></view></view><view wx:if="{{w}}" class="loading"><view class="loading-dot"></view><text class="loading-text">正在从当前在售好茶中认真筛选…</text></view><view wx:elif="{{x}}" class="empty"><text class="empty-title">暂时没有匹配到合适商品</text><text class="empty-desc">可以换一种需求描述，或请人工选茶师帮你挑选。</text><view class="retry" bindtap="{{y}}"><text class="retry-text">重新推荐</text></view></view><view wx:else class="results"><view wx:for="{{z}}" wx:for-item="item" wx:key="l" class="product"><view class="main-row"><image class="product-image" src="{{item.a}}" mode="aspectFill"></image><view class="product-mid"><view class="name-row"><text class="product-name">{{item.b}}</text><view class="rank"><text class="rank-t">{{item.c}}</text></view></view><text class="product-sub">{{item.d}}</text><view class="detail-row"><image class="detail-icon" src="{{A}}"></image><view class="detail-copy"><text class="detail-title">适合谁</text><text class="detail-text">{{item.e}}</text></view></view><view class="detail-row"><image class="detail-icon" src="{{B}}"></image><view class="detail-copy"><text class="detail-title">为什么推荐</text><text class="detail-text">{{item.f}}</text></view></view><view class="detail-row"><image class="detail-icon" src="{{C}}"></image><view class="detail-copy"><text class="detail-title">不一定适合谁</text><text class="detail-text">{{item.g}}</text></view></view></view><view class="actions"><view class="primary-btn" bindtap="{{item.h}}"><text class="primary-text">查看商品 ›</text></view><view class="ghost-btn" bindtap="{{item.i}}"><text class="ghost-text">咨询选茶师</text></view></view></view><view wx:if="{{item.j}}" class="tags"><text class="taste-label">口感关键词</text><text wx:for="{{item.k}}" wx:for-item="tag" wx:key="b" class="tag">{{tag.a}}</text></view></view></view><view class="advice"><view class="advice-head"><image class="advice-leaf" src="{{D}}"></image><text class="advice-title">选茶建议</text></view><view class="tips"><view wx:for="{{E}}" wx:for-item="item" wx:key="d" class="tip"><image class="tip-icon" src="{{item.a}}"></image><text class="tip-title">{{item.b}}</text><text class="tip-desc">{{item.c}}</text></view></view><text wx:if="{{F}}" class="skill-tip">本次推荐已应用：{{G}}</text></view><view class="chat-more" bindtap="{{I}}"><image class="chat-more-icon" src="{{H}}"></image><text class="chat-more-text">有任何疑问，随时找我聊茶。</text></view><view class="bottom-space"></view></scroll-view><wxs src="/common/uniView.wxs" module="uV"/>
