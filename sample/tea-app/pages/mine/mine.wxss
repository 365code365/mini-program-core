@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}
/* 凤凰云岫设计令牌：参考稿的暖米白、茶褐、低饱和金与书卷感排版 */
/* 字体栈第一位必须是 App.uvue 里 loadFontFace 注册过的 family，否则安卓机没有本机宋体，
   会整站掉到系统黑体。Yunxiu Serif = Noto Serif SC Regular(正文)，Source Han Serif SC = Heavy(标题)。 */
.root, .page {
  flex: 1;
  background-color: #f7f3ec;
}
.nav-title, .profile-name, .orders-title, .dialog-title {
  font-family: "Source Han Serif SC", "Yunxiu Serif", "Songti SC", "STSong", "Noto Serif CJK SC", serif;
}
.nav {
  padding-bottom: 16rpx;
  align-items: center;
  justify-content: center;
}
.nav-title {
  color: #4a3020;
  font-size: 36rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
}
.profile-card {
  margin: 0 24rpx;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  background-color: #b7935e;
  flex-direction: row;
  align-items: center;
  padding: 0 28rpx;
}
.profile-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0.28;
}
.profile-tone {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(150, 116, 66, 0.72);
}
.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 60rpx;
  background-color: rgba(255, 250, 243, 0.9);
  border: 3rpx solid rgba(255, 255, 255, 0.6);
  align-items: center;
  justify-content: center;
}
.avatar-img {
  width: 56rpx;
  height: 56rpx;
}
.profile-copy {
  flex: 1;
  margin-left: 24rpx;
}
.profile-name {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 900;
}
.profile-sub {
  color: rgba(255, 255, 255, 0.86);
  font-size: 20rpx;
  margin-top: 8rpx;
}
.level {
  align-self: flex-start;
  margin-top: 14rpx;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  background-color: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  align-items: center;
  justify-content: center;
}
.level-text {
  color: #fff4df;
  font-size: 18rpx;
}
.profile-arrow {
  color: rgba(255, 255, 255, 0.9);
  font-size: 40rpx;
}
.orders {
  margin: 20rpx 24rpx 0;
  border-radius: 24rpx;
  background-color: #ffffff;
  padding: 24rpx 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(76, 52, 29, 0.06);
}
.orders-head {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.orders-title {
  color: #4a3020;
  font-size: 27rpx;
  font-weight: 900;
}
.orders-all {
  color: #82786c;
  font-size: 19rpx;
}
.order-types {
  flex-direction: row;
  margin-top: 24rpx;
}
.order-type {
  flex: 1;
  align-items: center;
}
.order-icon {
  width: 44rpx;
  height: 44rpx;
}
.order-label {
  color: #62564b;
  font-size: 20rpx;
  margin-top: 8rpx;
}
.services {
  margin: 20rpx 24rpx 0;
  border-radius: 24rpx;
  background-color: #ffffff;
  padding: 4rpx 22rpx;
}
.service {
  min-height: 88rpx;
  flex-direction: row;
  align-items: center;
  border-bottom: 2rpx solid rgba(90, 66, 40, 0.06);
}
.service-icon {
  width: 38rpx;
  height: 38rpx;
}
.service-name {
  flex: 1;
  color: #56493d;
  font-size: 25rpx;
  margin-left: 18rpx;
}
.service-arrow {
  color: #a59a8e;
  font-size: 32rpx;
}
.dual-row {
  flex-direction: row;
  justify-content: space-between;
  margin: 20rpx 24rpx 0;
}
.dual-card {
  width: 342rpx;
  height: 220rpx;
  border-radius: 22rpx;
  background-color: #f0e7d9;
  overflow: hidden;
}
.dual-copy {
  padding: 24rpx;
}
.dual-title {
  color: #4a3020;
  font-size: 27rpx;
  font-weight: 900;
  font-family: "Source Han Serif SC", "Yunxiu Serif", "Songti SC", "STSong", "Noto Serif CJK SC", serif;
}
.dual-desc {
  color: #82786c;
  font-size: 18rpx;
  line-height: 28rpx;
  margin-top: 8rpx;
}
.dual-btn {
  align-self: flex-start;
  margin-top: 16rpx;
  height: 48rpx;
  padding: 0 22rpx;
  border-radius: 25rpx;
  border: 2rpx solid rgba(139, 105, 58, 0.4);
  align-items: center;
  justify-content: center;
}
.dual-btn-text {
  color: #886537;
  font-size: 18rpx;
}
.promise-bar {
  flex-direction: row;
  margin: 20rpx 24rpx 0;
  padding: 22rpx 0;
  border-radius: 22rpx;
  background-color: rgba(255, 255, 255, 0.6);
}
.promise-item {
  flex: 1;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.promise-icon {
  width: 40rpx;
  height: 40rpx;
}
.promise-copy {
  margin-left: 10rpx;
}
.promise-name {
  color: #5c4936;
  font-size: 20rpx;
  font-weight: 900;
}
.promise-desc {
  color: #82786c;
  font-size: 15rpx;
  margin-top: 2rpx;
}
.asset-row {
  flex-direction: row;
  margin: 20rpx 24rpx 0;
  padding: 24rpx 0;
  border-radius: 22rpx;
  background-color: #eee4d6;
}
.asset {
  flex: 1;
  align-items: center;
}
.asset-value {
  color: #875f34;
  font-size: 30rpx;
  font-weight: 900;
}
.asset-label {
  color: #82786c;
  font-size: 19rpx;
  margin-top: 5rpx;
}
.logout {
  margin: 20rpx 24rpx 0;
  height: 76rpx;
  border-radius: 38rpx;
  border: 2rpx solid rgba(142, 104, 57, 0.2);
  align-items: center;
  justify-content: center;
}
.logout-text {
  color: #896941;
  font-size: 23rpx;
}
.footer {
  text-align: center;
  color: #aaa094;
  font-size: 18rpx;
  margin-top: 28rpx;
}
.mine-cards {
  flex-direction: row;
  justify-content: space-between;
  margin: 20rpx 24rpx 0;
}
.mcard {
  width: 336rpx;
  height: 210rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  background-color: #e9e1d5;
}
.mcard-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.mcard-wash {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(245, 240, 231, 0.62);
}
.mcard-copy {
  position: absolute;
  left: 22rpx;
  top: 22rpx;
  right: 18rpx;
  bottom: 20rpx;
}
.mcard-title {
  color: #4a3020;
  font-size: 28rpx;
  font-weight: 900;
  font-family: "Source Han Serif SC", "Yunxiu Serif", "Songti SC", "STSong", "Noto Serif CJK SC", serif;
}
.mcard-sub {
  color: #6d6053;
  font-size: 18rpx;
  line-height: 27rpx;
  margin-top: 8rpx;
}
.mcard-btn {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 48rpx;
  padding-left: 20rpx;
  padding-right: 20rpx;
  border-radius: 25rpx;
  border: 2rpx solid rgba(139, 105, 58, 0.42);
  align-items: center;
  justify-content: center;
}
.mcard-btn-t {
  color: #886537;
  font-size: 19rpx;
}
.mtrust {
  flex-direction: row;
  margin: 20rpx 24rpx 0;
  padding: 22rpx 0;
  border-radius: 20rpx;
  background-color: rgba(255, 255, 255, 0.6);
}
.mtrust-item {
  flex: 1;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.mtrust-icon {
  width: 34rpx;
  height: 34rpx;
}
.mtrust-copy {
  margin-left: 12rpx;
}
.mtrust-t {
  color: #5f5040;
  font-size: 20rpx;
  font-weight: 900;
}
.mtrust-s {
  color: #82786c;
  font-size: 15rpx;
  margin-top: 2rpx;
}
.bottom-space {
  height: calc(164rpx + env(safe-area-inset-bottom));
}
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background-color: rgba(0, 0, 0, 0.46);
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}
.dialog {
  width: 100%;
  border-radius: 26rpx;
  background-color: #ffffff;
  padding: 38rpx 32rpx;
  align-items: center;
}
.dialog-title {
  color: #4a3020;
  font-size: 31rpx;
  font-weight: 900;
}
.dialog-sub {
  color: #82786c;
  font-size: 20rpx;
  margin-top: 8rpx;
  text-align: center;
}
.qr {
  width: 280rpx;
  height: 280rpx;
  border: 2rpx dashed rgba(164, 125, 73, 0.4);
  border-radius: 18rpx;
  margin-top: 24rpx;
  align-items: center;
  justify-content: center;
}
.qr-real {
  width: 260rpx;
  height: 260rpx;
}
.qr-empty {
  align-items: center;
}
.qr-icon {
  width: 70rpx;
  height: 70rpx;
}
.qr-text {
  color: #82786c;
  font-size: 19rpx;
  margin-top: 12rpx;
}
.qr-tip {
  color: #82786c;
  font-size: 18rpx;
  margin-top: 14rpx;
}
.dialog-btn {
  width: 100%;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: #a87536;
  margin-top: 24rpx;
  align-items: center;
  justify-content: center;
}
.dialog-btn-text {
  color: #ffffff;
  font-size: 24rpx;
}