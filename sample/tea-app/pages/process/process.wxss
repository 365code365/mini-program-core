@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}
/* 凤凰云岫设计令牌：参考稿的暖米白、茶褐、低饱和金与书卷感排版 */
.page {
  flex: 1;
  background-color: #f7f3ec;
}
.head-wrap {
  position: relative;
  margin: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
}
.head-img {
  width: 100%;
  height: 300rpx;
}
.head-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx;
  background-color: rgba(0, 0, 0, 0.35);
}
.head-t {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}
.head-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
  font-family: "Playfair Display", serif;
}
.timeline {
  padding: 16rpx 32rpx;
}
.node {
  flex-direction: row;
  padding-bottom: 28rpx;
}
.num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background-color: #a87536;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.num-t {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
}
.node-body {
  flex: 1;
}
.node-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #4a3020;
}
.node-desc {
  font-size: 24rpx;
  color: #8a8478;
  margin-top: 4rpx;
}
.tip {
  font-size: 22rpx;
  color: #b3ad9f;
  text-align: center;
}