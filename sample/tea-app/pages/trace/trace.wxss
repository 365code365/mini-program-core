@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}
/* 凤凰云岫设计令牌：参考稿的暖米白、茶褐、低饱和金与书卷感排版 */
/* 字体栈第一位必须是 App.uvue 里 loadFontFace 注册过的 family，否则安卓机没有本机宋体，
   会整站掉到系统黑体。Yunxiu Serif = Noto Serif SC Regular(正文)，Source Han Serif SC = Heavy(标题)。 */
.page {
  flex: 1;
  background-color: #f7f3ec;
}
.head {
  background-color: #536254;
  border-radius: 24rpx;
  margin: 24rpx;
  padding: 32rpx;
}
.tag {
  background-color: rgba(199, 154, 82, 0.25);
  color: #f0d9a8;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  align-self: flex-start;
}
.name {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-top: 16rpx;
}
.batch {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 6rpx;
}
.env {
  flex-direction: row;
  margin-top: 28rpx;
}
.env-item {
  flex: 1;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 18rpx 0;
  align-items: center;
  margin: 0 6rpx;
}
.env-v {
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
}
.env-k {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 6rpx;
}
.env-src {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 16rpx;
}
.sec {
  font-size: 32rpx;
  font-weight: bold;
  color: #4a3020;
  margin: 16rpx 32rpx;
}
.timeline {
  padding: 0 32rpx;
}
.node {
  flex-direction: row;
  padding-bottom: 32rpx;
}
.dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
  border: 4rpx solid #c5a46d;
  background-color: #f7f3ec;
  margin-right: 24rpx;
  margin-top: 6rpx;
}
.node-body {
  flex: 1;
}
.node-date {
  font-size: 22rpx;
  color: #a87536;
}
.node-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #4a3020;
  margin-top: 4rpx;
}
.node-desc {
  font-size: 24rpx;
  color: #8a8478;
  margin-top: 4rpx;
}
.report {
  flex-direction: row;
  align-items: center;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin: 0 24rpx;
  padding: 24rpx;
}
.report-ic {
  width: 48rpx;
  height: 48rpx;
}
.report-info {
  flex: 1;
  margin-left: 16rpx;
}
.report-t {
  font-size: 28rpx;
  font-weight: bold;
  color: #4a3020;
}
.report-sub {
  font-size: 22rpx;
  color: #82786c;
  margin-top: 4rpx;
}
.report-arrow {
  font-size: 24rpx;
  color: #a87536;
}
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  justify-content: flex-end;
}
.sheet {
  background-color: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  max-height: 82%;
}
.sheet-head {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.05);
}
.sheet-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4a3020;
}
.sheet-x {
  width: 36rpx;
  height: 36rpx;
}
.sheet-body {
  padding: 28rpx;
}
.ok {
  flex-direction: row;
  align-items: center;
  background-color: rgba(47, 79, 79, 0.05);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.ok-ic {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background-color: #536254;
  align-items: center;
  justify-content: center;
}
.ok-t {
  width: 32rpx;
  height: 32rpx;
}
.ok-info {
  margin-left: 16rpx;
}
.ok-h {
  font-size: 28rpx;
  font-weight: bold;
  color: #536254;
}
.ok-sub {
  font-size: 22rpx;
  color: #82786c;
  margin-top: 4rpx;
}
.rrow {
  flex-direction: row;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.05);
}
.rk {
  font-size: 26rpx;
  color: #82786c;
}
.rv {
  font-size: 26rpx;
  color: #3a2c18;
}
.rnote {
  font-size: 20rpx;
  color: #b3ad9f;
  margin-top: 16rpx;
}