@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}
/* 凤凰云岫设计令牌：参考稿的暖米白、茶褐、低饱和金与书卷感排版 */
.root {
  flex: 1;
  background-color: #f7f3ec;
}
.page {
  flex: 1;
  background-color: #f7f3ec;
}
.bottom-space {
  height: calc(132rpx + env(safe-area-inset-bottom));
}
.grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 16rpx 24rpx;
}
.cell {
  width: 335rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.cell-img {
  width: 100%;
}
.cell-body {
  padding: 18rpx;
}
.cell-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #4a3020;
}
.cell-desc {
  font-size: 22rpx;
  color: #82786c;
  margin-top: 6rpx;
}
.cell-bottom {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}
.price-wrap {
  flex-direction: row;
  align-items: baseline;
}
.price {
  font-size: 30rpx;
  font-weight: bold;
  color: #a87536;
}
.ot {
  font-size: 22rpx;
  color: #82786c;
  margin-left: 10rpx;
  text-decoration: line-through;
}
.add {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background-color: #a87536;
  align-items: center;
  justify-content: center;
}
.add-t {
  color: #ffffff;
  font-size: 36rpx;
}
.sk-img {
  width: 100%;
  height: 240rpx;
  background-color: #eee9e0;
}
.sk-line {
  height: 26rpx;
  background-color: #eee9e0;
  border-radius: 8rpx;
  margin-top: 14rpx;
}
.sk-line.short {
  width: 50%;
}
.empty {
  align-items: center;
  padding: 120rpx 0;
}
.empty-t {
  font-size: 26rpx;
  color: #82786c;
}
.nomore {
  align-items: center;
  padding: 24rpx 0;
}
.nomore-t {
  font-size: 22rpx;
  color: #82786c;
}