@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}
/* 凤凰云岫设计令牌：参考稿的暖米白、茶褐、低饱和金与书卷感排版 */
/* 字体栈第一位必须是 App.uvue 里 loadFontFace 注册过的 family，否则安卓机没有本机宋体，
   会整站掉到系统黑体。Yunxiu Serif = Noto Serif SC Regular(正文)，Source Han Serif SC = Heavy(标题)。 */
.page, .scroll {
  flex: 1;
  background-color: #f7f3ec;
}
.cover-wrap {
  position: relative;
  width: 100%;
  height: 520rpx;
  background-color: #efe9df;
}

/* swiper 默认高度只有 150px，必须显式撑到与 cover-wrap 等高 */
.cover-swiper {
  width: 100%;
  height: 520rpx;
}
.cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.cover-wash {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 220rpx;
  background-color: rgba(247, 243, 236, 0.55);
}
.cover-copy {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  bottom: 34rpx;
}
.cover-title {
  color: #33261a;
  font-size: 38rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  font-family: "Source Han Serif SC", "Yunxiu Serif", "Songti SC", "STSong", "Noto Serif CJK SC", serif;
}
.cover-sub {
  color: #5c4e3f;
  font-size: 21rpx;
  margin-top: 8rpx;
}
.cover-pill {
  align-self: flex-start;
  height: 42rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(120, 92, 55, 0.34);
  background-color: rgba(255, 253, 248, 0.6);
  align-items: center;
  justify-content: center;
  margin-top: 14rpx;
}
.cover-pill-t {
  color: #6d5942;
  font-size: 18rpx;
}
.cover-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 12rpx;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.cdot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background-color: rgba(120, 95, 60, 0.28);
  margin-left: 5rpx;
  margin-right: 5rpx;
}
.cdot-on {
  width: 22rpx;
  background-color: #a8834e;
}
.body {
  padding: 28rpx 32rpx;
  background-color: #ffffff;
}
.name, .origin-title, .sec {
  font-family: "Source Han Serif SC", "Yunxiu Serif", "Songti SC", "STSong", "Noto Serif CJK SC", serif;
}
.name {
  font-size: 39rpx;
  font-weight: 900;
  color: #4a3020;
}
.subtitle {
  color: #82786c;
  font-size: 21rpx;
  margin-top: 7rpx;
}
.price-row {
  flex-direction: row;
  align-items: baseline;
  margin-top: 16rpx;
}
.price {
  font-size: 46rpx;
  font-weight: 900;
  color: #a87536;
}
.ot {
  font-size: 25rpx;
  color: #82786c;
  margin-left: 14rpx;
  text-decoration: line-through;
}
.vip {
  font-size: 20rpx;
  color: #9a6735;
  background-color: #f4ecdf;
  border-radius: 18rpx;
  padding: 6rpx 16rpx;
  margin-left: 16rpx;
}
.sales {
  font-size: 22rpx;
  color: #82786c;
  margin-left: 20rpx;
}
.guide-card {
  margin: 20rpx 24rpx;
  padding: 10rpx 24rpx 26rpx;
  border-radius: 22rpx;
  background-color: #faf6ee;
  border: 2rpx solid rgba(150, 116, 66, 0.12);
}
.guide-row {
  flex-direction: row;
  align-items: flex-start;
  padding-top: 24rpx;
}
.guide-icon {
  width: 36rpx;
  height: 36rpx;
  margin-top: 2rpx;
}
.guide-copy {
  flex: 1;
  margin-left: 16rpx;
}
.guide-head {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.guide-more {
  color: #9a7b54;
  font-size: 19rpx;
}
.guide-title {
  color: #574432;
  font-size: 24rpx;
  font-weight: 900;
  font-family: "Source Han Serif SC", "Yunxiu Serif", "Songti SC", "STSong", "Noto Serif CJK SC", serif;
}
.guide-text {
  color: #7c7367;
  font-size: 20rpx;
  line-height: 32rpx;
  margin-top: 6rpx;
}
.spec {
  padding: 20rpx 32rpx 0;
  background-color: #ffffff;
}
.spec-name {
  font-size: 25rpx;
  color: #5a5248;
  font-weight: 900;
}
.spec-vals {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 12rpx;
}
.chip {
  font-size: 24rpx;
  color: #5a5248;
  background-color: #f0ece3;
  padding: 12rpx 26rpx;
  border-radius: 12rpx;
  margin: 0 14rpx 14rpx 0;
  border: 2rpx solid #f0ece3;
}
.chip-on {
  color: #a87536;
  background-color: rgba(199, 154, 82, 0.12);
  border-color: #a87536;
}
.qty {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background-color: #ffffff;
  border-top: 2rpx solid rgba(0, 0, 0, 0.05);
  margin-top: 2rpx;
}
.qty-t {
  font-size: 26rpx;
  color: #5a5248;
}
.stepper {
  flex-direction: row;
  align-items: center;
}
.step-btn {
  width: 54rpx;
  height: 54rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.15);
  border-radius: 28rpx;
  text-align: center;
  line-height: 50rpx;
  font-size: 34rpx;
}
.step-n {
  width: 64rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 900;
}
.origin-card {
  height: 238rpx;
  margin: 20rpx 24rpx;
  border-radius: 22rpx;
  overflow: hidden;
  position: relative;
  background-color: #f6f1e7;
  border: 2rpx solid rgba(150, 116, 66, 0.12);
}
.origin-image {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  opacity: 0.26;
}
.origin-wash {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 62%;
  background-color: rgba(248, 244, 236, 0.72);
}
.origin-copy {
  position: absolute;
  left: 28rpx;
  right: 24rpx;
  top: 30rpx;
}
.origin-title {
  color: #3d2e1e;
  font-size: 29rpx;
  font-weight: 900;
}
.origin-text {
  color: #6f6559;
  font-size: 19rpx;
  line-height: 31rpx;
  margin-top: 12rpx;
}
.intro {
  padding: 25rpx 32rpx;
  background-color: #ffffff;
}
.sec {
  font-size: 30rpx;
  font-weight: 900;
  color: #4a3020;
}
.intro-rich {
  margin-top: 12rpx;
}
.bar-space {
  height: calc(150rpx + env(safe-area-inset-bottom));
}
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  flex-direction: row;
  align-items: center;
  background-color: #ffffff;
  padding: 16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid rgba(0, 0, 0, 0.05);
}
.consult {
  width: 82rpx;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}
.consult-icon {
  width: 38rpx;
  height: 38rpx;
}
.consult-text {
  color: #82663f;
  font-size: 18rpx;
  margin-top: 3rpx;
}
.btn-line, .btn-fill {
  flex: 1;
  height: 80rpx;
  border-radius: 14rpx;
  align-items: center;
  justify-content: center;
}
.btn-line {
  border: 2rpx solid rgba(150, 116, 66, 0.5);
  margin-right: 12rpx;
}
.btn-fill {
  background-color: #9d4b39;
}
.btn-line-t {
  color: #a87536;
  font-size: 25rpx;
  font-weight: 900;
}
.btn-fill-t {
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
}