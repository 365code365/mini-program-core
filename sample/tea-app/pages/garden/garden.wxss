@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}
/* 凤凰云岫设计令牌：参考稿的暖米白、茶褐、低饱和金与书卷感排版 */
/* 字体栈第一位必须是 App.uvue 里 loadFontFace 注册过的 family，否则安卓机没有本机宋体，
   会整站掉到系统黑体。Yunxiu Serif = Noto Serif SC Regular(正文)，Source Han Serif SC = Heavy(标题)。 */
.page {
  flex: 1;
  background-color: #f7f3ec;
}
.live-wrap {
  position: relative;
  margin: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
}
.live {
  width: 100%;
}
.live-video {
  width: 100%;
  height: 420rpx;
}
.badge {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  flex-direction: row;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.55);
  border-radius: 40rpx;
  padding: 8rpx 20rpx;
}
.bdot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  background-color: #ff4d4f;
  margin-right: 10rpx;
}
.badge-t {
  color: #ffffff;
  font-size: 22rpx;
  font-family: "Playfair Display", "Times New Roman", serif;
}
.tag {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background-color: rgba(0, 0, 0, 0.4);
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.tip {
  font-size: 22rpx;
  color: #82786c;
  margin: 8rpx 32rpx;
}
.sec {
  font-size: 32rpx;
  font-weight: bold;
  color: #4a3020;
  margin: 24rpx 32rpx 12rpx;
}
.env {
  flex-direction: row;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin: 0 24rpx;
  padding: 28rpx 0;
}
.env-item {
  flex: 1;
  align-items: center;
}
.env-v {
  font-size: 34rpx;
  font-weight: bold;
  color: #4a3020;
}
.env-k {
  font-size: 22rpx;
  color: #82786c;
  margin-top: 6rpx;
}