@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}
/* 凤凰云岫设计令牌：参考稿的暖米白、茶褐、低饱和金与书卷感排版 */
/* 字体栈第一位必须是 App.uvue 里 loadFontFace 注册过的 family，否则安卓机没有本机宋体，
   会整站掉到系统黑体。Yunxiu Serif = Noto Serif SC Regular(正文)，Source Han Serif SC = Heavy(标题)。 */
.page {
  flex: 1;
  background-color: #f7f3ec;
}
.back {
  position: absolute;
  left: 24rpx;
  top: 80rpx;
  z-index: 10;
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background-color: rgba(0, 0, 0, 0.3);
  align-items: center;
  justify-content: center;
}
.back-arrow {
  font-size: 40rpx;
  color: #ffffff;
  margin-top: -4rpx;
}
.head-wrap {
  position: relative;
}
.head-img {
  width: 100%;
  height: 440rpx;
}
.head-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  align-items: center;
  justify-content: center;
}
.brand-cn, .sec {
  font-family: "Source Han Serif SC", "Yunxiu Serif", "Songti SC", "STSong", "Noto Serif CJK SC", serif;
}
.brand-cn {
  font-size: 64rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 12rpx;
}
.brand-en {
  font-size: 26rpx;
  color: #e7d2a6;
  letter-spacing: 10rpx;
  margin-top: 8rpx;
  font-family: "Playfair Display", "Times New Roman", serif;
}
.brand-slogan {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 16rpx;
}
.block {
  padding: 28rpx 32rpx 0;
}
.sec {
  font-size: 32rpx;
  font-weight: bold;
  color: #4a3020;
}
.p {
  font-size: 28rpx;
  color: #5a5248;
  line-height: 46rpx;
  margin-top: 12rpx;
}
.values {
  flex-direction: row;
  margin-top: 12rpx;
}
.value {
  flex: 1;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  align-items: center;
  margin: 0 8rpx;
}
.value-ic {
  width: 48rpx;
  height: 48rpx;
}
.value-t {
  font-size: 26rpx;
  font-weight: bold;
  color: #4a3020;
  margin-top: 12rpx;
}
.value-d {
  font-size: 20rpx;
  color: #82786c;
  margin-top: 6rpx;
}
.cta {
  background-color: #536254;
  border-radius: 24rpx;
  margin: 32rpx 24rpx 0;
  padding: 40rpx;
  align-items: center;
}
.cta-t {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
}
.cta-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
}
.cta-btn {
  background-color: #a87536;
  border-radius: 44rpx;
  padding: 20rpx 56rpx;
  margin-top: 28rpx;
}
.cta-btn-t {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}