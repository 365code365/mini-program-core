@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}
/* 凤凰云岫设计令牌：参考稿的暖米白、茶褐、低饱和金与书卷感排版 */
.page {
  flex: 1;
  background-color: #f7f3ec;
}
.tabs {
  flex-direction: row;
  justify-content: center;
  padding: 16rpx 0;
  background-color: #ffffff;
}
.tab {
  font-size: 30rpx;
  color: #82786c;
  margin: 0 40rpx;
  padding-bottom: 12rpx;
}
.tab-on {
  color: #4a3020;
  font-weight: bold;
  border-bottom: 4rpx solid #c5a46d;
}
.scroll {
  flex: 1;
}
.intro {
  padding: 16rpx 32rpx;
}
.intro-t {
  font-size: 26rpx;
  color: #7a746a;
  line-height: 40rpx;
}
.empty {
  align-items: center;
  padding-top: 140rpx;
}
.empty-t {
  font-size: 26rpx;
  color: #82786c;
}
.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  margin: 16rpx 24rpx 0;
  overflow: hidden;
}
.cover {
  width: 100%;
}
.body {
  padding: 24rpx;
}
.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #4a3020;
}
.desc {
  font-size: 24rpx;
  color: #8a8478;
  margin-top: 8rpx;
}
.specs {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 14rpx;
}
.spec {
  font-size: 22rpx;
  color: #a87536;
  background-color: rgba(199, 154, 82, 0.12);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin: 0 12rpx 8rpx 0;
}
.bottom {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.price-wrap {
  flex-direction: row;
  align-items: baseline;
}
.price {
  font-size: 40rpx;
  font-weight: bold;
  color: #a87536;
}
.price-unit {
  font-size: 22rpx;
  color: #82786c;
}
.btn {
  background-color: #a87536;
  border-radius: 40rpx;
  padding: 16rpx 40rpx;
}
.btn-off {
  background-color: #c4bdb0;
}
.btn-t {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}
.mine-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
}
.mine-head {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.mine-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #4a3020;
}
.mine-status {
  font-size: 22rpx;
  color: #a87536;
  background-color: rgba(199, 154, 82, 0.12);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.mine-row {
  flex-direction: row;
  justify-content: space-between;
  padding: 8rpx 0;
}
.mk {
  font-size: 24rpx;
  color: #82786c;
}
.mv {
  font-size: 24rpx;
  color: #3a2c18;
}
.mine-cancel {
  align-self: flex-end;
  border: 2rpx solid rgba(0, 0, 0, 0.15);
  border-radius: 40rpx;
  padding: 10rpx 28rpx;
  margin-top: 12rpx;
}
.mine-cancel-t {
  font-size: 24rpx;
  color: #4a3020;
}