<view class="top">
  <view class="banner-wrap" wx:if="{{banners.length && !tag}}">
    <swiper class="banner" autoplay interval="5000" circular indicator-dots indicator-color="rgba(255,255,255,0.45)" indicator-active-color="#ffffff">
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <image class="banner-img" src="{{item.image}}" mode="aspectFill" data-tag="{{item.target.tag}}" bindtap="onBanner"></image>
      </swiper-item>
    </swiper>
  </view>
  <scroll-view scroll-x class="tags" show-scrollbar="{{false}}">
    <view class="tag-row">
      <view class="tag {{tag === '' ? 'tag-on' : ''}}" data-name="" bindtap="onTag">全部</view>
      <view class="tag {{tag === item.name ? 'tag-on' : ''}}" wx:for="{{tags}}" wx:key="name" data-name="{{item.name}}" bindtap="onTag">
        <view class="tag-dot" style="background: {{item.color}}"></view>{{item.name}}<text class="tag-n">{{item.count}}</text>
      </view>
    </view>
  </scroll-view>
</view>

<view class="state" wx:if="{{status === 'loading'}}"><text>正在加载图片…</text></view>
<view class="state" wx:elif="{{status === 'error'}}">
  <view class="state-icon">!</view>
  <text>网络开小差了</text>
  <view class="retry" bindtap="onRetry">重新加载</view>
</view>
<view class="state" wx:elif="{{status === 'empty'}}">
  <view class="state-icon">∅</view>
  <text>这个标签下还没有作品</text>
</view>
<block wx:else>
  <view class="count sub">{{tag ? '#' + tag + ' · ' : ''}}共 {{total}} 张 · 长按图片可全屏预览</view>
  <view class="wf">
    <view class="wf-col">
      <view class="pc" wx:for="{{left}}" wx:key="id" data-id="{{item.id}}" data-index="{{item.index}}" bindtap="onPhoto" bindlongpress="onPreview">
        <image class="pc-img" src="{{item.url}}" mode="aspectFill" style="height: {{item.h}}rpx; background: {{item.color}}"></image>
        <view class="pc-info">
          <text class="pc-title ellipsis">{{item.title}}</text>
          <view class="row pc-meta">
            <image class="pc-avatar" src="{{item.author.avatar}}" mode="aspectFill"></image>
            <text class="pc-author ellipsis">{{item.author.name}}</text>
            <text class="pc-like {{item.liked ? 'pc-like-on' : ''}}" data-id="{{item.id}}" catchtap="onLike">{{item.liked ? '♥' : '♡'}} {{item.likes}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="wf-col wf-col-r">
      <view class="pc" wx:for="{{right}}" wx:key="id" data-id="{{item.id}}" data-index="{{item.index}}" bindtap="onPhoto" bindlongpress="onPreview">
        <image class="pc-img" src="{{item.url}}" mode="aspectFill" style="height: {{item.h}}rpx; background: {{item.color}}"></image>
        <view class="pc-info">
          <text class="pc-title ellipsis">{{item.title}}</text>
          <view class="row pc-meta">
            <image class="pc-avatar" src="{{item.author.avatar}}" mode="aspectFill"></image>
            <text class="pc-author ellipsis">{{item.author.name}}</text>
            <text class="pc-like {{item.liked ? 'pc-like-on' : ''}}" data-id="{{item.id}}" catchtap="onLike">{{item.liked ? '♥' : '♡'}} {{item.likes}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="foot" wx:if="{{more === 'loading'}}">加载中…</view>
  <view class="foot" wx:elif="{{more === 'error'}}" bindtap="onRetryMore">加载失败，<text class="accent">点击重试</text></view>
  <view class="foot" wx:elif="{{more === 'end'}}">— 已经看完全部 {{total}} 张 —</view>
  <view class="foot" wx:else>上拉加载更多</view>
</block>
