.top { background: #fff; padding-top: 16rpx; margin-bottom: 8rpx; }
.banner-wrap { padding: 0 24rpx 8rpx; }
.banner { width: 702rpx; height: 281rpx; border-radius: 20rpx; overflow: hidden; }
.banner-img { width: 702rpx; height: 281rpx; border-radius: 20rpx; }
.tags { width: 750rpx; }
.tag-row { display: flex; flex-direction: row; padding: 16rpx 16rpx 20rpx; }
.tag { flex-shrink: 0; display: flex; flex-direction: row; align-items: center; font-size: 26rpx; color: #4e5969; background: #f3f4f6; border-radius: 30rpx; padding: 10rpx 24rpx; margin: 0 8rpx; }
.tag-on { color: #fff; background: #3b82f6; font-weight: bold; }
.tag-dot { width: 14rpx; height: 14rpx; border-radius: 7rpx; margin-right: 10rpx; }
.tag-n { font-size: 20rpx; margin-left: 6rpx; opacity: 0.7; }
.count { padding: 16rpx 24rpx; }
