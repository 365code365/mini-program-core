page { background: #f4f5f7; color: #1f2329; font-size: 28rpx; }
.row { display: flex; flex-direction: row; align-items: center; }
.col { display: flex; flex-direction: column; }
.flex1 { flex: 1; }
.sub { font-size: 24rpx; color: #8a9099; }
.accent { color: #3b82f6; }
.ellipsis { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; color: #9aa0ab; }
.state-icon { width: 120rpx; height: 120rpx; border-radius: 60rpx; background: #e9ecf1; text-align: center; line-height: 120rpx; font-size: 52rpx; color: #c0c6d0; margin-bottom: 24rpx; }
.retry { margin-top: 28rpx; font-size: 26rpx; color: #3b82f6; border: 2rpx solid #3b82f6; border-radius: 32rpx; padding: 10rpx 44rpx; }
.foot { text-align: center; color: #b0b4ba; font-size: 24rpx; padding: 24rpx 0 40rpx; }
.btn-hover { opacity: 0.8; }
/* 瀑布流卡片（发现页 / 收藏页共用） */
.wf { display: flex; flex-direction: row; align-items: flex-start; padding: 0 20rpx; }
.wf-col { width: 345rpx; display: flex; flex-direction: column; }
.wf-col-r { margin-left: 20rpx; }
.pc { background: #fff; border-radius: 16rpx; overflow: hidden; margin-bottom: 20rpx; }
.pc-img { width: 345rpx; display: block; }
.pc-info { padding: 14rpx 16rpx 18rpx; }
.pc-title { font-size: 26rpx; font-weight: bold; }
.pc-meta { margin-top: 10rpx; }
.pc-avatar { width: 36rpx; height: 36rpx; border-radius: 18rpx; margin-right: 10rpx; }
.pc-author { flex: 1; font-size: 22rpx; color: #8a9099; }
.pc-like { font-size: 22rpx; color: #9aa0ab; }
.pc-like-on { color: #ff4d6d; }
