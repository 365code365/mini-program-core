<view class="head">
  <view class="hello">
    <text class="hello-t">安心保</text>
    <text class="hello-s">持牌经纪 · 保司直赔 · 7×24 小时报案</text>
  </view>
  <view class="search" bindtap="openSearch" hover-class="btn-hover">
    <text class="search-ic">⌕</text>
    <text class="search-tx">搜索 百万医疗 / 重疾险 / 意外险</text>
  </view>
</view>

<view class="wrap top">
  <swiper class="banner" autoplay interval="4000" circular indicator-dots indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff" bindchange="onSwiper">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="bn" data-id="{{item.id}}" bindtap="openProduct">
        <image class="bn-img" src="{{item.img}}" mode="aspectFill"></image>
        <view class="bn-txt">
          <text class="bn-badge">{{item.badge}}</text>
          <text class="bn-title">{{item.title}}</text>
          <text class="bn-sub">{{item.sub}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="card cats">
    <view class="cat" wx:for="{{cats}}" wx:key="key" data-key="{{item.key}}" bindtap="openCat" hover-class="btn-hover">
      <image class="cat-ic" src="{{item.icon}}"></image>
      <text class="cat-n">{{item.name}}</text>
      <text class="cat-d">{{item.desc}}</text>
    </view>
  </view>

  <view class="remind remind-{{reminder.kind}}" wx:if="{{reminder}}" bindtap="onReminder" hover-class="btn-hover">
    <view class="remind-l">
      <text class="remind-t">{{reminder.title}}</text>
      <text class="remind-s">{{reminder.sub}}</text>
    </view>
    <text class="remind-btn">{{reminder.act}}</text>
  </view>

  <view class="card svc">
    <view class="svc-i" wx:for="{{services}}" wx:key="key" data-key="{{item.key}}" bindtap="onService" hover-class="btn-hover">
      <image class="svc-ic" src="{{item.icon}}"></image>
      <text class="svc-n">{{item.name}}</text>
    </view>
  </view>

  <view class="sec-head">
    <text class="sec-title">热销榜</text>
    <text class="sec-more" bindtap="openSearch">全部产品 ›</text>
  </view>
  <view class="card prod" wx:for="{{hot}}" wx:key="id" data-id="{{item.id}}" bindtap="openProduct" hover-class="btn-hover">
    <view class="rank rank-{{index}}">{{index + 1}}</view>
    <image class="prod-img" src="{{item.cover}}" mode="aspectFill"></image>
    <view class="prod-info">
      <text class="prod-n">{{item.name}}</text>
      <text class="prod-t">{{item.tagline}}</text>
      <view class="tags"><text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text></view>
      <view class="prod-foot">
        <text class="muted">已售 {{item.sales}}</text>
        <view><text class="price">¥{{item.price}}</text><text class="price-unit"> 起</text></view>
      </view>
    </view>
  </view>
  <view class="foot-note">安心保保险经纪（上海）有限公司 · 经营保险经纪业务许可证 260931000000800</view>
</view>
<view class="tab-pad"></view>
