.rs { display: flex; flex-direction: column; align-items: center; padding: 64rpx 24rpx 40rpx; }
.rs-ic { width: 160rpx; height: 160rpx; display: flex; align-items: center; justify-content: center; }
.rs-t { font-size: 40rpx; font-weight: bold; margin-top: 16rpx; }
.rs-s { font-size: 24rpx; color: #8a93a3; margin-top: 16rpx; text-align: center; padding: 0 40rpx; line-height: 1.6; }
.rs-card { width: 100%; box-sizing: border-box; margin-top: 40rpx; }
.rs-btns { width: 100%; padding: 0 16rpx; box-sizing: border-box; margin-top: 16rpx; }
.rs-gap { margin-top: 24rpx; }
