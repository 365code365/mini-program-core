.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  border-top: 1rpx solid #EEEEEE;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
}

.tab-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 25%;
  height: 100rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
}

.tab-text {
  font-size: 20rpx;
  color: #8C8C8C;
}

.tab-item.active .tab-text {
  color: #FF6B35;
  font-weight: bold;
}

.tab-badge {
  position: absolute;
  top: 6rpx;
  left: 50%;
  margin-left: 10rpx;
  background-color: #FF3B30;
  color: #fff;
  font-size: 18rpx;
  line-height: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 14rpx;
  min-width: 12rpx;
  text-align: center;
  border: 2rpx solid #fff;
}
