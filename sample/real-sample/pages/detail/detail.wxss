.page {
  background-color: #F6F6F6;
  padding-bottom: 130rpx;
}

/* 主图 */
.product-images {
  position: relative;
  width: 750rpx;
  height: 750rpx;
  background-color: #fff;
}

.hero-img {
  width: 750rpx;
  height: 750rpx;
}

.image-indicator {
  position: absolute;
  bottom: 28rpx;
  right: 24rpx;
  background-color: rgba(0, 0, 0, 0.35);
  border-radius: 20rpx;
  padding: 4rpx 18rpx;
  color: #fff;
  font-size: 22rpx;
}

/* 价格条 */
.price-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: linear-gradient(90deg, #FF5A2C, #FF8A50);
}

.price-left {
  display: flex;
  flex-direction: column;
}

.price-line {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.pb-symbol {
  font-size: 30rpx;
  color: #fff;
  font-weight: bold;
}

.pb-price {
  font-size: 56rpx;
  color: #fff;
  font-weight: bold;
}

.pb-original {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  text-decoration: line-through;
  margin-left: 14rpx;
}

.pb-sold {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 2rpx;
}

.price-right {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pb-tag {
  background-color: #fff;
  color: #FF5A2C;
  font-size: 24rpx;
  font-weight: bold;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
}

.pb-tip {
  font-size: 20rpx;
  color: #fff;
  margin-top: 8rpx;
}

/* 卡片 */
.card {
  background-color: #fff;
  margin: 20rpx 20rpx 0;
  border-radius: 20rpx;
  padding: 28rpx;
}

.product-info {
  margin-top: 0;
  border-radius: 0 0 20rpx 20rpx;
  margin-left: 0;
  margin-right: 0;
}

.name-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.name {
  flex: 1;
  font-size: 34rpx;
  color: #1F1F1F;
  font-weight: bold;
  line-height: 1.4;
}

.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 20rpx;
  font-size: 20rpx;
  color: #999;
}

.share-icon {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 4rpx;
}

.desc {
  display: block;
  font-size: 26rpx;
  color: #8C8C8C;
  margin-top: 10rpx;
}

.coupon-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 22rpx;
}

.coupon {
  font-size: 22rpx;
  color: #FF5A2C;
  background-color: #FFF1EA;
  border: 1rpx dashed #FFB08C;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-right: 14rpx;
}

.coupon-more {
  margin-left: auto;
  font-size: 24rpx;
  color: #FF6B35;
}

.spec-row {
  display: flex;
  flex-direction: row;
  padding: 14rpx 0;
}

.spec-label {
  width: 90rpx;
  font-size: 26rpx;
  color: #999;
}

.spec-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.card-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  color: #1F1F1F;
  font-weight: bold;
}

.card-more {
  font-size: 24rpx;
  color: #FF6B35;
}

/* 评价 */
.review-item {
  padding: 16rpx 0;
}

.review-user {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 12rpx;
}

.review-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
}

.avatar-text {
  background-color: #FFE3D6;
  color: #FF6B35;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-name {
  font-size: 26rpx;
  color: #333;
  margin-left: 14rpx;
}

.review-stars {
  font-size: 22rpx;
  color: #FFB300;
  margin-left: auto;
}

.review-content {
  display: block;
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

.review-images {
  display: flex;
  flex-direction: row;
  margin-top: 14rpx;
}

.review-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

/* 看了又看 */
.rec-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.rec-item {
  width: 200rpx;
  display: flex;
  flex-direction: column;
}

.rec-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 14rpx;
  background-color: #F5F5F5;
}

.rec-name {
  font-size: 24rpx;
  color: #333;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-price {
  font-size: 28rpx;
  color: #FF4D1C;
  font-weight: bold;
  margin-top: 4rpx;
}

/* 详情 */
.detail-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 20rpx;
}

.detail-img {
  width: 654rpx;
  height: 654rpx;
  border-radius: 12rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background-color: #fff;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 20rpx 0 28rpx;
  border-top: 1rpx solid #F0F0F0;
  box-sizing: border-box;
  z-index: 100;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  margin-right: 36rpx;
}

.bar-icon {
  width: 44rpx;
  height: 44rpx;
}

.item-text {
  font-size: 20rpx;
  color: #666;
  margin-top: 2rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -14rpx;
  background-color: #FF3B30;
  color: #fff;
  font-size: 18rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 8rpx;
  border-radius: 14rpx;
  min-width: 12rpx;
  text-align: center;
}

.bar-right {
  flex: 1;
  display: flex;
  flex-direction: row;
  height: 76rpx;
}

.btn-add-cart,
.btn-buy {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

/* 两个按钮各自带半边圆角拼成一个胶囊（不依赖父级 overflow 裁剪） */
.btn-add-cart {
  background: linear-gradient(90deg, #FFC24D, #FF9F2E);
  border-radius: 38rpx 0 0 38rpx;
}

.btn-buy {
  background: linear-gradient(90deg, #FF7A40, #FF4D1C);
  border-radius: 0 38rpx 38rpx 0;
}
