<view class="page">
  <!-- 商品主图 -->
  <view class="product-images">
    <image class="hero-img" src="{{product.hero}}" mode="aspectFill"></image>
    <view class="image-indicator">
      <text>1 / 1</text>
    </view>
  </view>

  <!-- 价格条 -->
  <view class="price-banner">
    <view class="price-left">
      <view class="price-line">
        <text class="pb-symbol">¥</text>
        <text class="pb-price">{{product.price}}</text>
        <text class="pb-original">¥{{product.originalPrice}}</text>
      </view>
      <text class="pb-sold">已售 {{product.sold}} · 好评率 98%</text>
    </view>
    <view class="price-right">
      <text class="pb-tag">{{product.tag || '精选好物'}}</text>
      <text class="pb-tip">限时直降</text>
    </view>
  </view>

  <!-- 商品信息 -->
  <view class="card product-info">
    <view class="name-row">
      <text class="name">{{product.name}}</text>
      <view class="share-btn">
        <image class="share-icon" src="/assets/icons/share.png"></image>
        <text>分享</text>
      </view>
    </view>
    <text class="desc">{{product.desc}}</text>
    <view class="coupon-row">
      <text class="coupon">满199减20</text>
      <text class="coupon">新人立减10</text>
      <text class="coupon-more">领券 ></text>
    </view>
  </view>

  <!-- 服务 / 参数 -->
  <view class="card">
    <view class="spec-row">
      <text class="spec-label">服务</text>
      <text class="spec-value">正品保证 · 七天无理由退换 · 极速发货</text>
    </view>
    <view class="spec-row">
      <text class="spec-label">配送</text>
      <text class="spec-value">北京朝阳 · 现货，今日下单明日达</text>
    </view>
    <view class="spec-row">
      <text class="spec-label">规格</text>
      <text class="spec-value">标准装 · 库存 {{product.stock}} 件</text>
    </view>
  </view>

  <!-- 用户评价 -->
  <view class="card">
    <view class="card-header">
      <text class="card-title">用户评价 (128)</text>
      <text class="card-more">好评率 98% ></text>
    </view>
    <view class="review-item">
      <view class="review-user">
        <image class="review-avatar" src="/assets/avatar.jpg" mode="aspectFill"></image>
        <text class="user-name">橙***子</text>
        <text class="review-stars">★★★★★</text>
      </view>
      <text class="review-content">质量很好，物流也很快，包装很用心，推荐购买！</text>
      <view class="review-images">
        <image class="review-img" src="{{product.image}}" mode="aspectFill"></image>
      </view>
    </view>
    <view class="review-item">
      <view class="review-user">
        <view class="review-avatar avatar-text"><text>买</text></view>
        <text class="user-name">买家***2</text>
        <text class="review-stars">★★★★★</text>
      </view>
      <text class="review-content">性价比很高，和描述一致，值得入手。</text>
    </view>
  </view>

  <!-- 看了又看 -->
  <view class="card">
    <view class="card-header">
      <text class="card-title">看了又看</text>
    </view>
    <view class="rec-row">
      <view class="rec-item" wx:for="{{recommends}}" wx:key="id" bindtap="onRecommendTap" data-id="{{item.id}}">
        <image class="rec-img" src="{{item.image}}" mode="aspectFill"></image>
        <text class="rec-name">{{item.name}}</text>
        <text class="rec-price">¥{{item.price}}</text>
      </view>
    </view>
  </view>

  <!-- 商品详情 -->
  <view class="card">
    <view class="card-header">
      <text class="card-title">商品详情</text>
    </view>
    <text class="detail-text">本商品为精选品质好物，经过严格的质量检验，保证正品。采用优质材料制作，做工精良，设计时尚，是您品质生活的理想选择。</text>
    <image class="detail-img" src="{{product.hero}}" mode="aspectFill"></image>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bar-item" bindtap="onContact">
      <image class="bar-icon" src="/assets/icons/bar_service.png"></image>
      <text class="item-text">客服</text>
    </view>
    <view class="bar-item" bindtap="onCart">
      <image class="bar-icon" src="/assets/icons/bar_cart.png"></image>
      <text class="item-text">购物车</text>
      <view class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
    </view>
    <view class="bar-right">
      <view class="btn-add-cart" bindtap="onAddCart"><text>加入购物车</text></view>
      <view class="btn-buy" bindtap="onBuyNow"><text>立即购买</text></view>
    </view>
  </view>
</view>
