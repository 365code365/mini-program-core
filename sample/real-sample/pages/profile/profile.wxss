.page {
  background-color: #F6F6F6;
}

/* 用户头部 */
.user-header {
  background: linear-gradient(160deg, #FF6B35, #FF9A5C);
  padding: 36rpx 32rpx 96rpx;
}

.user-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  background-color: #FFD9C7;
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.user-name {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.user-level {
  margin-top: 10rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background-color: rgba(0, 0, 0, 0.15);
  font-size: 22rpx;
  color: #FFE7A3;
}

.sign-btn {
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  background-color: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  color: #fff;
}

.asset-row {
  display: flex;
  flex-direction: row;
  margin-top: 36rpx;
}

.asset-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.asset-value {
  font-size: 34rpx;
  color: #fff;
  font-weight: bold;
}

.asset-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

/* 会员卡：压在头部底边上 */
.vip-card {
  margin: -64rpx 24rpx 20rpx;
  height: 108rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #3A3A48, #22222C);
  padding: 0 28rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.vip-left {
  display: flex;
  flex-direction: column;
}

.vip-title {
  font-size: 30rpx;
  color: #F5D7A1;
  font-weight: bold;
}

.vip-desc {
  font-size: 22rpx;
  color: rgba(245, 215, 161, 0.7);
  margin-top: 4rpx;
}

.vip-btn {
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(90deg, #F8E2B8, #E9C27F);
  font-size: 24rpx;
  color: #5A3D12;
  font-weight: bold;
}

/* 卡片 */
.card {
  background-color: #fff;
  margin: 0 24rpx 20rpx;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  color: #1F1F1F;
  font-weight: bold;
}

.status-title {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.view-all {
  font-size: 24rpx;
  color: #999;
}

.status-list {
  display: flex;
  flex-direction: row;
}

.status-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.status-icon {
  width: 56rpx;
  height: 56rpx;
}

.status-name {
  font-size: 24rpx;
  color: #333;
  margin-top: 12rpx;
}

.status-badge {
  position: absolute;
  top: -10rpx;
  left: 50%;
  margin-left: 16rpx;
  background-color: #FF3B30;
  color: #fff;
  font-size: 18rpx;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 9rpx;
  border-radius: 15rpx;
  min-width: 12rpx;
  text-align: center;
  border: 2rpx solid #fff;
}

/* 宫格 */
.grid {
  display: flex;
  flex-direction: row;
  margin-top: 28rpx;
}

.grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.grid-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
}

.grid-name {
  font-size: 24rpx;
  color: #333;
  margin-top: 12rpx;
}

/* 列表 */
.list-card {
  padding: 0 24rpx;
}

.function-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F2F2F2;
}

.function-item:last-child {
  border-bottom: none;
}

.function-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
}

.function-name {
  flex: 1;
  font-size: 28rpx;
  color: #1F1F1F;
  margin-left: 20rpx;
}

.function-extra {
  font-size: 24rpx;
  color: #AAA;
  margin-right: 12rpx;
}

.function-arrow {
  font-size: 26rpx;
  color: #C8C8C8;
}

/* 给自定义 tabBar 留位置 */
.bottom-space {
  height: 140rpx;
}
