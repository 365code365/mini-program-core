<view class="page">
  <!-- 用户头部 -->
  <view class="user-header">
    <view class="user-row">
      <image class="user-avatar" src="{{userInfo.avatar || '/assets/avatar.jpg'}}" mode="aspectFill"></image>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickName}}</text>
        <view class="user-level"><text>★ {{userInfo.level}}</text></view>
      </view>
      <view class="sign-btn"><text>签到 +5</text></view>
    </view>
    <view class="asset-row">
      <view class="asset-item">
        <text class="asset-value">1,280</text>
        <text class="asset-label">积分</text>
      </view>
      <view class="asset-item">
        <text class="asset-value">3</text>
        <text class="asset-label">优惠券</text>
      </view>
      <view class="asset-item">
        <text class="asset-value">12</text>
        <text class="asset-label">收藏</text>
      </view>
      <view class="asset-item">
        <text class="asset-value">36</text>
        <text class="asset-label">足迹</text>
      </view>
    </view>
  </view>

  <!-- 会员卡 -->
  <view class="vip-card">
    <view class="vip-left">
      <text class="vip-title">PLUS 会员</text>
      <text class="vip-desc">开通立享 95 折 · 每月免邮券</text>
    </view>
    <view class="vip-btn"><text>立即开通</text></view>
  </view>

  <!-- 订单状态 -->
  <view class="card order-status">
    <view class="status-title">
      <text class="card-title">我的订单</text>
      <text class="view-all" bindtap="onViewAllOrders">全部订单 ></text>
    </view>
    <view class="status-list">
      <view class="status-item" bindtap="onOrderStatusTap" data-status="pending">
        <image class="status-icon" src="/assets/icons/order_pay.png"></image>
        <text class="status-name">待付款</text>
        <view class="status-badge" wx:if="{{orderCounts.pending > 0}}">{{orderCounts.pending}}</view>
      </view>
      <view class="status-item" bindtap="onOrderStatusTap" data-status="paid">
        <image class="status-icon" src="/assets/icons/order_ship.png"></image>
        <text class="status-name">待发货</text>
        <view class="status-badge" wx:if="{{orderCounts.paid > 0}}">{{orderCounts.paid}}</view>
      </view>
      <view class="status-item" bindtap="onOrderStatusTap" data-status="shipped">
        <image class="status-icon" src="/assets/icons/order_recv.png"></image>
        <text class="status-name">待收货</text>
        <view class="status-badge" wx:if="{{orderCounts.shipped > 0}}">{{orderCounts.shipped}}</view>
      </view>
      <view class="status-item" bindtap="onOrderStatusTap" data-status="completed">
        <image class="status-icon" src="/assets/icons/order_done.png"></image>
        <text class="status-name">已完成</text>
      </view>
    </view>
  </view>

  <!-- 常用功能：宫格 -->
  <view class="card">
    <text class="card-title">常用功能</text>
    <view class="grid">
      <view class="grid-item" bindtap="onAddressManage">
        <image class="grid-icon" src="/assets/icons/fn_address.png"></image>
        <text class="grid-name">收货地址</text>
      </view>
      <view class="grid-item" bindtap="onMyCoupons">
        <image class="grid-icon" src="/assets/icons/fn_coupon.png"></image>
        <text class="grid-name">优惠券</text>
      </view>
      <view class="grid-item" bindtap="onMyFavorites">
        <image class="grid-icon" src="/assets/icons/fn_fav.png"></image>
        <text class="grid-name">我的收藏</text>
      </view>
      <view class="grid-item" bindtap="onHistory">
        <image class="grid-icon" src="/assets/icons/fn_history.png"></image>
        <text class="grid-name">浏览记录</text>
      </view>
    </view>
  </view>

  <!-- 客户服务：列表 -->
  <view class="card list-card">
    <view class="function-item" bindtap="onContactService">
      <image class="function-icon" src="/assets/icons/fn_service.png"></image>
      <text class="function-name">联系客服</text>
      <text class="function-extra">9:00-18:00</text>
      <text class="function-arrow">></text>
    </view>
    <view class="function-item" bindtap="onFeedback">
      <image class="function-icon" src="/assets/icons/fn_feedback.png"></image>
      <text class="function-name">意见反馈</text>
      <text class="function-arrow">></text>
    </view>
    <view class="function-item" bindtap="onAbout">
      <image class="function-icon" src="/assets/icons/fn_about.png"></image>
      <text class="function-name">关于我们</text>
      <text class="function-extra">v1.0.0</text>
      <text class="function-arrow">></text>
    </view>
  </view>

  <view class="bottom-space"></view>
</view>
