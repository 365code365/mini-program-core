.page {
  background-color: #F6F6F6;
  min-height: 100vh;
}

/* 搜索栏 */
.search-bar {
  background-color: #fff;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 24rpx;
}

.search-input-wrapper {
  flex: 1;
  height: 68rpx;
  background-color: #F5F5F5;
  border-radius: 34rpx;
  padding: 0 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  margin: 0 12rpx;
}

.search-placeholder {
  color: #B3B3B3;
}

.search-btn {
  margin-left: 20rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  background: linear-gradient(90deg, #FF8A50, #FF6B35);
  color: #fff;
  font-size: 26rpx;
}

/* 区块 */
.block {
  background-color: #fff;
  margin: 20rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 28rpx 24rpx 12rpx;
}

.section-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1F1F1F;
}

.section-action {
  font-size: 24rpx;
  color: #999;
}

.chip-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #F5F5F5;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #555;
  margin: 0 16rpx 16rpx 0;
}

.chip-hot {
  background-color: #FFF1EA;
  color: #FF5A2C;
}

.hot-index {
  width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  background: linear-gradient(135deg, #FF8A50, #FF4D1C);
  color: #fff;
  font-size: 20rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
}

/* 猜你喜欢 */
.guess-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.guess-item {
  width: 310rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20rpx;
}

.guess-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.guess-info {
  flex: 1;
  margin-left: 14rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.guess-name {
  font-size: 24rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guess-price {
  font-size: 26rpx;
  color: #FF4D1C;
  font-weight: bold;
  margin-top: 6rpx;
}

/* 搜索结果 */
.result-section {
  padding: 20rpx 24rpx;
}

.result-count {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.result-item {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-img {
  width: 170rpx;
  height: 170rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.result-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.result-name {
  display: block;
  font-size: 28rpx;
  color: #1F1F1F;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.result-bottom {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-top: 36rpx;
}

.result-price {
  font-size: 32rpx;
  color: #FF4D1C;
  font-weight: bold;
}

.result-sold {
  font-size: 22rpx;
  color: #AAA;
  margin-left: 12rpx;
}

.result-add {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #FF8A50, #FF6B35);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 空结果 */
.empty-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.empty-img {
  width: 240rpx;
  height: 240rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-top: 24rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}
