.page {
  background-color: #F6F6F6;
  min-height: 100vh;
}

/* 地址列表 */
.address-list {
  padding: 20rpx 24rpx 0;
}

.address-item {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx 0;
  margin-bottom: 20rpx;
}

.address-main {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding-bottom: 24rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.address-info {
  flex: 1;
  margin-left: 20rpx;
}

.address-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 10rpx;
}

.name {
  font-size: 30rpx;
  color: #1F1F1F;
  font-weight: bold;
}

.phone {
  font-size: 26rpx;
  color: #666;
  margin-left: 16rpx;
}

.default-badge {
  background-color: #FF6B35;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 14rpx;
}

.tag-badge {
  color: #4A90D9;
  background-color: #EAF2FD;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 10rpx;
}

.address-text {
  display: block;
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
}

.address-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  border-top: 1rpx solid #F2F2F2;
  height: 84rpx;
}

.default-switch {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: auto;
}

.check {
  width: 30rpx;
  height: 30rpx;
  border-radius: 15rpx;
  border: 2rpx solid #CCC;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
  box-sizing: border-box;
}

.check-on {
  background-color: #FF6B35;
  border-color: #FF6B35;
}

.action-item {
  margin-left: 32rpx;
}

.action-text {
  font-size: 24rpx;
  color: #666;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-img {
  width: 240rpx;
  height: 240rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 24rpx;
}

/* 添加按钮 */
.add-btn-wrapper {
  padding: 20rpx 24rpx;
}

.add-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(90deg, #FF8A50, #FF6B35);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 44rpx;
}

/* 底部结算栏 */
.checkout-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background-color: #fff;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx 0 32rpx;
  border-top: 1rpx solid #F0F0F0;
  box-sizing: border-box;
  z-index: 100;
}

.checkout-info {
  display: flex;
  flex-direction: column;
}

.checkout-total {
  font-size: 32rpx;
  color: #FF4D1C;
  font-weight: bold;
}

.checkout-count {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.checkout-btn {
  width: 220rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: linear-gradient(90deg, #FF8A50, #FF6B35);
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 38rpx;
}
