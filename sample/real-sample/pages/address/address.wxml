<view class="page">
  <!-- 收货地址列表 -->
  <view class="address-list" wx:if="{{addresses.length > 0}}">
    <view class="address-item" wx:for="{{addresses}}" wx:key="id">
      <view class="address-main" bindtap="onSelectAddress" data-id="{{item.id}}">
        <image class="avatar" src="/assets/icons/fn_address.png"></image>
        <view class="address-info">
          <view class="address-header">
            <text class="name">{{item.name}}</text>
            <text class="phone">{{item.phone}}</text>
            <text class="default-badge" wx:if="{{item.isDefault}}">默认</text>
            <text class="tag-badge" wx:if="{{item.tag}}">{{item.tag}}</text>
          </view>
          <text class="address-text">{{item.address}}</text>
        </view>
      </view>
      <view class="address-actions">
        <view class="default-switch" bindtap="onSetDefault" data-id="{{item.id}}">
          <view class="check {{item.isDefault ? 'check-on' : ''}}">
            <icon wx:if="{{item.isDefault}}" type="success_no_circle" size="10" color="#fff"></icon>
          </view>
          <text class="action-text">{{item.isDefault ? '已设为默认' : '设为默认'}}</text>
        </view>
        <view class="action-item" bindtap="onEditAddress" data-id="{{item.id}}">
          <text class="action-text">编辑</text>
        </view>
        <view class="action-item" bindtap="onDeleteAddress" data-id="{{item.id}}">
          <text class="action-text">删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{addresses.length === 0}}">
    <image class="empty-img" src="/assets/icons/empty_address.png"></image>
    <text class="empty-text">暂无收货地址</text>
  </view>

  <!-- 添加地址按钮 -->
  <view class="add-btn-wrapper">
    <view class="add-btn" bindtap="onAddAddress"><text>+ 添加新地址</text></view>
  </view>

  <!-- 底部结算栏 (仅结算页面显示) -->
  <view class="checkout-bar" wx:if="{{isCheckout}}">
    <view class="checkout-info">
      <text class="checkout-total">合计 ¥{{checkoutTotal}}</text>
      <text class="checkout-count">共{{checkoutCount}}件商品</text>
    </view>
    <view class="checkout-btn" bindtap="onConfirmOrder"><text>提交订单</text></view>
  </view>

  <view class="bottom-space" style="height: {{isCheckout ? '120rpx' : '20rpx'}};"></view>
</view>
