<view class="page">
  <!-- 订单筛选 -->
  <view class="order-filter">
    <view class="filter-item" wx:for="{{tabs}}" wx:key="key" bindtap="onTabChange" data-tab="{{item.key}}">
      <text class="filter-text {{currentTab === item.key ? 'active' : ''}}">{{item.name}}</text>
      <view class="filter-line {{currentTab === item.key ? 'line-on' : ''}}"></view>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="order-item" wx:for="{{orders}}" wx:key="id">
      <!-- 订单头部 -->
      <view class="order-header">
        <view class="shop">
          <image class="shop-logo" src="/assets/icons/tab_home_on.png"></image>
          <text class="shop-name">精选商城自营</text>
        </view>
        <text class="order-status {{item.status}}">{{item.statusText}}</text>
      </view>

      <!-- 订单商品 -->
      <view class="product-item" wx:for="{{item.products}}" wx:for-item="product" wx:key="id">
        <image class="product-img" src="{{product.image}}" mode="aspectFill"></image>
        <view class="product-info">
          <text class="product-name">{{product.name}}</text>
          <text class="product-desc">{{product.desc || '默认规格'}}</text>
        </view>
        <view class="product-right">
          <text class="product-price">¥{{product.price}}</text>
          <text class="product-quantity">x{{product.quantity}}</text>
        </view>
      </view>

      <!-- 订单金额 -->
      <view class="order-total">
        <text class="order-time">{{item.createTime}}</text>
        <text class="total-label">实付款 </text>
        <text class="total-amount">¥{{item.total}}</text>
      </view>

      <!-- 订单操作 -->
      <view class="order-actions">
        <view class="action-btn secondary" wx:if="{{item.status === 'pending'}}" bindtap="onCancelOrder" data-id="{{item.id}}"><text>取消订单</text></view>
        <view class="action-btn primary" wx:if="{{item.status === 'pending'}}" bindtap="onPayOrder" data-id="{{item.id}}"><text>去支付</text></view>
        <view class="action-btn secondary" wx:if="{{item.status === 'paid'}}" bindtap="onViewLogistics" data-id="{{item.id}}"><text>提醒发货</text></view>
        <view class="action-btn secondary" wx:if="{{item.status === 'shipped'}}" bindtap="onViewLogistics" data-id="{{item.id}}"><text>查看物流</text></view>
        <view class="action-btn primary" wx:if="{{item.status === 'shipped'}}" bindtap="onConfirmReceipt" data-id="{{item.id}}"><text>确认收货</text></view>
        <view class="action-btn secondary" wx:if="{{item.status === 'completed'}}" bindtap="onDeleteOrder" data-id="{{item.id}}"><text>删除订单</text></view>
        <view class="action-btn outline" wx:if="{{item.status === 'completed'}}" bindtap="onBuyAgain"><text>再次购买</text></view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{orders.length === 0}}">
    <image class="empty-img" src="/assets/icons/empty_order.png"></image>
    <text class="empty-text">暂无相关订单</text>
    <text class="empty-tip">逛逛首页，发现更多好物</text>
    <view class="empty-btn" bindtap="onBuyAgain"><text>去逛逛</text></view>
  </view>

  <view class="bottom-space"></view>
</view>
