.page {
  background-color: #F6F6F6;
  min-height: 100vh;
}

/* 订单筛选：下划线用真实节点而不是 ::after，引擎与各端表现一致 */
.order-filter {
  background-color: #fff;
  display: flex;
  flex-direction: row;
  padding: 0 12rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.filter-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.filter-text {
  font-size: 28rpx;
  color: #666;
}

.filter-text.active {
  color: #1F1F1F;
  font-weight: bold;
  font-size: 30rpx;
}

.filter-line {
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-top: 8rpx;
  background-color: transparent;
}

.filter-line.line-on {
  background-color: #FF6B35;
}

/* 订单列表 */
.order-list {
  padding: 20rpx 24rpx;
}

.order-item {
  background-color: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
}

.order-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 8rpx;
}

.shop {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.shop-logo {
  width: 32rpx;
  height: 32rpx;
}

.shop-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #1F1F1F;
  margin-left: 10rpx;
}

.order-status {
  font-size: 26rpx;
}

.order-status.pending {
  color: #FF4D1C;
}

.order-status.paid {
  color: #4A90D9;
}

.order-status.shipped {
  color: #FF8A00;
}

.order-status.completed {
  color: #999;
}

/* 商品 */
.product-item {
  display: flex;
  flex-direction: row;
  padding: 16rpx 0;
}

.product-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background-color: #F5F5F5;
}

.product-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.product-name {
  max-width: 100%;
  font-size: 28rpx;
  color: #1F1F1F;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-desc {
  font-size: 22rpx;
  color: #999;
  background-color: #F6F6F6;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-top: 12rpx;
}

.product-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
}

.product-price {
  font-size: 28rpx;
  color: #1F1F1F;
  font-weight: bold;
}

.product-quantity {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 金额 */
.order-total {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  padding: 12rpx 0 20rpx;
}

.order-time {
  font-size: 22rpx;
  color: #AAA;
  margin-right: auto;
}

.total-label {
  font-size: 24rpx;
  color: #666;
}

.total-amount {
  font-size: 32rpx;
  color: #1F1F1F;
  font-weight: bold;
}

/* 操作 */
.order-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  border-top: 1rpx solid #F2F2F2;
  padding-top: 20rpx;
}

.action-btn {
  height: 60rpx;
  line-height: 58rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  margin-left: 16rpx;
  box-sizing: border-box;
}

.action-btn.primary {
  background: linear-gradient(90deg, #FF8A50, #FF6B35);
  color: #fff;
  line-height: 60rpx;
}

.action-btn.secondary {
  color: #666;
  border: 1rpx solid #D9D9D9;
}

.action-btn.outline {
  color: #FF6B35;
  border: 1rpx solid #FF6B35;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-img {
  width: 240rpx;
  height: 240rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-top: 24rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.empty-btn {
  margin-top: 40rpx;
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 36rpx;
  border: 2rpx solid #FF6B35;
  color: #FF6B35;
  font-size: 28rpx;
  box-sizing: border-box;
}

.bottom-space {
  height: 20rpx;
}
