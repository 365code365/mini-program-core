.page {
  background-color: #F6F6F6;
  min-height: 100vh;
}

/* 空购物车 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-img {
  width: 240rpx;
  height: 240rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-top: 24rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.empty-btn {
  margin-top: 40rpx;
  width: 260rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: linear-gradient(90deg, #FF8A50, #FF6B35);
  color: #fff;
  font-size: 28rpx;
  border-radius: 38rpx;
}

/* 购物车 */
.cart-container {
  /* 结算栏 100rpx + tabBar 100rpx */
  padding-bottom: 220rpx;
}

.cart-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  padding: 24rpx 32rpx 4rpx;
}

.cart-head-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1F1F1F;
}

.cart-head-tip {
  font-size: 22rpx;
  color: #FF6B35;
}

.cart-list {
  background-color: #fff;
  margin: 16rpx 24rpx;
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
}

.shop-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0 8rpx;
}

.shop-logo {
  width: 32rpx;
  height: 32rpx;
}

.shop-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #1F1F1F;
  margin-left: 10rpx;
}

.cart-item {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F2F2F2;
}

.cart-item:last-child {
  border-bottom: none;
}

/* 圆形勾选框 */
.check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  border: 2rpx solid #CCCCCC;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.check-on {
  background-color: #FF6B35;
  border-color: #FF6B35;
}

.item-img {
  width: 172rpx;
  height: 172rpx;
  border-radius: 14rpx;
  margin: 0 20rpx;
  flex-shrink: 0;
  background-color: #F5F5F5;
}

.item-info {
  flex: 1;
  height: 172rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 28rpx;
  color: #1F1F1F;
  font-weight: bold;
  padding-right: 64rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-spec {
  align-self: flex-start;
  font-size: 22rpx;
  color: #999;
  background-color: #F6F6F6;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-top: 10rpx;
}

.item-bottom {
  margin-top: auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.price-wrap {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.price-symbol {
  font-size: 22rpx;
  color: #FF4D1C;
  font-weight: bold;
}

.item-price {
  font-size: 34rpx;
  color: #FF4D1C;
  font-weight: bold;
}

.item-quantity {
  display: flex;
  flex-direction: row;
  align-items: center;
  border: 1rpx solid #E5E5E5;
  border-radius: 8rpx;
}

.quantity-btn {
  width: 48rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
}

.quantity-btn.disabled {
  color: #CCC;
}

.quantity-num {
  width: 60rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333;
  border-left: 1rpx solid #E5E5E5;
  border-right: 1rpx solid #E5E5E5;
}

.item-delete {
  position: absolute;
  top: 22rpx;
  right: 0;
  font-size: 22rpx;
  color: #AAA;
  padding: 4rpx 0 4rpx 12rpx;
}

/* 底部结算栏：在 tabBar（100rpx）上方 */
.cart-footer {
  position: fixed;
  bottom: 100rpx;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx 0 32rpx;
  border-top: 1rpx solid #F0F0F0;
  box-sizing: border-box;
  z-index: 99;
}

.footer-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.select-text {
  font-size: 26rpx;
  color: #333;
  margin-left: 12rpx;
}

.footer-right {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.total-price {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-right: 20rpx;
}

.total-label {
  font-size: 26rpx;
  color: #333;
}

.total-amount {
  font-size: 38rpx;
  color: #FF4D1C;
  font-weight: bold;
}

.checkout-btn {
  width: 200rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: linear-gradient(90deg, #FF8A50, #FF6B35);
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 36rpx;
}

.checkout-disabled {
  background: #CCCCCC;
}
