.page {
  background-color: #F6F6F6;
}

/* 顶部搜索栏：橙色头部延伸到 banner 后面 */
.header {
  background: linear-gradient(180deg, #FF6B35, #FF8A50);
  padding: 16rpx 24rpx 80rpx;
}

.search-box {
  height: 68rpx;
  background-color: #fff;
  border-radius: 34rpx;
  padding: 0 8rpx 0 26rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.search-text {
  flex: 1;
  font-size: 26rpx;
  color: #B3B3B3;
  margin-left: 12rpx;
}

.search-btn {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(90deg, #FF8A50, #FF6B35);
  color: #fff;
  font-size: 24rpx;
}

/* Banner */
.banner-wrap {
  margin: -64rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.18);
}

.banner-swiper {
  height: 300rpx;
}

.banner-item {
  position: relative;
  width: 100%;
  height: 300rpx;
}

.banner-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 300rpx;
}

.banner-text {
  position: absolute;
  left: 36rpx;
  top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.banner-tag {
  background-color: rgba(255, 255, 255, 0.95);
  color: #FF6B35;
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 16rpx;
  border-radius: 18rpx;
}

.banner-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-top: 18rpx;
}

.banner-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
}

.banner-cta {
  margin-top: 22rpx;
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  color: #fff;
  font-size: 22rpx;
}

/* 服务承诺 */
.promise-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 18rpx 36rpx 6rpx;
}

.promise {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 22rpx;
  color: #8C8C8C;
}

.promise-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background-color: #FF6B35;
  margin-right: 8rpx;
}

/* 分类导航：4×2 */
.category-nav {
  background-color: #fff;
  margin: 16rpx 24rpx 20rpx;
  padding: 28rpx 0 8rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.category-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
}

.category-name {
  font-size: 24rpx;
  color: #333;
  margin-top: 12rpx;
}

/* 通用区块 */
.section {
  background-color: #fff;
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
}

.section-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.title-bar {
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background-color: #FF6B35;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #1F1F1F;
  margin-left: 12rpx;
}

.title-sub {
  font-size: 22rpx;
  color: #FF6B35;
  background-color: #FFF1EA;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

.price-symbol {
  font-size: 22rpx;
  color: #FF4D1C;
  font-weight: bold;
}

/* 限时特惠：横向滚动 */
.flash-scroll {
  width: 100%;
}

.flash-row {
  display: flex;
  flex-direction: row;
}

.flash-card {
  width: 196rpx;
  min-width: 196rpx;
  margin-right: 18rpx;
  display: flex;
  flex-direction: column;
}

.flash-img {
  width: 196rpx;
  height: 196rpx;
  border-radius: 14rpx;
  background-color: #F3F3F3;
}

.flash-name {
  font-size: 24rpx;
  color: #333;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flash-price-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-top: 4rpx;
}

.flash-price {
  font-size: 30rpx;
  color: #FF4D1C;
  font-weight: bold;
}

.flash-original {
  font-size: 20rpx;
  color: #BBB;
  text-decoration: line-through;
  margin-left: 8rpx;
}

/* 热销推荐：双列卡片 */
.block-title {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
  padding: 12rpx 0 20rpx;
}

.block-title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #1F1F1F;
}

.block-title-sub {
  font-size: 22rpx;
  color: #999;
  margin-left: 12rpx;
}

.product-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx;
}

.grid-card {
  width: 343rpx;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.grid-img {
  width: 343rpx;
  height: 343rpx;
  background-color: #F3F3F3;
}

.grid-body {
  padding: 16rpx 20rpx 20rpx;
}

.grid-name {
  display: block;
  font-size: 28rpx;
  color: #1F1F1F;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grid-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grid-tags {
  display: flex;
  flex-direction: row;
  margin-top: 10rpx;
}

.tag {
  color: #FF6B35;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid #FFB896;
  margin-right: 8rpx;
}

.tag-grey {
  color: #8C8C8C;
  border-color: #DDDDDD;
}

.grid-bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.grid-price-wrap {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.grid-price {
  font-size: 34rpx;
  color: #FF4D1C;
  font-weight: bold;
}

.grid-sold {
  font-size: 20rpx;
  color: #AAA;
  margin-left: 10rpx;
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #FF8A50, #FF6B35);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
}

/* 新品上架：列表 */
.list-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2F2F2;
}

.list-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.list-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background-color: #F3F3F3;
}

.list-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.list-name {
  display: block;
  font-size: 28rpx;
  color: #1F1F1F;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.list-bottom {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-top: 24rpx;
}

.list-price {
  font-size: 32rpx;
  color: #FF4D1C;
  font-weight: bold;
}

.list-original {
  font-size: 22rpx;
  color: #BBB;
  text-decoration: line-through;
  margin-left: 8rpx;
}

.list-add {
  background: linear-gradient(90deg, #FF8A50, #FF6B35);
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 26rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 给自定义 tabBar 留位置 */
.bottom-space {
  height: 140rpx;
}
