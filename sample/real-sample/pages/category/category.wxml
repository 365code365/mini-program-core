<view class="page">
  <!-- 搜索入口 -->
  <view class="top-search">
    <view class="search-box">
      <icon type="search" size="14" color="#B3B3B3"></icon>
      <text class="search-text">搜索{{activeName}}好物</text>
    </view>
  </view>

  <view class="category-container">
    <!-- 左侧分类菜单 -->
    <scroll-view class="category-left" scroll-y="{{true}}">
      <view class="category-item {{item.id === activeCategory ? 'active' : ''}}"
            wx:for="{{categories}}"
            wx:key="id"
            bindtap="onCategoryChange"
            data-id="{{item.id}}">
        <view class="active-bar" wx:if="{{item.id === activeCategory}}"></view>
        <text class="category-text">{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 右侧商品列表 -->
    <scroll-view class="category-right" scroll-y="{{true}}" scroll-top="{{scrollTop}}">
      <view class="right-inner">
        <!-- 分类横幅 -->
        <view class="cat-banner">
          <text class="cat-banner-title">{{activeName}}精选</text>
          <text class="cat-banner-desc">品质好物 · 每周上新</text>
        </view>

        <!-- 子分类 -->
        <view class="subcategory-section" wx:if="{{subcategories.length > 0}}">
          <text class="block-title">热门分类</text>
          <view class="subcategory-list">
            <view class="subcategory-item"
                  wx:for="{{subcategories}}"
                  wx:key="id"
                  bindtap="onSubCategoryTap"
                  data-id="{{item.id}}">
              <image class="subcategory-img" src="{{item.image}}" mode="aspectFill"></image>
              <text class="subcategory-name">{{item.name}}</text>
            </view>
          </view>
        </view>

        <!-- 商品列表 -->
        <text class="block-title">全部商品 · {{products.length}}</text>
        <view class="product-item"
              wx:for="{{products}}"
              wx:key="id"
              bindtap="onProductTap"
              data-id="{{item.id}}">
          <image class="product-img" src="{{item.image}}" mode="aspectFill"></image>
          <view class="product-info">
            <text class="product-name">{{item.name}}</text>
            <text class="product-desc">{{item.desc}}</text>
            <view class="product-bottom">
              <view class="price-wrap">
                <text class="price-symbol">¥</text>
                <text class="product-price">{{item.price}}</text>
              </view>
              <view class="add-btn" catchtap="onAddCart" data-product="{{item}}">
                <text>+</text>
              </view>
            </view>
          </view>
        </view>
        <view class="bottom-space"></view>
      </view>
    </scroll-view>
  </view>
</view>
