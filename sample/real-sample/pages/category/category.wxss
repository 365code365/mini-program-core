/* 整页定高：顶部搜索 + 左右两栏（各自滚动），底部给自定义 tabBar 让出 100rpx */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #fff;
  padding-bottom: 100rpx;
  box-sizing: border-box;
}

.top-search {
  padding: 16rpx 24rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #F2F2F2;
}

.search-box {
  height: 64rpx;
  border-radius: 32rpx;
  background-color: #F5F5F5;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
}

.search-text {
  font-size: 26rpx;
  color: #B3B3B3;
  margin-left: 12rpx;
}

.category-container {
  flex: 1;
  display: flex;
  flex-direction: row;
  overflow: hidden;
}

/* 左侧分类 */
.category-left {
  width: 176rpx;
  height: 100%;
  background-color: #F7F7F7;
}

.category-item {
  position: relative;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-item.active {
  background-color: #fff;
}

.active-bar {
  position: absolute;
  left: 0;
  top: 32rpx;
  width: 6rpx;
  height: 36rpx;
  border-radius: 0 6rpx 6rpx 0;
  background-color: #FF6B35;
}

.category-text {
  font-size: 26rpx;
  color: #666;
}

.category-item.active .category-text {
  color: #FF6B35;
  font-weight: bold;
  font-size: 28rpx;
}

/* 右侧内容 */
.category-right {
  flex: 1;
  height: 100%;
  background-color: #fff;
}

.right-inner {
  padding: 20rpx 24rpx;
}

.cat-banner {
  height: 150rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FF8A50, #FF6B35);
  padding: 0 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-bottom: 28rpx;
}

.cat-banner-title {
  font-size: 34rpx;
  color: #fff;
  font-weight: bold;
}

.cat-banner-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.block-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #1F1F1F;
  margin-bottom: 20rpx;
}

/* 子分类 */
.subcategory-section {
  margin-bottom: 16rpx;
}

.subcategory-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.subcategory-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.subcategory-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background-color: #F5F5F5;
}

.subcategory-name {
  font-size: 22rpx;
  color: #666;
  margin-top: 10rpx;
}

/* 商品 */
.product-item {
  display: flex;
  flex-direction: row;
  margin-bottom: 28rpx;
}

.product-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background-color: #F5F5F5;
}

.product-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 28rpx;
  color: #1F1F1F;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.price-wrap {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.price-symbol {
  font-size: 22rpx;
  color: #FF4D1C;
  font-weight: bold;
}

.product-price {
  font-size: 34rpx;
  color: #FF4D1C;
  font-weight: bold;
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #FF8A50, #FF6B35);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
}

.bottom-space {
  height: 20rpx;
}
