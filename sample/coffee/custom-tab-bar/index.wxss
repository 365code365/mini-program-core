.tab-bar {
  display: flex;
  flex-direction: row;
  height: 100rpx;
  background: #ffffff;
  border-top: 1rpx solid #efe9e2;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-text {
  font-size: 20rpx;
  margin-top: 4rpx;
}
