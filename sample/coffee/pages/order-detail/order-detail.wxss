.head {
  margin: 24rpx 28rpx 0;
  padding: 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(160deg, #6b4226, #3d2416);
  color: #fff6ec;
}
.h-status {
  font-size: 40rpx;
  font-weight: bold;
}
.h-code {
  font-size: 30rpx;
  font-weight: bold;
  color: #f3d3a5;
}
.h-tip {
  display: block;
  font-size: 24rpx;
  margin-top: 8rpx;
  color: rgba(255, 246, 236, 0.8);
}
.h-steps {
  margin-top: 28rpx;
}
.h-step {
  flex: 1;
  margin-right: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 246, 236, 0.5);
}
.h-step:last-child {
  margin-right: 0;
}
.h-bar {
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 246, 236, 0.2);
  margin-bottom: 8rpx;
}
.h-step-on {
  color: #fff6ec;
  font-weight: bold;
}
.h-step-on .h-bar {
  background: #f3d3a5;
}
.h-ops {
  margin-top: 28rpx;
  flex-wrap: wrap;
}
.h-op {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  margin: 0 14rpx 10rpx 0;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 246, 236, 0.5);
  font-size: 24rpx;
}
.h-op-main {
  background: #f3d3a5;
  border-color: #f3d3a5;
  color: #5b3a29;
  font-weight: bold;
}
.stars {
  margin-top: 16rpx;
}
.star {
  font-size: 48rpx;
  line-height: 60rpx;
  color: #e5ddd4;
  margin-right: 12rpx;
}
.star-on {
  color: #e9a23b;
}
.star-text {
  font-size: 26rpx;
  color: #b5562a;
  margin-left: 8rpx;
}
.tags {
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.tag {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 20rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 26rpx;
  background: #f7f3ee;
  font-size: 24rpx;
  color: #5c5047;
  border: 1rpx solid #f7f3ee;
}
.tag-on {
  background: #fbf1e6;
  border-color: #a8693a;
  color: #6b4226;
}
.rate-input {
  width: 100%;
  height: 140rpx;
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: #f7f3ee;
  font-size: 26rpx;
}
.ph {
  color: #c2b8ae;
}
.rate-btn {
  margin-top: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}
.rate-text {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #5c5047;
}
.store-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #c98b4e, #8a5a3b);
  font-size: 30rpx;
  margin-right: 20rpx;
}
.s-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
}
.s-line {
  display: block;
  line-height: 34rpx;
}
.s-nav {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 22rpx;
  border-radius: 26rpx;
  background: #f7f3ee;
  color: #5b3a29;
  font-size: 24rpx;
  margin-left: 16rpx;
}
.deliver {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #f7f3ee;
  display: flex;
  flex-direction: column;
}
.deliver-text {
  font-size: 26rpx;
  font-weight: bold;
  line-height: 40rpx;
}
.item {
  margin-top: 24rpx;
}
.item-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 14rpx;
  margin-right: 20rpx;
}
.item-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 40rpx;
}
.item-spec {
  display: block;
  font-size: 22rpx;
  color: #9b9087;
}
.item-qty {
  margin: 0 24rpx;
}
.lines {
  margin-top: 24rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f1ebe4;
}
.line {
  height: 60rpx;
  font-size: 26rpx;
}
.cut {
  color: #b5562a;
}
.paid {
  height: 72rpx;
}
.paid-num {
  font-size: 36rpx;
}
.info-row {
  height: 64rpx;
  font-size: 26rpx;
}
.copy {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #8a5a3b;
  padding: 0 14rpx;
  line-height: 36rpx;
  border-radius: 18rpx;
  border: 1rpx solid #d8cdc2;
}
.remark {
  max-width: 420rpx;
}
.gap {
  height: 48rpx;
}
.none {
  padding-top: 240rpx;
  text-align: center;
}
