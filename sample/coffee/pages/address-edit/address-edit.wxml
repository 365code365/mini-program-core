<view class="card form">
  <view class="f-row row">
    <text class="f-label">联系人</text>
    <input class="f-input flex1 f-name" placeholder="收货人姓名" placeholder-class="ph" value="{{name}}" maxlength="16" bindinput="onName" />
  </view>
  <view class="f-row row">
    <text class="f-label">手机号</text>
    <input class="f-input flex1 f-phone" type="number" placeholder="11 位手机号" placeholder-class="ph" value="{{phone}}" maxlength="11" bindinput="onPhone" />
  </view>
  <picker mode="region" value="{{region}}" bindchange="onRegion">
    <view class="f-row row f-region">
      <text class="f-label">所在地区</text>
      <text class="flex1 {{region.length ? '' : 'ph'}}">{{region.length ? region[0] + ' ' + region[1] + ' ' + region[2] : '省 / 市 / 区'}}</text>
      <view class="arrow"></view>
    </view>
  </picker>
  <view class="f-row row no-border">
    <text class="f-label">详细地址</text>
    <input class="f-input flex1 f-detail" placeholder="街道、楼栋、门牌号" placeholder-class="ph" value="{{detail}}" maxlength="40" bindinput="onDetail" />
  </view>
</view>
<view class="card">
  <view class="f-row row">
    <text class="f-label">标签</text>
    <view class="row flex1">
      <text wx:for="{{tags}}" wx:key="*this" class="chip {{tag === item ? 'chip-on' : ''}}" data-tag="{{item}}" bindtap="onTag">{{item}}</text>
    </view>
  </view>
  <view class="f-row row between no-border">
    <view>
      <text class="f-label-strong">设为默认地址</text>
      <text class="sub f-hint">外送下单时优先使用</text>
    </view>
    <switch checked="{{isDefault}}" color="#6b4226" bindchange="onDefault" />
  </view>
</view>
<view class="btn save" bindtap="onSave">保存</view>
<view wx:if="{{id}}" class="del" bindtap="onDelete">删除地址</view>
