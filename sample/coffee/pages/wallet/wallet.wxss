.bal {
  margin: 24rpx 28rpx 0;
  padding: 36rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #8a5a3b, #3d2416);
  color: #fff6ec;
}
.bal-label {
  font-size: 24rpx;
  color: rgba(255, 246, 236, 0.8);
}
.bal-rule {
  font-size: 22rpx;
  padding: 0 16rpx;
  line-height: 40rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 246, 236, 0.5);
}
.bal-num {
  display: block;
  font-size: 72rpx;
  line-height: 100rpx;
  font-weight: bold;
  color: #f3d3a5;
  margin-top: 8rpx;
}
.bal-tip {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 246, 236, 0.7);
}
.opts {
  margin-top: 20rpx;
}
.opt {
  flex: 1;
  height: 140rpx;
  margin-right: 18rpx;
  border-radius: 18rpx;
  border: 2rpx solid #efe6dc;
  background: #fbf8f4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.opt:last-child {
  margin-right: 0;
}
.opt-on {
  border-color: #a8693a;
  background: #fbf1e6;
}
.opt-pay {
  font-size: 40rpx;
  font-weight: bold;
  color: #5b3a29;
}
.opt-bonus {
  font-size: 22rpx;
  color: #b5562a;
  margin-top: 4rpx;
}
.go {
  margin-top: 28rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
}
.log {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f0ea;
}
.log-type {
  width: 72rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 20rpx;
  margin-right: 18rpx;
  background: #f3ece4;
  color: #8a5a3b;
}
.log-recharge {
  background: #e7f3e4;
  color: #4f7a4a;
}
.log-refund {
  background: #e6eef8;
  color: #3f5f86;
}
.log-title {
  display: block;
  font-size: 26rpx;
}
.log-amt {
  font-size: 30rpx;
  font-weight: bold;
  margin-left: 16rpx;
}
.log-in {
  color: #4f7a4a;
}
.none {
  padding: 40rpx 0;
  text-align: center;
}
.gap {
  height: 48rpx;
}
