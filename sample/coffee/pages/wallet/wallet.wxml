<view class="bal">
  <view class="row between">
    <text class="bal-label">咖啡钱包余额（元）</text>
    <text class="bal-rule" bindtap="onRule">说明</text>
  </view>
  <text class="bal-num">{{balance}}</text>
  <text class="bal-tip">下单选「咖啡钱包」支付，免输密码更快取到咖啡</text>
</view>
<view class="card">
  <text class="title">充值</text>
  <view class="opts row">
    <view wx:for="{{options}}" wx:key="pay" class="opt {{pick === index ? 'opt-on' : ''}}" data-i="{{index}}" bindtap="onPick">
      <text class="opt-pay">¥{{item.pay}}</text>
      <text class="opt-bonus">送 ¥{{item.bonus}}</text>
    </view>
  </view>
  <view class="btn go" bindtap="onRecharge">立即充值 ¥{{options[pick].pay}}，到账 ¥{{options[pick].pay + options[pick].bonus}}</view>
</view>
<view class="card">
  <text class="title">收支明细</text>
  <view class="log row" wx:for="{{logs}}" wx:key="k">
    <text class="log-type log-{{item.type}}">{{item.typeName}}</text>
    <view class="flex1">
      <text class="log-title ellipsis">{{item.title}}</text>
      <text class="sub">{{item.time}}</text>
    </view>
    <text class="log-amt {{item.amount > 0 ? 'log-in' : ''}}">{{item.sign}}{{item.abs}}</text>
  </view>
  <view wx:if="{{!logs.length}}" class="sub none">还没有收支记录</view>
</view>
<view class="gap"></view>
