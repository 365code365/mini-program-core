.tt-main { padding-bottom: 16rpx; border-bottom: 1rpx solid #f0f2f4; display: flex; flex-direction: column; }
.tt-name { font-size: 29rpx; font-weight: bold; margin-right: 12rpx; }
.tag-gray { color: #4d565f; background: #f1f3f5; }
.def { font-size: 20rpx; color: #f2542d; border: 1rpx solid #f2542d; border-radius: 6rpx; padding: 0 8rpx; }
.ops { justify-content: flex-end; padding-top: 16rpx; }
.op { font-size: 25rpx; color: #4d565f; margin-left: 36rpx; }
.bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: #ffffff; display: flex; flex-direction: row; }
.bar-b { flex: 1; margin: 0 10rpx; height: 80rpx; line-height: 76rpx; }
.btn.bar-b { line-height: 80rpx; }
