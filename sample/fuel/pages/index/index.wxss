.top { background: #13a874; padding: 10rpx 28rpx 24rpx; display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.loc { display: flex; flex-direction: row; align-items: center; }
.loc-ic { font-size: 28rpx; }
.loc-tx { color: #ffffff; font-size: 30rpx; font-weight: bold; margin-left: 8rpx; }
.loc-tip { color: rgba(255,255,255,0.8); font-size: 22rpx; margin-left: 14rpx; }
.net { color: rgba(255,255,255,0.85); font-size: 22rpx; }
.banner { width: 702rpx; height: 243rpx; margin: 20rpx 24rpx 0; border-radius: 18rpx; }
.filter { display: flex; flex-direction: row; align-items: center; padding: 22rpx 24rpx 4rpx; }
.oil { display: flex; flex-direction: row; align-items: center; background: #13a874; border-radius: 28rpx; padding: 6rpx 22rpx; }
.oil-tx { color: #ffffff; font-size: 26rpx; font-weight: bold; }
.oil-arrow { color: #ffffff; font-size: 20rpx; margin-left: 6rpx; }
.sort { font-size: 26rpx; color: #4d565f; margin-left: 30rpx; }
.sort-on { color: #13a874; font-weight: bold; }
.mode { margin-left: auto; border: 2rpx solid #13a874; border-radius: 26rpx; padding: 4rpx 18rpx; }
.mode-tx { color: #13a874; font-size: 22rpx; }

.st { display: flex; flex-direction: row; align-items: flex-start; }
.st-logo { width: 72rpx; height: 72rpx; border-radius: 16rpx; }
.st-mid { flex: 1; margin-left: 18rpx; display: flex; flex-direction: column; overflow: hidden; }
.st-name { font-size: 29rpx; font-weight: bold; }
.st-addr { margin-top: 6rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.st-tags { margin-top: 12rpx; }
.tag-blue { color: #2f7be8; background: #e8f1fd; }
.st-right { display: flex; flex-direction: column; align-items: flex-end; margin-left: 12rpx; }
.st-p { align-items: baseline; }
.st-yen { font-size: 24rpx; }
.st-ours { font-size: 40rpx; }
.st-list { font-size: 20rpx; color: #a3aab1; text-decoration: line-through; }
.st-cut { font-size: 20rpx; color: #f2542d; }
.st-go { margin-top: 10rpx; background: #13a874; border-radius: 26rpx; height: 52rpx; padding: 0 22rpx; }
.st-go-tx { color: #ffffff; font-size: 24rpx; line-height: 52rpx; }

.mapwrap { position: relative; margin-top: 16rpx; }
.map { width: 750rpx; height: 760rpx; }
.map-cards { position: absolute; left: 0; right: 0; bottom: 20rpx; white-space: nowrap; }
.map-row { display: flex; flex-direction: row; padding: 0 24rpx; }
.mc { width: 300rpx; background: #ffffff; border-radius: 16rpx; padding: 18rpx; margin-right: 18rpx; flex-shrink: 0; border: 3rpx solid #ffffff; box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.12); }
.mc-on { border-color: #13a874; }
.mc-logo { width: 44rpx; height: 44rpx; border-radius: 10rpx; }
.mc-name { font-size: 26rpx; font-weight: bold; margin-left: 10rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; }
.mc-b { margin-top: 10rpx; }
.mc-ops { margin-top: 12rpx; }
.mc-op { flex: 1; text-align: center; font-size: 24rpx; color: #13a874; border: 2rpx solid #13a874; border-radius: 24rpx; height: 48rpx; line-height: 44rpx; margin-right: 10rpx; }
.mc-op-main { background: #13a874; color: #ffffff; margin-right: 0; }
