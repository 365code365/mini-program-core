.head { background: #13a874; padding: 16rpx 28rpx 36rpx; }
.oils { display: flex; flex-direction: row; }
.oil { font-size: 26rpx; color: rgba(255,255,255,0.85); padding: 6rpx 24rpx; border-radius: 26rpx; margin-right: 14rpx; background: rgba(255,255,255,0.15); }
.oil-on { background: #ffffff; color: #13a874; font-weight: bold; }
.cur { margin-top: 24rpx; }
.cur-k { color: rgba(255,255,255,0.85); font-size: 24rpx; }
.cur-row { align-items: baseline; }
.cur-v { color: #ffffff; font-size: 72rpx; font-weight: bold; }
.cur-u { color: #ffffff; font-size: 24rpx; margin-left: 8rpx; }
.chg { font-size: 24rpx; margin-left: 24rpx; border-radius: 6rpx; padding: 2rpx 12rpx; background: rgba(255,255,255,0.2); color: #ffffff; }
.cv { width: 654rpx; height: 400rpx; margin-top: 16rpx; }
.cv-fail { height: 120rpx; display: flex; align-items: center; justify-content: center; }
.hl { margin-top: 16rpx; }
.hl-it { flex: 1; display: flex; flex-direction: column; align-items: center; }
.hl-k { font-size: 22rpx; color: #8b939b; }
.hl-v { font-size: 28rpx; font-weight: bold; margin-top: 4rpx; }
.up { color: #f2542d; }
.down { color: #2f7be8; }
.rm { height: 52rpx; line-height: 48rpx; font-size: 22rpx; padding: 0 20rpx; }
.tr { display: flex; flex-direction: row; align-items: center; height: 76rpx; border-bottom: 1rpx solid #f0f2f4; }
.tr-d { flex: 1; font-size: 26rpx; color: #4d565f; }
.tr-v { flex: 1; font-size: 28rpx; font-weight: bold; text-align: center; }
.tr-diff { flex: 1; font-size: 26rpx; text-align: right; }
