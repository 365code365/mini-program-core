.floors { height: 44px; display: flex; flex-direction: row; align-items: center; padding: 0 20rpx; background: #ffffff; }
.fl { font-size: 26rpx; color: #6f655c; padding: 8rpx 24rpx; border-radius: 28rpx; margin-right: 12rpx; background: #f4efe9; }
.fl-on { background: #a45c34; color: #ffffff; }
.upd { margin-left: auto; font-size: 22rpx; color: #9a8f84; }
.sv { background: #f6f2ec; }
.tip { text-align: center; font-size: 22rpx; color: #b3a89c; padding: 16rpx 0 0; }
.hall { margin: 20rpx 28rpx 0; background: #ffffff; border-radius: 20rpx; overflow: hidden; position: relative; }
.hall-on { opacity: 0.85; }
.hall-img { width: 100%; height: 300rpx; }
.hall-badge { position: absolute; left: 20rpx; top: 20rpx; background: rgba(0, 0, 0, 0.45); color: #ffffff; font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; }
.hall-body { padding: 20rpx 24rpx 24rpx; display: flex; flex-direction: column; }
.hall-row { display: flex; flex-direction: row; align-items: center; }
.hall-n { font-size: 32rpx; font-weight: bold; }
.hall-th { font-size: 24rpx; color: #a45c34; }
.cr { margin-left: auto; font-size: 22rpx; padding: 2rpx 12rpx; border-radius: 6rpx; }
.cr0 { color: #2f8f5a; background: #e5f4ea; }
.cr1 { color: #b07a12; background: #fbf0d8; }
.cr2 { color: #c0392b; background: #fbe4e1; }
.hall-in { font-size: 24rpx; color: #6f655c; line-height: 38rpx; margin: 10rpx 0; }
