.nav { position: fixed; left: 0; top: 0; width: 100%; z-index: 50; }
.nav-title { position: absolute; left: 32rpx; font-size: 34rpx; font-weight: bold; }
.hero { position: relative; height: 560rpx; }
.hero-img { width: 100%; height: 560rpx; }
.hero-mask { position: absolute; left: 0; right: 0; bottom: 0; height: 260rpx; background: linear-gradient(rgba(0, 0, 0, 0), rgba(20, 14, 10, 0.55)); }
.hero-tx { position: absolute; left: 32rpx; bottom: 80rpx; display: flex; flex-direction: column; }
.hero-en { color: #f3d9bf; font-size: 22rpx; letter-spacing: 6rpx; }
.hero-cn { color: #ffffff; font-size: 40rpx; font-weight: bold; margin-top: 8rpx; }
.today { position: relative; margin: -48rpx 28rpx 0; background: #ffffff; border-radius: 20rpx; padding: 28rpx; display: flex; flex-direction: row; align-items: center; box-shadow: 0 8rpx 24rpx rgba(80, 50, 30, 0.08); }
.today-l { flex: 1; display: flex; flex-direction: column; }
.today-row { display: flex; flex-direction: row; align-items: center; margin-bottom: 6rpx; }
.dot { width: 16rpx; height: 16rpx; border-radius: 8rpx; background: #c9bfb4; margin-right: 12rpx; }
.dot-on { background: #3aa66b; }
.today-st { font-size: 34rpx; font-weight: bold; }
.today-left { font-size: 24rpx; color: #a45c34; margin-top: 8rpx; }
.today-btn { background: #a45c34; color: #ffffff; font-size: 26rpx; border-radius: 32rpx; padding: 0 30rpx; height: 64rpx; line-height: 64rpx; }
.entries { display: flex; flex-direction: row; margin: 24rpx 28rpx 0; background: #ffffff; border-radius: 20rpx; padding: 24rpx 0; }
.entry { flex: 1; display: flex; flex-direction: column; align-items: center; }
.entry-on { opacity: 0.6; }
.entry-ic { width: 84rpx; height: 84rpx; border-radius: 42rpx; background: #f7ebe2; color: #a45c34; font-size: 34rpx; font-weight: bold; text-align: center; line-height: 84rpx; }
.entry-t { font-size: 26rpx; margin-top: 12rpx; }
.entry-s { font-size: 20rpx; color: #9a8f84; margin-top: 4rpx; }
.expo-sw { height: 420rpx; margin-top: 20rpx; }
.expo { margin: 0 12rpx; height: 400rpx; border-radius: 20rpx; overflow: hidden; background: #ffffff; transform: scale(0.94); opacity: 0.8; }
.expo-cur { transform: scale(1); opacity: 1; }
.expo-img { width: 100%; height: 230rpx; }
.expo-info { padding: 16rpx 24rpx; display: flex; flex-direction: column; }
.expo-st { font-size: 20rpx; color: #8a7f74; }
.st-on { color: #3aa66b; }
.expo-t { font-size: 32rpx; font-weight: bold; margin-top: 4rpx; }
.expo-s { font-size: 22rpx; color: #6f655c; margin-top: 4rpx; }
.expo-d { font-size: 22rpx; color: #9a8f84; margin-top: 4rpx; }
.treasures { display: flex; flex-direction: row; flex-wrap: wrap; padding: 0 20rpx; }
.tr { width: 335rpx; margin: 20rpx 8rpx 0; background: #ffffff; border-radius: 16rpx; overflow: hidden; display: flex; flex-direction: column; padding-bottom: 16rpx; }
.tr-img { width: 335rpx; height: 335rpx; }
.tr-n { font-size: 28rpx; font-weight: bold; margin: 14rpx 18rpx 0; }
.tr-e { font-size: 22rpx; color: #9a8f84; margin: 4rpx 18rpx 0; }
.notice { padding: 12rpx 28rpx; }
.nt { display: flex; flex-direction: row; padding: 12rpx 0; }
.nt-i { width: 36rpx; height: 36rpx; border-radius: 18rpx; background: #f7ebe2; color: #a45c34; font-size: 22rpx; text-align: center; line-height: 36rpx; margin-right: 16rpx; flex-shrink: 0; }
.nt-t { flex: 1; font-size: 25rpx; color: #5c534b; line-height: 40rpx; }
