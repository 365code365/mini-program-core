.head { padding: 40rpx 32rpx 50rpx; background: linear-gradient(135deg, #3f9a3c, #6cbf5c); display: flex; flex-direction: column; }
.head-unpaid, .head-grouping { background: linear-gradient(135deg, #e4572e, #f08a3c); }
.head-cancelled, .head-refunded { background: linear-gradient(135deg, #8a9186, #a7ada3); }
.h1 { font-size: 38rpx; color: #ffffff; font-weight: bold; }
.h2 { font-size: 24rpx; color: rgba(255,255,255,0.88); margin-top: 8rpx; }
.lg { display: flex; flex-direction: row; }
.lg-axis { width: 40rpx; display: flex; flex-direction: column; align-items: center; padding-top: 28rpx; }
.lg-dot { width: 16rpx; height: 16rpx; border-radius: 8rpx; background: #c4c8c0; }
.lg-dot-on { background: #3f9a3c; }
.lg-line { width: 2rpx; flex: 1; background: #e0e3dc; margin-top: 6rpx; }
.lg-mid { flex: 1; display: flex; flex-direction: column; padding: 20rpx 0 10rpx 10rpx; }
.lg-tx { font-size: 26rpx; color: #5d6858; line-height: 1.5; }
.lg-tx-on { color: #1f2a1c; font-weight: bold; }
.refund-tip { margin-top: 12rpx; }
.addr-ic { font-size: 34rpx; margin-right: 16rpx; }
.addr-mid { flex: 1; display: flex; flex-direction: column; }
.addr-name { font-size: 28rpx; font-weight: bold; margin-right: 16rpx; }
.addr-detail { font-size: 26rpx; color: #3b4537; margin-top: 6rpx; line-height: 1.5; }
.it { display: flex; flex-direction: row; margin-bottom: 16rpx; }
.it-img { width: 130rpx; height: 130rpx; border-radius: 10rpx; }
.it-mid { flex: 1; margin-left: 16rpx; display: flex; flex-direction: column; }
.it-name { font-size: 27rpx; font-weight: bold; }
.it-right { display: flex; flex-direction: column; align-items: flex-end; font-size: 26rpx; }
.line { display: flex; flex-direction: row; justify-content: space-between; align-items: center; min-height: 70rpx; font-size: 26rpx; }
.line-v { color: #5d6858; max-width: 480rpx; text-align: right; }
.bar { position: fixed; left: 0; right: 0; bottom: 0; height: 110rpx; padding: 0 24rpx env(safe-area-inset-bottom); background: #ffffff; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; border-top: 1rpx solid #eceee8; }
.bar-b { border: 2rpx solid #c4c8c0; border-radius: 34rpx; height: 68rpx; padding: 0 32rpx; margin-left: 20rpx; }
.bar-tx { font-size: 26rpx; line-height: 64rpx; color: #3b4537; }
.bar-main { border-color: #e4572e; background: #e4572e; }
.bar-main .bar-tx { color: #ffffff; }
