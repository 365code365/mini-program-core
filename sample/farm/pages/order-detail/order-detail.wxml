<view class="head head-{{o.status}}">
  <text class="h1">{{statusText}}</text>
  <text class="h2">{{statusSub}}</text>
</view>

<view class="card" wx:if="{{logistics.length}}">
  <view class="row between">
    <text class="sec-title">物流信息</text>
    <text class="muted" bindtap="copyNo">顺丰 {{o.expressNo}} 复制</text>
  </view>
  <view class="lg" wx:for="{{logistics}}" wx:key="time">
    <view class="lg-axis">
      <view class="lg-dot {{index === 0 ? 'lg-dot-on' : ''}}"></view>
      <view class="lg-line" wx:if="{{index < logistics.length - 1}}"></view>
    </view>
    <view class="lg-mid">
      <text class="lg-tx {{index === 0 ? 'lg-tx-on' : ''}}">{{item.text}}</text>
      <text class="muted">{{item.time}}</text>
    </view>
  </view>
</view>

<view class="card" wx:if="{{o.refund}}">
  <text class="sec-title">售后进度</text>
  <view class="line"><text>退款原因</text><text class="line-v">{{o.refund.reason}}</text></view>
  <view class="line"><text>退款金额</text><text class="price">¥{{o.refund.amount}}</text></view>
  <view class="line" wx:if="{{o.refund.desc}}"><text>问题描述</text><text class="line-v">{{o.refund.desc}}</text></view>
  <text class="muted refund-tip">{{o.status === 'refunding' ? '商家将在 24 小时内处理，同意后 1~3 个工作日原路退回' : '已原路退回，请留意支付账户'}}</text>
</view>

<view class="card">
  <view class="row">
    <text class="addr-ic">📍</text>
    <view class="addr-mid">
      <view class="row"><text class="addr-name">{{o.address.name}}</text><text class="muted">{{o.address.phone}}</text></view>
      <text class="addr-detail">{{o.address.region[0]}} {{o.address.region[1]}} {{o.address.region[2]}} {{o.address.detail}}</text>
    </view>
  </view>
</view>

<view class="card">
  <view class="it" wx:for="{{o.items}}" wx:key="key" data-id="{{item.goodsId}}" bindtap="openGoods">
    <image class="it-img" src="{{item.cover}}" mode="aspectFill"></image>
    <view class="it-mid">
      <text class="it-name">{{item.name}}</text>
      <text class="muted">{{item.skuText}}</text>
    </view>
    <view class="it-right"><text>¥{{item.price}}</text><text class="muted">× {{item.qty}}</text></view>
  </view>
  <view class="line"><text>商品金额</text><text>¥{{o.goodsAmount}}</text></view>
  <view class="line"><text>运费</text><text>{{o.freight === '0.00' ? '包邮' : '¥' + o.freight}}</text></view>
  <view class="line"><text>实付款</text><text class="price">¥{{o.total}}</text></view>
</view>

<view class="card">
  <view class="line"><text>订单编号</text><text class="line-v" bindtap="copyOrderNo">{{o.no}} 复制</text></view>
  <view class="line"><text>下单时间</text><text class="line-v">{{createdText}}</text></view>
  <view class="line" wx:if="{{paidText}}"><text>付款时间</text><text class="line-v">{{paidText}}</text></view>
  <view class="line"><text>期望送达</text><text class="line-v">{{o.date}} {{o.slot}}</text></view>
  <view class="line" wx:if="{{o.remark}}"><text>备注</text><text class="line-v">{{o.remark}}</text></view>
</view>
<view style="height: 160rpx;"></view>

<view class="bar" wx:if="{{ops.length}}">
  <view class="bar-b {{item.main ? 'bar-main' : ''}}" wx:for="{{ops}}" wx:key="k" data-k="{{item.k}}" bindtap="onOp" hover-class="btn-hover">
    <text class="bar-tx">{{item.t}}</text>
  </view>
</view>

<cashier show="{{cashier}}" amount="{{o.total}}" order-no="{{o.no}}" bind:paid="onPaid" bind:cancel="onPayCancel"></cashier>
