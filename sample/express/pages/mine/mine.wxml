<view class="profile">
  <view class="row">
    <view class="me-avatar">鹿</view>
    <view class="flex1 me-main">
      <text class="me-name">林小鹿</text>
      <view class="row"><text class="vip">黄金会员</text><text class="me-phone">138****6630</text></view>
    </view>
    <text class="me-set" bindtap="onSetting">设置</text>
  </view>
  <view class="stats row">
    <view class="stat flex1" wx:for="{{stats}}" wx:key="label" data-k="{{item.key}}" bindtap="onStat">
      <text class="stat-num">{{item.num}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>
</view>

<view class="card coupon row" wx:if="{{coupon}}" bindtap="onUseCoupon">
  <view class="coupon-left">
    <text class="coupon-amt">¥{{coupon.amount}}</text>
    <text class="coupon-cond">{{coupon.min ? '满 ' + coupon.min + ' 可用' : '无门槛'}}</text>
  </view>
  <view class="flex1 coupon-main">
    <text class="coupon-title">{{coupon.title}}</text>
    <text class="sub">{{coupon.expire}} 前有效 · 共 {{couponCount}} 张可用</text>
  </view>
  <view class="coupon-btn"><text>查看</text></view>
</view>

<view class="card menu">
  <view class="menu-item row" wx:for="{{menus}}" wx:key="text" bindtap="onMenu" data-i="{{index}}">
    <view class="menu-icon" style="background: {{item.bg}}">{{item.glyph}}</view>
    <text class="flex1 menu-text">{{item.text}}</text>
    <text class="sub">{{item.hint}}</text>
    <view class="chev"></view>
  </view>
</view>

<view class="card menu">
  <view class="menu-item row" bindtap="onClear">
    <view class="menu-icon" style="background: #f2453d">清</view>
    <text class="flex1 menu-text">清除查询记录</text>
    <view class="chev"></view>
  </view>
</view>
<text class="ver">快递100查 v3.8.2 · 蓝鲸速达</text>
<view class="safe"></view>
