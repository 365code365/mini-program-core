.head {
  background: linear-gradient(180deg, #2f6bff, #5a90ff);
  border-radius: 0 0 48rpx 48rpx;
  padding: 32rpx 32rpx 40rpx;
  margin-bottom: 24rpx;
}
.head .logo {
  border: 4rpx solid rgba(255, 255, 255, 0.9);
}
.head-main {
  margin-left: 20rpx;
}
.head-carrier {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
}
.head-no {
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
}
.copy {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
  padding: 2rpx 16rpx;
}
.head-tag {
  background: #ffffff;
}
.route {
  margin-top: 36rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
}
.city {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 96rpx;
}
.city-name {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: bold;
}
.city-sub {
  color: rgba(255, 255, 255, 0.75);
  font-size: 22rpx;
  margin-top: 4rpx;
}
.route-line {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 20rpx;
}
.route-bar {
  width: 100%;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.3);
}
.route-fill {
  height: 8rpx;
  border-radius: 4rpx;
  background: #ffd25e;
}
.route-eta {
  margin-top: 14rpx;
  color: #ffffff;
  font-size: 24rpx;
}
.courier-main {
  margin-left: 20rpx;
}
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #ffd8a8, #ff9f5a);
  color: #ffffff;
  font-size: 36rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}
.courier-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-right: 14rpx;
}
.star {
  font-size: 24rpx;
  color: #ff9a1f;
}
.circle-btn {
  width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 30rpx;
  background: #eaf1ff;
  color: #2f6bff;
  font-size: 26rpx;
  font-weight: bold;
}
.tl-head {
  margin-bottom: 28rpx;
}
.tl-item {
  display: flex;
  flex-direction: row;
}
.tl-axis {
  width: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: #c8ceda;
  margin-top: 12rpx;
}
.first .tl-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
  background: #2f6bff;
  border: 6rpx solid #d6e3ff;
  margin-top: 4rpx;
}
.tl-line {
  flex: 1;
  width: 2rpx;
  background: #e3e7ee;
  margin-top: 8rpx;
}
.tl-body {
  margin-left: 16rpx;
  padding-bottom: 36rpx;
}
.tl-text {
  font-size: 26rpx;
  color: #8a919f;
  line-height: 40rpx;
}
.first .tl-text {
  color: #1f2329;
  font-weight: bold;
}
.tl-time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b3b9c4;
}
.actions {
  padding: 8rpx 24rpx 0;
}
.act-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: linear-gradient(90deg, #4c86ff, #2f6bff);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  margin: 0 12rpx;
}
.act-btn.ghost {
  background: #ffffff;
  color: #2f6bff;
  border: 2rpx solid #2f6bff;
}
.safe {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
