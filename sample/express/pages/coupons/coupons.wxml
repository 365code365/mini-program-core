<view class="tabs row">
  <view class="tab {{tab === 0 ? 'on' : ''}}" data-i="0" bindtap="onTab"><text class="tab-t">可用（{{counts[0]}}）</text><view class="tab-line" wx:if="{{tab === 0}}"></view></view>
  <view class="tab {{tab === 1 ? 'on' : ''}}" data-i="1" bindtap="onTab"><text class="tab-t">已使用 / 过期（{{counts[1]}}）</text><view class="tab-line" wx:if="{{tab === 1}}"></view></view>
</view>
<view class="empty" wx:if="{{!list.length}}"><text class="sub">{{tab === 0 ? '暂无可用的寄件券' : '没有已使用的券'}}</text></view>
<view class="card cp row {{item.status === 'valid' ? '' : 'off'}}" wx:for="{{list}}" wx:key="id">
  <view class="cp-l">
    <text class="cp-amt">¥{{item.amount}}</text>
    <text class="cp-cond">{{item.cond}}</text>
  </view>
  <view class="flex1 cp-main">
    <text class="cp-title">{{item.title}}</text>
    <text class="sub">{{item.expire}} 前有效 · 寄件通用</text>
  </view>
  <view class="cp-btn" wx:if="{{item.status === 'valid'}}" bindtap="onUse"><text>去寄件</text></view>
  <text class="cp-used" wx:else>已使用</text>
</view>
<text class="note">下单时自动使用最省的一张，每单限用一张；取消寄件后券退回。</text>
