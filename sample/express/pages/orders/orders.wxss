.tabs { background: #ffffff; height: 88rpx; margin-bottom: 24rpx; }
.tab { flex: 1; height: 88rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; }
.tab-t { font-size: 26rpx; color: #5c6370; white-space: nowrap; }
.tab.on .tab-t { color: #2f6bff; font-weight: bold; }
.tab-line { position: absolute; bottom: 0; width: 48rpx; height: 6rpx; border-radius: 3rpx; background: #2f6bff; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 160rpx 0; }
.go-send { margin-top: 32rpx; font-size: 28rpx; color: #ffffff; background: #2f6bff; border-radius: 40rpx; padding: 16rpx 56rpx; }
.o-main { margin-left: 20rpx; }
.o-name { font-size: 30rpx; font-weight: bold; }
.o-st { font-size: 24rpx; white-space: nowrap; }
.st-pending { color: #8a919f; }
.st-transit, .st-deliver { color: #2f6bff; }
.st-signed { color: #19a974; }
.st-cancelled { color: #c4c9d2; }
.route { margin: 24rpx 0 8rpx; background: #f6f8fc; border-radius: 16rpx; padding: 20rpx 24rpx; }
.r-city { display: flex; flex-direction: column; }
.r-city.right { align-items: flex-end; }
.r-c { font-size: 34rpx; font-weight: bold; }
.r-line { display: flex; flex-direction: column; align-items: center; padding: 0 20rpx; }
.r-goods { font-size: 22rpx; color: #8a919f; margin-bottom: 8rpx; white-space: nowrap; }
.r-bar { height: 4rpx; width: 100%; background: #c9d6f5; border-radius: 2rpx; }
.o-foot { margin-top: 20rpx; }
.o-pay { font-size: 28rpx; font-weight: bold; color: #1f2329; }
.o-btn { font-size: 24rpx; color: #5c6370; border: 2rpx solid #d6dbe6; border-radius: 26rpx; padding: 8rpx 22rpx; margin-left: 14rpx; white-space: nowrap; }
.o-btn.main { color: #2f6bff; border-color: #2f6bff; }
.o-cancel { color: #f2453d; border-color: #f7b4b0; }
.safe { height: 60rpx; }
