/* 热榜 / 签到 */
@keyframes pulseBtn { 0%,100% { transform: scale(1); } 50% { transform: scale(1.08); } }

.hnav {
  background-color: #D43C33;
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
}
.hnav-back,
.hnav-act {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hnav-title {
  flex: 1;
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  text-align: center;
}

.card {
  background-color: #fff;
  padding: 24rpx;
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
}
.card-title {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: bold;
}
.sub {
  font-size: 22rpx;
  color: #8A8A8A;
  margin-top: 8rpx;
}
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.col {
  display: flex;
  flex-direction: column;
}
.grow {
  flex: 1;
}

/* 签到按钮 */
.checkin-btn {
  background-color: #D43C33;
  border-radius: 32rpx;
  padding: 14rpx 34rpx;
}
.checkin-btn.checked {
  background-color: #F2F3F5;
}
.anim-pulse {
  animation: pulseBtn 1.2s ease-in-out infinite;
}
.checkin-tx {
  font-size: 26rpx;
  color: #fff;
  font-weight: bold;
}
.checked .checkin-tx {
  color: #9A9A9A;
}

/* 日历 */
.cal-week {
  display: flex;
  flex-direction: row;
  margin-top: 24rpx;
}
.cal-wd {
  width: 14.28%;
  font-size: 22rpx;
  color: #9A9A9A;
  text-align: center;
}
.cal-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.cal-cell {
  width: 14.28%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0;
}
.cal-day {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cal-done {
  background-color: #D43C33;
}
.cal-today {
  border: 2rpx solid #D43C33;
}
.cal-tx {
  font-size: 24rpx;
  color: #555;
}
.cal-tx-on {
  color: #fff;
  font-weight: bold;
}

/* 图表 */
.chart {
  width: 100%;
  height: 280rpx;
  margin: 16rpx 0;
}

/* 榜单 */
.filter {
  font-size: 26rpx;
  color: #666;
  margin-left: 24rpx;
}
.filter.on {
  color: #D43C33;
  font-weight: bold;
}
.rank-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.rank-no {
  width: 46rpx;
  font-size: 30rpx;
  font-weight: bold;
}
.no-top {
  color: #D43C33;
}
.no-normal {
  color: #CFCFCF;
}
.rank-title {
  font-size: 28rpx;
  color: #1a1a1a;
}
.bar-bg {
  height: 8rpx;
  border-radius: 4rpx;
  background-color: #F2F3F5;
  margin-top: 12rpx;
}
.bar-in {
  height: 8rpx;
  border-radius: 4rpx;
  background-color: #F0A5A0;
}
.rank-heat {
  font-size: 22rpx;
  color: #BFBFBF;
  margin-left: 16rpx;
}

/* 收藏 */
.fav-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.fav-tx {
  font-size: 28rpx;
  color: #333;
  margin-left: 14rpx;
}
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}
.empty-tx {
  font-size: 24rpx;
  color: #9A9A9A;
  margin-top: 20rpx;
}
.bottom-space {
  height: 140rpx;
}
