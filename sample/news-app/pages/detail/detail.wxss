.article {
  background-color: #fff;
  padding: 28rpx 24rpx 24rpx;
}

.article-title {
  display: block;
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.author-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 24rpx;
}

.author-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background-color: #EFEFEF;
  flex-shrink: 0;
}

.author-info {
  flex: 1;
  margin-left: 16rpx;
}

.author-name {
  display: block;
  font-size: 28rpx;
  color: #2A2A2A;
  font-weight: bold;
}

.author-time {
  display: block;
  font-size: 22rpx;
  color: #9A9A9A;
  margin-top: 6rpx;
}

.follow-btn {
  border: 1rpx solid #D43C33;
  border-radius: 28rpx;
  padding: 8rpx 24rpx;
  flex-shrink: 0;
}

.follow-btn.followed {
  border-color: #D9D9D9;
  background-color: #F5F5F5;
}

.follow-text {
  font-size: 24rpx;
  color: #D43C33;
}

.followed .follow-text {
  color: #9A9A9A;
}

.article-cover {
  width: 100%;
  height: 380rpx;
  border-radius: 10rpx;
  margin-top: 24rpx;
  background-color: #F0F0F0;
}

.article-body {
  display: block;
  font-size: 30rpx;
  line-height: 52rpx;
  color: #333;
  margin-top: 24rpx;
}

.tag-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

/* 相关阅读 / 评论 */
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.related {
  background-color: #fff;
  margin-top: 16rpx;
  padding: 24rpx;
}

.related-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F2F2F2;
}

.related-title {
  display: block;
  font-size: 28rpx;
  color: #2A2A2A;
  line-height: 40rpx;
}

.related-meta {
  display: block;
  font-size: 22rpx;
  color: #9A9A9A;
  margin-top: 8rpx;
}

.comments {
  background-color: #fff;
  margin-top: 16rpx;
  padding: 24rpx;
}

.comment-item {
  display: flex;
  flex-direction: row;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.comment-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #EFEFEF;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
  margin-left: 16rpx;
}

.comment-user {
  display: block;
  font-size: 24rpx;
  color: #5A6B8C;
  font-weight: bold;
}

.comment-text {
  display: block;
  font-size: 28rpx;
  color: #2A2A2A;
  line-height: 40rpx;
  margin-top: 8rpx;
}

.comment-foot {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}

.comment-time {
  font-size: 22rpx;
  color: #B5B5B5;
}

.comment-like {
  font-size: 22rpx;
  color: #8A8A8A;
}

.bottom-space {
  height: 120rpx;
}

/* 底部固定操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background-color: #fff;
  border-top: 1rpx solid #E6E6E6;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 20rpx;
}

.comment-input {
  flex: 1;
  height: 64rpx;
  background-color: #F2F3F5;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  margin-right: 20rpx;
}

.comment-input-text {
  font-size: 26rpx;
  color: #9A9A9A;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
}

.action-count {
  font-size: 20rpx;
  color: #8A8A8A;
  margin-top: 4rpx;
}

/* ── 新增：返回栏 / 夜间模式 / 评论输入 / 字号面板 ── */
.dnav {
  background-color: #D43C33;
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
}
.dnav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dnav-title {
  flex: 1;
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  text-align: center;
}
.dnav-act {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.dnav-font {
  font-size: 26rpx;
  color: #fff;
}

/* 夜间模式 */
.night {
  background-color: #1B1B1B;
}
.night .article,
.night .related,
.night .comments {
  background-color: #242424;
}
.night .article-title,
.night .section-title,
.night .related-title,
.night .comment-user {
  color: #EDEDED;
}
.night .article-body,
.night .comment-text {
  color: #BFBFBF;
}

/* 阅读进度 */
.read-row {
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
}
.read-tx {
  font-size: 22rpx;
  color: #8A8A8A;
  margin-bottom: 10rpx;
}

/* 评论输入 */
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.mine-tag {
  font-size: 18rpx;
  color: #fff;
  background-color: #D43C33;
  border-radius: 4rpx;
  padding: 2rpx 8rpx;
  margin-left: 12rpx;
}
.compose {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.compose-input {
  flex: 1;
  height: 64rpx;
  background-color: #F2F3F5;
  border-radius: 32rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #333;
}
.send-btn {
  background-color: #D43C33;
  border-radius: 32rpx;
  padding: 12rpx 28rpx;
  margin-left: 16rpx;
}
.send-tx {
  font-size: 26rpx;
  color: #fff;
}

/* 字号面板 */
.font-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 900;
}
.font-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx 40rpx 32rpx;
  z-index: 1000;
  display: flex;
  flex-direction: column;
}
.font-title {
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.font-preview {
  color: #666;
  line-height: 1.8;
  margin-top: 20rpx;
}
.font-done {
  background-color: #D43C33;
  border-radius: 44rpx;
  padding: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
}
.font-done-tx {
  font-size: 30rpx;
  color: #fff;
  font-weight: bold;
}
