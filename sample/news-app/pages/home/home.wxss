/* 固定顶栏：状态栏 + 品牌 / 搜索 + 频道栏，一整块红色，信息流在下面滚 */
.top-fixed {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 100;
  background: linear-gradient(to bottom, #DC443A, #CF362E);
}
.top-fixed .nav-bar {
  background: none;
  padding-top: 0;
  padding-bottom: 0;
}
/* 频道栏（在红色顶栏里：白字，当前频道加粗加大、白色下划线） */
.channel-bar {
  white-space: nowrap;
  height: 84rpx;
}
.channel-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 24rpx;
}
.channel-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.78);
}
.channel-active .channel-text {
  color: #fff;
  font-weight: bold;
  font-size: 34rpx;
}
.channel-underline {
  width: 32rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: #fff;
  margin-top: 4rpx;
}
/* 不在当前频道：下划线占位但不显示（切频道时文字不上下跳） */
.channel-underline-off {
  background-color: transparent;
}
/* 左右滑切频道：新频道的内容从滑动方向进来 */
@keyframes slideInLeft { from { transform: translateX(48px); opacity: 0.4; } to { transform: translateX(0); opacity: 1; } }
@keyframes slideInRight { from { transform: translateX(-48px); opacity: 0.4; } to { transform: translateX(0); opacity: 1; } }
.slide-in-left {
  animation: slideInLeft .22s ease-out both;
}
.slide-in-right {
  animation: slideInRight .22s ease-out both;
}
/* 置顶要闻 */
.top-news {
  background-color: #fff;
  padding: 22rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-bottom: 1rpx solid #F0F0F0;
}
.top-badge {
  font-size: 20rpx;
  color: #D43C33;
  border: 1rpx solid #D43C33;
  border-radius: 6rpx;
  padding: 0 8rpx;
  line-height: 30rpx;
  margin-right: 16rpx;
}
.top-title {
  flex: 1;
  font-size: 30rpx;
  color: #222222;
  font-weight: bold;
}
/* 信息流：与上方要闻区留一道灰缝 */
.feed {
  margin-top: 16rpx;
}
/* 大图卡片 */
.big-title {
  display: block;
  font-size: 36rpx;
  line-height: 52rpx;
  color: #222222;
  font-weight: bold;
}
.big-cover {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
  background-color: #F0F0F0;
}
/* 左文右图 */
.row-card {
  display: flex;
  flex-direction: row;
  align-items: stretch;
}
.row-left {
  flex: 1;
  margin-right: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.row-title {
  display: block;
  font-size: 32rpx;
  line-height: 46rpx;
  color: #222222;
}
.row-thumb {
  width: 228rpx;
  height: 152rpx;
  border-radius: 10rpx;
  background-color: #F0F0F0;
  flex-shrink: 0;
}
/* 三图 */
.triple-imgs {
  display: flex;
  flex-direction: row;
  margin-top: 18rpx;
  /* 每张图右侧留 8rpx 缝，整行往右多伸 8rpx 抵掉最后一张的缝 */
  margin-right: -8rpx;
}
.triple-img {
  flex: 1;
  height: 150rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
  background-color: #F0F0F0;
}
/* 热榜 */
.hot-card {
  margin-top: 16rpx;
}
.hot-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.hot-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222222;
}
.hot-more {
  font-size: 24rpx;
  color: #999999;
}
.hot-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.hot-rank {
  width: 40rpx;
  font-size: 30rpx;
  font-weight: bold;
  text-align: center;
}
.rank-1 {
  color: #D43C33;
}
.rank-2 {
  color: #F0612E;
}
.rank-3 {
  color: #F2A12E;
}
.rank-normal {
  color: #B5B5B5;
}
.hot-text {
  flex: 1;
  font-size: 28rpx;
  color: #222222;
  margin-left: 16rpx;
}
.hot-heat {
  font-size: 22rpx;
  color: #B0B0B0;
}
.bottom-space {
  height: 110rpx;
}
/* ── 要闻轮播 / 刷新提示 / 收藏动作 ── */
@keyframes spinRing { to { transform: rotate(360deg); } }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.nav-hot {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
}
.focus-swiper {
  width: 100%;
  height: 340rpx;
  background-color: #fff;
}
.focus-item {
  width: 100%;
  height: 340rpx;
  position: relative;
}
.focus-img {
  width: 100%;
  height: 340rpx;
}
.focus-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  /* 底部留出 48rpx 给指示点，标题不再压在点上 */
  padding: 64rpx 32rpx 48rpx;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.62));
  display: flex;
  flex-direction: column;
  /* 纵向 flex 的交叉轴默认 stretch，会把「要闻」标签拉成和标题一样宽
     （浏览器行为一致），这里让子项按内容宽度靠左 */
  align-items: flex-start;
}
.focus-tag {
  font-size: 20rpx;
  color: #fff;
  background-color: #D43C33;
  border-radius: 6rpx;
  padding: 0 10rpx;
  line-height: 32rpx;
  margin-bottom: 12rpx;
}
.focus-title {
  font-size: 32rpx;
  line-height: 44rpx;
  color: #fff;
  font-weight: bold;
}
.refresh-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  background-color: #fff;
}
.refresh-ring {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #F0F0F0;
  border-top-color: #D43C33;
  border-radius: 50%;
  animation: spinRing .8s linear infinite;
}
.refresh-tx {
  font-size: 24rpx;
  color: #999999;
  margin-left: 14rpx;
}
.refreshed {
  background-color: #FFF3F2;
  padding: 16rpx 32rpx;
}
.anim-fade {
  animation: fadeIn .35s ease-out both;
}
.refreshed-tx {
  font-size: 24rpx;
  color: #D43C33;
}
.grow {
  flex: 1;
}
.act {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.act-tx {
  font-size: 22rpx;
  color: #999999;
  margin-left: 6rpx;
}
