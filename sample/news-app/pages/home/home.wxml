<view class="page">
  <!-- 顶部（固定）：状态栏 + 品牌 / 搜索（右边给胶囊让位）+ 频道栏，一整块红色顶栏，信息流在它下面滚 -->
  <view class="top-fixed" style="padding-top:{{nav.statusBar}}px">
    <view class="nav-bar" style="height:{{nav.navHeight}}px;padding-right:{{nav.capsuleSpace}}px">
      <text class="nav-logo">头条</text>
      <view class="nav-search" bindtap="onSearchTap">
        <icon type="search" size="14" color="#9A9A9A"></icon>
        <text class="nav-search-text">{{searchHint}}</text>
      </view>
      <view class="nav-hot" bindtap="onMoreHot">
        <icon type="star" size="18" color="#ffffff"></icon>
      </view>
    </view>
    <!-- 频道栏：横向滚动；切频道（点或在信息流上左右滑）时把当前频道滚到中间 -->
    <scroll-view class="channel-bar" scroll-x="true" scroll-into-view="{{channelAnchor}}"
                 scroll-into-view-alignment="center" scroll-with-animation="{{true}}">
      <view
        wx:for="{{channels}}"
        wx:key="id"
        id="ch{{item.id}}"
        class="channel-item {{currentChannel == item.id ? 'channel-active' : ''}}"
        bindtap="onSelectChannel"
        data-id="{{item.id}}"
      >
        <text class="channel-text">{{item.name}}</text>
        <view class="channel-underline {{currentChannel == item.id ? '' : 'channel-underline-off'}}"></view>
      </view>
    </scroll-view>
  </view>
  <!-- 顶栏是 fixed 的：这里垫一块同样高的空白，内容从顶栏下面开始 -->
  <view style="height:{{headerHeight}}px"></view>
  <!-- 要闻轮播 -->
  <swiper class="focus-swiper" indicator-dots="{{true}}" autoplay="{{true}}" interval="3200"
          circular="{{true}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff">
    <swiper-item wx:for="{{focusList}}" wx:key="id">
      <view class="focus-item" bindtap="onOpenArticle" data-id="{{item.id}}">
        <image class="focus-img" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="focus-shade">
          <text class="focus-tag">{{item.tag}}</text>
          <text class="focus-title">{{item.title}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 轮播下面的内容：左右滑切频道（轮播自己吃横滑，不包进来） -->
  <view class="feed-wrap {{slideClass}}" bindtouchstart="onFeedTouchStart" bindtouchend="onFeedTouchEnd">
  <!-- 刷新提示（下拉刷新时出现，带动画） -->
  <view wx:if="{{refreshing}}" class="refresh-row">
    <view class="refresh-ring"></view>
    <text class="refresh-tx">正在刷新…</text>
  </view>
  <view wx:if="{{refreshedTip}}" class="refreshed anim-fade">
    <text class="refreshed-tx">{{refreshedTip}}</text>
  </view>

  <!-- 置顶要闻 -->
  <view class="top-news" bindtap="onOpenArticle" data-id="{{topNews.id}}">
    <text class="top-badge">置顶</text>
    <text class="top-title">{{topNews.title}}</text>
  </view>

  <!-- 信息流 -->
  <view class="feed">
    <!-- 大图卡片 -->
    <view class="card big-card">
      <text class="big-title" bindtap="onOpenArticle" data-id="{{bigCard.id}}">{{bigCard.title}}</text>
      <image class="big-cover" src="{{bigCard.cover}}" mode="aspectFill"
             bindtap="onOpenArticle" data-id="{{bigCard.id}}"></image>
      <view class="meta-row">
        <text class="tag">{{bigCard.tag}}</text>
        <text class="meta-source">{{bigCard.source}}</text>
        <view class="meta-dot"></view>
        <text class="meta-comment">{{bigCard.comments}}评论</text>
        <view class="grow"></view>
        <view class="act" catchtap="onToggleFav" data-id="{{bigCard.id}}" data-title="{{bigCard.title}}">
          <icon type="{{favMap['a' + bigCard.id] ? 'star' : 'star_o'}}" size="14"
                color="{{favMap['a' + bigCard.id] ? '#D43C33' : '#bbbbbb'}}"></icon>
          <text class="act-tx">收藏</text>
        </view>
      </view>
    </view>

    <!-- 左文右图卡片列表 -->
    <view
      class="card row-card"
      wx:for="{{list}}"
      wx:key="id"
      bindtap="onOpenArticle"
      data-id="{{item.id}}"
    >
      <view class="row-left">
        <text class="row-title">{{item.title}}</text>
        <view class="meta-row">
          <text wx:if="{{item.hot}}" class="tag">热</text>
          <text class="meta-source">{{item.source}}</text>
          <view class="meta-dot"></view>
          <text class="meta-comment">{{item.comments}}评论</text>
          <view class="grow"></view>
          <view class="act" catchtap="onToggleFav" data-id="{{item.id}}" data-title="{{item.title}}">
            <icon type="{{favMap['a' + item.id] ? 'star' : 'star_o'}}" size="14"
                  color="{{favMap['a' + item.id] ? '#D43C33' : '#bbbbbb'}}"></icon>
          </view>
        </view>
      </view>
      <image class="row-thumb" src="{{item.thumb}}" mode="aspectFill"></image>
    </view>

    <!-- 三图卡片 -->
    <view class="card triple-card" bindtap="onOpenArticle" data-id="{{tripleCard.id}}">
      <text class="row-title">{{tripleCard.title}}</text>
      <view class="triple-imgs">
        <image class="triple-img" wx:for="{{tripleCard.images}}" wx:key="*this" src="{{item}}" mode="aspectFill"></image>
      </view>
      <view class="meta-row">
        <text class="meta-source">{{tripleCard.source}}</text>
        <view class="meta-dot"></view>
        <text class="meta-comment">{{tripleCard.comments}}评论</text>
      </view>
    </view>

    <!-- 热榜 -->
    <view class="card hot-card">
      <view class="hot-head">
        <text class="hot-title">🔥 今日热榜</text>
        <text class="hot-more" bindtap="onMoreHot">更多</text>
      </view>
      <view class="hot-item" wx:for="{{hotList}}" wx:key="id" bindtap="onOpenArticle" data-id="{{item.id}}">
        <text class="hot-rank rank-{{index < 3 ? index + 1 : 'normal'}}">{{index + 1}}</text>
        <text class="hot-text">{{item.title}}</text>
        <text class="hot-heat">{{item.heat}}万</text>
      </view>
    </view>

    <!-- 触底加载 -->
    <view class="refresh-row">
      <text class="refresh-tx">没有更多了</text>
    </view>
  </view>

  </view>
  <view class="bottom-space"></view>
</view>
