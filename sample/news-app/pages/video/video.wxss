.filter-row {
  display: flex;
  flex-direction: row;
  background-color: #fff;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #EDEDED;
}

.filter-chip {
  background-color: #F2F3F5;
  border-radius: 26rpx;
  padding: 10rpx 26rpx;
  margin-right: 16rpx;
}

.chip-active {
  background-color: #FDECEA;
}

.chip-text {
  font-size: 26rpx;
  color: #5A5A5A;
}

.chip-active .chip-text {
  color: #D43C33;
  font-weight: bold;
}

.video-card {
  background-color: #fff;
  padding: 24rpx;
  border-bottom: 1rpx solid #EDEDED;
}

.cover-wrap {
  position: relative;
  width: 100%;
  height: 380rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background-color: #EDEDED;
}

.cover {
  width: 100%;
  height: 100%;
}

.duration {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  background-color: rgba(0, 0, 0, 0.65);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}

.duration-text {
  font-size: 20rpx;
  color: #fff;
}

.play-badge {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 88rpx;
  height: 88rpx;
  margin-left: -44rpx;
  margin-top: -44rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-icon {
  font-size: 32rpx;
  color: #fff;
}

.video-title {
  display: block;
  font-size: 32rpx;
  line-height: 44rpx;
  color: #1A1A1A;
  font-weight: bold;
  margin-top: 18rpx;
}

.bottom-space {
  height: 110rpx;
}

/* ── 新增：播放器 / 自动播放开关 / 收藏 ── */
.player {
  width: 100%;
  height: 380rpx;
  border-radius: 10rpx;
  background-color: #000;
}
.grow {
  flex: 1;
}
.auto-line {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.auto-tx {
  font-size: 22rpx;
  color: #8A8A8A;
  margin-right: 12rpx;
}
.act {
  display: flex;
  flex-direction: row;
  align-items: center;
}
