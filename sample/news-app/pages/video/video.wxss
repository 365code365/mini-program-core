.filter-row {
  display: flex;
  flex-direction: row;
  background-color: #fff;
  align-items: center;
  padding: 18rpx 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.filter-chip {
  background-color: #F2F3F5;
  border-radius: 28rpx;
  padding: 0 28rpx;
  line-height: 56rpx;
  margin-right: 16rpx;
}

.chip-active {
  background-color: #FDECEA;
}

.chip-text {
  font-size: 26rpx;
  color: #555555;
}

.chip-active .chip-text {
  color: #D43C33;
  font-weight: bold;
}

.video-card {
  background-color: #fff;
  padding: 24rpx 32rpx 26rpx;
  margin-top: 16rpx;
}

.cover-wrap {
  position: relative;
  width: 100%;
  height: 386rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #EDEDED;
}

.cover {
  width: 100%;
  height: 100%;
}

.duration {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  background-color: rgba(0, 0, 0, 0.55);
  border-radius: 20rpx;
  padding: 0 14rpx;
  line-height: 36rpx;
}

.duration-text {
  font-size: 20rpx;
  color: #fff;
}

.play-badge {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 96rpx;
  height: 96rpx;
  margin-left: -52rpx;
  margin-top: -52rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  background-color: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-icon {
  font-size: 34rpx;
  color: #fff;
  margin-left: 6rpx;
}

.video-title {
  display: block;
  font-size: 32rpx;
  line-height: 46rpx;
  color: #222222;
  font-weight: bold;
  margin-top: 20rpx;
}

.bottom-space {
  height: 110rpx;
}

/* ── 新增：播放器 / 自动播放开关 / 收藏 ── */
.player {
  width: 100%;
  height: 386rpx;
  border-radius: 12rpx;
  background-color: #000;
}
.grow {
  flex: 1;
}
.auto-line {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.auto-tx {
  font-size: 22rpx;
  color: #8A8A8A;
  margin-right: 12rpx;
}
.act {
  display: flex;
  flex-direction: row;
  align-items: center;
}
