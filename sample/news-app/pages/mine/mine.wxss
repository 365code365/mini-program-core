.user-header {
  background-color: #D43C33;
  background: linear-gradient(to bottom, #DC443A, #C9322B);
  padding: 48rpx 32rpx 96rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.user-avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.7);
  background-color: rgba(255, 255, 255, 0.35);
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
}

.user-name {
  display: block;
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.user-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}

.user-arrow {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 统计 */
.stat-card {
  background-color: #fff;
  /* 上浮压住红色头部，形成层次 */
  margin: -64rpx 24rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  padding: 30rpx 0;
  position: relative;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
}

.stat-value {
  font-size: 40rpx;
  color: #222222;
  font-weight: bold;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 菜单 */
.menu-card {
  background-color: #fff;
  margin: 0 24rpx 20rpx;
  border-radius: 16rpx;
  padding: 8rpx 28rpx 4rpx;
}

.menu-head {
  display: block;
  font-size: 28rpx;
  color: #222222;
  font-weight: bold;
  padding: 20rpx 0 8rpx;
}

.menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  margin-left: 20rpx;
}

.menu-badge {
  font-size: 20rpx;
  color: #fff;
  background-color: #D43C33;
  border-radius: 18rpx;
  padding: 2rpx 12rpx;
  margin-right: 12rpx;
}

.menu-arrow {
  font-size: 26rpx;
  color: #C8C8C8;
}

/* 开关 / 滑块 */
.switch-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.switch-label {
  font-size: 30rpx;
  color: #333333;
}

.slider-row {
  padding: 22rpx 0 8rpx;
}

.logout-wrap {
  padding: 12rpx 24rpx 20rpx;
}

.logout-btn {
  background-color: #fff;
  color: #D43C33;
  border-radius: 46rpx;
  font-size: 30rpx;
}

.bottom-space {
  height: 110rpx;
}

/* ── 新增：字号预览 ── */
.font-sample {
  color: #555;
  line-height: 1.8;
  margin-top: 16rpx;
}
