/* 头条新闻 · 全局样式 */
page {
  background-color: #F4F5F6;
}
/* 顶部品牌栏（红底 + 搜索框） */
.nav-bar {
  background-color: #D43C33;
  background: linear-gradient(to bottom, #DC443A, #CF362E);
  padding: 16rpx 28rpx 18rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.nav-logo {
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 2rpx;
  margin-right: 20rpx;
}
.nav-search {
  flex: 1;
  background-color: #ffffff;
  border-radius: 32rpx;
  height: 64rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
}
.nav-search-text {
  font-size: 26rpx;
  color: #A3A3A3;
  margin-left: 12rpx;
}
/* 卡片通用 */
.card {
  background-color: #fff;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.meta-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 16rpx;
}
.meta-source {
  font-size: 22rpx;
  color: #999999;
}
.meta-dot {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background-color: #C4C4C4;
  margin: 0 12rpx;
}
.meta-comment {
  font-size: 22rpx;
  color: #999999;
}
.tag {
  font-size: 20rpx;
  color: #D43C33;
  border: 1rpx solid #F2B8B3;
  border-radius: 6rpx;
  padding: 0 8rpx;
  line-height: 30rpx;
  margin-right: 12rpx;
}
