<view class="hero">
  <text class="hero-label">杭州二手房参考均价（元/㎡）</text>
  <text class="hero-num">38,612</text>
  <view class="row hero-row">
    <text class="hero-sub">环比上月 <text class="down">-0.6%</text></text>
    <text class="hero-sub">同比去年 <text class="down">-4.2%</text></text>
    <text class="hero-sub">本月成交 5,214 套</text>
  </view>
</view>
<view class="card">
  <view class="row between">
    <text class="title">各区房价</text>
    <view class="sorts row">
      <text class="st {{sortKey === 'avg' ? 'on' : ''}}" bindtap="onSort" data-k="avg">均价</text>
      <text class="st {{sortKey === 'mom' ? 'on' : ''}}" bindtap="onSort" data-k="mom">涨幅</text>
      <text class="st {{sortKey === 'deals' ? 'on' : ''}}" bindtap="onSort" data-k="deals">成交</text>
    </view>
  </view>
  <view class="d-row row" wx:for="{{districts}}" wx:key="name" bindtap="onDistrict" data-name="{{item.name}}">
    <text class="d-name">{{item.name}}</text>
    <view class="flex1 row base">
      <text class="d-avg">{{item.avgText}}</text>
      <text class="sub d-unit">元/㎡</text>
    </view>
    <text class="d-mom {{item.up ? 'up' : 'down'}}">{{item.momText}}</text>
    <text class="d-deals sub">{{item.deals}} 套</text>
    <view class="chev"></view>
  </view>
</view>
<view class="card">
  <text class="title">小区房价</text>
  <view class="search row">
    <input class="search-input flex1" placeholder="输入小区名查房价" value="{{kw}}" bindinput="onKw" />
  </view>
  <view class="c-row row" wx:for="{{communities}}" wx:key="id" bindtap="onCommunity" data-id="{{item.id}}">
    <view class="flex1">
      <text class="c-name">{{item.community}}</text>
      <text class="sub">{{item.district}} · {{item.typeText}}</text>
    </view>
    <text class="d-avg">{{item.unitText}}</text>
    <text class="sub d-unit">元/㎡</text>
    <view class="chev"></view>
  </view>
  <view class="c-empty" wx:if="{{!communities.length}}"><text class="sub">没有找到这个小区</text></view>
</view>
<view class="sell row" bindtap="onSell">
  <view class="flex1">
    <text class="sell-title">我家房子值多少？</text>
    <text class="sub">输入面积、楼层，1 分钟出估价</text>
  </view>
  <view class="sell-btn"><text>免费估价</text></view>
</view>
<view class="safe"></view>
