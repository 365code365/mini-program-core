.map {
  position: relative;
  margin: 0 24rpx 24rpx;
  height: 680rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #eef1ea;
}
.road {
  position: absolute;
  background: #ffffff;
}
.r1 {
  left: 0;
  right: 0;
  top: 300rpx;
  height: 14rpx;
}
.r2 {
  top: 0;
  bottom: 0;
  left: 400rpx;
  width: 14rpx;
}
.r3 {
  top: 0;
  bottom: 0;
  left: 180rpx;
  width: 10rpx;
}
.lake {
  position: absolute;
  left: 30rpx;
  top: 340rpx;
  width: 130rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #bfdcf2;
  display: flex;
  align-items: center;
  justify-content: center;
}
.river {
  position: absolute;
  left: 0;
  right: 0;
  top: 470rpx;
  height: 60rpx;
  background: #bfdcf2;
  display: flex;
  align-items: center;
  padding-left: 40rpx;
}
.geo {
  font-size: 20rpx;
  color: #6d8fae;
}
.bubble {
  position: absolute;
  width: 168rpx;
  padding: 10rpx 0;
  border-radius: 16rpx;
  background: #4f8bff;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 6rpx 16rpx rgba(47, 95, 224, 0.25);
}
.bubble.on {
  background: #ff6a1f;
  box-shadow: 0 6rpx 16rpx rgba(255, 90, 31, 0.3);
}
.bubble.none {
  background: #9aa1ad;
}
.b-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #ffffff;
  white-space: nowrap;
}
.b-avg {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}
.locate {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}
.loc-ring {
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  border: 4rpx solid #ff6a1f;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loc-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background: #ff6a1f;
}
.list {
  padding: 8rpx 28rpx;
}
.head {
  padding: 20rpx 0 4rpx;
}
.none-tip,
.tip {
  padding: 24rpx 0;
  text-align: center;
}
