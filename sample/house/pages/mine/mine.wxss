.head {
  background: linear-gradient(160deg, #ff8a3d 0%, #ff5a1f 100%);
  padding: 36rpx 32rpx 32rpx;
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: 24rpx;
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: linear-gradient(135deg, #ffe5c8, #ffc48a);
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  color: #b35a12;
  font-size: 44rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}
.me {
  margin-left: 22rpx;
}
.me-name {
  display: block;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: bold;
}
.me-sub {
  display: block;
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-top: 6rpx;
}
.edit {
  font-size: 24rpx;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
}
.stats {
  margin-top: 32rpx;
}
.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
}
.stat-label {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
}
.bk {
  margin-top: 24rpx;
  align-items: flex-start;
}
.bk-img {
  width: 150rpx;
  height: 112rpx;
  border-radius: 12rpx;
}
.bk-main {
  margin-left: 20rpx;
}
.bk-name {
  font-size: 28rpx;
  font-weight: bold;
}
.bk-status {
  font-size: 22rpx;
  color: #ff5a1f;
  background: #fff1e8;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.bk-status.done {
  color: #19a974;
  background: #e7f7f0;
}
.bk-time {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #1f2329;
}
.bk-empty {
  padding: 32rpx 0 8rpx;
  text-align: center;
}
.menu {
  padding: 4rpx 28rpx;
}
.m-item {
  height: 100rpx;
  border-bottom: 1rpx solid #f0f1f4;
}
.m-item:last-child {
  border-bottom: none;
}
.m-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.m-text {
  font-size: 28rpx;
}
