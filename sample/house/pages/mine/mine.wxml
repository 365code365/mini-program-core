<view class="head">
  <view class="row">
    <view class="avatar"><text>{{initial}}</text></view>
    <view class="flex1 me">
      <text class="me-name">{{profile.name}}</text>
      <text class="me-sub">已实名 · 杭州 · {{profile.need}}</text>
    </view>
    <view class="edit" bindtap="onEdit"><text>购房需求</text></view>
  </view>
  <view class="stats row">
    <view class="stat flex1" bindtap="onFavTab"><text class="stat-num">{{favCount}}</text><text class="stat-label">收藏</text></view>
    <view class="stat flex1" bindtap="onHistoryTab"><text class="stat-num">{{historyCount}}</text><text class="stat-label">足迹</text></view>
    <view class="stat flex1" bindtap="onBookings"><text class="stat-num">{{bookingCount}}</text><text class="stat-label">看房</text></view>
    <view class="stat flex1" bindtap="onSubs"><text class="stat-num">{{subCount}}</text><text class="stat-label">订阅</text></view>
  </view>
</view>
<view class="card">
  <view class="row between">
    <text class="title">我的看房预约</text>
    <view class="more-link" bindtap="onBookings"><text>{{pendingCount ? pendingCount + ' 条待带看' : '全部'}}</text><view class="chev"></view></view>
  </view>
  <view class="bk row" wx:for="{{bookings}}" wx:key="id" bindtap="onBookings">
    <image class="bk-img" src="{{item.cover}}" mode="aspectFill" />
    <view class="flex1 bk-main">
      <view class="row between">
        <text class="bk-name">{{item.community}}</text>
        <text class="bk-status {{item.status === 'done' ? 'done' : (item.status === 'cancelled' ? 'gray' : '')}}">{{item.statusText}}</text>
      </view>
      <text class="sub">{{item.layout}} · {{item.area}}㎡ · 经纪人 {{item.agent}}</text>
      <text class="bk-time">{{item.time}}</text>
    </view>
  </view>
  <view class="bk-empty" wx:if="{{!bookings.length}}"><text class="sub">暂无预约，去房源详情页预约看房</text></view>
</view>
<view class="card menu">
  <view class="m-item row" wx:for="{{menus}}" wx:key="key" bindtap="onMenu" data-key="{{item.key}}">
    <view class="m-icon" style="background: {{item.bg}}"><text>{{item.glyph}}</text></view>
    <text class="flex1 m-text">{{item.text}}</text>
    <text class="sub m-hint">{{item.hint}}</text>
    <view class="chev"></view>
  </view>
</view>
<view class="tab-safe"></view>
