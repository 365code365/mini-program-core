.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  background: #ffffff;
  border-top: 1rpx solid #eceef2;
  padding-bottom: env(safe-area-inset-bottom);
}
.tab-item {
  flex: 1;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tab-icon {
  width: 48rpx;
  height: 48rpx;
}
.tab-text {
  font-size: 20rpx;
  margin-top: 6rpx;
}
