page {
  background: #f5f6f8;
  color: #1f2329;
  font-size: 28rpx;
}
.card {
  background: #ffffff;
  border-radius: 20rpx;
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
}
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.between {
  justify-content: space-between;
}
.flex1 {
  flex: 1;
}
.title {
  font-size: 32rpx;
  font-weight: bold;
}
.sub {
  font-size: 24rpx;
  color: #8a919f;
}
.chev {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #c4c9d2;
  border-right: 3rpx solid #c4c9d2;
  transform: rotate(45deg);
  margin: 0 8rpx 0 16rpx;
}
.btn-primary {
  background: linear-gradient(90deg, #ff8a3d, #ff5a1f);
  color: #ffffff;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
}
.tab-safe {
  height: calc(140rpx + env(safe-area-inset-bottom));
}
/* 房源卡（首页 / 列表 / 收藏共用） */
.h-card {
  display: flex;
  flex-direction: row;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}
.h-img {
  width: 240rpx;
  height: 180rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}
.h-main {
  flex: 1;
  margin-left: 22rpx;
  overflow: hidden;
}
.h-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1f2329;
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.h-brief {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a919f;
}
.h-tags {
  display: flex;
  flex-direction: row;
  margin-top: 10rpx;
}
.h-tag {
  font-size: 20rpx;
  color: #4a7bd1;
  background: #eef3fc;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
}
.h-tag.hot {
  color: #e8590c;
  background: #fff1e8;
}
.h-price {
  margin-top: 10rpx;
  display: flex;
  flex-direction: row;
  align-items: baseline;
}
.h-price-main {
  font-size: 34rpx;
  font-weight: bold;
  color: #f2453d;
}
.h-price-unit {
  font-size: 22rpx;
  color: #f2453d;
  margin-left: 4rpx;
}
.h-price-sub {
  font-size: 22rpx;
  color: #a3a8b3;
  margin-left: 14rpx;
}
/* 引擎给 input 默认 12px/8px 内边距（微信是 0），而且把 padding 全 0 当成「没写」照样套默认值，
   所以各页输入框 class 里写的是 padding: 0 0 0 1rpx（左边 0.5px，看不出来） */
