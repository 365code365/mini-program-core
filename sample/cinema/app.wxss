page { background: #f5f6f8; color: #1f2329; font-size: 28rpx; }
.card { background: #fff; border-radius: 20rpx; margin: 0 24rpx 24rpx; padding: 28rpx; }
.row { display: flex; flex-direction: row; align-items: center; }
.between { justify-content: space-between; }
.flex1 { flex: 1; }
.sub { font-size: 24rpx; color: #8a9099; }
.red { color: #F0384D; }
.gold { color: #FFB400; }
.btn-primary { background: linear-gradient(90deg, #FF5A6E, #E8243F); color: #fff; font-size: 32rpx; font-weight: bold; height: 92rpx; line-height: 92rpx; text-align: center; border-radius: 46rpx; }
.tag { font-size: 20rpx; color: #F0384D; border: 1rpx solid #FFB3BD; padding: 2rpx 10rpx; border-radius: 6rpx; margin-right: 10rpx; }
.chev { width: 14rpx; height: 14rpx; border-top: 3rpx solid #c4c7cc; border-right: 3rpx solid #c4c7cc; transform: rotate(45deg); margin-left: 10rpx; }
/* 引擎的 input 只要 padding 全为 0 就套用默认 8px/12px 内边距（微信里 input 无内边距），给 1rpx 让它认作自定义 */
input { padding: 0 0 0 1rpx; }
