<view class="redeem row">
  <input id="code{{formSeq}}" class="r-input" placeholder="输入兑换码（试试 GY2026）" value="{{code}}" bindinput="onCode" />
  <view class="r-btn" bindtap="onRedeem"><text>兑换</text></view>
</view>
<view class="tabs row">
  <view class="tab {{tab === 0 ? 'tab-on' : ''}}" data-i="0" bindtap="onTab"><text>可用（{{usable.length}}）</text></view>
  <view class="tab {{tab === 1 ? 'tab-on' : ''}}" data-i="1" bindtap="onTab"><text>已使用（{{used.length}}）</text></view>
</view>
<view wx:if="{{tab === 0 && !usable.length}}" class="empty sub">没有可用的优惠券</view>
<view wx:if="{{tab === 1 && !used.length}}" class="empty sub">还没有用过优惠券</view>
<view class="cp {{tab === 1 ? 'cp-used' : ''}}" wx:for="{{tab === 0 ? usable : used}}" wx:key="id">
  <view class="cp-left">
    <text class="cp-yen">¥<text class="cp-off">{{item.off}}</text></text>
    <text class="cp-min">{{item.min ? '满' + item.min + '可用' : '无门槛'}}</text>
  </view>
  <view class="flex1 cp-mid">
    <text class="cp-name">{{item.name}}</text>
    <text class="sub">{{item.desc}}</text>
    <text class="sub">有效期至 {{item.exp}}</text>
  </view>
  <view wx:if="{{tab === 0}}" class="cp-use" bindtap="onUse"><text>去使用</text></view>
  <text wx:else class="cp-done">已使用</text>
</view>
<view class="gap"></view>
