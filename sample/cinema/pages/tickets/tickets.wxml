<view class="tabs row">
  <view class="tab {{tab === item.key ? 'tab-on' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="onTab"><text>{{item.name}}{{item.n ? ' ' + item.n : ''}}</text></view>
</view>
<view wx:if="{{!list.length}}" class="empty">
  <text class="empty-t">{{tab === 'all' ? '还没有电影票' : '这里还没有电影票'}}</text>
  <view class="empty-btn" bindtap="onGo">去选片</view>
</view>
<view class="ticket {{item.status === 'refunded' ? 'refunded' : ''}}" wx:for="{{list}}" wx:key="id">
  <view class="t-top row" data-id="{{item.id}}" bindtap="onDetail">
    <image class="t-poster" src="{{item.poster}}" mode="aspectFill"></image>
    <view class="flex1 t-info">
      <view class="row between"><text class="t-title">{{item.title}}</text><text class="t-status st-{{item.status}}">{{item.statusText}}</text></view>
      <text class="t-time">{{item.day}} {{item.time}}</text>
      <text class="sub t-line">{{item.cinema}}</text>
      <text class="sub t-line">{{item.hall}} · {{item.seatText}}</text>
    </view>
  </view>
  <view class="t-cut">
    <view class="notch left"></view>
    <view class="dash"></view>
    <view class="notch right"></view>
  </view>
  <view class="t-bottom" wx:if="{{open === item.id && item.status === 'unused'}}">
    <view class="qr" data-id="{{item.id}}" bindtap="onToggle">
      <view class="qr-row" wx:for="{{qr}}" wx:key="index" wx:for-item="qrow">
        <view class="qr-cell {{v ? 'on' : ''}}" wx:for="{{qrow}}" wx:key="index" wx:for-item="v"></view>
      </view>
    </view>
    <text class="code-label">取票码</text>
    <text class="code">{{item.codeText}}</text>
    <text class="sub">请在开场前到 {{item.hall}} 旁自助机取票，或直接扫码入场</text>
    <view class="row t-acts">
      <view class="t-act {{item.canRefund ? '' : 't-act-off'}}" data-id="{{item.id}}" bindtap="onRefund"><text>退票</text></view>
      <view class="t-act {{item.canChange ? '' : 't-act-off'}}" data-id="{{item.id}}" bindtap="onChange"><text>{{item.changed ? '已改签' : '改签'}}</text></view>
      <view class="t-act" data-id="{{item.id}}" bindtap="onNav"><text>导航到影院</text></view>
    </view>
  </view>
  <view class="t-bottom fold row" wx:else data-id="{{item.id}}" bindtap="onToggle">
    <text class="sub" wx:if="{{item.status === 'unused'}}">点击查看取票码</text>
    <text class="sub" wx:elif="{{item.status === 'used'}}">{{item.reviewed ? '已写影评，点击修改' : '感谢观影，去写影评吧'}}</text>
    <text class="sub" wx:else>已退 ¥{{item.refund.amount}}</text>
    <text class="t-price">¥{{item.total}}</text>
  </view>
</view>
<view class="gap"></view>
