<view wx:if="{{!t}}" class="empty">
  <text class="sub">没有找到这张电影票</text>
  <view class="empty-btn" bindtap="onTickets"><text>查看我的票</text></view>
</view>
<block wx:else>
  <view class="banner st-{{t.status}}">
    <text class="b-title">{{t.statusText}}</text>
    <text class="b-sub" wx:if="{{t.status === 'unused'}}">请提前 15 分钟到场，凭取票码或二维码入场</text>
    <text class="b-sub" wx:elif="{{t.status === 'used'}}">感谢观影，说说你的观后感吧</text>
    <text class="b-sub" wx:else>已退 ¥{{t.refund.amount}}（手续费 ¥{{t.refund.fee}}），1-3 个工作日原路到账</text>
  </view>
  <view class="card movie">
    <image class="poster" src="{{t.poster}}" mode="aspectFill"></image>
    <view class="flex1 info">
      <text class="title">{{t.title}}</text>
      <text class="line strong">{{t.day}} {{t.time}}-{{t.end}}</text>
      <text class="line">{{t.lang}} · {{t.hall}}</text>
      <text class="line">{{t.seatText}}</text>
      <text class="line" wx:if="{{t.changed}}">已改签（原场次 {{t.changed.from}}）</text>
    </view>
  </view>
  <view class="card code-card" wx:if="{{t.status === 'unused'}}">
    <view class="qr">
      <view class="qr-row" wx:for="{{qr}}" wx:key="index" wx:for-item="qrow">
        <view class="qr-cell {{v ? 'on' : ''}}" wx:for="{{qrow}}" wx:key="index" wx:for-item="v"></view>
      </view>
    </view>
    <text class="code-label">取票码</text>
    <view class="row"><text class="code">{{t.codeText}}</text><text class="copy" bindtap="onCopy">复制</text></view>
    <text class="sub" wx:if="{{t.snackCode}}">卖品取货码 {{t.snackCode}}（爆米花可乐套餐，凭码到卖品柜台领取）</text>
  </view>
  <view class="card">
    <view class="row between c-row" bindtap="onNav">
      <view class="flex1 c-col">
        <text class="c-name">{{t.cinema}}</text>
        <text class="sub">点击查看位置与路线</text>
      </view>
      <view class="chev"></view>
    </view>
    <view class="row c-acts">
      <view class="c-op" bindtap="onNav"><text>导航到影院</text></view>
      <view class="c-op" bindtap="onCall"><text>联系影院</text></view>
    </view>
  </view>
  <view class="card">
    <text class="block-title">订单信息</text>
    <view class="kv row between"><text class="k">票价（¥{{t.price}} × {{t.seats.length}}）</text><text>¥{{t.ticketFee}}</text></view>
    <view class="kv row between"><text class="k">服务费</text><text>¥{{t.service}}</text></view>
    <view class="kv row between" wx:if="{{t.snackFee}}"><text class="k">卖品</text><text>¥{{t.snackFee}}</text></view>
    <view class="kv row between" wx:if="{{t.discount}}"><text class="k">{{t.coupon ? t.coupon.name : '优惠'}}</text><text class="red">-¥{{t.discount}}</text></view>
    <view class="kv row between" wx:if="{{t.changed && t.changed.diff}}"><text class="k">改签差价</text><text>{{t.changed.diff > 0 ? '+' : '-'}}¥{{t.changed.diff > 0 ? t.changed.diff : -t.changed.diff}}</text></view>
    <view class="kv row between"><text class="k">实付</text><text class="red strong">¥{{t.total}}</text></view>
    <view class="kv row between"><text class="k">支付方式</text><text>{{t.payText}}</text></view>
    <view class="kv row between"><text class="k">手机号</text><text>{{t.phone}}</text></view>
    <view class="kv row between"><text class="k">订单号</text><text>{{t.id}}</text></view>
    <view class="kv row between"><text class="k">下单时间</text><text>{{t.createdText}}</text></view>
  </view>
  <view class="tips card" wx:if="{{t.status === 'unused'}}">
    <text class="tips-t">· 开场前 60 分钟以外可退票（¥2/张 手续费）或改签一次</text>
    <text class="tips-t">· 退票后优惠券退回账户，会员卡支付的退回卡内余额</text>
  </view>
  <view class="bottom-space"></view>
  <view class="bar">
    <block wx:if="{{t.status === 'unused'}}">
      <view class="bar-btn ghost {{t.canRefund ? '' : 'off'}}" bindtap="onRefund"><text>退票</text></view>
      <view class="bar-btn ghost {{t.canChange ? '' : 'off'}}" bindtap="onChange"><text>{{t.changed ? '已改签' : '改签'}}</text></view>
      <view class="bar-btn main" bindtap="onNav"><text>去影院</text></view>
    </block>
    <block wx:elif="{{t.status === 'used'}}">
      <view class="bar-btn ghost" bindtap="onRebuy"><text>再次购票</text></view>
      <view class="bar-btn main" bindtap="onReview"><text>{{t.reviewed ? '查看影评' : '写影评'}}</text></view>
    </block>
    <block wx:else>
      <view class="bar-btn main" bindtap="onRebuy"><text>重新购票</text></view>
    </block>
  </view>
</block>
