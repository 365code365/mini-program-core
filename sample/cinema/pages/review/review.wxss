page { padding-top: 24rpx; }
.movie { display: flex; flex-direction: row; }
.poster { width: 120rpx; height: 168rpx; border-radius: 10rpx; }
.info { margin-left: 22rpx; display: flex; flex-direction: column; justify-content: center; }
.title { font-size: 32rpx; font-weight: bold; margin-bottom: 10rpx; }
.block-title { display: block; font-size: 28rpx; font-weight: bold; }
.stars { margin-top: 16rpx; }
.star { font-size: 56rpx; color: #e3e5e8; margin-right: 14rpx; }
.star-on { color: #FFB400; }
.star-text { font-size: 26rpx; color: #FFB400; margin-left: 10rpx; }
.tag-title { margin-top: 30rpx; }
.tags { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 16rpx; }
.tg { font-size: 24rpx; color: #4e5969; background: #f5f6f8; border: 2rpx solid #f5f6f8; border-radius: 28rpx; padding: 8rpx 24rpx; margin: 0 16rpx 16rpx 0; white-space: nowrap; }
.tg-on { color: #F0384D; background: #FFF1F3; border: 2rpx solid #FFB3BD; }
.ta { width: 100%; height: 240rpx; margin-top: 10rpx; background: #f5f6f8; border-radius: 14rpx; padding: 20rpx; box-sizing: border-box; font-size: 28rpx; }
.ph { color: #b5b9bf; }
.count { display: block; text-align: right; font-size: 22rpx; color: #b5b9bf; margin-top: 10rpx; }
.btns { padding: 16rpx 24rpx 40rpx; }
.del { margin-top: 28rpx; text-align: center; font-size: 26rpx; color: #9aa0a6; }
