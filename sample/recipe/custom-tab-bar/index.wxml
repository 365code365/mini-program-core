<view class="tab-bar">
  <view class="tab-item" wx:for="{{list}}" wx:key="pagePath" data-path="{{item.pagePath}}" data-index="{{index}}" bindtap="switchTab">
    <view class="tab-icon" style="background: {{selected === index ? selectedColor : '#f6efe6'}}">
      <text class="tab-glyph" style="color: {{selected === index ? '#ffffff' : color}}">{{item.glyph}}</text>
    </view>
    <text class="tab-text" style="color: {{selected === index ? selectedColor : color}}">{{item.text}}</text>
  </view>
</view>
