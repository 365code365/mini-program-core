.top { padding: 16rpx 24rpx; background: #fff; }
.loc { margin-right: 20rpx; }
.loc-dot { width: 16rpx; height: 16rpx; border-radius: 8rpx; background: #00B87A; margin-right: 10rpx; }
.loc-t { font-size: 28rpx; font-weight: bold; }
.search { background: #f2f4f3; height: 68rpx; border-radius: 34rpx; padding: 0 24rpx; }
.search-icon { width: 20rpx; height: 20rpx; border: 4rpx solid #9aa0a6; border-radius: 14rpx; margin-right: 14rpx; }
/* input 的 font-size 恰好 14px(28rpx) 时引擎当成「没写」改用 16px，所以写 26rpx */
.search-input { font-size: 26rpx; height: 68rpx; }
.ph { color: #b0b5bc; }

.map { position: relative; height: 440rpx; background: #eef1ec; overflow: hidden; }
.park { position: absolute; background: #d8ecd2; border-radius: 40rpx; }
.p1 { left: 30rpx; top: 230rpx; width: 220rpx; height: 160rpx; }
.p2 { left: 500rpx; top: 30rpx; width: 200rpx; height: 120rpx; border-radius: 60rpx; }
.river { position: absolute; left: -40rpx; right: -40rpx; top: 300rpx; height: 40rpx; background: #cfe3f5; transform: rotate(-8deg); }
.road { position: absolute; background: #ffffff; }
.h1 { left: 0; right: 0; top: 120rpx; height: 22rpx; }
.h2 { left: 0; right: 0; top: 380rpx; height: 14rpx; }
.v1 { top: 0; bottom: 0; left: 270rpx; width: 22rpx; }
.v2 { top: 0; bottom: 0; left: 560rpx; width: 14rpx; }
.d1 { left: 300rpx; top: 220rpx; width: 520rpx; height: 12rpx; transform: rotate(28deg); background: #fbe7b8; }
.road-name { position: absolute; font-size: 20rpx; color: #8a9a8e; }
.n1 { left: 40rpx; top: 90rpx; }
.n2 { left: 590rpx; top: 66rpx; }
.me { position: absolute; width: 0; height: 0; }
.me-halo { position: absolute; left: -36rpx; top: -36rpx; width: 72rpx; height: 72rpx; border-radius: 36rpx; background: rgba(45, 140, 240, 0.18); }
.me-dot { position: absolute; left: -14rpx; top: -14rpx; width: 22rpx; height: 22rpx; border-radius: 14rpx; background: #2D8CF0; border: 4rpx solid #fff; }
.marker { position: absolute; margin-left: -50rpx; margin-top: -70rpx; width: 100rpx; display: flex; flex-direction: column; align-items: center; }
.m-bubble { background: #00B87A; border-radius: 28rpx; padding: 4rpx 14rpx 4rpx 4rpx; box-shadow: 0 6rpx 14rpx rgba(0, 120, 80, 0.3); }
.m-bolt { width: 40rpx; height: 40rpx; border-radius: 20rpx; background: #fff; display: flex; flex-direction: row; align-items: center; justify-content: center; margin-right: 8rpx; }
.m-bolt-t { font-size: 22rpx; color: #00B87A; font-weight: bold; }
.m-t { color: #fff; font-size: 26rpx; font-weight: bold; }
/* 气泡尖角：border 透明边拼三角引擎画不出来，用旋转方块 */
.m-tip { width: 16rpx; height: 16rpx; background: #00B87A; transform: rotate(45deg); margin-top: -10rpx; }
.marker.sel .m-bubble, .marker.sel .m-tip { background: #FF7A1A; }
.marker.sel .m-bolt-t { color: #FF7A1A; }
.marker.full .m-bubble, .marker.full .m-tip { background: #a3aab2; }
.locate { position: absolute; right: 24rpx; bottom: 84rpx; width: 72rpx; height: 72rpx; border-radius: 16rpx; background: #fff; box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1); display: flex; flex-direction: row; align-items: center; justify-content: center; }
.locate-in { width: 22rpx; height: 22rpx; border-radius: 14rpx; border: 5rpx solid #2D8CF0; }

.scan-bar { margin: -60rpx 24rpx 20rpx; position: relative; background: linear-gradient(100deg, #22D193, #00A36C); border-radius: 24rpx; padding: 28rpx; box-shadow: 0 10rpx 24rpx rgba(0, 160, 110, 0.25); }
.scan-ic { position: relative; width: 64rpx; height: 64rpx; margin-right: 24rpx; }
.sc { position: absolute; width: 18rpx; height: 18rpx; border-color: #fff; border-style: solid; border-width: 0; }
.c1 { left: 0; top: 0; border-top-width: 5rpx; border-left-width: 5rpx; }
.c2 { right: 0; top: 0; border-top-width: 5rpx; border-right-width: 5rpx; }
.c3 { left: 0; bottom: 0; border-bottom-width: 5rpx; border-left-width: 5rpx; }
.c4 { right: 0; bottom: 0; border-bottom-width: 5rpx; border-right-width: 5rpx; }
.sc-line { position: absolute; left: 8rpx; right: 8rpx; top: 29rpx; height: 5rpx; background: #fff; border-radius: 3rpx; }
.scan-title { color: #fff; font-size: 34rpx; font-weight: bold; }
.scan-sub { color: rgba(255, 255, 255, 0.85); font-size: 24rpx; margin-top: 4rpx; }
.chev.white { border-color: #fff; width: 18rpx; height: 18rpx; }
.charging-tip { margin: 0 24rpx 20rpx; background: #e6f8f0; border-radius: 16rpx; padding: 20rpx 24rpx; }
.pulse { width: 16rpx; height: 16rpx; border-radius: 8rpx; background: #00B87A; margin-right: 14rpx; }
.tip-t { color: #00835a; font-size: 26rpx; }
.filters { white-space: nowrap; margin-bottom: 20rpx; }
.filters-in { padding: 0 24rpx; }
.chip { background: #fff; border-radius: 28rpx; padding: 10rpx 26rpx; margin-right: 16rpx; flex-shrink: 0; }
.chip.on { background: #00B87A; }
.chip-t { font-size: 26rpx; color: #5c6370; white-space: nowrap; }
.chip.on .chip-t { color: #fff; font-weight: bold; }
.st { border: 2rpx solid transparent; }
.st-sel { border-color: #FF9B4D; }
.st-name { font-size: 30rpx; font-weight: bold; margin-right: 16rpx; }
.st-dist { font-size: 24rpx; color: #5c6370; }
.st-addr { display: block; margin: 8rpx 0 20rpx; }
.st-mid { margin-bottom: 18rpx; }
.free { margin-right: 28rpx; }
.free-ic { width: 36rpx; height: 36rpx; border-radius: 8rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; margin-right: 10rpx; }
.free-ic.fast { background: #FF7A1A; }
.free-ic.slow { background: #2D8CF0; }
.free-ic-t { color: #fff; font-size: 20rpx; font-weight: bold; }
.free-n { font-size: 28rpx; font-weight: bold; color: #00A36C; }
.free-n.none { color: #a3aab2; }
.free-total { font-size: 24rpx; color: #9aa0a6; }
.price { font-size: 36rpx; color: #FF7A1A; }
