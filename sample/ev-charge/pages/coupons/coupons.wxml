<view class="tabs row">
  <view class="tab {{tab === 0 ? 'on' : ''}}" data-i="0" bindtap="onTab"><text class="tab-t">可用（{{validCount}}）</text><view class="tab-line" wx:if="{{tab === 0}}"></view></view>
  <view class="tab {{tab === 1 ? 'on' : ''}}" data-i="1" bindtap="onTab"><text class="tab-t">已使用 / 过期（{{usedCount}}）</text><view class="tab-line" wx:if="{{tab === 1}}"></view></view>
</view>
<view class="card redeem row">
  <input id="code{{codeSeq}}" class="code-input flex1" placeholder="输入兑换码，如 EV2026" placeholder-class="ph" value="{{code}}" maxlength="16" bindinput="onCode" />
  <view class="redeem-btn" bindtap="onRedeem"><text class="redeem-t">兑换</text></view>
</view>
<view wx:if="{{list.length === 0}}" class="empty col">
  <view class="empty-ic"><text class="empty-ic-t">券</text></view>
  <text class="sub">{{tab === 0 ? '暂无可用充电券' : '没有已使用的券'}}</text>
</view>
<view wx:for="{{list}}" wx:key="id" class="cp row {{item.status === 'valid' ? '' : 'off'}}">
  <view class="cp-l col">
    <view class="row cp-amt"><text class="cp-y" wx:if="{{item.unit === '元'}}">¥</text><text class="cp-big">{{item.big}}</text><text class="cp-u" wx:if="{{item.unit === '折'}}">折</text></view>
    <text class="cp-cond">{{item.cond}}</text>
  </view>
  <view class="col flex1 cp-r">
    <text class="cp-title">{{item.title}}</text>
    <text class="sub">有效期至 {{item.expire}}</text>
  </view>
  <view wx:if="{{item.status === 'valid'}}" class="cp-use" bindtap="onUse"><text class="cp-use-t">去充电</text></view>
  <text wx:else class="cp-used">已使用</text>
</view>
<text class="sub tip">结束充电时自动使用最省的一张券，每单限用一张。</text>
