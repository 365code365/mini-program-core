.top { background: linear-gradient(180deg, #0f3d2e 0%, #11573f 100%); padding: 24rpx 32rpx 40rpx; margin-bottom: 20rpx; }
.st-line { margin-bottom: 24rpx; }
.live { width: 14rpx; height: 14rpx; border-radius: 7rpx; background: #22D193; margin-right: 12rpx; animation: blink 1.2s ease-in-out infinite; }
@keyframes blink { 0% { opacity: 1; } 50% { opacity: 0.25; } 100% { opacity: 1; } }
.st-t { color: #fff; font-size: 28rpx; }
.term-t { color: rgba(255, 255, 255, 0.7); font-size: 24rpx; }
/* 引擎里定宽块的 margin: 0 auto 不居中，外面套一层 flex 居中 */
.ring-wrap { display: flex; flex-direction: row; justify-content: center; }
.ring { position: relative; width: 440rpx; height: 440rpx; }
.dot { position: absolute; width: 14rpx; height: 14rpx; border-radius: 7rpx; background: rgba(255, 255, 255, 0.16); }
.dot.on { background: #22D193; box-shadow: 0 0 8rpx rgba(34, 209, 147, 0.8); }
.ring-in { position: absolute; left: 60rpx; top: 60rpx; width: 320rpx; height: 320rpx; border-radius: 160rpx; background: radial-gradient(circle, #1a6b4f 0%, #0f3d2e 100%); align-items: center; justify-content: center; }
.pct-l { color: rgba(255, 255, 255, 0.7); font-size: 24rpx; }
.pct-row { align-items: flex-end; }
.pct { color: #fff; font-size: 108rpx; font-weight: bold; line-height: 120rpx; }
.pct-u { color: #fff; font-size: 36rpx; font-weight: bold; margin: 0 0 22rpx 4rpx; }
.pct-sub { color: #7fe8c2; font-size: 24rpx; }
.stats { margin-top: 36rpx; background: rgba(255, 255, 255, 0.08); border-radius: 20rpx; padding: 24rpx 0; }
.stat { flex: 1; align-items: center; }
.stat-n { color: #fff; font-size: 40rpx; font-weight: bold; white-space: nowrap; }
.stat-l { color: rgba(255, 255, 255, 0.65); font-size: 22rpx; margin-top: 6rpx; }
.vline { width: 1rpx; height: 60rpx; background: rgba(255, 255, 255, 0.15); }
.grid { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 12rpx; }
.g-item { width: 50%; padding: 18rpx 0; }
.g-n { font-size: 36rpx; font-weight: bold; margin-bottom: 4rpx; white-space: nowrap; }
.g-u { font-size: 22rpx; color: #8a9099; font-weight: normal; }
.tips { padding: 20rpx 28rpx; }
.tip { align-items: flex-start; margin: 8rpx 0; }
.tip-dot { width: 10rpx; height: 10rpx; border-radius: 5rpx; background: #c4c7cc; margin: 14rpx 14rpx 0 0; }
.tip-t { flex: 1; font-size: 24rpx; color: #8a9099; line-height: 38rpx; }
.bottom-space { height: calc(150rpx + env(safe-area-inset-bottom)); }
.bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); }
.btn-stop { background: #F5455C; color: #fff; font-size: 30rpx; font-weight: bold; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 44rpx; }
