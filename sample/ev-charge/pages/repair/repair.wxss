.tabs { background: #fff; margin-bottom: 20rpx; }
.tab { flex: 1; height: 88rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; border-bottom: 4rpx solid transparent; }
.tab-on { border-bottom-color: #00B87A; }
.tab-t { font-size: 28rpx; color: #5c6370; }
.tab-on .tab-t { color: #00B87A; font-weight: bold; }
.ipt { height: 80rpx; margin-top: 16rpx; background: #f6f7f8; border-radius: 12rpx; padding-left: 20rpx; font-size: 28rpx; }
.ph { color: #b4b9c0; }
.ok-t { display: block; margin-top: 12rpx; font-size: 24rpx; color: #00A36C; }
.err-t { display: block; margin-top: 12rpx; font-size: 24rpx; color: #F5455C; }
.form-err { margin: 0 24rpx 16rpx; }
.types { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 12rpx; }
.ty { padding: 12rpx 22rpx; margin: 8rpx 16rpx 8rpx 0; border-radius: 30rpx; background: #f2f3f5; font-size: 26rpx; color: #4e5566; border: 2rpx solid #f2f3f5; }
.ty-on { background: #e6f8f0; color: #00A36C; border-color: #00B87A; font-weight: bold; }
.desc { width: 100%; height: 180rpx; margin-top: 16rpx; background: #f6f7f8; border-radius: 12rpx; padding: 16rpx 20rpx; box-sizing: border-box; font-size: 28rpx; }
.photos { margin-top: 20rpx; flex-wrap: wrap; }
.ph-item { position: relative; width: 150rpx; height: 150rpx; margin-right: 20rpx; }
.ph-img { width: 150rpx; height: 150rpx; border-radius: 12rpx; }
.ph-del { position: absolute; right: -10rpx; top: -10rpx; width: 40rpx; height: 40rpx; border-radius: 20rpx; background: rgba(0, 0, 0, 0.6); display: flex; flex-direction: row; align-items: center; justify-content: center; }
.ph-del-t { color: #fff; font-size: 28rpx; }
.ph-add { width: 150rpx; height: 150rpx; border-radius: 12rpx; border: 2rpx dashed #c4c7cc; align-items: center; justify-content: center; box-sizing: border-box; }
.ph-plus { font-size: 52rpx; color: #a0a6ae; }
.sample { display: block; margin-top: 16rpx; font-size: 24rpx; color: #2D8CF0; }
.submit-btn { margin: 8rpx 24rpx 0; }
.foot { display: block; text-align: center; margin: 24rpx 48rpx 0; }
.empty { align-items: center; padding: 160rpx 0; }
.empty-ic { width: 120rpx; height: 120rpx; border-radius: 60rpx; background: #e6f8f0; display: flex; flex-direction: row; align-items: center; justify-content: center; margin-bottom: 20rpx; }
.empty-ic-t { color: #00B87A; font-size: 44rpx; font-weight: bold; }
.rec-no { font-size: 28rpx; font-weight: bold; }
.rec-st { font-size: 24rpx; }
.st-0 { color: #FF7A1A; }
.st-1 { color: #2D8CF0; }
.st-2 { color: #00A36C; }
.rec-line { display: block; margin-top: 8rpx; }
.steps { margin-top: 20rpx; }
.sp-dot { width: 20rpx; height: 20rpx; border-radius: 10rpx; background: #dcdfe3; }
.sp-line { width: 220rpx; height: 4rpx; background: #dcdfe3; }
.sp-on { background: #00B87A; }
.rec-note { display: block; margin-top: 16rpx; font-size: 24rpx; color: #4e5566; }
.bottom-space { height: 80rpx; }
