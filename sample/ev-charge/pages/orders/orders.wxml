<view class="summary row">
  <view class="sum col"><text class="sum-n">{{sum.count}}</text><text class="sum-l">累计充电(次)</text></view>
  <view class="sum col"><text class="sum-n">{{sum.kwh}}</text><text class="sum-l">累计电量(度)</text></view>
  <view class="sum col"><text class="sum-n">{{sum.co2}}</text><text class="sum-l">减少碳排(kg)</text></view>
</view>

<view class="tabs row">
  <view wx:for="{{tabs}}" wx:key="*this" class="tab {{tIdx === index ? 'on' : ''}}" data-idx="{{index}}" bindtap="onTab">
    <text class="tab-t">{{item}}</text>
    <view class="tab-line" wx:if="{{tIdx === index}}"></view>
  </view>
</view>

<view class="card going row" wx:if="{{session && tIdx !== 2}}" bindtap="onSession">
  <view class="g-ic"><text class="g-ic-t">充</text></view>
  <view class="col flex1">
    <text class="o-name">{{session.stationName}}</text>
    <text class="sub">终端 {{session.no}}·正在充电</text>
  </view>
  <text class="g-tag">查看进度</text>
</view>

<view wx:for="{{shown}}" wx:key="id" class="card order" data-idx="{{index}}" bindtap="onOrder">
  <view class="row between o-head">
    <text class="o-name flex1">{{item.stationName}}</text>
    <text class="o-st">已完成</text>
  </view>
  <view class="row o-body">
    <view class="o-kv col"><text class="o-v">{{item.kwh}}</text><text class="sub">电量(度)</text></view>
    <view class="o-kv col"><text class="o-v">{{item.minutes}}</text><text class="sub">时长(分钟)</text></view>
    <view class="o-kv col right"><text class="o-v fee money">¥{{item.feeText}}</text><text class="sub">实付</text></view>
  </view>
  <view class="row between o-foot">
    <text class="sub">{{item.date}}·{{item.terminal}}</text>
    <text class="sub">{{item.id}}</text>
  </view>
</view>
<view wx:if="{{shown.length === 0 && !(session && tIdx !== 2)}}" class="empty col">
  <view class="empty-ic"></view>
  <text class="sub">暂无订单</text>
</view>
<view class="tabbar-space"></view>
