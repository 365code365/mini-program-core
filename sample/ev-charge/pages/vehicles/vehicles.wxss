.top-gap { height: 20rpx; }
.plate { background: linear-gradient(135deg, #3FD7A0, #00A36C); border-radius: 10rpx; padding: 8rpx 20rpx; margin-right: 16rpx; border: 3rpx solid #fff; box-shadow: 0 0 0 2rpx #00A36C; }
.plate-t { color: #fff; font-size: 32rpx; font-weight: bold; white-space: nowrap; }
.car-sub { display: block; margin: 16rpx 0 20rpx; }
.ops { border-top: 1rpx solid #f2f3f5; padding-top: 20rpx; }
.radio { width: 32rpx; height: 32rpx; border-radius: 16rpx; border: 3rpx solid #c4c7cc; display: flex; flex-direction: row; align-items: center; justify-content: center; margin-right: 12rpx; }
.radio.on { border-color: #00B87A; }
.radio-in { width: 16rpx; height: 16rpx; border-radius: 8rpx; background: #00B87A; }
.op-t { font-size: 26rpx; color: #5c6370; }
.op { font-size: 26rpx; color: #5c6370; margin-left: 36rpx; }
.op-del { color: #F5455C; }
.tip { display: block; padding: 8rpx 36rpx; line-height: 36rpx; }
.empty { align-items: center; padding: 120rpx 0 60rpx; }
.empty-ic { width: 120rpx; height: 120rpx; border-radius: 60rpx; background: #eaf3fe; margin-bottom: 20rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.empty-ic-t { color: #2D8CF0; font-size: 44rpx; font-weight: bold; }
.bottom-space { height: calc(150rpx + env(safe-area-inset-bottom)); }
.bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04); }
