.dm { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.45); z-index: 90; }
.dlg { position: fixed; left: 60rpx; right: 60rpx; top: 320rpx; background: #ffffff; border-radius: 20rpx; z-index: 91; padding: 40rpx 32rpx 0; }
.dt { display: block; font-size: 32rpx; font-weight: bold; text-align: center; color: #1d2129; }
.di { width: 100%; height: 160rpx; margin-top: 28rpx; background: #f2f3f5; border-radius: 12rpx; padding: 16rpx; box-sizing: border-box; font-size: 28rpx; }
.de { display: block; color: #f53f3f; font-size: 22rpx; margin-top: 8rpx; }
.db { display: flex; flex-direction: row; margin: 32rpx -32rpx 0; border-top: 1rpx solid #e5e6eb; }
.dbtn { flex: 1; height: 100rpx; line-height: 100rpx; text-align: center; font-size: 30rpx; color: #4e5969; }
.dok { color: #1677ff; font-weight: bold; border-left: 1rpx solid #e5e6eb; }
