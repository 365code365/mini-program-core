.days { background: #ffffff; padding: 16rpx; }
.day { flex: 1; align-items: center; padding: 12rpx 0; border-radius: 12rpx; margin: 0 6rpx; }
.day-on { background: #1677ff; }
.day-on .d-t, .day-on .d-m { color: #ffffff; }
.d-t { font-size: 26rpx; color: #1d2129; }
.d-m { font-size: 22rpx; color: #86909c; margin-top: 4rpx; }
.grid { background: #ffffff; margin-top: 20rpx; align-items: flex-start; }
.left { width: 170rpx; flex-shrink: 0; border-right: 1rpx solid #e5e6eb; }
.lh { height: 48rpx; }
.lr { height: 120rpx; justify-content: center; padding-left: 20rpx; border-top: 1rpx solid #f2f3f5; box-sizing: border-box; }
.rn { font-size: 28rpx; font-weight: bold; }
.ri { font-size: 18rpx; color: #86909c; margin-top: 2rpx; }
.right { flex: 1; width: 0; white-space: nowrap; }
.tl { width: 1584rpx; }
.th { height: 48rpx; }
.tt { width: 88rpx; height: 48rpx; flex-shrink: 0; font-size: 20rpx; color: #86909c; line-height: 48rpx; }
.tr { height: 120rpx; border-top: 1rpx solid #f2f3f5; box-sizing: border-box; }
.cell { width: 84rpx; height: 100rpx; margin: 0 2rpx; border-radius: 8rpx; flex-shrink: 0; overflow: hidden; position: relative; }
.cl { position: absolute; left: 6rpx; top: 6rpx; width: 72rpx; font-size: 18rpx; line-height: 24rpx; color: #ffffff; white-space: normal; }
.c-free { background: #f2f7ff; }
.c-busy { background: #a9aeb8; }
.c-mine { background: #00b42a; }
.c-sel { background: #1677ff; }
.c-past { background: #f7f8fa; }
.legend { justify-content: center; background: #ffffff; padding: 16rpx 0 20rpx; }
.lgi { font-size: 22rpx; color: #4e5969; margin: 0 16rpx; }
.lgb { width: 24rpx; height: 24rpx; border-radius: 6rpx; margin-right: 8rpx; }
.sm { padding: 40rpx 0; }
.bk { padding: 20rpx 0; border-bottom: 1rpx solid #f2f3f5; }
.bk-s { font-size: 28rpx; margin-bottom: 6rpx; }
.bk-c { font-size: 24rpx; color: #f53f3f; border: 2rpx solid #f53f3f; border-radius: 24rpx; padding: 4rpx 20rpx; }
.foot { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #f2f3f5; }
.f-t { font-size: 28rpx; font-weight: bold; margin-bottom: 4rpx; }
.fbtn { width: 200rpx; height: 76rpx; line-height: 76rpx; }
.dis { background: #94bfff; }
