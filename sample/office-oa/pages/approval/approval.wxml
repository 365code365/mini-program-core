<view class="head">
  <view class="row between">
    <view class="row">
      <view class="ava" style="background: {{a.applicantColor}};">{{a.applicantIni}}</view>
      <view class="col h-in">
        <text class="h-t">{{a.mine ? '我' : a.applicantName}}的{{a.typeName}}申请</text>
        <text class="muted">{{a.deptName}} · {{a.createdAt}}</text>
      </view>
    </view>
    <text class="stamp st-{{a.status}}">{{a.statusText}}</text>
  </view>
  <view class="no row" bindtap="copyNo"><text class="muted">审批编号 {{a.id}}</text><text class="copy">复制</text></view>
</view>

<view class="card">
  <view class="kv row" wx:for="{{rows}}" wx:key="k">
    <text class="k">{{item.k}}</text>
    <text class="v flex1">{{item.v}}</text>
  </view>
</view>

<view class="card">
  <text class="sec-title">审批流程</text>
  <view class="nd row" wx:for="{{nodes}}" wx:key="role">
    <view class="nd-l col">
      <view class="ava sm" style="background: {{item.color}};">{{item.ini}}</view>
      <view class="nd-line" wx:if="{{index < nodes.length - 1}}"></view>
    </view>
    <view class="col flex1 nd-in">
      <view class="row between">
        <text class="nd-n">{{item.role}} · {{item.whoName}}</text>
        <text class="nd-s s-{{item.status}}">{{item.text}}</text>
      </view>
      <text class="muted" wx:if="{{item.time}}">{{item.time}}</text>
      <view class="cm" wx:if="{{item.comment}}"><text>「{{item.comment}}」</text></view>
    </view>
  </view>
</view>
<view style="height: 170rpx;"></view>

<view class="foot row" wx:if="{{a.needMe}}">
  <view class="btn btn-danger flex1 fb" bindtap="reject">驳回</view>
  <view class="btn flex1 fb" bindtap="agree">同意</view>
</view>
<view class="foot row" wx:elif="{{a.mine && a.status === 'pending'}}">
  <view class="btn btn-ghost flex1 fb" bindtap="withdraw">撤回</view>
  <view class="btn flex1 fb" bindtap="urge">{{urging ? '已提醒…' : '催办'}}</view>
</view>
<view class="foot row" wx:elif="{{a.mine && (a.status === 'rejected' || a.status === 'withdrawn')}}">
  <view class="btn flex1 fb" bindtap="again">重新发起</view>
</view>

<input-dialog show="{{dlg.show}}" title="{{dlg.title}}" placeholder="{{dlg.placeholder}}" required="{{dlg.required}}" bindconfirm="onDlgOk" bindcancel="onDlgCancel"></input-dialog>
