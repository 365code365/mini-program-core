.paper {
  margin: 20rpx 24rpx 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  border: 2rpx solid #efe8d8;
}
.title-input {
  height: 80rpx;
  padding: 0 0 0 1rpx;
  font-size: 36rpx;
  font-weight: bold;
}
.meta {
  justify-content: space-between;
  padding: 8rpx 0 16rpx;
  border-bottom: 1rpx solid #efe8d8;
}
.meta-words,
.meta-state {
  font-size: 22rpx;
  color: #a39e92;
}
.body-input {
  width: 100%;
  height: 360rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 44rpx;
}
.sec {
  display: block;
  font-size: 24rpx;
  color: #8f8a7e;
  padding: 0 32rpx 12rpx;
}
.tag-group,
.color-group {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}
.tag-opt,
.color-opt {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 8rpx 24rpx 8rpx 0;
}
.tag-name,
.color-name {
  font-size: 26rpx;
  margin-left: 6rpx;
}
.swatch {
  width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  border: 2rpx solid #ddd5c2;
  margin-left: 4rpx;
}
.del {
  margin: 16rpx 24rpx;
}
