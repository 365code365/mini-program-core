.cur { margin-top: 20rpx; }
.cur-title { display: block; font-size: 32rpx; font-weight: bold; margin-bottom: 8rpx; }
.head { padding: 8rpx 32rpx 16rpx; }
.sec-t { font-size: 26rpx; color: #8f8a7e; }
.clear-all { font-size: 24rpx; color: #e5483d; }
.ver-title { display: block; font-size: 28rpx; margin-bottom: 6rpx; }
.arrow { font-size: 24rpx; color: #f5a623; margin-left: 16rpx; }
.ver-body { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #f3efe6; }
.ver-text { display: block; font-size: 26rpx; line-height: 42rpx; color: #5a564c; margin-bottom: 24rpx; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 160rpx 60rpx 0; }
.empty.small { padding-top: 40rpx; }
.empty-ic { font-size: 80rpx; }
.empty-text { margin-top: 20rpx; font-size: 26rpx; color: #a39e92; text-align: center; }
