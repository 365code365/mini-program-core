page {
  background: #f6f6f9;
  color: #1f2329;
  font-size: 28rpx;
}
.card {
  background: #ffffff;
  border-radius: 24rpx;
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
}
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.between {
  justify-content: space-between;
}
.flex1 {
  flex: 1;
}
.title {
  font-size: 32rpx;
  font-weight: bold;
}
.sub {
  font-size: 24rpx;
  color: #8f95a3;
}
.chev {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #c4c9d2;
  border-right: 3rpx solid #c4c9d2;
  transform: rotate(45deg);
  margin: 0 8rpx 0 16rpx;
}
.btn-primary {
  background: linear-gradient(90deg, #ff8a5c, #ff6250);
  color: #ffffff;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
}
.tab-safe {
  height: calc(140rpx + env(safe-area-inset-bottom));
}
/* 引擎给 input 默认 12px/8px 内边距（微信是 0），而且把 padding 全 0 当成「没写」照样套默认值，
   所以各页输入框 class 里写的是 padding: 0 0 0 1rpx（左边 0.5px，看不出来） */
