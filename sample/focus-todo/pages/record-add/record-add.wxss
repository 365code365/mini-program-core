.top-gap { margin-top: 24rpx; }
.cells { padding: 0 28rpx; }
.cell { height: 104rpx; border-bottom: 1rpx solid #f0f1f4; }
.cell.last { border-bottom: none; }
.ic { width: 48rpx; height: 48rpx; border-radius: 12rpx; color: #ffffff; font-size: 24rpx; font-weight: bold; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; }
.cell-label { font-size: 28rpx; }
.cell-value { font-size: 28rpx; color: #ff6250; }
.task-v { max-width: 360rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.min-v { font-size: 30rpx; color: #ff6250; font-weight: bold; }
.min-slider { margin: 24rpx 0 12rpx; }
.err { display: block; color: #f2453d; font-size: 24rpx; padding: 0 40rpx 12rpx; }
.save-wrap { padding: 12rpx 32rpx 60rpx; }
