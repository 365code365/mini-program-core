.banner-wrap { padding: 16rpx 24rpx 8rpx; }
.banner { width: 702rpx; height: 281rpx; border-radius: 20rpx; overflow: hidden; }
.banner-img { width: 702rpx; height: 281rpx; border-radius: 20rpx; }
.entries { justify-content: space-around; padding: 24rpx 12rpx 32rpx; }
.entry { display: flex; flex-direction: column; align-items: center; }
.e-icon { width: 96rpx; height: 96rpx; border-radius: 48rpx; display: flex; align-items: center; justify-content: center; }
.e1 { background: linear-gradient(135deg, #ff8a8a, #f04c4c); }
.e2 { background: linear-gradient(135deg, #7ad7ff, #3d8bff); }
.e3 { background: linear-gradient(135deg, #ffd36b, #ff9f1a); }
.e4 { background: linear-gradient(135deg, #b28bff, #7b61ff); }
.e-t { color: #fff; font-size: 34rpx; font-weight: bold; }
.e-l { font-size: 24rpx; color: #4e5969; margin-top: 12rpx; }
.chart-scroll { width: 702rpx; }
.chart-row { display: flex; flex-direction: row; }
.chart { width: 560rpx; flex-shrink: 0; background: #fff; border-radius: 20rpx; padding: 24rpx; margin-right: 20rpx; box-sizing: border-box; }
.chart-h { justify-content: space-between; margin-bottom: 12rpx; }
.chart-name { font-size: 32rpx; font-weight: bold; }
.chart-song { margin-top: 16rpx; }
.cs-cover { width: 84rpx; height: 84rpx; border-radius: 12rpx; background: #e9ebef; }
.cs-rank { width: 56rpx; text-align: center; font-size: 30rpx; font-weight: bold; font-style: italic; }
.cs-main { overflow: hidden; }
.cs-name { font-size: 28rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 24rpx 0 8rpx; }
.pad { padding: 0 24rpx; }
.ns-cover { width: 92rpx; height: 92rpx; border-radius: 12rpx; margin-right: 12rpx; background: #e9ebef; }
