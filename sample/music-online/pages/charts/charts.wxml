<view class="state" wx:if="{{status === 'loading'}}"><text>加载中…</text></view>
<view class="state" wx:elif="{{status === 'error'}}">
  <text>榜单加载失败</text>
  <view class="retry" bindtap="onRetry">重试</view>
</view>
<block wx:else>
  <view class="tabs row">
    <view class="tab {{cur === index ? 'tab-on' : ''}}" wx:for="{{charts}}" wx:key="id" data-index="{{index}}" bindtap="onTab" style="{{cur === index ? 'background:' + item.color : ''}}">{{item.name}}</view>
  </view>
  <view class="hero" style="background: linear-gradient(135deg, {{color}}, #2b2d42)">
    <text class="hero-t">{{charts[cur].name}}</text>
    <text class="hero-s">{{charts[cur].updateText}} · TOP {{songs.length}}</text>
    <view class="pa row" bindtap="onPlayAll"><view class="pa-tri"></view><text>播放全部</text></view>
  </view>
  <view class="list">
    <view class="song {{playingId === item.id ? 'song-on' : ''}}" wx:for="{{songs}}" wx:key="id" data-index="{{index}}" bindtap="onSong" hover-class="song-hover">
      <view class="rank-box">
        <text class="rank {{item.rank <= 3 ? 'rank-top' : ''}}" style="{{item.rank <= 3 ? 'color:' + color : ''}}">{{item.rank}}</text>
        <text class="trend {{item.trendCls}}">{{item.trendText}}</text>
      </view>
      <image class="cover" src="{{item.cover}}" mode="aspectFill"></image>
      <view class="song-main">
        <text class="song-name">{{item.name}}</text>
        <view class="row"><text class="vip" wx:if="{{item.vip}}">VIP</text><text class="song-meta">{{item.singer.name}} · {{item.album.name}}</text></view>
      </view>
      <text class="dur">{{item.durationText}}</text>
    </view>
  </view>
</block>
<view class="mp-gap" wx:if="{{hasSong}}"></view>
<mini-player></mini-player>
