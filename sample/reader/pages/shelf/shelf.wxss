.recent {
  margin: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
}
.mini-cover {
  width: 96rpx;
  height: 128rpx;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.r-k {
  display: block;
  font-size: 22rpx;
  color: #c8873c;
}
.r-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin: 4rpx 0;
}
.r-go {
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  background: #c8873c;
  color: #ffffff;
  font-size: 24rpx;
}
.head {
  padding: 8rpx 32rpx 16rpx;
}
.h {
  font-size: 34rpx;
  font-weight: bold;
}
.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 0 12rpx;
}
.book {
  width: 33.33%;
  box-sizing: border-box;
  padding: 12rpx 20rpx 24rpx;
}
.cover {
  position: relative;
  height: 280rpx;
  border-radius: 10rpx;
  padding: 24rpx 16rpx;
  box-sizing: border-box;
  color: #ffffff;
}
.cover-t {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  line-height: 1.3;
}
.cover-a {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  opacity: 0.8;
}
.pbar {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.3);
}
.pbar-in {
  height: 6rpx;
  border-radius: 3rpx;
  background: #ffffff;
}
.add-cover {
  background: #ebe5da;
  display: flex;
  align-items: center;
  justify-content: center;
}
.plus {
  font-size: 60rpx;
  color: #b9ad98;
}
.b-title {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.b-pct {
  display: block;
  font-size: 22rpx;
  color: #a0968a;
}
.empty {
  padding: 160rpx 0;
  text-align: center;
  color: #a0968a;
}
.go-store {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 40rpx;
  border-radius: 36rpx;
  background: #c8873c;
  color: #ffffff;
}
