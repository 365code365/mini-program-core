.hero { width: 100%; height: 400rpx; background: #dde3ea; }
.title { font-size: 40rpx; font-weight: bold; color: #1c3d5a; }
.between { justify-content: space-between; }
.fav { padding: 8rpx 24rpx; border-radius: 30rpx; border: 2rpx solid #e8590c; color: #e8590c; font-size: 24rpx; }
.fav-on { background: #e8590c; color: #ffffff; }
.intro { display: block; margin: 16rpx 0; font-size: 26rpx; line-height: 1.7; color: #3e4c59; }
.kv { display: flex; flex-direction: row; padding: 10rpx 0; font-size: 26rpx; }
.k { width: 160rpx; color: #8a94a0; }
.v { flex: 1; color: #1f2933; }
.mini-map { width: 100%; height: 300rpx; margin: 16rpx 0 8rpx; border-radius: 12rpx; background-color: #e8eef5; }
.tip { margin-top: 10rpx; font-size: 26rpx; color: #3e4c59; line-height: 1.6; }
.actions { display: flex; flex-direction: row; padding: 20rpx 24rpx 60rpx; }
.act { flex: 1; margin: 0 8rpx; }
