.player { width: 100%; height: 422rpx; background-color: #000000; }
.bar { display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 14rpx 24rpx; background: #111111; }
.badge { font-size: 22rpx; color: #9aa5b1; }
.on { color: #ff6b6b; }
.res { font-size: 22rpx; color: #9aa5b1; }
.ops { display: flex; flex-direction: row; margin-top: 20rpx; }
.op { flex: 1; margin: 0 6rpx; }
.shots { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 12rpx; }
.shot { width: 200rpx; height: 120rpx; margin: 0 12rpx 12rpx 0; border-radius: 8rpx; background: #dde3ea; }
.log { display: block; font-size: 22rpx; color: #52606d; line-height: 1.7; }
