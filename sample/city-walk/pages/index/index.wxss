.chips { display: flex; flex-direction: row; padding: 16rpx 24rpx; background: #ffffff; }
.chip { margin-right: 16rpx; padding: 10rpx 26rpx; border-radius: 30rpx; background: #eef1f4; color: #52606d; font-size: 24rpx; }
.chip-on { background: #1c3d5a; color: #ffffff; }
.map { width: 100%; height: 620rpx; background-color: #e8eef5; }
.tools { position: relative; display: flex; flex-direction: row; justify-content: flex-end; margin-top: -96rpx; padding: 0 24rpx; height: 96rpx; }
.tool { width: 88rpx; height: 64rpx; margin-left: 16rpx; border-radius: 12rpx; background: #ffffff; color: #1c3d5a; font-size: 22rpx; line-height: 64rpx; text-align: center; box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12); }
.spot { display: flex; flex-direction: row; }
.cover { width: 200rpx; height: 160rpx; border-radius: 12rpx; margin-right: 20rpx; background: #dde3ea; }
.spot-body { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.dist { font-size: 22rpx; color: #e8590c; }
.between { justify-content: space-between; }
.item { display: flex; flex-direction: row; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #eef1f4; }
.dot { width: 18rpx; height: 18rpx; border-radius: 9rpx; margin-right: 20rpx; }
.item-body { flex: 1; display: flex; flex-direction: column; }
.item-name { font-size: 28rpx; color: #1f2933; }
.go { font-size: 24rpx; color: #1c7ed6; }
