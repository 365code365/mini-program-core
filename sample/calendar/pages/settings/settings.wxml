<view class="card cells top-gap">
  <picker class="pk-ws" mode="selector" range="{{weekStarts}}" value="{{wsIdx}}" bindchange="onWeekStart">
    <view class="cell row">
      <text class="flex1 cell-label">每周起始日</text>
      <text class="cell-value v-ws">{{weekStarts[wsIdx]}}</text>
      <view class="chev"></view>
    </view>
  </picker>
  <picker class="pk-remind" mode="selector" range="{{reminds}}" value="{{remindIdx}}" bindchange="onRemind">
    <view class="cell row cell-last">
      <text class="flex1 cell-label">新日程默认提醒</text>
      <text class="cell-value">{{reminds[remindIdx]}}</text>
      <view class="chev"></view>
    </view>
  </picker>
</view>
<view class="card cells">
  <view class="cell row cell-last clear" bindtap="onClear">
    <text class="flex1 cell-label danger">清空全部日程</text>
    <text class="cell-value">{{count}} 条</text>
  </view>
</view>
<text class="sub tip">日程只保存在本机，卸载小程序后会丢失</text>
