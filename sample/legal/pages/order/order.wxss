.av { width: 88rpx; height: 88rpx; border-radius: 44rpx; margin-right: 20rpx; }
.n { font-size: 30rpx; font-weight: bold; margin-bottom: 6rpx; }
.label { font-size: 28rpx; font-weight: bold; margin-bottom: 16rpx; }
.mt { margin-top: 28rpx; }
.svc { padding: 18rpx 0; border-bottom: 1rpx solid #eef0f4; }
.svc-in { margin-left: 12rpx; }
.svc-n { font-size: 28rpx; margin-bottom: 4rpx; }
.pick { background: #f6f8fc; border-radius: 12rpx; padding: 0 24rpx; height: 80rpx; font-size: 28rpx; }
.ta { width: 100%; height: 240rpx; background: #f6f8fc; border-radius: 12rpx; padding: 20rpx; box-sizing: border-box; font-size: 28rpx; line-height: 40rpx; }
.imgs { flex-wrap: wrap; }
.img { width: 160rpx; height: 160rpx; margin-right: 20rpx; position: relative; border-radius: 12rpx; }
.img-i { width: 160rpx; height: 160rpx; border-radius: 12rpx; }
.img-x { position: absolute; right: -12rpx; top: -12rpx; width: 40rpx; height: 40rpx; border-radius: 20rpx; background: rgba(0, 0, 0, 0.6); color: #fff; font-size: 28rpx; line-height: 38rpx; text-align: center; }
.add { background: #f6f8fc; border: 2rpx dashed #c3cbd9; box-sizing: border-box; align-items: center; justify-content: center; }
.add-p { font-size: 48rpx; color: #8a93a3; line-height: 56rpx; }
.add-t { font-size: 22rpx; color: #8a93a3; }
.ipt { background: #f6f8fc; border-radius: 12rpx; height: 80rpx; padding: 0 24rpx; font-size: 28rpx; }
.agree { display: block; margin: 24rpx 32rpx 0; }
.foot { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #eceef2; }
.big { font-size: 40rpx; }
.pay { width: 300rpx; }
.x { font-size: 44rpx; color: #8a93a3; padding: 0 8rpx; }
.amt { text-align: center; font-size: 64rpx; font-weight: bold; margin-top: 24rpx; }
.center { display: block; text-align: center; }
.way { height: 96rpx; border-bottom: 1rpx solid #eef0f4; font-size: 28rpx; }
.way-ic { width: 48rpx; height: 48rpx; border-radius: 10rpx; color: #fff; font-size: 24rpx; line-height: 48rpx; text-align: center; margin-right: 20rpx; }
.ck { color: #1f4fb4; font-size: 32rpx; }
.tip { margin-top: 16rpx; }
.sub { margin-bottom: 20rpx; }
