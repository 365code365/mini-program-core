.namebar { background: #ffffff; padding: 0 24rpx; height: 96rpx; border-bottom: 1rpx solid #eef0f4; }
.name { font-size: 32rpx; font-weight: bold; height: 96rpx; }
.tools { background: #ffffff; padding: 12rpx 16rpx; border-bottom: 1rpx solid #eef0f4; }
.t { flex: 1; height: 60rpx; line-height: 60rpx; text-align: center; font-size: 24rpx; color: #39424f; border-radius: 10rpx; margin: 0 4rpx; background: #f4f6fa; }
.t-on { background: #1f4fb4; color: #ffffff; }
.b { font-weight: bold; font-size: 30rpx; }
.paper { margin: 24rpx; background: #ffffff; border-radius: 12rpx; padding: 24rpx; min-height: 880rpx; box-shadow: 0 4rpx 16rpx rgba(31, 79, 180, 0.06); }
.ed { width: 100%; min-height: 880rpx; height: 880rpx; font-size: 28rpx; line-height: 46rpx; color: #1f2633; }
.pv { font-size: 28rpx; line-height: 46rpx; }
.hint { margin: 0 32rpx; font-size: 22rpx; color: #8a93a3; line-height: 34rpx; }
.foot { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #eceef2; }
.fb { font-size: 24rpx; color: #556070; margin-right: 24rpx; }
.fbtn { flex: 1; height: 76rpx; line-height: 76rpx; font-size: 28rpx; margin-left: 12rpx; }
.para { margin-bottom: 8rpx; }
