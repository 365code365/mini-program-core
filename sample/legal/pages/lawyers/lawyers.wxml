<view class="bar">
  <scroll-view scroll-x class="chips" enhanced show-scrollbar="{{false}}">
    <view class="chips-in row">
      <view class="chip {{cat === item.id ? 'chip-on' : ''}}" wx:for="{{cats}}" wx:key="id" data-id="{{item.id}}" bindtap="pickCat">{{item.name}}</view>
    </view>
  </scroll-view>
  <view class="filters row">
    <picker mode="selector" range="{{cities}}" range-key="name" value="{{cityIdx}}" bindchange="onCity">
      <view class="f-city row"><text>{{cities[cityIdx].name}}</text><text class="arrow">▾</text></view>
    </picker>
    <view class="f-sort {{sort === index ? 'f-on' : ''}}" wx:for="{{sorts}}" wx:key="*this" data-i="{{index}}" bindtap="pickSort">{{item}}</view>
    <view class="f-sort {{favOnly ? 'f-on' : ''}}" bindtap="toggleFavOnly">★ 收藏</view>
  </view>
</view>

<view class="loading" wx:if="{{loading}}">正在为你匹配律师…</view>
<block wx:else>
  <view class="empty" wx:if="{{list.length === 0}}">
    <view class="empty-ic">?</view>
    <text class="empty-tx">没有符合条件的律师</text>
    <view class="reset" bindtap="reset">清空筛选</view>
  </view>
  <view class="lw card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goLawyer">
    <view class="row">
      <image class="av" src="{{item.avatar}}" mode="aspectFill"></image>
      <view class="col flex1">
        <view class="row">
          <text class="n">{{item.name}}</text>
          <text class="tag">{{item.city}}</text>
          <text class="tag tag-gold">执业 {{item.years}} 年</text>
          <text class="fav" wx:if="{{item.fav}}">★</text>
        </view>
        <text class="muted firm">{{item.firm}}</text>
        <text class="fd">擅长：{{item.fieldText}}</text>
      </view>
    </view>
    <view class="row between foot">
      <view class="row">
        <text class="star">★ {{item.rating}}</text>
        <text class="muted">服务 {{item.consults}} 人 · {{item.reply}}</text>
      </view>
      <view class="ask" catchtap="ask" data-id="{{item.id}}">¥{{item.price.text}} 咨询</view>
    </view>
  </view>
</block>
<view class="tab-pad"></view>
