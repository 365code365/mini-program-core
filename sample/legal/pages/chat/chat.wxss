.wrap { height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; background: #f0f2f6; }
.top { background: #ffffff; padding: 16rpx 24rpx; border-bottom: 1rpx solid #eceef2; }
.top-t { font-size: 28rpx; font-weight: bold; margin-bottom: 4rpx; }
.st { font-size: 22rpx; border-radius: 8rpx; padding: 4rpx 12rpx; margin-right: 12rpx; }
.st-active { color: #1f4fb4; background: #eaf0fc; }
.st-done { color: #a5740f; background: #fbf3e2; }
.st-rated { color: #2c9a7a; background: #e4f5ef; }
.end { font-size: 24rpx; color: #d64545; border: 2rpx solid #f0c4c4; border-radius: 24rpx; padding: 6rpx 20rpx; }
.list { flex: 1; height: 0; }
.list-in { padding: 16rpx 24rpx 24rpx; }
.tip { text-align: center; font-size: 22rpx; color: #a5740f; margin: 8rpx 0 16rpx; }
.sys { margin: 16rpx 60rpx; text-align: center; font-size: 22rpx; color: #8a93a3; background: #e4e8ef; border-radius: 12rpx; padding: 10rpx 16rpx; line-height: 32rpx; }
.msg { align-items: flex-start; margin-top: 20rpx; }
.me { justify-content: flex-end; }
.end-col { align-items: flex-end; }
.av { width: 72rpx; height: 72rpx; border-radius: 36rpx; margin-right: 16rpx; flex-shrink: 0; }
.me-av { margin: 0 0 0 16rpx; background: #1f4fb4; color: #fff; font-size: 26rpx; line-height: 72rpx; text-align: center; }
.time { font-size: 20rpx; color: #a0a7b3; margin-bottom: 6rpx; }
.bubble { max-width: 480rpx; font-size: 28rpx; line-height: 42rpx; padding: 18rpx 22rpx; border-radius: 16rpx; }
.b-l { background: #ffffff; color: #1f2633; }
.b-me { background: #1f4fb4; color: #ffffff; }
.typing { color: #8a93a3; }
.pic { width: 280rpx; height: 210rpx; border-radius: 12rpx; }
.rated { text-align: center; margin-top: 24rpx; font-size: 24rpx; color: #2c9a7a; display: flex; flex-direction: row; justify-content: center; }
.bar { background: #ffffff; padding: 14rpx 16rpx calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e3e6ec; }
.closed { text-align: center; color: #8a93a3; font-size: 26rpx; }
.tool { width: 64rpx; height: 64rpx; border-radius: 32rpx; background: #f1f3f7; color: #556070; font-size: 26rpx; line-height: 64rpx; text-align: center; margin-right: 12rpx; }
.ipt { height: 72rpx; background: #f1f3f7; border-radius: 36rpx; padding: 0 24rpx; font-size: 28rpx; margin-right: 12rpx; }
.send { background: #1f4fb4; color: #fff; font-size: 26rpx; border-radius: 32rpx; height: 64rpx; line-height: 64rpx; padding: 0 24rpx; }
.send-off { background: #b8c4dc; }
.stars { margin: 24rpx 0 8rpx; }
.star { font-size: 56rpx; margin-right: 12rpx; }
.tags { flex-wrap: wrap; margin-top: 12rpx; }
.rt { font-size: 24rpx; color: #556070; background: #f1f3f7; border-radius: 28rpx; padding: 10rpx 24rpx; margin: 0 16rpx 16rpx 0; }
.rt-on { color: #1f4fb4; background: #eaf0fc; }
.rta { width: 100%; height: 160rpx; background: #f6f8fc; border-radius: 12rpx; padding: 16rpx; box-sizing: border-box; font-size: 26rpx; margin: 8rpx 0 24rpx; }
.body { max-width: 500rpx; }
.b-t { font-size: 28rpx; line-height: 42rpx; }
.sys-t { font-size: 22rpx; line-height: 32rpx; }
