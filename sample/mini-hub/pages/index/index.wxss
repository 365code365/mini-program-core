.hero { background: linear-gradient(135deg, #8b7bff, #6b5cff 55%, #3f8cff); padding: 44rpx 32rpx 96rpx; color: #fff; display: flex; flex-direction: column; }
.hero-t { font-size: 44rpx; font-weight: bold; }
.hero-s { font-size: 24rpx; color: rgba(255, 255, 255, 0.85); margin-top: 10rpx; }
.launch { margin-top: -64rpx; box-shadow: 0 8rpx 28rpx rgba(80, 70, 200, 0.12); }
.pill { font-size: 22rpx; color: #8a9099; background: #f0f1f4; border-radius: 20rpx; padding: 4rpx 16rpx; }
.pill-on { color: #fff; background: #00b578; }
.kv { align-items: flex-start; padding: 10rpx 0; border-top: 1rpx solid #f5f6f8; }
.k { width: 170rpx; font-size: 24rpx; color: #8a9099; flex-shrink: 0; }
.v { flex: 1; font-size: 24rpx; color: #1f2329; word-break: break-all; }
.mono { font-family: Menlo, monospace; font-size: 22rpx; white-space: pre-wrap; }
.muted { color: #b0b4ba; }
.nav { padding: 20rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.nav-icon { width: 72rpx; height: 72rpx; border-radius: 18rpx; color: #fff; font-size: 32rpx; font-weight: bold; text-align: center; line-height: 72rpx; margin-right: 20rpx; }
.nav-t { font-size: 28rpx; font-weight: bold; }
.nav-s { font-size: 20rpx; color: #9aa0ab; margin-top: 4rpx; font-family: Menlo, monospace; word-break: break-all; }
.chev { font-size: 40rpx; color: #c4c7cc; margin-left: 12rpx; }
.form-link { margin-top: 20rpx; font-size: 26rpx; color: #6b5cff; text-align: center; }
