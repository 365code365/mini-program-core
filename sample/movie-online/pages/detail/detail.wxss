.head { padding: 32rpx 32rpx 28rpx; color: #fff; }
.head-row { align-items: flex-start; }
.poster { width: 220rpx; height: 330rpx; border-radius: 14rpx; background: rgba(255, 255, 255, 0.15); flex-shrink: 0; }
.head-info { margin-left: 28rpx; display: flex; flex-direction: column; }
.title { font-size: 42rpx; font-weight: bold; }
.en { font-size: 24rpx; color: rgba(255, 255, 255, 0.75); margin-top: 6rpx; }
.meta { font-size: 24rpx; color: rgba(255, 255, 255, 0.85); margin-top: 14rpx; }
.head-tags { margin-top: 18rpx; flex-wrap: wrap; }
.htag { font-size: 20rpx; border: 1rpx solid rgba(255, 255, 255, 0.6); border-radius: 6rpx; padding: 2rpx 10rpx; margin-right: 10rpx; }
.score-box { margin-top: 28rpx; background: rgba(0, 0, 0, 0.22); border-radius: 16rpx; padding: 20rpx 24rpx; }
.score-label { font-size: 22rpx; color: rgba(255, 255, 255, 0.7); }
.score { font-size: 56rpx; font-weight: bold; color: #ffc94a; }
.score-unit { font-size: 24rpx; color: rgba(255, 255, 255, 0.85); font-weight: normal; }
.score-side { margin-left: 18rpx; }
.score-n { font-size: 20rpx; color: rgba(255, 255, 255, 0.7); margin-top: 4rpx; }
.box-office { align-items: flex-end; }
.bo { font-size: 36rpx; font-weight: bold; margin-top: 8rpx; }
.actions { padding: 24rpx; }
.act { flex: 1; height: 76rpx; line-height: 76rpx; text-align: center; border-radius: 38rpx; background: #fff; font-size: 28rpx; color: #1f2329; margin-right: 20rpx; }
.act-on { color: #ff4e6a; background: #fff0f2; }
.act-music { margin-right: 0; color: #fff; background: linear-gradient(90deg, #36d1dc, #5b86e5); }
/* 简介收起时只露 4 行：固定高度裁掉（line-clamp 不是每个后端都认） */
.summary-fold { height: 176rpx; overflow: hidden; }
.summary-t { font-size: 28rpx; line-height: 44rpx; color: #4e5969; }
.fold-btn { text-align: center; color: #ff4e6a; font-size: 24rpx; padding-top: 16rpx; }
.card-flush { padding-left: 0; padding-right: 0; }
.pad { padding: 0 28rpx; }
.hscroll { width: 702rpx; }
.hrow { display: flex; flex-direction: row; padding: 0 16rpx; }
.person { width: 140rpx; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; margin: 0 6rpx; }
.avatar { width: 112rpx; height: 112rpx; border-radius: 56rpx; background: #eceef1; }
.p-name { font-size: 24rpx; margin-top: 12rpx; }
.p-role { font-size: 20rpx; color: #9aa0a6; margin-top: 4rpx; }
.still { width: 320rpx; height: 180rpx; border-radius: 12rpx; margin: 0 8rpx; flex-shrink: 0; background: #eceef1; }
.cmt { padding: 20rpx 0; border-bottom: 1rpx solid #f3f4f6; display: flex; flex-direction: column; }
.c-avatar { width: 64rpx; height: 64rpx; border-radius: 32rpx; margin-right: 16rpx; }
.c-name { font-size: 26rpx; color: #4e5969; }
.stars-sm { transform: scale(0.8); transform-origin: left center; margin-top: 2rpx; }
.c-text { font-size: 28rpx; line-height: 42rpx; margin: 14rpx 0 8rpx; }
.all-btn { text-align: center; color: #4e5969; font-size: 26rpx; padding-top: 24rpx; }
.bottom-gap { height: 140rpx; }
.bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 16rpx 24rpx 28rpx; box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05); }
.bar-btn { font-size: 26rpx; color: #4e5969; padding: 0 32rpx 0 8rpx; }
