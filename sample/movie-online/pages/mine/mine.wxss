.hero { background: linear-gradient(135deg, #ff7a8a, #ff4e6a 60%, #c2185b); padding: 40rpx 32rpx 32rpx; color: #fff; margin-bottom: 24rpx; }
.me { width: 104rpx; height: 104rpx; border-radius: 52rpx; background: rgba(255, 255, 255, 0.25); text-align: center; line-height: 104rpx; font-size: 44rpx; font-weight: bold; margin-right: 24rpx; }
.hello { font-size: 36rpx; font-weight: bold; }
.hint { font-size: 24rpx; color: rgba(255, 255, 255, 0.8); margin-top: 6rpx; }
.stats { margin-top: 36rpx; background: rgba(255, 255, 255, 0.16); border-radius: 16rpx; padding: 20rpx 0; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.n { font-size: 40rpx; font-weight: bold; }
.l { font-size: 22rpx; color: rgba(255, 255, 255, 0.8); margin-top: 4rpx; }
.item { padding: 20rpx 0; border-bottom: 1rpx solid #f5f6f8; }
.item-hover { background: #fafafa; }
.poster { width: 110rpx; height: 156rpx; border-radius: 10rpx; background: #eceef1; flex-shrink: 0; }
.info { margin-left: 22rpx; }
.title { font-size: 30rpx; font-weight: bold; }
.line { margin-top: 8rpx; }
.status { font-size: 24rpx; color: #4e5969; }
.score { font-size: 32rpx; color: #ffb400; font-weight: bold; margin-right: 16rpx; }
.rm { width: 48rpx; height: 48rpx; line-height: 46rpx; text-align: center; color: #b0b4ba; font-size: 36rpx; }
.about { text-align: center; padding: 8rpx 0 40rpx; }
