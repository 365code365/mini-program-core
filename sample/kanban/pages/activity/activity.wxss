.types { background: #ffffff; white-space: nowrap; }
.type-row { display: flex; flex-direction: row; padding: 20rpx 24rpx; }
.type { flex-shrink: 0; font-size: 24rpx; color: #595959; background: #f0f2f7; border-radius: 28rpx; padding: 8rpx 24rpx; margin-right: 16rpx; }
.type.on { color: #ffffff; background: #2f54eb; }
.act { align-items: flex-start; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.act-avatar { width: 56rpx; height: 56rpx; border-radius: 28rpx; line-height: 56rpx; font-size: 24rpx; margin-right: 16rpx; }
.act-who { font-size: 26rpx; font-weight: bold; }
.act-line { margin-top: 6rpx; }
.act-dot { width: 12rpx; height: 12rpx; border-radius: 6rpx; margin-right: 10rpx; }
.act-title { font-size: 26rpx; color: #262626; }
.act-title.gone { color: #bfbfbf; text-decoration: line-through; }
.act-text { display: block; margin-top: 4rpx; font-size: 24rpx; color: #8c8c8c; }
.empty-box { padding: 120rpx 0; text-align: center; }
.safe { height: 60rpx; }
