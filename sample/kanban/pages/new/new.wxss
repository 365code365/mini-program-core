.head {
  margin-top: 24rpx;
}
.box-title {
  font-size: 28rpx;
  font-weight: bold;
}
.req {
  color: #f5222d;
}
.n-title {
  height: 80rpx;
  margin-top: 12rpx;
  padding: 0 0 0 1rpx;
  font-size: 32rpx;
  border-bottom: 2rpx solid #f0f0f0;
}
.n-title.bad {
  border-bottom-color: #f5222d;
}
.error {
  display: block;
  color: #f5222d;
  font-size: 24rpx;
  margin-top: 8rpx;
}
.n-desc {
  width: 100%;
  height: 160rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
}
.cells {
  padding-top: 0;
  padding-bottom: 0;
}
