.missing {
  padding: 200rpx 0;
  text-align: center;
  color: #8c8c8c;
}
.head {
  margin-top: 24rpx;
}
.col-tag {
  font-size: 22rpx;
  color: #2f54eb;
  background: #f0f5ff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.late-tag {
  font-size: 22rpx;
  color: #f5222d;
  background: #fff1f0;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}
.f-title {
  height: 80rpx;
  margin-top: 12rpx;
  padding: 0 0 0 1rpx;
  font-size: 34rpx;
  font-weight: bold;
}
.f-desc {
  width: 100%;
  height: 160rpx;
  font-size: 26rpx;
  color: #595959;
  line-height: 40rpx;
}
.cells {
  padding-top: 0;
  padding-bottom: 0;
}
.late {
  color: #f5222d;
}
.box-title {
  font-size: 28rpx;
  font-weight: bold;
}
.prog {
  margin: 16rpx 0 8rpx;
}
.sub-row {
  height: 80rpx;
}
.sub-text {
  font-size: 28rpx;
  margin-left: 8rpx;
}
.sub-text.done {
  color: #bfbfbf;
  text-decoration: line-through;
}
.sub-new {
  margin-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 12rpx;
}
.sub-input {
  height: 72rpx;
  padding: 0 0 0 1rpx;
}
.sub-add {
  color: #2f54eb;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
}
.safe {
  height: 80rpx;
}
