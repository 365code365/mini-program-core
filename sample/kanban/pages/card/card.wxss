.missing {
  padding: 180rpx 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #8c8c8c;
}
.missing-ic {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background: #e6ebff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.missing-sheet {
  width: 56rpx;
  height: 72rpx;
  border-radius: 8rpx;
  border: 6rpx solid #85a5ff;
}
.missing-text {
  margin: 28rpx 0 32rpx;
  font-size: 28rpx;
}
.missing-back {
  width: 320rpx;
}
.head {
  margin-top: 24rpx;
}
.col-tag {
  font-size: 22rpx;
  color: #2f54eb;
  background: #f0f5ff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.late-tag {
  font-size: 22rpx;
  color: #f5222d;
  background: #fff1f0;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}
.f-title {
  height: 80rpx;
  margin-top: 12rpx;
  padding: 0 0 0 1rpx;
  font-size: 34rpx;
  font-weight: bold;
}
.f-desc {
  width: 100%;
  height: 160rpx;
  font-size: 26rpx;
  color: #595959;
  line-height: 40rpx;
}
.cells {
  padding-top: 0;
  padding-bottom: 0;
}
.late {
  color: #f5222d;
}
.box-title {
  font-size: 28rpx;
  font-weight: bold;
}
.prog {
  margin: 16rpx 0 8rpx;
}
.sub-row {
  height: 80rpx;
}
.sub-text {
  font-size: 28rpx;
  margin-left: 8rpx;
}
.sub-text.done {
  color: #bfbfbf;
  text-decoration: line-through;
}
.sub-new {
  margin-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 12rpx;
}
.sub-input {
  height: 72rpx;
  padding: 0 0 0 1rpx;
}
.sub-add {
  color: #2f54eb;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
}
.safe {
  height: 80rpx;
}
.comments {
  margin-top: 24rpx;
}
.cm-new {
  margin: 16rpx 0 8rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 0 0 0 20rpx;
}
.cm-input {
  height: 72rpx;
  font-size: 26rpx;
  padding: 0 0 0 1rpx;
}
.cm-send {
  color: #bfbfbf;
  font-size: 26rpx;
  padding: 8rpx 24rpx;
}
.cm-send.on {
  color: #2f54eb;
  font-weight: bold;
}
.cm {
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.cm-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  margin-right: 16rpx;
}
.cm-name {
  font-size: 26rpx;
  font-weight: bold;
}
.cm-text {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #434343;
  line-height: 1.5;
}
.cm-empty {
  display: block;
  padding: 16rpx 0 4rpx;
}
