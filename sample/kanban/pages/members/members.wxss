.list {
  padding-top: 0;
  padding-bottom: 0;
}
.member {
  height: 120rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.member.on {
  background: #f0f5ff;
}
.m-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 72rpx;
  text-align: center;
  margin-right: 20rpx;
}
.m-name {
  display: block;
  font-size: 30rpx;
}
.m-role {
  display: block;
  font-size: 22rpx;
  color: #8c8c8c;
}
.m-stat {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}
.m-open {
  font-size: 34rpx;
  font-weight: bold;
  color: #2f54eb;
}
.m-total {
  font-size: 24rpx;
  color: #8c8c8c;
}
.m-late {
  font-size: 22rpx;
  color: #f5222d;
  margin-left: 12rpx;
}
.m-card {
  height: 80rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.m-prio {
  color: #ffffff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 16rpx;
}
.m-card-title {
  font-size: 28rpx;
}
.m-due {
  font-size: 22rpx;
  color: #8c8c8c;
}
.m-due.late {
  color: #f5222d;
}
