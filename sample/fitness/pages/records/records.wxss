.sum { margin: 24rpx 24rpx 0; border-radius: 24rpx; background: linear-gradient(135deg, #ff7a3d, #ff3d6e); display: flex; flex-direction: row; padding: 36rpx 0; }
.s-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.s-v { font-size: 44rpx; font-weight: bold; color: #ffffff; }
.s-k { margin-top: 6rpx; font-size: 22rpx; color: rgba(255,255,255,0.85); }
.seg { display: flex; flex-direction: row; background: #f3f4f6; border-radius: 28rpx; padding: 4rpx; }
.seg-i { padding: 8rpx 24rpx; border-radius: 24rpx; font-size: 24rpx; color: #8b909a; }
.seg-i.on { background: #ffffff; color: #ff5a36; font-weight: bold; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.chart { position: relative; height: 380rpx; margin-top: 24rpx; display: flex; flex-direction: row; align-items: flex-end; border-bottom: 2rpx solid #f0f1f4; }
.avg { position: absolute; left: 0; right: 0; height: 0; border-top: 2rpx dashed #ffb38a; }
.avg-t { position: absolute; right: 0; top: -34rpx; font-size: 20rpx; color: #ff7a3d; }
.col { flex: 1; height: 380rpx; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.col-v { font-size: 22rpx; color: rgba(255,255,255,0); margin-bottom: 8rpx; }
.col-v.show { color: #ff5a36; font-weight: bold; }
.col-bar { width: 40rpx; border-radius: 12rpx 12rpx 4rpx 4rpx; background: linear-gradient(180deg, #ffc2a6, #ffe2d4); }
.col-bar.sel { background: linear-gradient(180deg, #ff7a3d, #ff3d6e); }
.col-bar.zero { background: #eceef2; }
.col-d { margin: 12rpx 0 -48rpx; font-size: 22rpx; color: #a0a5ae; height: 36rpx; }
.col-d.sel { color: #ff5a36; font-weight: bold; }
.tip { margin-top: 64rpx; padding: 18rpx 22rpx; background: #fff6f2; border-radius: 14rpx; }
.h { display: flex; flex-direction: row; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f2f3f5; }
.h:last-child { border-bottom: none; }
.h-ic { width: 72rpx; height: 72rpx; border-radius: 20rpx; color: #fff; font-size: 28rpx; font-weight: bold; display: flex; align-items: center; justify-content: center; }
.h-ic.g { background: linear-gradient(135deg, #ff7a3d, #ff3d6e); }
.h-ic.s { background: linear-gradient(135deg, #6a8bff, #3d5afe); }
.h-main { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; min-width: 0; }
.h-name { font-size: 28rpx; font-weight: bold; color: #1c1f26; margin-bottom: 6rpx; }
.h-k { display: flex; flex-direction: column; align-items: flex-end; }
.h-kv { font-size: 32rpx; font-weight: bold; color: #ff5a36; }
