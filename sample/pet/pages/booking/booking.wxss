/* 最多 5 只：一行两只 */
.pets { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 20rpx; }
.pc { width: 313rpx; display: flex; flex-direction: row; align-items: center; padding: 20rpx; border-radius: 20rpx; background: #faf8f6; border: 3rpx solid #faf8f6; margin: 0 20rpx 20rpx 0; position: relative; box-sizing: border-box; }
.pc:nth-child(2n) { margin-right: 0; }
.pc.on { border-color: #ff8a3d; background: #fff7f0; }
.pet-av.sm { width: 76rpx; height: 76rpx; border-radius: 38rpx; font-size: 32rpx; }
.pc-m { margin-left: 16rpx; display: flex; flex-direction: column; }
.pc-n { font-size: 30rpx; font-weight: bold; }
.ok { position: absolute; right: 0; top: 0; width: 40rpx; height: 36rpx; border-radius: 0 16rpx 0 16rpx; background: #ff8a3d; }
.ok-v { position: absolute; left: 14rpx; top: 6rpx; width: 8rpx; height: 16rpx; border-right: 4rpx solid #fff; border-bottom: 4rpx solid #fff; transform: rotate(45deg); }
.svc { display: flex; flex-direction: row; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f3efea; }
.svc:last-child { border-bottom: none; padding-bottom: 0; }
.box { width: 40rpx; height: 40rpx; border-radius: 20rpx; border: 3rpx solid #d9d2cb; box-sizing: border-box; position: relative; flex-shrink: 0; }
.box.on { background: #ff8a3d; border-color: #ff8a3d; }
.box-v { position: absolute; left: 13rpx; top: 7rpx; width: 8rpx; height: 16rpx; border-right: 4rpx solid #fff; border-bottom: 4rpx solid #fff; transform: rotate(45deg); }
.svc-m { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; }
.svc-n { font-size: 28rpx; font-weight: bold; margin-bottom: 4rpx; }
.svc .price { font-size: 32rpx; }
.form { padding-top: 4rpx; padding-bottom: 4rpx; }
.f { display: flex; flex-direction: row; align-items: center; min-height: 100rpx; border-bottom: 1rpx solid #f3efea; }
.f.last { border-bottom: none; }
.f-k { width: 160rpx; font-size: 28rpx; color: #5a4f47; flex-shrink: 0; }
.f-pk { flex: 1; }
.f-v { display: flex; flex-direction: row; align-items: center; justify-content: flex-end; font-size: 28rpx; }
.f-sw { flex: 1; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; }
.f-sw .muted { margin-right: 16rpx; }
/* 引擎把 padding 为 0 当成「没写」，套 12px 默认内边距，所以写 1rpx */
.f-in { flex: 1; text-align: right; font-size: 26rpx; padding: 0 0 0 1rpx; }
.bar { position: fixed; left: 0; right: 0; bottom: 0; background: #ffffff; padding: 20rpx 32rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: row; align-items: center; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05); }
.bar-l { flex: 1; display: flex; flex-direction: column; }
.total { font-size: 44rpx; margin-left: 8rpx; }
.bar-btn { width: 260rpx; }
.segs { display: flex; flex-direction: row; margin: 24rpx 24rpx 0; padding: 6rpx; border-radius: 40rpx; background: #ffffff; }
.seg { flex: 1; height: 64rpx; border-radius: 32rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; color: #7a7069; white-space: nowrap; }
.seg.on { background: linear-gradient(90deg, #ffb547, #ff7b54); color: #ffffff; font-weight: bold; }
.no-pet { margin-top: 20rpx; padding: 24rpx; border-radius: 16rpx; background: #faf7f4; display: flex; flex-direction: row; justify-content: space-between; align-items: center; font-size: 26rpx; color: #9a928b; }
.f-vt { flex: 1; min-width: 0; text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.stepper { display: flex; flex-direction: row; align-items: center; background: #f7f3ef; border-radius: 28rpx; }
.st-b { width: 60rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.st-v { width: 56rpx; text-align: center; font-size: 28rpx; font-weight: bold; }
.pay-way { display: flex; flex-direction: row; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #f3efea; }
.pay-way:last-child { border-bottom: none; padding-bottom: 0; }
.pay-way.dis { opacity: 0.5; }
.pw-ic { width: 56rpx; height: 56rpx; border-radius: 16rpx; color: #ffffff; font-size: 26rpx; font-weight: bold; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.pw-ic.wx { background: #22b35e; }
.pw-ic.card { background: linear-gradient(135deg, #ffb547, #ff7b54); }
.pw-m { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; min-width: 0; }
.pw-n { font-size: 28rpx; font-weight: bold; margin-bottom: 4rpx; }
.radio { width: 40rpx; height: 40rpx; border-radius: 20rpx; border: 3rpx solid #d9d2cb; box-sizing: border-box; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.radio.on { border-color: #ff8a3d; background: #ff8a3d; }
.radio-in { width: 14rpx; height: 14rpx; border-radius: 7rpx; background: #ffffff; }
.lines { padding-top: 12rpx; padding-bottom: 12rpx; }
.line { display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 12rpx 0; font-size: 26rpx; }
.cut { color: #ff5b35; }
.note { display: block; margin-top: 8rpx; padding-top: 16rpx; border-top: 1rpx solid #f3efea; line-height: 34rpx; }
