.top { background: #fff8f1; padding: 8rpx 24rpx 20rpx; display: flex; flex-direction: row; align-items: center; }
.loc { display: flex; flex-direction: row; align-items: center; margin-right: 20rpx; }
.loc-t { font-size: 28rpx; font-weight: bold; }
.down { width: 12rpx; height: 12rpx; border-right: 3rpx solid #2a2522; border-bottom: 3rpx solid #2a2522; transform: rotate(45deg); margin: -6rpx 0 0 12rpx; }
.search { flex: 1; height: 68rpx; border-radius: 34rpx; background: #ffffff; display: flex; flex-direction: row; align-items: center; padding: 0 24rpx; }
.s-ic { width: 20rpx; height: 20rpx; border: 4rpx solid #b5aca4; border-radius: 50%; margin-right: 12rpx; }
.s-ph { font-size: 24rpx; color: #b5aca4; }
.pets { height: 280rpx; margin-top: 16rpx; }
.pet { height: 260rpx; margin-right: 20rpx; border-radius: 28rpx; padding: 32rpx; box-sizing: border-box; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; }
.paw { position: absolute; border-radius: 50%; background: rgba(255,255,255,0.16); }
.p1 { width: 200rpx; height: 200rpx; right: -40rpx; top: -50rpx; }
.p2 { width: 110rpx; height: 110rpx; right: 140rpx; bottom: -40rpx; }
.pet-av { width: 104rpx; height: 104rpx; border-radius: 52rpx; background: rgba(255,255,255,0.3); border: 4rpx solid rgba(255,255,255,0.8); font-size: 44rpx; }
.pet-m { margin-left: 22rpx; display: flex; flex-direction: column; }
.pet-n { font-size: 38rpx; font-weight: bold; color: #ffffff; }
.pet-g { margin-left: 12rpx; font-size: 20rpx; color: #ffffff; background: rgba(255,255,255,0.25); padding: 2rpx 12rpx; border-radius: 16rpx; }
.pet-b { margin-top: 6rpx; font-size: 22rpx; color: rgba(255,255,255,0.9); }
.remind { display: flex; flex-direction: row; align-items: center; background: rgba(255,255,255,0.92); border-radius: 16rpx; padding: 14rpx 20rpx; }
.r-dot { width: 12rpx; height: 12rpx; border-radius: 6rpx; background: #ff5b35; margin-right: 12rpx; }
.r-t { font-size: 24rpx; color: #5a4f47; }
.entries { display: flex; flex-direction: row; padding: 28rpx 8rpx; }
.en { flex: 1; display: flex; flex-direction: column; align-items: center; }
.en-ic { width: 96rpx; height: 96rpx; border-radius: 30rpx; position: relative; }
.en-t { margin-top: 12rpx; font-size: 26rpx; font-weight: bold; color: #2a2522; }
.en-s { margin-top: 2rpx; font-size: 20rpx; color: #a9a099; }
/* 入口图标：纯 CSS 小图形 */
.g2-wash { position: absolute; left: 18rpx; top: 30rpx; width: 60rpx; height: 6rpx; background: #ffffff; border-radius: 3rpx; }
.g-wash { position: absolute; left: 24rpx; top: 30rpx; width: 48rpx; height: 36rpx; border: 5rpx solid #ffffff; border-top: none; border-radius: 0 0 24rpx 24rpx; }
.g-stay { position: absolute; left: 26rpx; top: 44rpx; width: 44rpx; height: 30rpx; background: #ffffff; border-radius: 0 0 4rpx 4rpx; }
.g2-stay { position: absolute; left: 32rpx; top: 22rpx; width: 32rpx; height: 32rpx; background: #ffffff; transform: rotate(45deg); border-radius: 4rpx; }
.g-med { position: absolute; left: 40rpx; top: 24rpx; width: 16rpx; height: 48rpx; background: #ffffff; border-radius: 4rpx; }
.g2-med { position: absolute; left: 24rpx; top: 40rpx; width: 48rpx; height: 16rpx; background: #ffffff; border-radius: 4rpx; }
.g2-shop { position: absolute; left: 36rpx; top: 18rpx; width: 24rpx; height: 24rpx; border: 5rpx solid #ffffff; border-radius: 14rpx 14rpx 0 0; border-bottom: none; }
.g-shop { position: absolute; left: 26rpx; top: 36rpx; width: 44rpx; height: 38rpx; border: 5rpx solid #ffffff; border-radius: 6rpx 6rpx 12rpx 12rpx; }
.promo { margin: 24rpx 24rpx 0; border-radius: 24rpx; padding: 28rpx 32rpx; background: linear-gradient(110deg, #fff0dc, #ffe1cc); display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.pr-t { display: block; font-size: 30rpx; font-weight: bold; color: #b5531c; }
.pr-s { display: block; margin-top: 6rpx; font-size: 22rpx; color: #c98656; }
.pr-btn { padding: 12rpx 28rpx; border-radius: 30rpx; background: linear-gradient(90deg, #ffb547, #ff7b54); color: #ffffff; font-size: 24rpx; font-weight: bold; }
.st { display: flex; flex-direction: row; padding: 28rpx 0; border-bottom: 1rpx solid #f3efea; }
.st:last-child { border-bottom: none; padding-bottom: 0; }
.st-pic { width: 136rpx; height: 136rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; color: #ffffff; font-size: 30rpx; font-weight: bold; flex-shrink: 0; }
.st-m { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; min-width: 0; }
.st-n { font-size: 28rpx; font-weight: bold; color: #2a2522; }
.st-meta { margin-top: 6rpx; }
.star { font-size: 22rpx; color: #ff8a3d; font-weight: bold; margin-right: 12rpx; }
.st-a { margin-top: 6rpx; font-size: 22rpx; color: #a9a099; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.st-tags { margin-top: 10rpx; }
.st-btn { align-self: center; width: 104rpx; height: 56rpx; border-radius: 28rpx; border: 2rpx solid #ff8a3d; color: #ff8a3d; font-size: 24rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; margin-left: 12rpx; flex-shrink: 0; }
