.gal { height: 620rpx; background: #ffffff; }
.gal-i { height: 620rpx; display: flex; align-items: center; justify-content: center; }
.gal-img { width: 520rpx; height: 520rpx; border-radius: 32rpx; }
.info { margin-top: -24rpx; position: relative; }
.pr { align-items: flex-end; }
.price.big { font-size: 52rpx; }
.orig { margin: 0 0 10rpx 12rpx; font-size: 24rpx; color: #c4bcb4; text-decoration: line-through; }
.save { margin: 0 0 10rpx 12rpx; font-size: 20rpx; color: #ff5b35; background: #fff0eb; padding: 2rpx 10rpx; border-radius: 6rpx; }
.fav { display: flex; flex-direction: column; align-items: center; font-size: 20rpx; color: #9a928b; }
.star { font-size: 40rpx; line-height: 44rpx; color: #d9d2cb; }
.fav.on { color: #ff5b35; }
.fav.on .star { color: #ff8a3d; }
.g-n { display: block; margin-top: 16rpx; font-size: 34rpx; font-weight: bold; color: #2a2522; line-height: 48rpx; }
.g-s { display: block; margin-top: 8rpx; font-size: 24rpx; color: #9a928b; }
.g-tags { margin-top: 18rpx; }
.g-sales { margin-left: auto; }
.lbl { width: 96rpx; font-size: 26rpx; color: #9a928b; flex-shrink: 0; }
.v { font-size: 26rpx; color: #2a2522; }
.specs { display: flex; flex-direction: row; flex-wrap: wrap; }
.spec { padding: 10rpx 28rpx; border-radius: 12rpx; background: #f7f3ef; border: 2rpx solid #f7f3ef; font-size: 24rpx; color: #5a4f47; margin-right: 16rpx; }
.spec.on { background: #fff4ea; border-color: #ff8a3d; color: #ff8a3d; font-weight: bold; }
.qty-row { margin: 28rpx 0; }
.stepper { display: flex; flex-direction: row; align-items: center; background: #f7f3ef; border-radius: 30rpx; }
.st-b { width: 60rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #2a2522; }
.st-b.dis { color: #c4bcb4; }
.st-v { width: 64rpx; text-align: center; font-size: 28rpx; font-weight: bold; }
.rv { margin-top: 24rpx; }
.rv-av { width: 52rpx; height: 52rpx; border-radius: 26rpx; color: #fff; font-size: 22rpx; display: flex; align-items: center; justify-content: center; }
.rv-n { margin-left: 14rpx; font-size: 26rpx; font-weight: bold; }
.rv-pet { margin-left: 12rpx; font-size: 20rpx; color: #e0782f; background: #fff1e4; padding: 2rpx 10rpx; border-radius: 6rpx; }
.rv-t { display: block; margin-top: 12rpx; font-size: 26rpx; color: #5a4f47; line-height: 40rpx; }
.bar { position: fixed; left: 0; right: 0; bottom: 0; background: #ffffff; padding: 16rpx 24rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: row; align-items: center; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05); }
.bar-ic { width: 96rpx; display: flex; flex-direction: column; align-items: center; font-size: 20rpx; color: #5a4f47; position: relative; }
.i-home { width: 32rpx; height: 28rpx; border: 4rpx solid #5a4f47; border-radius: 4rpx; margin-bottom: 6rpx; box-sizing: border-box; }
.i-cart { width: 36rpx; height: 30rpx; border: 4rpx solid #5a4f47; border-radius: 4rpx 4rpx 10rpx 10rpx; margin-bottom: 6rpx; box-sizing: border-box; }
.badge { position: absolute; right: 8rpx; top: -10rpx; min-width: 32rpx; height: 32rpx; padding: 0 6rpx; border-radius: 16rpx; background: #ff3b30; color: #fff; font-size: 18rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.b-add, .b-buy { flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: bold; color: #ffffff; }
.b-add { margin-left: 12rpx; background: linear-gradient(90deg, #ffd06b, #ffb547); border-radius: 40rpx 0 0 40rpx; }
.b-buy { background: linear-gradient(90deg, #ff9a52, #ff6a3d); border-radius: 0 40rpx 40rpx 0; }
.i-img { width: 44rpx; height: 44rpx; margin-bottom: 2rpx; }
