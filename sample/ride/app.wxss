page { background: #f5f6f8; color: #1f2329; font-size: 28rpx; }
.card { background: #fff; border-radius: 20rpx; margin: 0 24rpx 24rpx; padding: 28rpx; box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.05); }
.title { font-size: 34rpx; font-weight: bold; }
.sub { font-size: 24rpx; color: #8a9099; }
.row { display: flex; flex-direction: row; align-items: center; }
.between { justify-content: space-between; }
.flex1 { flex: 1; min-width: 0; }
.orange { color: #FF7A1A; }
.btn-primary { background: linear-gradient(90deg, #FF9A3C, #FF6A1A); color: #fff; font-size: 32rpx; font-weight: bold; height: 92rpx; line-height: 92rpx; text-align: center; border-radius: 46rpx; }
.btn-ghost { background: #fff; color: #1f2329; border: 2rpx solid #e3e5e8; font-size: 28rpx; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 40rpx; }
.btn-off { background: #d5d8dc; }
.dot { width: 16rpx; height: 16rpx; border-radius: 8rpx; flex-shrink: 0; }
.dot-green { background: #19BE6B; }
.dot-orange { background: #FF7A1A; }
.section-title { font-size: 30rpx; font-weight: bold; margin: 32rpx 24rpx 0; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.nowrap { white-space: nowrap; }
/* 右箭头用 CSS 画：U+203A「›」在引擎字体回退里画成了冒号 */
.chev { width: 14rpx; height: 14rpx; border-top: 3rpx solid #c4c7cc; border-right: 3rpx solid #c4c7cc; transform: rotate(45deg); margin-left: 12rpx; flex-shrink: 0; }
.chev.white { border-color: #fff; width: 18rpx; height: 18rpx; }
/* 引擎的 input 只要 padding 全为 0 就套用默认 8px/12px 内边距（微信里 input 无内边距），给 1rpx 让它认作自定义 */
input { padding: 0 0 0 1rpx; }
.ph { color: #b5b9bf; }
/* 底部面板：遮罩与面板是兄弟节点，面板里再 catchtap 一层保险 */
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0, 0, 0, 0.45); z-index: 20; }
.sheet-panel { position: fixed; left: 0; right: 0; bottom: 0; z-index: 21; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); }
.sheet-head { margin-bottom: 24rpx; }
.sheet-title { font-size: 32rpx; font-weight: bold; }
.sheet-close { font-size: 26rpx; color: #8a9099; padding: 8rpx 0 8rpx 24rpx; }
/* 选项胶囊：选中态加粗，nowrap 防止加粗后折行 */
.chip { height: 60rpx; line-height: 60rpx; padding: 0 26rpx; margin: 0 16rpx 16rpx 0; border-radius: 30rpx; background: #f5f6f8; color: #4e5969; font-size: 26rpx; border: 2rpx solid #f5f6f8; white-space: nowrap; }
.chip-on { background: #FFF2E8; color: #FF6A1A; border-color: #FF9A3C; font-weight: bold; }
.chips { display: flex; flex-direction: row; flex-wrap: wrap; }
/* 表单行 */
.field { height: 96rpx; border-bottom: 1rpx solid #f0f1f3; }
.field-label { width: 150rpx; font-size: 28rpx; color: #4e5969; flex-shrink: 0; }
.field-input { flex: 1; height: 96rpx; font-size: 28rpx; }
/* 勾选框：勾用旋转的 L 形边框画（✓ 字形画不出来） */
.check { width: 36rpx; height: 36rpx; border-radius: 18rpx; border: 3rpx solid #c4c7cc; box-sizing: border-box; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.check-on { background: #FF7A1A; border-color: #FF7A1A; }
.tick { width: 16rpx; height: 9rpx; border-left: 4rpx solid #fff; border-bottom: 4rpx solid #fff; transform: rotate(-45deg); margin-top: -4rpx; }
.empty { text-align: center; color: #9aa0a6; font-size: 26rpx; padding: 100rpx 0; }
/* 定宽块的 margin: 0 auto 在引擎里不居中：空态一律放进 flex 居中的 .empty-wrap */
.empty-ic { width: 120rpx; height: 120rpx; border-radius: 60rpx; background: #FFF2E8; margin-bottom: 20rpx; display: flex; align-items: center; justify-content: center; }
.empty-ic-t { color: #FF9A3C; font-size: 44rpx; font-weight: bold; }
.empty-wrap { display: flex; flex-direction: column; align-items: center; padding: 160rpx 0 40rpx; }
.empty-btn { margin-top: 32rpx; width: 320rpx; }
