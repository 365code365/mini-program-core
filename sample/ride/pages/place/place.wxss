.search-bar { display: flex; flex-direction: row; align-items: center; background: #fff; padding: 16rpx 24rpx 24rpx; }
/* 示例数据只有北京的地点：城市只是搜索范围的标签，不做成可点的下拉 */
.city { font-size: 28rpx; font-weight: bold; margin-right: 20rpx; }
.search { flex: 1; height: 76rpx; background: #f5f6f8; border-radius: 38rpx; display: flex; flex-direction: row; align-items: center; padding: 0 24rpx; }
.search-input { flex: 1; margin-left: 16rpx; font-size: 28rpx; height: 76rpx; }
.clear { width: 40rpx; height: 40rpx; border-radius: 20rpx; background: #d5d8dc; display: flex; align-items: center; justify-content: center; margin-left: 16rpx; }
.clear-x { font-size: 26rpx; color: #fff; }
.common { display: flex; flex-direction: row; margin: 24rpx; }
.common-item { flex: 1; min-width: 0; background: #fff; border-radius: 20rpx; padding: 24rpx; display: flex; flex-direction: row; align-items: center; margin-right: 16rpx; }
.common-item:last-child { margin-right: 0; }
.common-icon { width: 64rpx; height: 64rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.common-glyph { color: #fff; font-size: 28rpx; font-weight: bold; }
.common-body { margin-left: 16rpx; display: flex; flex-direction: column; flex: 1; min-width: 0; }
.common-tag { font-size: 28rpx; font-weight: bold; }
.common-name { font-size: 22rpx; color: #8a9099; margin-top: 4rpx; }
.common-name.orange { color: #FF7A1A; }
.list-head { margin: 32rpx 24rpx 12rpx; }
.list-title { font-size: 28rpx; font-weight: bold; color: #4e5969; }
.manage { padding: 4rpx 0 4rpx 20rpx; }
.list { background: #fff; margin: 0 24rpx; border-radius: 20rpx; padding: 0 24rpx; }
.here-list { margin-top: 24rpx; }
.result { margin-top: 24rpx; }
.empty { text-align: center; color: #9aa0a6; font-size: 26rpx; padding: 40rpx 0; }
.poi { display: flex; flex-direction: row; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f0f1f3; }
.poi:last-child { border-bottom: none; }
.poi-icon { width: 52rpx; height: 52rpx; border-radius: 26rpx; background: #f2f3f5; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.poi-pin { width: 18rpx; height: 18rpx; border-radius: 9rpx; border: 5rpx solid #8a9099; }
.here-icon { background: #e7f8ef; }
.here-dot { width: 18rpx; height: 18rpx; border-radius: 9rpx; background: #19BE6B; border: 4rpx solid #fff; }
.star-icon { background: #FFF2E8; }
.star-t { color: #FF9A3C; font-size: 26rpx; }
.clock { position: relative; }
.clock-hand { width: 20rpx; height: 20rpx; border-left: 4rpx solid #8a9099; border-bottom: 4rpx solid #8a9099; margin-left: 8rpx; margin-top: -8rpx; }
.poi-body { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
.poi-name { font-size: 30rpx; color: #1f2329; }
.poi-addr { font-size: 24rpx; color: #9aa0a6; margin-top: 6rpx; }
.poi-dist { font-size: 24rpx; color: #9aa0a6; margin-left: 16rpx; white-space: nowrap; }
.gap { height: 48rpx; }
