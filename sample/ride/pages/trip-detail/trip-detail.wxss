.hero { background: linear-gradient(160deg, #FF9A3C, #FF6A1A); padding: 40rpx 32rpx 100rpx; display: flex; flex-direction: column; align-items: center; }
.hero-label { color: rgba(255, 255, 255, 0.9); font-size: 28rpx; }
.hero-price { display: flex; flex-direction: row; align-items: flex-end; margin-top: 8rpx; }
.hero-num { color: #fff; font-size: 80rpx; font-weight: bold; }
.hero-unit { color: #fff; font-size: 28rpx; margin: 0 0 16rpx 6rpx; }
.hero-sub { color: rgba(255, 255, 255, 0.85); font-size: 24rpx; margin-top: 8rpx; }
.overlap { margin-top: -70rpx; }
.route-text { flex: 1; min-width: 0; font-size: 28rpx; margin-left: 18rpx; }
.route-line { width: 2rpx; height: 24rpx; background: #e3e5e8; margin: 6rpx 0 6rpx 7rpx; }
.driver { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #f0f1f3; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 40rpx; background: linear-gradient(135deg, #8EC5FF, #3D7BFF); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.avatar-text { color: #fff; font-size: 32rpx; font-weight: bold; }
.ml { margin-left: 20rpx; }
.driver-name { font-size: 28rpx; font-weight: bold; display: block; }
.block { display: block; margin-top: 4rpx; }
.mini-btn { font-size: 24rpx; color: #FF7A1A; border: 2rpx solid #FF9A3C; border-radius: 28rpx; padding: 8rpx 24rpx; margin-left: 16rpx; white-space: nowrap; }
.again { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #f0f1f3; }
.unpaid-text { display: block; font-size: 26rpx; color: #4e5969; line-height: 40rpx; }
.go-pay { margin-top: 24rpx; }
.head { margin-bottom: 12rpx; }
.rule { padding: 4rpx 0 4rpx 20rpx; }
.title-sm { font-size: 30rpx; font-weight: bold; }
.fee { font-size: 28rpx; color: #4e5969; padding: 12rpx 0; }
.total { border-top: 1rpx dashed #e3e5e8; margin-top: 12rpx; padding: 22rpx 0 12rpx; }
.total-label { font-size: 30rpx; font-weight: bold; }
.total-num { font-size: 36rpx; font-weight: bold; }
.cancel-box { margin: 12rpx 0 8rpx; }
.cancel-text { display: block; font-size: 26rpx; color: #4e5969; line-height: 40rpx; }
.stars { margin-top: 16rpx; }
.star { font-size: 52rpx; line-height: 64rpx; color: #e3e5e8; margin-right: 14rpx; }
.star-on { color: #FFB400; }
.star-text { font-size: 26rpx; color: #FF7A1A; margin-left: 8rpx; }
.rate .chips { margin-top: 16rpx; }
.rate-input { width: 100%; height: 140rpx; padding: 16rpx 20rpx; box-sizing: border-box; border-radius: 14rpx; background: #f7f8fa; font-size: 26rpx; }
.rate-btn { margin-top: 24rpx; height: 80rpx; line-height: 80rpx; font-size: 28rpx; border-radius: 40rpx; }
.rate-said { display: block; margin-top: 8rpx; font-size: 26rpx; color: #4e5969; line-height: 40rpx; }
/* 已提交评价里的标签：只展示，样式同选中的 chip */
.said-tag { height: 52rpx; line-height: 52rpx; padding: 0 22rpx; margin: 0 16rpx 16rpx 0; border-radius: 26rpx; background: #FFF2E8; color: #FF6A1A; border: 2rpx solid #FF9A3C; font-size: 24rpx; white-space: nowrap; }
.complaint { padding-top: 24rpx; padding-bottom: 24rpx; }
.cp-tag { font-size: 20rpx; color: #fff; background: #FF7A1A; border-radius: 8rpx; padding: 2rpx 12rpx; margin-right: 16rpx; white-space: nowrap; }
.cp-text { font-size: 26rpx; color: #4e5969; }
.info { padding-top: 12rpx; padding-bottom: 12rpx; }
.info-row { height: 68rpx; font-size: 26rpx; }
.copy { margin-left: 16rpx; font-size: 22rpx; color: #FF7A1A; padding: 0 14rpx; line-height: 36rpx; border-radius: 18rpx; border: 1rpx solid #FF9A3C; }
.ops { display: flex; flex-direction: row; margin: 8rpx 24rpx 0; }
.gap { height: calc(48rpx + env(safe-area-inset-bottom)); }
