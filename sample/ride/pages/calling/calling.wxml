<view class="map">
  <view class="road h" style="top:160rpx;"></view>
  <view class="road h thin" style="top:340rpx;"></view>
  <view class="road v" style="left:200rpx;"></view>
  <view class="road v thin" style="left:560rpx;"></view>
  <view class="block" style="left:260rpx;top:210rpx;width:260rpx;height:110rpx;"></view>
  <view class="block park" style="left:30rpx;top:200rpx;width:140rpx;height:120rpx;"></view>
  <view class="block" style="left:610rpx;top:200rpx;width:120rpx;height:120rpx;"></view>
  <view wx:if="{{stage === 'waiting'}}" class="radar">
    <view class="wave w1"></view>
    <view class="wave w2"></view>
    <view class="wave w3"></view>
    <view class="radar-core"><view class="radar-dot"></view></view>
  </view>
  <block wx:elif="{{stage === 'accepted' || stage === 'arrived'}}">
    <view wx:if="{{map.lineH}}" class="route-line" style="top:{{map.lineTop}}rpx;height:{{map.lineH}}rpx;"></view>
    <view class="me"><view class="me-dot"></view></view>
    <view class="driver-car" style="top:{{map.carTop}}rpx;"></view>
    <view class="map-bubble bubble-pick">
      <block wx:if="{{stage === 'accepted'}}">
        <text>司机距你</text><text class="orange b-num">{{v.distText}}</text><text>· 约</text><text class="orange b-num">{{v.etaMin}}</text><text>分钟</text>
      </block>
      <text wx:else>司机已到达上车点</text>
    </view>
  </block>
  <block wx:elif="{{stage === 'ongoing'}}">
    <view class="route-line ride-line" style="top:{{map.lineTop}}rpx;height:{{map.lineH}}rpx;"></view>
    <view class="dest-pin"><view class="dest-in"></view></view>
    <view class="driver-car ride-car" style="top:{{map.carTop}}rpx;"></view>
    <view class="map-bubble bubble-ride">
      <text>距终点</text><text class="orange b-num">{{leftKm}}</text><text>公里 · 约</text><text class="orange b-num">{{v.leftMin}}</text><text>分钟</text>
    </view>
  </block>
  <view wx:else class="pin-wrap">
    <view wx:if="{{stage === 'booked'}}" class="map-bubble-static"><text>{{v.whenText}} 在这里上车</text></view>
    <view class="pin"><view class="pin-inner"></view></view>
    <view class="pin-stick"></view>
  </view>
</view>
<view class="sheet">
  <view wx:if="{{!o}}" class="empty-wrap none">
    <view class="empty-ic"><text class="empty-ic-t">车</text></view>
    <text class="sub">当前没有进行中的行程</text>
    <view class="btn-primary empty-btn" bindtap="onHome">去叫车</view>
  </view>
  <block wx:elif="{{stage === 'waiting'}}">
    <view class="wait-title">正在为你呼叫{{o.type}}</view>
    <view class="wait-sub"><text>已等待</text><text class="orange mono">{{v.waited}}</text><text>附近有 {{nearby}} 辆车</text></view>
    <view class="progress"><view class="progress-bar"></view></view>
    <view class="trip-mini">
      <view class="row"><view class="dot dot-green"></view><text class="trip-mini-text">{{o.from.name}}</text></view>
      <view class="row mt"><view class="dot dot-orange"></view><text class="trip-mini-text">{{o.to.name}}</text><text class="edit-to" bindtap="onChangeDest">修改</text></view>
    </view>
    <view wx:if="{{o.passenger}}" class="proxy-tip"><text>为 {{o.passenger.name}}（{{pMask}}）叫车，司机接单后短信通知 TA</text></view>
    <view class="tip-row" bindtap="onRule">
      <text class="sub">{{est.cut ? '券后预估' : '预估'}}</text>
      <text class="tip-price">{{est.pay}}</text>
      <text class="sub">元</text>
      <text wx:if="{{est.cut}}" class="sub tip-coupon">{{est.couponName}}抵 {{est.cut}} 元</text>
    </view>
    <view class="btn-ghost cancel-btn" bindtap="onCancel">取消呼叫</view>
  </block>
  <block wx:else>
    <view class="status-row row between">
      <text class="status-title">{{head.title}}</text>
      <text class="sub">{{head.sub}}</text>
    </view>
    <view wx:if="{{stage === 'booked'}}" class="note"><text>司机会在出发前 15 分钟出发接你，司机出发前取消免费</text></view>
    <view wx:elif="{{stage === 'accepted'}}" class="note {{v.freeLeft ? '' : 'note-warn'}}"><text>{{v.freeLeft ? '接单 2 分钟内可免费取消，还剩 ' + v.freeLeft : '现在取消将收取 ¥5 取消费（司机原因除外）'}}</text></view>
    <view wx:elif="{{stage === 'arrived'}}" class="note note-warn"><text>司机已在 {{o.from.name}} 等你，现在取消将收取 ¥5 取消费</text></view>
    <view wx:else class="ride">
      <view class="ride-bar"><view class="ride-fill" style="width:{{v.progress}}%;"></view></view>
      <view class="row between ride-meta">
        <text class="sub">已行驶 {{v.traveled}} 公里</text>
        <text class="sub">全程 {{o.km}} 公里 · 剩余约 {{v.leftMin}} 分钟</text>
      </view>
    </view>
    <view class="driver-card">
      <view class="avatar"><text class="avatar-text">{{o.driver.surname}}</text></view>
      <view class="driver-info">
        <view class="plate-row"><text class="plate">{{o.driver.plate}}</text></view>
        <text class="car-model">{{o.driver.color}} · {{o.driver.model}}</text>
        <view class="row meta">
          <text class="driver-name">{{o.driver.name}}</text>
          <text class="star">★</text><text class="rating">{{o.driver.rating}}</text>
          <text class="sub orders">接单 {{o.driver.orders}} 次</text>
        </view>
      </view>
      <view class="car-pic"><view class="car-top"></view><view class="car-body"></view><view class="wheel l"></view><view class="wheel r"></view></view>
    </view>
    <view class="actions">
      <view class="act act-call" bindtap="onCallDriver"><view class="act-icon"><text>话</text></view><text class="act-text">打电话</text></view>
      <view class="act act-msg" bindtap="onMessage"><view class="act-icon"><text>信</text></view><text class="act-text">发消息</text></view>
      <view class="act act-safe" bindtap="onSafety"><view class="act-icon safe"><text>安</text></view><text class="act-text">安全中心</text></view>
      <view class="act act-more" bindtap="onMore"><view class="act-icon"><text>…</text></view><text class="act-text">更多</text></view>
    </view>
    <view class="row btns">
      <block wx:if="{{stage === 'booked'}}">
        <view class="btn-ghost flex1 cancel-btn" bindtap="onCancel">取消预约</view>
        <view class="btn-primary flex1 ml home-btn" bindtap="onHome">返回首页</view>
      </block>
      <block wx:elif="{{stage === 'accepted'}}">
        <view class="btn-ghost flex1 cancel-btn" bindtap="onCancel">取消行程</view>
        <view class="btn-primary flex1 ml share-btn" bindtap="onShare">分享行程</view>
      </block>
      <block wx:elif="{{stage === 'arrived'}}">
        <view class="btn-ghost flex1 cancel-btn" bindtap="onCancel">取消行程</view>
        <view class="btn-primary flex1 ml board-btn" bindtap="onBoard">我已上车</view>
      </block>
      <block wx:else>
        <view class="btn-ghost flex1 share-btn" bindtap="onShare">分享行程</view>
        <view class="btn-alarm flex1 ml alarm-btn" bindtap="onAlarm">一键报警</view>
      </block>
    </view>
    <view wx:if="{{msgs.length}}" class="chat">
      <view wx:for="{{msgs}}" wx:key="k" class="msg-row {{item.me ? 'msg-me' : ''}}">
        <text class="msg {{item.me ? 'msg-mine' : ''}}">{{item.me ? '' : o.driver.name + '：'}}{{item.text}}</text>
      </view>
    </view>
    <view class="trip-mini">
      <view class="row"><view class="dot dot-green"></view><text class="trip-mini-text">{{o.from.name}}</text></view>
      <view class="row mt"><view class="dot dot-orange"></view><text class="trip-mini-text">{{o.to.name}}</text><text class="edit-to" bindtap="onChangeDest">修改</text></view>
      <view class="row mt"><text class="sub">{{o.type}} · 约 {{o.km}} 公里 · {{est.cut ? '券后预估 ' : '预估 '}}{{est.pay}} 元</text></view>
    </view>
    <view wx:if="{{o.passenger}}" class="proxy-tip"><text>乘车人 {{o.passenger.name}}（{{pMask}}），司机信息已短信通知 TA</text></view>
    <view class="safe-strip row">
      <view class="dot {{recording ? 'dot-green' : 'dot-gray'}}"></view>
      <text class="sub safe-text">{{recording ? '行程录音保护中' : '行程录音已关闭'}}{{o.shared ? ' · 已分享给紧急联系人' : ''}}</text>
    </view>
  </block>
</view>
