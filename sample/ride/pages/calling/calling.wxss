page { background: #ffffff; }
.map { position: relative; height: 560rpx; overflow: hidden; background: #eef1ec; }
.road { position: absolute; background: #fff; }
.road.h { left: 0; width: 750rpx; height: 32rpx; }
.road.v { top: 0; height: 560rpx; width: 30rpx; }
.road.thin.h { height: 18rpx; }
.road.thin.v { width: 18rpx; }
.block { position: absolute; background: #e4e2dc; border-radius: 16rpx; }
.block.park { background: #d3e8c8; }
.radar { position: absolute; left: 255rpx; top: 60rpx; width: 240rpx; height: 240rpx; display: flex; align-items: center; justify-content: center; }
.wave { position: absolute; left: 0; top: 0; width: 240rpx; height: 240rpx; border-radius: 120rpx; background: rgba(255, 122, 26, 0.22); animation: wave 3s ease-out infinite; }
.w2 { animation-delay: 1s; }
.w3 { animation-delay: 2s; }
@keyframes wave { 0% { transform: scale(0.2); opacity: 1; } 100% { transform: scale(1.4); opacity: 0; } }
.radar-core { width: 64rpx; height: 64rpx; border-radius: 32rpx; background: #FF7A1A; display: flex; align-items: center; justify-content: center; box-shadow: 0 6rpx 16rpx rgba(255, 122, 26, 0.5); }
.radar-dot { width: 22rpx; height: 22rpx; border-radius: 11rpx; background: #fff; }
.route-line { position: absolute; left: 207rpx; top: 196rpx; width: 16rpx; height: 200rpx; background: #19BE6B; border-radius: 8rpx; }
.me { position: absolute; left: 190rpx; top: 380rpx; width: 50rpx; height: 50rpx; border-radius: 25rpx; background: rgba(61, 123, 255, 0.25); display: flex; align-items: center; justify-content: center; }
.me-dot { width: 24rpx; height: 24rpx; border-radius: 12rpx; background: #3D7BFF; border: 4rpx solid #fff; }
.driver-car { position: absolute; left: 196rpx; top: 160rpx; width: 38rpx; height: 64rpx; border-radius: 10rpx; background: #1f2329; border: 4rpx solid #fff; box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.3); }
.eta-bubble { position: absolute; left: 260rpx; top: 120rpx; background: #fff; padding: 14rpx 24rpx; border-radius: 30rpx; font-size: 26rpx; box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.12); }

.sheet { position: relative; margin-top: -40rpx; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); min-height: 700rpx; }
.wait-title { font-size: 40rpx; font-weight: bold; text-align: center; }
.wait-sub { font-size: 26rpx; color: #8a9099; margin-top: 12rpx; display: flex; flex-direction: row; justify-content: center; }
.mono { font-weight: bold; }
.progress { height: 8rpx; background: #f2f3f5; border-radius: 4rpx; margin: 32rpx 0; overflow: hidden; }
.progress-bar { width: 40%; height: 8rpx; border-radius: 4rpx; background: linear-gradient(90deg, #FFB067, #FF6A1A); animation: slide 1.6s ease-in-out infinite; }
@keyframes slide { 0% { transform: translateX(-100%); } 100% { transform: translateX(260%); } }
.trip-mini { background: #f7f8fa; border-radius: 16rpx; padding: 24rpx; }
.trip-mini-text { font-size: 28rpx; margin-left: 18rpx; }
.mt { margin-top: 20rpx; }
.tip-row { display: flex; flex-direction: row; align-items: center; justify-content: center; margin: 32rpx 0; }
.tip-price { font-size: 36rpx; font-weight: bold; margin: 0 8rpx; }

.status-title { font-size: 38rpx; font-weight: bold; }
.status-row { margin-bottom: 28rpx; }
.driver-card { display: flex; flex-direction: row; align-items: center; background: #f7f8fa; border-radius: 20rpx; padding: 28rpx 24rpx; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 48rpx; background: linear-gradient(135deg, #8EC5FF, #3D7BFF); display: flex; align-items: center; justify-content: center; }
.avatar-text { color: #fff; font-size: 40rpx; font-weight: bold; }
.driver-info { flex: 1; margin-left: 22rpx; display: flex; flex-direction: column; }
.plate-row { display: flex; flex-direction: row; }
.plate { font-size: 40rpx; font-weight: bold; letter-spacing: 2rpx; background: #fff; border: 2rpx solid #e3e5e8; border-radius: 10rpx; padding: 2rpx 14rpx; }
.car-model { font-size: 26rpx; color: #4e5969; margin-top: 10rpx; }
.meta { margin-top: 8rpx; }
.driver-name { font-size: 24rpx; color: #4e5969; margin-right: 12rpx; }
.star { color: #FFB400; font-size: 24rpx; }
.rating { font-size: 24rpx; font-weight: bold; margin-left: 4rpx; }
.orders { margin-left: 12rpx; }
.car-pic { position: relative; width: 140rpx; height: 80rpx; }
.car-top { position: absolute; left: 30rpx; top: 6rpx; width: 80rpx; height: 34rpx; border-radius: 20rpx 20rpx 0 0; background: #dfe3e8; }
.car-body { position: absolute; left: 0; top: 34rpx; width: 140rpx; height: 32rpx; border-radius: 14rpx; background: #fff; border: 2rpx solid #dfe3e8; }
.wheel { position: absolute; top: 54rpx; width: 26rpx; height: 26rpx; border-radius: 13rpx; background: #3a3f47; }
.wheel.l { left: 20rpx; }
.wheel.r { left: 94rpx; }
.actions { display: flex; flex-direction: row; justify-content: space-around; margin: 36rpx 0; }
.act { display: flex; flex-direction: column; align-items: center; }
.act-icon { width: 84rpx; height: 84rpx; border-radius: 42rpx; background: #f2f3f5; text-align: center; line-height: 84rpx; font-size: 30rpx; color: #4e5969; font-weight: bold; }
.act-icon.safe { background: #e7f8ef; color: #19BE6B; }
.act-text { font-size: 24rpx; color: #4e5969; margin-top: 10rpx; }
.btns { margin-top: 8rpx; }
.btns .btn-ghost { height: 92rpx; line-height: 92rpx; border-radius: 46rpx; }
.ml { margin-left: 20rpx; }
