page { background: #ffffff; }
.map { position: relative; height: 480rpx; overflow: hidden; background: #eef1ec; }
.road { position: absolute; background: #fff; }
.road.h { left: 0; width: 750rpx; height: 32rpx; }
.road.v { top: 0; height: 480rpx; width: 30rpx; }
.road.thin.h { height: 18rpx; }
.road.thin.v { width: 18rpx; }
.block { position: absolute; background: #e4e2dc; border-radius: 16rpx; }
.block.park { background: #d3e8c8; }
.radar { position: absolute; left: 255rpx; top: 40rpx; width: 240rpx; height: 240rpx; display: flex; align-items: center; justify-content: center; }
.wave { position: absolute; left: 0; top: 0; width: 240rpx; height: 240rpx; border-radius: 120rpx; background: rgba(255, 122, 26, 0.22); animation: wave 3s ease-out infinite; }
.w2 { animation-delay: 1s; }
.w3 { animation-delay: 2s; }
@keyframes wave { 0% { transform: scale(0.2); opacity: 1; } 100% { transform: scale(1.4); opacity: 0; } }
.radar-core { width: 64rpx; height: 64rpx; border-radius: 32rpx; background: #FF7A1A; display: flex; align-items: center; justify-content: center; box-shadow: 0 6rpx 16rpx rgba(255, 122, 26, 0.5); }
.radar-dot { width: 22rpx; height: 22rpx; border-radius: 11rpx; background: #fff; }
/* 接驾：左边那条路，车往下开到乘客；行程中：右边那条路，车往上开到终点 */
.route-line { position: absolute; left: 207rpx; width: 16rpx; background: #19BE6B; border-radius: 8rpx; }
.ride-line { left: 561rpx; }
.me { position: absolute; left: 190rpx; top: 326rpx; width: 50rpx; height: 50rpx; border-radius: 25rpx; background: rgba(61, 123, 255, 0.25); display: flex; align-items: center; justify-content: center; }
.me-dot { width: 24rpx; height: 24rpx; border-radius: 12rpx; background: #3D7BFF; border: 4rpx solid #fff; }
.driver-car { position: absolute; left: 196rpx; width: 38rpx; height: 64rpx; border-radius: 10rpx; background: #1f2329; border: 4rpx solid #fff; box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.3); }
.ride-car { left: 550rpx; }
.dest-pin { position: absolute; left: 549rpx; top: 24rpx; width: 40rpx; height: 40rpx; border-radius: 20rpx; background: #FF7A1A; display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 10rpx rgba(255, 122, 26, 0.45); }
.dest-in { width: 14rpx; height: 14rpx; border-radius: 7rpx; background: #fff; }
/* 嵌套 <text> 前后的空格会被引擎吞掉：气泡用 flex 排，数字左右留外边距 */
.map-bubble { position: absolute; display: flex; flex-direction: row; align-items: center; background: #fff; padding: 14rpx 24rpx; border-radius: 30rpx; font-size: 26rpx; box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.12); white-space: nowrap; }
.bubble-pick { left: 260rpx; top: 96rpx; }
.bubble-ride { left: 60rpx; top: 96rpx; }
.b-num { margin: 0 6rpx; font-weight: bold; }
.pin-wrap { position: absolute; left: 0; right: 0; top: 110rpx; display: flex; flex-direction: column; align-items: center; }
.map-bubble-static { background: #fff; padding: 14rpx 26rpx; border-radius: 32rpx; font-size: 26rpx; box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.12); margin-bottom: 18rpx; white-space: nowrap; }
.pin { width: 56rpx; height: 56rpx; border-radius: 28rpx; background: #FF7A1A; display: flex; align-items: center; justify-content: center; box-shadow: 0 6rpx 14rpx rgba(255, 122, 26, 0.45); }
.pin-inner { width: 20rpx; height: 20rpx; border-radius: 10rpx; background: #fff; }
.pin-stick { width: 6rpx; height: 30rpx; background: #FF7A1A; border-radius: 3rpx; }
.sheet { position: relative; margin-top: -40rpx; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); min-height: 700rpx; }
.none { padding-top: 80rpx; }
.wait-title { font-size: 40rpx; font-weight: bold; text-align: center; }
.wait-sub { font-size: 26rpx; color: #8a9099; margin-top: 12rpx; display: flex; flex-direction: row; justify-content: center; }
.mono { font-weight: bold; margin: 0 12rpx 0 8rpx; }
.progress { height: 8rpx; background: #f2f3f5; border-radius: 4rpx; margin: 32rpx 0; overflow: hidden; }
.progress-bar { width: 40%; height: 8rpx; border-radius: 4rpx; background: linear-gradient(90deg, #FFB067, #FF6A1A); animation: slide 1.6s ease-in-out infinite; }
@keyframes slide { 0% { transform: translateX(-100%); } 100% { transform: translateX(260%); } }
.trip-mini { background: #f7f8fa; border-radius: 16rpx; padding: 24rpx; margin-top: 24rpx; }
.trip-mini-text { flex: 1; min-width: 0; font-size: 28rpx; margin-left: 18rpx; }
.edit-to { font-size: 24rpx; color: #FF6A1A; padding: 4rpx 0 4rpx 20rpx; white-space: nowrap; }
.mt { margin-top: 20rpx; }
.proxy-tip { margin-top: 16rpx; font-size: 24rpx; color: #7B5CFF; background: #F3EFFF; border-radius: 12rpx; padding: 14rpx 20rpx; }
.tip-row { display: flex; flex-direction: row; align-items: center; justify-content: center; margin: 32rpx 0; }
.tip-price { font-size: 36rpx; font-weight: bold; margin: 0 8rpx; }
.tip-coupon { margin-left: 16rpx; color: #FF7A1A; }
.status-title { font-size: 38rpx; font-weight: bold; }
.status-row { margin-bottom: 20rpx; }
.note { font-size: 24rpx; color: #19BE6B; background: #e7f8ef; border-radius: 12rpx; padding: 14rpx 20rpx; margin-bottom: 20rpx; }
.note-warn { color: #C2570C; background: #FFF2E8; }
.ride { margin-bottom: 20rpx; }
.ride-bar { height: 12rpx; background: #f2f3f5; border-radius: 6rpx; overflow: hidden; }
.ride-fill { height: 12rpx; border-radius: 6rpx; background: linear-gradient(90deg, #5FD99A, #19BE6B); }
.ride-meta { margin-top: 12rpx; }
.driver-card { display: flex; flex-direction: row; align-items: center; background: #f7f8fa; border-radius: 20rpx; padding: 28rpx 24rpx; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 48rpx; background: linear-gradient(135deg, #8EC5FF, #3D7BFF); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.avatar-text { color: #fff; font-size: 40rpx; font-weight: bold; }
.driver-info { flex: 1; min-width: 0; margin-left: 22rpx; display: flex; flex-direction: column; }
.plate-row { display: flex; flex-direction: row; }
.plate { font-size: 40rpx; font-weight: bold; letter-spacing: 2rpx; background: #fff; border: 2rpx solid #e3e5e8; border-radius: 10rpx; padding: 2rpx 14rpx; }
.car-model { font-size: 26rpx; color: #4e5969; margin-top: 10rpx; }
.meta { margin-top: 8rpx; }
.driver-name { font-size: 24rpx; color: #4e5969; margin-right: 12rpx; }
.star { color: #FFB400; font-size: 24rpx; }
.rating { font-size: 24rpx; font-weight: bold; margin-left: 4rpx; }
.orders { margin-left: 12rpx; }
.car-pic { position: relative; width: 140rpx; height: 80rpx; flex-shrink: 0; }
.car-top { position: absolute; left: 30rpx; top: 6rpx; width: 80rpx; height: 34rpx; border-radius: 20rpx 20rpx 0 0; background: #dfe3e8; }
.car-body { position: absolute; left: 0; top: 34rpx; width: 140rpx; height: 32rpx; border-radius: 14rpx; background: #fff; border: 2rpx solid #dfe3e8; }
.wheel { position: absolute; top: 54rpx; width: 26rpx; height: 26rpx; border-radius: 13rpx; background: #3a3f47; }
.wheel.l { left: 20rpx; }
.wheel.r { left: 94rpx; }
.chat { margin-top: 24rpx; }
.msg-row { display: flex; flex-direction: row; margin-top: 12rpx; }
.msg-me { justify-content: flex-end; }
.msg { max-width: 520rpx; font-size: 26rpx; line-height: 38rpx; padding: 14rpx 22rpx; border-radius: 20rpx; background: #f2f3f5; color: #1f2329; }
.msg-mine { background: #FFE8D6; color: #8A3A00; }
.actions { display: flex; flex-direction: row; justify-content: space-around; margin: 28rpx 0 24rpx; }
.act { display: flex; flex-direction: column; align-items: center; }
.act-icon { width: 84rpx; height: 84rpx; border-radius: 42rpx; background: #f2f3f5; display: flex; align-items: center; justify-content: center; font-size: 30rpx; color: #4e5969; font-weight: bold; }
.act-icon.safe { background: #e7f8ef; color: #19BE6B; }
.act-text { font-size: 24rpx; color: #4e5969; margin-top: 10rpx; }
.btns { margin-top: 8rpx; }
.btns .btn-ghost { height: 92rpx; line-height: 92rpx; border-radius: 46rpx; }
.btn-alarm { background: #F5455C; color: #fff; font-size: 32rpx; font-weight: bold; height: 92rpx; line-height: 92rpx; text-align: center; border-radius: 46rpx; }
.ml { margin-left: 20rpx; }
.safe-strip { justify-content: center; margin-top: 24rpx; }
.dot-gray { background: #c4c7cc; }
.safe-text { margin-left: 12rpx; }
