.bal { margin: 24rpx 24rpx; padding: 36rpx 32rpx; border-radius: 24rpx; background: linear-gradient(135deg, #FF9A3C, #FF6A1A); box-shadow: 0 8rpx 24rpx rgba(255, 106, 26, 0.25); }
.bal-label { font-size: 24rpx; color: rgba(255, 255, 255, 0.85); }
.bal-rule { font-size: 22rpx; color: #fff; padding: 0 16rpx; line-height: 40rpx; border-radius: 20rpx; border: 1rpx solid rgba(255, 255, 255, 0.6); }
.bal-num { display: block; font-size: 72rpx; line-height: 100rpx; font-weight: bold; color: #fff; margin-top: 8rpx; }
.bal-foot { margin-top: 4rpx; }
.bal-tip { font-size: 22rpx; color: rgba(255, 255, 255, 0.85); }
.bal-gap { margin-left: 32rpx; }
.opts { margin-top: 20rpx; }
.opt { flex: 1; height: 140rpx; margin-right: 18rpx; border-radius: 18rpx; border: 2rpx solid #eceef1; background: #f7f8fa; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.opt:last-child { margin-right: 0; }
.opt-on { border-color: #FF9A3C; background: #FFF2E8; }
.opt-pay { font-size: 40rpx; font-weight: bold; color: #1f2329; }
.opt-on .opt-pay { color: #FF6A1A; }
.opt-bonus { font-size: 22rpx; color: #FF7A1A; margin-top: 4rpx; white-space: nowrap; }
.go { margin-top: 28rpx; height: 84rpx; line-height: 84rpx; font-size: 28rpx; border-radius: 42rpx; }
.log { padding: 20rpx 0; border-bottom: 1rpx solid #f0f1f3; }
.log:last-child { border-bottom: none; }
.log-type { width: 72rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 8rpx; font-size: 20rpx; margin-right: 18rpx; background: #f2f3f5; color: #4e5969; flex-shrink: 0; }
.log-recharge { background: #e7f8ef; color: #19BE6B; }
.log-gift { background: #FFF2E8; color: #FF6A1A; }
.log-refund { background: #e8f0ff; color: #3D7BFF; }
.log-title { display: block; font-size: 26rpx; }
.log-amt { font-size: 30rpx; font-weight: bold; margin-left: 16rpx; white-space: nowrap; }
.log-in { color: #19BE6B; }
.none { padding: 40rpx 0; text-align: center; }
.gap { height: 48rpx; }
