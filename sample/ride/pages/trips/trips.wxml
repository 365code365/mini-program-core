<view class="tabs">
  <view wx:for="{{tabs}}" wx:key="key" class="tab {{tab === item.key ? 'tab-on' : ''}}" data-key="{{item.key}}" bindtap="onTab">
    <text>{{item.name}}</text>
    <view wx:if="{{tab === item.key}}" class="tab-line"></view>
  </view>
</view>
<view class="summary">
  <view class="sum-item"><text class="sum-num">{{stat.count}}</text><text class="sum-label">本月行程</text></view>
  <view class="sum-split"></view>
  <view class="sum-item"><text class="sum-num">{{stat.km}}</text><text class="sum-label">累计公里</text></view>
  <view class="sum-split"></view>
  <view class="sum-item"><text class="sum-num">¥{{stat.saved}}</text><text class="sum-label">优惠已省</text></view>
</view>
<view wx:if="{{!list.length}}" class="empty">暂无行程</view>
<view class="trip card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
  <view class="row between">
    <view class="row">
      <text class="trip-type">{{item.type}}</text>
      <text class="trip-date">{{item.date}}</text>
    </view>
    <text class="status {{item.status}}">{{item.status === 'done' ? '已完成' : '已取消'}}</text>
  </view>
  <view class="route">
    <view class="row"><view class="dot dot-green"></view><text class="route-text">{{item.from}}</text></view>
    <view class="route-line"></view>
    <view class="row"><view class="dot dot-orange"></view><text class="route-text">{{item.to}}</text></view>
  </view>
  <view class="row between foot" wx:if="{{item.status === 'done'}}">
    <text class="sub">{{item.km}} 公里 · {{item.min}} 分钟</text>
    <view class="row"><text class="sub pay-label">实付</text><text class="pay">¥{{item.total}}</text></view>
  </view>
</view>
<view class="bottom-gap"></view>
