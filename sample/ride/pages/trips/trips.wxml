<view class="tabs">
  <view wx:for="{{tabs}}" wx:key="key" class="tab {{tab === item.key ? 'tab-on' : ''}}" data-key="{{item.key}}" bindtap="onTab">
    <text>{{item.name}}</text>
    <view wx:if="{{tab === item.key}}" class="tab-line"></view>
  </view>
</view>
<view class="summary">
  <view class="sum-item"><text class="sum-num">{{stat.count}}</text><text class="sum-label">累计行程</text></view>
  <view class="sum-split"></view>
  <view class="sum-item"><text class="sum-num">{{stat.km}}</text><text class="sum-label">累计公里</text></view>
  <view class="sum-split"></view>
  <view class="sum-item"><text class="sum-num">¥{{stat.saved}}</text><text class="sum-label">优惠已省</text></view>
</view>
<view wx:if="{{ongoing}}" class="card live row" bindtap="onOngoing">
  <view class="live-dot"></view>
  <view class="flex1">
    <text class="live-title">进行中的行程</text>
    <text class="live-text">{{ongoing.text}}</text>
  </view>
  <text class="live-go">查看</text>
  <view class="chev"></view>
</view>
<view wx:if="{{!list.length}}" class="empty-wrap">
  <view class="empty-ic"><text class="empty-ic-t">程</text></view>
  <text class="sub">{{tab === 'cancel' ? '没有取消的行程' : '还没有行程'}}</text>
  <view class="btn-primary empty-btn" bindtap="onGoCall">去叫车</view>
</view>
<view class="trip card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
  <view class="row between">
    <view class="row">
      <text class="trip-type">{{item.type}}</text>
      <text class="trip-date">{{item.date}}</text>
    </view>
    <text class="status {{item.unpaid ? 'unpaid' : item.status}}">{{item.statusText}}</text>
  </view>
  <view class="route">
    <view class="row"><view class="dot dot-green"></view><text class="route-text">{{item.fromName}}</text></view>
    <view class="route-line"></view>
    <view class="row"><view class="dot dot-orange"></view><text class="route-text">{{item.toName}}</text></view>
  </view>
  <view class="row between foot" wx:if="{{item.foot}}">
    <text class="sub">{{item.passenger ? '乘车人 ' + item.passenger + ' · ' : ''}}{{item.km}} 公里 · {{item.min}} 分钟</text>
    <view class="row">
      <view wx:if="{{item.needRate}}" class="rate-chip" data-id="{{item.id}}" catchtap="onRate">去评价</view>
      <text class="pay {{item.unpaid ? 'orange' : ''}}">{{item.foot}}</text>
    </view>
  </view>
</view>
<view class="bottom-gap"></view>
