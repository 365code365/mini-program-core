<view class="alarm row" bindtap="onAlarm">
  <view class="alarm-ic"><text class="alarm-t">110</text></view>
  <view class="flex1">
    <text class="alarm-title">一键报警</text>
    <text class="alarm-sub">遇到危险立即拨打 110，位置同步给安全专员</text>
  </view>
  <view class="chev white"></view>
</view>
<view class="section-title row between">
  <text>紧急联系人</text>
  <text class="sub">{{list.length}}/{{max}}</text>
</view>
<view class="card list">
  <view wx:if="{{!list.length && !adding}}" class="none"><text class="sub">添加后，行程中可以一键把实时行程发给 TA</text></view>
  <view class="person row" wx:for="{{list}}" wx:key="id">
    <view class="p-avatar"><text class="p-initial">{{item.initial}}</text></view>
    <view class="flex1 p-body">
      <view class="row"><text class="p-name">{{item.name}}</text><text class="p-rel">{{item.relation}}</text></view>
      <text class="sub">{{item.mask}}</text>
    </view>
    <text class="p-op p-call" data-i="{{index}}" bindtap="onCallContact">拨打</text>
    <text class="p-op p-del" data-i="{{index}}" bindtap="onRemove">删除</text>
  </view>
  <!-- 输入框 id 跟着 formSeq 变：引擎里用户打过字的输入框，页面再 setData 改 value 不会重画（框里留着旧字、wx:if 重建也一样），换 id 就是一份新的输入状态 -->
  <view wx:if="{{adding}}" class="form">
    <view class="field row">
      <text class="field-label">姓名</text>
      <input id="c-name-{{formSeq}}" class="field-input c-name" placeholder="联系人姓名" placeholder-class="ph" value="{{name}}" maxlength="10" bindinput="onName" />
    </view>
    <view class="field row">
      <text class="field-label">手机号</text>
      <input id="c-phone-{{formSeq}}" class="field-input c-phone" type="number" placeholder="11 位手机号" placeholder-class="ph" value="{{phone}}" maxlength="11" bindinput="onPhone" />
    </view>
    <view class="rel row">
      <text class="field-label">关系</text>
      <view class="chips flex1">
        <text wx:for="{{relations}}" wx:key="*this" class="chip rel-chip {{relation === item ? 'chip-on' : ''}}" data-r="{{item}}" bindtap="onRelation">{{item}}</text>
      </view>
    </view>
    <view class="row form-btns">
      <view class="btn-ghost flex1 cancel-add" bindtap="onCancelAdd">取消</view>
      <view class="btn-primary flex1 ml save-contact" bindtap="onSave">保存</view>
    </view>
  </view>
  <view wx:if="{{!adding && list.length < max}}" class="row add-row">
    <view class="add-op add-manual" bindtap="onAdd"><text>手动添加</text></view>
    <view class="add-op add-import" bindtap="onImport"><text>从通讯录导入</text></view>
  </view>
</view>
<view class="section-title">安全设置</view>
<view class="card setting">
  <view class="set row">
    <view class="flex1">
      <text class="set-name">行程录音保护</text>
      <text class="sub set-sub">行程中自动录音，加密保存 7 天</text>
    </view>
    <switch class="sw-record" checked="{{recording}}" color="#FF7A1A" bindchange="onRecording" />
  </view>
  <view class="set row">
    <view class="flex1">
      <text class="set-name">夜间行程自动分享</text>
      <text class="sub set-sub">22:00-05:00 上车后把行程发给全部紧急联系人</text>
    </view>
    <switch class="sw-share" checked="{{autoShare}}" color="#FF7A1A" bindchange="onAutoShare" />
  </view>
</view>
<view class="gap"></view>
