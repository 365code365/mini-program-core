.hero { background: linear-gradient(160deg, #FF9A3C, #FF6A1A); padding: 40rpx 32rpx 100rpx; display: flex; flex-direction: column; align-items: center; }
.hero-label { color: rgba(255, 255, 255, 0.9); font-size: 28rpx; }
.hero-price { display: flex; flex-direction: row; align-items: flex-end; margin-top: 8rpx; }
.hero-num { color: #fff; font-size: 80rpx; font-weight: bold; }
.hero-unit { color: #fff; font-size: 28rpx; margin: 0 0 16rpx 6rpx; }
.hero-sub { color: rgba(255, 255, 255, 0.85); font-size: 24rpx; margin-top: 8rpx; }
.overlap { margin-top: -70rpx; }
.route-text { flex: 1; min-width: 0; font-size: 28rpx; margin-left: 18rpx; }
.route-line { width: 2rpx; height: 24rpx; background: #e3e5e8; margin: 6rpx 0 6rpx 7rpx; }
.why { margin-top: 20rpx; font-size: 24rpx; line-height: 36rpx; color: #C2570C; background: #FFF2E8; border-radius: 12rpx; padding: 14rpx 20rpx; }
/* 分两行写：引擎的中文换行不避头，长句里的「）」「。」会落到行首 */
.why-line { display: block; }
.title-sm { display: block; font-size: 30rpx; font-weight: bold; margin-bottom: 8rpx; }
.fee { font-size: 28rpx; color: #4e5969; padding: 12rpx 0; }
.total { border-top: 1rpx dashed #e3e5e8; margin-top: 12rpx; padding: 22rpx 0 4rpx; }
.total-label { font-size: 30rpx; font-weight: bold; }
.total-num { font-size: 36rpx; font-weight: bold; }
.way { padding: 22rpx 0; border-bottom: 1rpx solid #f0f1f3; }
.way:last-child { border-bottom: none; }
.way-off .way-name { color: #9aa0a6; }
.way-icon { width: 60rpx; height: 60rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex-shrink: 0; }
.wallet-ic { background: linear-gradient(135deg, #FFB067, #FF7A1A); }
.wechat-ic { background: linear-gradient(135deg, #5FD99A, #19BE6B); }
.way-glyph { color: #fff; font-size: 26rpx; font-weight: bold; }
.way-name { display: block; font-size: 28rpx; }
.way-sub { display: block; margin-top: 4rpx; }
.way-link { font-size: 24rpx; color: #FF6A1A; border: 2rpx solid #FF9A3C; border-radius: 24rpx; padding: 6rpx 18rpx; margin-right: 20rpx; white-space: nowrap; }
.bar-gap { height: 180rpx; }
.bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05); }
.bar-sum { align-items: baseline; }
.bar-num { font-size: 40rpx; font-weight: bold; color: #FF6A1A; margin-left: 10rpx; }
.pay-btn { width: 340rpx; height: 84rpx; line-height: 84rpx; font-size: 30rpx; border-radius: 42rpx; }
.cp { padding: 22rpx 0; border-bottom: 1rpx solid #f0f1f3; }
.cp-none { border-bottom: none; }
.cp-amt { width: 120rpx; display: flex; flex-direction: row; align-items: baseline; color: #FF6A1A; flex-shrink: 0; }
.cp-yen { font-size: 24rpx; }
.cp-num { font-size: 44rpx; font-weight: bold; }
.cp-name { display: block; font-size: 28rpx; }
.cp-sub { display: block; margin-top: 4rpx; }
