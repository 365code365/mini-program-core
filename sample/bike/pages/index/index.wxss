.page { position: relative; width: 100%; height: 100vh; overflow: hidden; }
.map { width: 100%; height: 100vh; background: #e8eef0; }

.banners { position: absolute; left: 24rpx; right: 24rpx; top: 20rpx; display: flex; flex-direction: column; }
.banner { border-radius: 14rpx; padding: 18rpx 24rpx; font-size: 24rpx; margin-bottom: 12rpx; display: flex; flex-direction: row; justify-content: space-between; align-items: center; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12); }
.b-weak { background: #fff6e0; color: #a86400; }
.b-ride { background: #13a868; color: #ffffff; }
.b-unpaid { background: #fff0ef; color: #d6392d; }
.b-loc { background: rgba(31, 35, 41, 0.78); color: #ffffff; }
.b-txt { font-size: 26rpx; }
.b-go { font-size: 24rpx; }

.side { position: absolute; left: 24rpx; top: 210rpx; width: 96rpx; display: flex; flex-direction: column; align-items: center; }
.avatar { width: 88rpx; height: 88rpx; border-radius: 44rpx; border: 4rpx solid #ffffff; margin-bottom: 20rpx; }
.side-item { width: 96rpx; height: 104rpx; background: #ffffff; border-radius: 16rpx; margin-bottom: 16rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.1); }
.side-ic { width: 44rpx; height: 44rpx; }
.side-tx { font-size: 20rpx; color: #464c55; margin-top: 6rpx; }

.price-pill { position: absolute; right: 24rpx; top: 214rpx; height: 64rpx; padding: 0 22rpx; background: #ffffff; border-radius: 32rpx; display: flex; flex-direction: row; align-items: center; box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.1); }
.pill-ic { width: 32rpx; height: 32rpx; margin-right: 8rpx; }
.pill-tx { font-size: 24rpx; color: #464c55; }

.tools { position: absolute; right: 24rpx; bottom: 330rpx; display: flex; flex-direction: column; }
.tools-up { bottom: 520rpx; }
.tool { width: 84rpx; height: 84rpx; border-radius: 42rpx; background: #ffffff; margin-top: 20rpx; display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.12); }
.tool-ic { width: 44rpx; height: 44rpx; }

.bottom { position: absolute; left: 24rpx; right: 24rpx; bottom: calc(32rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; }
.near { background: #ffffff; border-radius: 20rpx; padding: 24rpx 28rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1); }
.near-tx { font-size: 30rpx; color: #1f2329; }
.near-sub { font-size: 24rpx; color: #8a9099; margin-top: 8rpx; }

.bike-card { background: #ffffff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1); display: flex; flex-direction: column; }
.bc-head { display: flex; flex-direction: row; align-items: baseline; justify-content: space-between; }
.bc-name { font-size: 32rpx; font-weight: bold; color: #1f2329; }
.bc-no { font-size: 24rpx; color: #8a9099; }
.bc-info { display: flex; flex-direction: row; margin-top: 24rpx; }
.bc-cell { flex: 1; display: flex; flex-direction: column; }
.bc-v { font-size: 34rpx; color: #13a868; }
.bc-k { font-size: 22rpx; color: #8a9099; margin-top: 6rpx; }
.bc-ring { margin-top: 24rpx; height: 72rpx; border: 2rpx solid #13a868; color: #13a868; border-radius: 36rpx; font-size: 28rpx; display: flex; align-items: center; justify-content: center; }

.scan { height: 104rpx; border-radius: 52rpx; background: #13a868; display: flex; flex-direction: row; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(19, 168, 104, 0.4); }
.scan-ic { width: 48rpx; height: 48rpx; margin-right: 14rpx; }
.scan-tx { font-size: 36rpx; font-weight: bold; color: #ffffff; }

.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.5); z-index: 50; display: flex; align-items: center; justify-content: center; }
.dlg { width: 600rpx; background: #ffffff; border-radius: 24rpx; padding: 40rpx 36rpx 0; display: flex; flex-direction: column; }
.dlg-title { font-size: 34rpx; font-weight: bold; text-align: center; color: #1f2329; }
.dlg-sub { font-size: 24rpx; color: #8a9099; text-align: center; margin-top: 12rpx; }
.dlg-input { margin-top: 32rpx; height: 92rpx; border-radius: 12rpx; background: #f4f6f8; padding: 0 24rpx; font-size: 36rpx; letter-spacing: 4rpx; text-align: center; }
.dlg-err { font-size: 24rpx; color: #e5483c; margin-top: 14rpx; text-align: center; }
.dlg-btns { display: flex; flex-direction: row; margin-top: 36rpx; border-top: 1rpx solid #eeeeee; }
.dlg-btn { flex: 1; height: 100rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; color: #646a73; }
.dlg-ok { color: #13a868; font-weight: bold; border-left: 1rpx solid #eeeeee; }
