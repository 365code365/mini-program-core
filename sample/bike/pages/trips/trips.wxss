.sum { display: flex; flex-direction: row; background: linear-gradient(120deg, #2fd08a, #109060); padding: 36rpx 0; }
.sum-i { flex: 1; display: flex; flex-direction: column; align-items: center; }
.sum-v { font-size: 40rpx; font-weight: bold; color: #ffffff; }
.sum-k { font-size: 22rpx; color: rgba(255, 255, 255, 0.85); margin-top: 6rpx; }
.tabs { display: flex; flex-direction: row; background: #ffffff; padding: 0 16rpx; }
.tab { padding: 24rpx 28rpx; font-size: 28rpx; color: #646a73; border-bottom: 4rpx solid transparent; }
.tab-on { color: #13a868; font-weight: bold; border-bottom-color: #13a868; }
.loading { padding: 24rpx; }
.sk { background: #ffffff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; }
.sk-a { width: 40%; height: 28rpx; background: #eef0f3; border-radius: 6rpx; }
.sk-b { width: 80%; height: 32rpx; background: #eef0f3; border-radius: 6rpx; margin-top: 20rpx; }
.sk-c { width: 55%; height: 26rpx; background: #eef0f3; border-radius: 6rpx; margin-top: 20rpx; }
.list { padding: 8rpx 24rpx 40rpx; }
.item { background: #ffffff; border-radius: 20rpx; padding: 28rpx; margin-top: 20rpx; }
.date { font-size: 26rpx; color: #464c55; margin-left: 12rpx; }
.st-unpaid { font-size: 24rpx; color: #e5483c; }
.st-paid { font-size: 24rpx; color: #8a9099; }
.route { display: flex; flex-direction: row; align-items: center; margin: 20rpx 0 16rpx; }
.pl { font-size: 30rpx; color: #1f2329; }
.arrow { color: #a0a4ab; margin: 0 14rpx; }
.end { display: block; text-align: center; font-size: 22rpx; color: #a0a4ab; margin-top: 30rpx; }
.empty-btn { width: 360rpx; margin-top: 40rpx; }
