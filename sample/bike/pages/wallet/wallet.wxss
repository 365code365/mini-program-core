.bal { margin: 24rpx 24rpx 0; border-radius: 24rpx; padding: 40rpx 36rpx; background: linear-gradient(120deg, #2fd08a, #0f8a56); display: flex; flex-direction: column; }
.bal-k { font-size: 26rpx; color: rgba(255, 255, 255, 0.85); }
.bal-v { font-size: 80rpx; font-weight: bold; color: #ffffff; margin-top: 10rpx; }
.bal-tip { font-size: 22rpx; color: rgba(255, 255, 255, 0.75); margin-top: 10rpx; }
.plans { display: flex; flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin: 24rpx 0 28rpx; }
.plan { width: 148rpx; padding: 22rpx 0; border-radius: 14rpx; border: 2rpx solid #e4e7ec; display: flex; flex-direction: column; align-items: center; }
.plan-on { border-color: #13a868; background: #e3f7ee; }
.plan-v { font-size: 30rpx; font-weight: bold; }
.plan-b { font-size: 22rpx; color: #de6e12; margin-top: 6rpx; }
.c-item { display: flex; flex-direction: row; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.c-l { flex: 1; display: flex; flex-direction: column; }
.c-name { font-size: 30rpx; font-weight: bold; }
.hot { font-size: 20rpx; color: #ffffff; background: #f05246; padding: 2rpx 10rpx; border-radius: 6rpx; margin-left: 10rpx; }
.c-desc { font-size: 24rpx; color: #8a9099; margin-top: 8rpx; }
.c-own { font-size: 24rpx; color: #13a868; margin-top: 6rpx; }
.c-r { display: flex; flex-direction: column; align-items: flex-end; margin-left: 20rpx; }
.c-btn { margin-top: 12rpx; padding: 10rpx 30rpx; border-radius: 30rpx; background: #13a868; color: #ffffff; font-size: 24rpx; }
.t-item { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid #f3f3f3; }
.t-l { display: flex; flex-direction: column; flex: 1; margin-right: 20rpx; }
.t-title { font-size: 28rpx; margin-bottom: 6rpx; }
.t-in { font-size: 30rpx; color: #13a868; font-weight: bold; }
.t-out { font-size: 30rpx; color: #1f2329; font-weight: bold; }
.small { padding: 40rpx 0; }
