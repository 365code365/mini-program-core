.av { width: 96rpx; height: 96rpx; border-radius: 48rpx; }
.av-info { margin-left: 20rpx; }
.av-nm { font-size: 30rpx; font-weight: bold; }
.rate { margin: 16rpx 0 8rpx; }
.tags { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 16rpx; }
.tg { display: flex; flex-direction: row; align-items: center; border: 2rpx solid #e3e7e5; border-radius: 30rpx; padding: 4rpx 14rpx 4rpx 4rpx; margin: 0 10rpx 14rpx 0; }
.tg-on { border-color: #f08c00; background: #fff6e8; }
.tg-tx { font-size: 24rpx; color: #2b3430; margin-left: 4rpx; }
.ta { width: 100%; min-height: 160rpx; background: #f6f8f7; border-radius: 12rpx; padding: 16rpx; box-sizing: border-box; font-size: 26rpx; }
.cnt { display: block; text-align: right; font-size: 22rpx; color: #a3aca7; margin-top: 6rpx; }
.ph-list { flex-wrap: wrap; margin-top: 12rpx; }
.ph-box { position: relative; margin: 0 16rpx 16rpx 0; }
.ph { width: 150rpx; height: 150rpx; border-radius: 12rpx; }
.ph-del { position: absolute; top: -12rpx; right: -12rpx; width: 36rpx; height: 36rpx; border-radius: 18rpx; background: rgba(0, 0, 0, 0.55); color: #ffffff; font-size: 26rpx; text-align: center; line-height: 34rpx; }
.ph-add { background: #f6f8f7; border: 2rpx dashed #c9d2cd; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; margin: 0 16rpx 16rpx 0; }
.ph-plus { font-size: 48rpx; color: #9aa59f; line-height: 1.2; }
.sample { font-size: 24rpx; }
.done { display: flex; flex-direction: column; align-items: center; padding: 48rpx 28rpx; }
.done-tt { font-size: 34rpx; font-weight: bold; margin: 16rpx 0 6rpx; }
