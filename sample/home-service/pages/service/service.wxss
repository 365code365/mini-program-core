.cover { width: 100%; height: 360rpx; display: block; }
.top { margin-top: -50rpx; }
.meta { margin-top: 16rpx; }
.big { font-size: 40rpx; }
.spec { padding: 18rpx 20rpx; border: 2rpx solid #eef1ef; border-radius: 12rpx; margin-bottom: 14rpx; }
.spec-on { border-color: #13a86b; background: #f0faf5; }
.li { align-items: flex-start; padding: 6rpx 0; }
.li-dot { font-size: 18rpx; margin: 8rpx 14rpx 0 0; }
.li-no { width: 34rpx; height: 34rpx; border-radius: 17rpx; background: #e7f6ef; color: #13a86b; font-size: 20rpx; text-align: center; line-height: 34rpx; margin: 4rpx 14rpx 0 0; flex-shrink: 0; }
.li-tx { flex: 1; font-size: 26rpx; color: #2b3430; }
.std-title { color: #13a86b; }
.av { width: 96rpx; height: 96rpx; border-radius: 48rpx; }
.av-info { margin-left: 20rpx; }
.av-nm { font-size: 30rpx; font-weight: bold; }
.bk { width: 260rpx; }
