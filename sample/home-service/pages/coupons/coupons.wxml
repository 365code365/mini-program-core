<view class="tabs">
  <view class="tb {{tab === item.key ? 'tb-on' : ''}}" wx:for="{{tabs}}" wx:key="key" data-k="{{item.key}}" bindtap="switchTab">
    <text class="tb-tx">{{item.text}}（{{counts[item.key] || 0}}）</text>
    <view class="tb-bar" wx:if="{{tab === item.key}}"></view>
  </view>
</view>
<view class="wrap">
  <view class="card rd">
    <view class="row">
      <input class="rd-ipt flex1" value="{{code}}" placeholder="输入兑换码，如 HAOGUANJIA" maxlength="16" bindinput="onCode" />
      <view class="rd-btn" bindtap="redeem">
        <text>兑换</text>
      </view>
    </view>
    <text class="err" wx:if="{{codeErr}}">{{codeErr}}</text>
  </view>
  <view class="loading" wx:if="{{loading}}">
    <text>加载中…</text>
  </view>
  <view class="empty" wx:elif="{{!list.length}}">
    <text class="empty-tx">{{tab === 'unused' ? '暂无可用优惠券' : (tab === 'used' ? '还没有用过优惠券' : '没有过期的优惠券')}}</text>
  </view>
  <view class="cp row {{tab !== 'unused' ? 'cp-off' : ''}}" wx:for="{{list}}" wx:key="id">
    <view class="cp-l">
      <view class="row cp-amt-row">
        <text class="cp-y">¥</text>
        <text class="cp-amt">{{item.amount}}</text>
      </view>
      <text class="cp-cond">{{item.cond}}</text>
    </view>
    <view class="cp-r col flex1">
      <text class="cp-nm">{{item.name}}</text>
      <text class="sub">{{item.scope}}</text>
      <view class="between cp-ft">
        <text class="sub">有效期至 {{item.expire}}</text>
        <view class="cp-use" wx:if="{{tab === 'unused'}}" data-id="{{item.id}}" bindtap="use">
          <text>去使用</text>
        </view>
        <text class="cp-st" wx:else>{{tab === 'used' ? '已使用' : '已过期'}}</text>
      </view>
    </view>
  </view>
  <text class="tip">下单时自动选用面额最大的可用券；取消订单后券原路退回</text>
</view>
