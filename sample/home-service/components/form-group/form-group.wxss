.fg { background: #ffffff; border-radius: 20rpx; padding: 8rpx 28rpx; margin-bottom: 24rpx; }
.fg-hd { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 20rpx 0 4rpx; }
