.head { background: linear-gradient(135deg, #3aa0ff, #1d63d8); padding: 32rpx 32rpx 28rpx; color: #ffffff; }
.head-gray { background: linear-gradient(135deg, #a7aeb9, #7d8593); }
.h-st { font-size: 40rpx; font-weight: 700; color: #ffffff; }
.mode { font-size: 20rpx; color: #ffffff; background: rgba(255,255,255,0.22); padding: 4rpx 14rpx; border-radius: 16rpx; }
.h-d { display: block; font-size: 24rpx; color: rgba(255,255,255,0.9); margin-top: 8rpx; }
.nodes { justify-content: space-between; margin-top: 28rpx; }
.node { display: flex; flex-direction: column; align-items: center; width: 150rpx; opacity: 0.5; }
.node-on { opacity: 1; }
.nd { width: 22rpx; height: 22rpx; border-radius: 11rpx; background: #ffffff; }
.nd-t { font-size: 22rpx; color: #ffffff; margin-top: 8rpx; }
.tl { align-items: flex-start; margin-top: 22rpx; }
.tl-dot { width: 16rpx; height: 16rpx; border-radius: 8rpx; background: #c8ced8; margin: 12rpx 20rpx 0 4rpx; }
.tl-now { background: #1e8cf0; }
.tl-t { font-size: 26rpx; color: #4a5260; }
.tl-t-now { color: #1e8cf0; font-weight: 600; }
.qc { margin-top: 20rpx; justify-content: space-between; }
.qc-i { width: 150rpx; height: 150rpx; border-radius: 12rpx; overflow: hidden; }
.qc-img { width: 150rpx; height: 150rpx; }
.qc-n { align-items: flex-start; margin-top: 14rpx; }
.qc-k { font-size: 22rpx; color: #1e8cf0; width: 64rpx; }
.qc-v { font-size: 24rpx; color: #4a5260; line-height: 1.5; }
.rv { margin-top: 16rpx; }
.rv-k { font-size: 26rpx; margin-right: 16rpx; }
.rv-t { display: block; font-size: 26rpx; line-height: 1.6; margin-top: 14rpx; }
.rv-tags { flex-wrap: wrap; margin-top: 12rpx; }
.rv-tag { font-size: 22rpx; color: #1e8cf0; background: #e6f1fd; padding: 4rpx 16rpx; border-radius: 20rpx; margin: 0 12rpx 8rpx 0; }
.ln { padding: 12rpx 0; font-size: 26rpx; }
.ln-q { margin: 0 24rpx; }
.ln-p { width: 120rpx; text-align: right; }
.total { border-top: 1rpx solid #f0f2f5; margin-top: 8rpx; padding-top: 18rpx; }
.pay { font-size: 32rpx; }
.kv { padding: 10rpx 0; align-items: flex-start; }
.k { width: 140rpx; font-size: 26rpx; color: #8a919c; }
.v { flex: 1; font-size: 26rpx; }
.copy { font-size: 24rpx; color: #1e8cf0; margin-left: 16rpx; }
.foot-space { height: 140rpx; }
.bar { position: fixed; left: 0; right: 0; bottom: 0; height: calc(112rpx + env(safe-area-inset-bottom)); padding: 0 24rpx env(safe-area-inset-bottom); background: #ffffff; border-top: 1rpx solid #eceef2; justify-content: flex-end; }
.b-gap { margin-left: 20rpx; }
