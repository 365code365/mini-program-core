<view class="page">
  <view class="top">
    <view class="ok"><text class="ok-t">✓</text></view>
    <text class="r-t">支付成功</text>
    <text class="r-p">¥{{o.payable}}</text>
    <text class="sub">{{o.payBy === 'mock' ? '演示环境模拟支付，未真实扣款' : '微信支付'}}</text>
  </view>
  <view class="card">
    <view class="kv row"><text class="k">订单号</text><text class="v">{{o.id}}</text></view>
    <view class="kv row"><text class="k">袋码</text><text class="v">{{o.bagNo}}</text></view>
    <view class="kv row"><text class="k">取件时间</text><text class="v">{{pickText}}</text></view>
    <view class="kv row"><text class="k">取件地址</text><text class="v">{{o.addr.community}} {{o.addr.room}}</text></view>
    <view class="kv row"><text class="k">衣物</text><text class="v">共 {{o.count}} 件</text></view>
  </view>
  <view class="card note">
    <text class="n-t">取件员接单后会电话联系你。请把衣物口袋清空，贵重饰品（胸针、可拆卸纽扣）请先取下。</text>
  </view>
  <view class="ops row">
    <view class="btn-gray flex1" bindtap="goHome"><text>返回首页</text></view>
    <view class="btn flex1 o-btn" bindtap="goDetail"><text>查看订单</text></view>
  </view>
</view>
