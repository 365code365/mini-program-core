.loc { padding: 20rpx 24rpx 0; }
.loc-t { font-size: 32rpx; font-weight: 600; margin-right: 12rpx; }
.loc-s { flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.scan { font-size: 24rpx; color: #1e8cf0; background: #e6f1fd; padding: 10rpx 24rpx; border-radius: 28rpx; margin-left: 16rpx; }
.banner { height: 300rpx; margin: 20rpx 24rpx 0; border-radius: 20rpx; overflow: hidden; }
.b-item { position: relative; width: 702rpx; height: 300rpx; }
.b-img { width: 702rpx; height: 300rpx; }
.b-txt { position: absolute; left: 36rpx; top: 50rpx; display: flex; flex-direction: column; }
.b-t { font-size: 40rpx; font-weight: 700; color: #ffffff; }
.b-s { font-size: 24rpx; color: rgba(255,255,255,0.9); margin-top: 10rpx; }
.b-btn { margin-top: 28rpx; width: 160rpx; height: 52rpx; line-height: 52rpx; text-align: center; border-radius: 26rpx; background: #ffffff; color: #1e6fe0; font-size: 24rpx; }
.svc { padding: 24rpx 8rpx 8rpx; }
.svc-grid { display: flex; flex-direction: row; flex-wrap: wrap; }
.svc-i { width: 228rpx; display: flex; flex-direction: column; align-items: center; margin-bottom: 24rpx; }
.svc-ic { width: 96rpx; height: 96rpx; border-radius: 28rpx; }
.svc-ic.all { background: #eef1f5; display: flex; align-items: center; justify-content: center; }
.all-t { font-size: 26rpx; color: #4a5260; }
.svc-t { font-size: 24rpx; margin-top: 10rpx; }
.a-st { font-size: 30rpx; font-weight: 600; color: #1e8cf0; margin-right: 16rpx; }
.a-no { margin-left: 4rpx; }
.a-d { display: block; font-size: 24rpx; color: #4a5260; margin-top: 6rpx; }
.flow { justify-content: space-between; margin-top: 24rpx; }
.f-i { width: 150rpx; display: flex; flex-direction: column; align-items: center; }
.f-n { width: 52rpx; height: 52rpx; border-radius: 26rpx; background: #1e8cf0; color: #ffffff; font-size: 24rpx; display: flex; align-items: center; justify-content: center; }
.f-t { font-size: 26rpx; margin-top: 10rpx; }
.f-s { font-size: 20rpx; color: #8a919c; margin-top: 4rpx; text-align: center; }
.promise { margin-top: 20rpx; align-items: flex-start; }
.p-dot { width: 14rpx; height: 14rpx; border-radius: 7rpx; background: #37c3a5; margin: 12rpx 16rpx 0 0; }
.p-t { display: block; font-size: 26rpx; margin-bottom: 2rpx; }
.d-title { display: block; font-size: 32rpx; font-weight: 600; text-align: center; }
.d-sub { display: block; text-align: center; margin: 8rpx 0 24rpx; }
.d-in { margin-bottom: 8rpx; }
.d-ops { margin-top: 24rpx; }
.d-ok { margin-left: 20rpx; height: 64rpx; line-height: 64rpx; font-size: 26rpx; }
