.top { background: linear-gradient(180deg, #1e8cf0, #4fb0ff); padding: 32rpx 32rpx 80rpx; }
.av { width: 112rpx; height: 112rpx; border-radius: 56rpx; border: 4rpx solid rgba(255,255,255,0.6); margin-right: 24rpx; }
.nm { display: block; font-size: 34rpx; font-weight: 600; color: #ffffff; }
.lv { display: block; font-size: 24rpx; color: rgba(255,255,255,0.9); margin-top: 6rpx; }
.ost { margin-top: -56rpx; }
.os { justify-content: space-around; margin-top: 24rpx; }
.os-i { display: flex; flex-direction: column; align-items: center; width: 140rpx; }
.os-n { font-size: 36rpx; font-weight: 700; color: #1e8cf0; margin-bottom: 4rpx; }
.list { padding-top: 4rpx; padding-bottom: 4rpx; }
.li { padding: 28rpx 0; border-bottom: 1rpx solid #f0f2f5; font-size: 28rpx; }
.li.last { border-bottom: none; }
.danger { color: #ff4d3a; }
.ver { display: block; text-align: center; font-size: 22rpx; color: #a0a7b2; margin-top: 40rpx; }
