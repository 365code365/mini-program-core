.notice { background: #fff6e8; padding: 16rpx 24rpx; }
.n-t { font-size: 22rpx; color: #c7801f; }
.tabs { display: flex; flex-direction: row; background: #ffffff; padding: 0 12rpx; height: 88rpx; align-items: center; border-bottom: 1rpx solid #eceef2; }
.sticky { position: sticky; top: 0; z-index: 10; }
.tabs-fixed { position: fixed; left: 0; right: 0; top: 0; z-index: 20; }
.tab { flex: 1; text-align: center; font-size: 26rpx; color: #4a5260; height: 88rpx; line-height: 88rpx; }
.tab-on { color: #1e8cf0; font-weight: 600; border-bottom: 4rpx solid #1e8cf0; box-sizing: border-box; }
.sec { background: #ffffff; margin: 20rpx 24rpx 0; border-radius: 20rpx; padding: 8rpx 24rpx; }
.sec-h { padding: 20rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.sec-ic { width: 64rpx; height: 64rpx; border-radius: 18rpx; margin-right: 18rpx; }
.sec-t { display: block; font-size: 30rpx; font-weight: 600; }
.it { padding: 24rpx 0; border-bottom: 1rpx solid #f5f6f8; }
.it-n { display: block; font-size: 28rpx; margin-bottom: 4rpx; }
.it-p { margin-right: 20rpx; }
.foot-space { height: 140rpx; }
.bar { position: fixed; left: 0; right: 0; bottom: calc(100rpx + env(safe-area-inset-bottom)); height: 112rpx; background: #ffffff; padding: 0 24rpx; border-top: 1rpx solid #eceef2; }
.bar-l { font-size: 26rpx; margin-right: 8rpx; }
.bar-p { font-size: 38rpx; }
.clear { font-size: 24rpx; color: #8a919c; margin-right: 24rpx; }
.go { background: #1e8cf0; color: #ffffff; height: 76rpx; line-height: 76rpx; padding: 0 44rpx; border-radius: 38rpx; font-size: 28rpx; }
.go-dis { background: #b9d9f7; }
