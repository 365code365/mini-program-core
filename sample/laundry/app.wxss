/* 主色：清透蓝 #1e8cf0 */
page { background: #f4f6f9; color: #1f2733; font-size: 28rpx; }
.page { min-height: 100vh; padding-bottom: 40rpx; box-sizing: border-box; }
.tab-page { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.card { background: #ffffff; border-radius: 20rpx; margin: 24rpx 24rpx 0; padding: 28rpx; }
.row { display: flex; flex-direction: row; align-items: center; }
.between { justify-content: space-between; }
.flex1 { flex: 1; }
.col { display: flex; flex-direction: column; }
.title { font-size: 32rpx; font-weight: 600; }
.sub { font-size: 24rpx; color: #8a919c; }
.price { color: #ff5a36; font-weight: 600; }
.btn { background: #1e8cf0; color: #ffffff; border-radius: 44rpx; height: 88rpx; line-height: 88rpx; text-align: center; font-size: 30rpx; }
.btn-line { border: 2rpx solid #1e8cf0; color: #1e8cf0; border-radius: 36rpx; height: 64rpx; line-height: 60rpx; padding: 0 28rpx; font-size: 26rpx; box-sizing: border-box; text-align: center; }
.btn-gray { border: 2rpx solid #d5d9e0; color: #4a5260; border-radius: 36rpx; height: 64rpx; line-height: 60rpx; padding: 0 28rpx; font-size: 26rpx; box-sizing: border-box; text-align: center; }
.hover { opacity: 0.7; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 100rpx 0 60rpx; }
.empty-ic { width: 140rpx; height: 140rpx; border-radius: 70rpx; background: #e6f1fd; margin-bottom: 24rpx; }
.empty-tx { font-size: 26rpx; color: #8a919c; margin-bottom: 28rpx; }
.skeleton { background: #eceff3; border-radius: 12rpx; }
.tag { font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 6rpx; }
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 100; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #ffffff; border-radius: 28rpx 28rpx 0 0; padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); z-index: 101; }
.dialog { position: fixed; left: 60rpx; right: 60rpx; top: 360rpx; background: #ffffff; border-radius: 24rpx; padding: 40rpx 36rpx 32rpx; z-index: 101; }
.input { height: 80rpx; background: #f4f6f9; border-radius: 12rpx; padding: 0 24rpx; font-size: 28rpx; }
.err { font-size: 24rpx; color: #ff4d3a; }
