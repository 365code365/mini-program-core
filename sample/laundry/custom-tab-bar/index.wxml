<view class="tb">
  <view class="tb-item" wx:for="{{list}}" wx:key="pagePath" data-index="{{index}}" data-path="{{item.path}}" bindtap="switchTab">
    <view class="tb-icw">
      <image class="tb-ic" src="{{selected === index ? item.iconOn : item.icon}}"></image>
      <view wx:if="{{index === 1 && cartN > 0}}" class="tb-badge"><text>{{cartN}}</text></view>
    </view>
    <text class="tb-tx" style="color: {{selected === index ? selectedColor : color}};">{{item.text}}</text>
  </view>
</view>
