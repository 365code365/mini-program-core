.area { position: fixed; left: 0; top: 0; width: 100%; }
.sv { width: 100%; }
.head { padding: 36rpx 32rpx 100rpx; background: #1f6fff; }
.head-serving { background: #13a26b; }
.head-done { background: #f07a12; }
.head-reviewed { background: #4b5567; }
.head-cancelled { background: #9aa3b2; }
.h-st { font-size: 40rpx; font-weight: bold; color: #ffffff; margin-left: 16rpx; }
.h-tip { display: block; font-size: 26rpx; color: #eef3ff; margin-top: 12rpx; }
.top { margin-top: -70rpx; }
.kv { padding: 8rpx 0; align-items: flex-start; }
.kv-v { max-width: 440rpx; text-align: right; }
.strong { font-weight: bold; color: #1d2433; }
.big { font-size: 36rpx; }
.wrap-tags { flex-wrap: wrap; margin: 12rpx 0; }
.rv-tx { font-size: 26rpx; color: #39425a; }
.tl { align-items: flex-start; padding: 10rpx 0; }
.tl-dot { width: 18rpx; height: 18rpx; border-radius: 9rpx; background: #c7cdd9; margin: 14rpx 20rpx 0 4rpx; }
.tl-dot-on { background: #1f6fff; }
.pad { height: 60rpx; }
.fab { width: 64px; height: 64px; border-radius: 32px; background: #ff7a1a; box-shadow: 0 6rpx 20rpx rgba(240, 122, 18, 0.4); z-index: 10; }
.fab-in { width: 64px; height: 64px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.fab-tx { color: #ffffff; font-size: 22rpx; line-height: 1.3; }
.bar { position: fixed; left: 0; right: 0; bottom: 0; height: 68px; box-sizing: border-box; background: #ffffff; padding: 0 24rpx; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; border-top: 1rpx solid #e8ebf0; }
.act { width: 280rpx; margin-left: 20rpx; }
