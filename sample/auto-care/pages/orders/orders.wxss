.tabs { display: flex; flex-direction: row; background: #ffffff; height: 88rpx; }
.tb { flex: 1; display: flex; flex-direction: row; align-items: center; justify-content: center; font-size: 28rpx; color: #4b5567; position: relative; }
.tb-on { color: #1f6fff; font-weight: bold; border-bottom: 4rpx solid #1f6fff; }
.badge { font-size: 18rpx; color: #ffffff; background: #f0443a; border-radius: 14rpx; padding: 0 8rpx; margin-left: 4rpx; line-height: 28rpx; }
.od-store { font-size: 30rpx; font-weight: bold; }
.od-items { display: block; font-size: 26rpx; color: #39425a; margin: 10rpx 0; }
.st { font-size: 26rpx; }
.st-pending { color: #1f6fff; }
.st-serving { color: #13a26b; }
.st-done { color: #f07a12; }
.st-reviewed, .st-cancelled { color: #8a93a6; }
.od-ft { margin-top: 16rpx; }
.empty-ic { width: 120rpx; height: 120rpx; opacity: 0.6; }
