.hero { background: linear-gradient(180deg, #1f6fff 0%, #4d8dff 100%); padding: 24rpx 32rpx 120rpx; color: #ffffff; }
.hero-loc { font-size: 26rpx; color: #e6efff; }
.hero-link { font-size: 26rpx; color: #ffffff; }
.hero-hi { font-size: 40rpx; font-weight: bold; margin-top: 12rpx; }
.cars { height: 360rpx; margin-top: -100rpx; }
.car-card { margin: 0 12rpx; height: 340rpx; background: #ffffff; border-radius: 24rpx; padding: 24rpx 28rpx; box-shadow: 0 8rpx 24rpx rgba(31, 111, 255, 0.12); position: relative; }
.car-name { font-size: 32rpx; font-weight: bold; margin-right: 12rpx; }
.car-year { font-size: 22rpx; color: #8a93a6; }
.car-plate { font-size: 26rpx; color: #ffffff; background: #1f4fbf; border-radius: 8rpx; padding: 4rpx 14rpx; }
.car-img { width: 100%; height: 200rpx; margin-top: 8rpx; border-radius: 16rpx; }
.car-km { position: absolute; left: 28rpx; bottom: 18rpx; font-size: 22rpx; color: #4b5567; }
.car-add { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed #a9c4ff; box-shadow: none; }
.add-plus { font-size: 72rpx; color: #1f6fff; line-height: 1; }
.add-tx { font-size: 30rpx; color: #1f6fff; margin: 12rpx 0 6rpx; }
.pend { background: #fff7eb; }
.pend-tt { font-size: 28rpx; color: #b45f06; font-weight: bold; }
.remind { margin: 24rpx 0; }
.r-num { font-size: 44rpx; font-weight: bold; }
.r-date { font-size: 30rpx; font-weight: bold; color: #1d2433; line-height: 66rpx; }
.remind-ft { margin-top: 20rpx; }
.grid { display: flex; flex-direction: row; flex-wrap: wrap; padding: 20rpx 0 4rpx; }
.g-item { width: 25%; display: flex; flex-direction: column; align-items: center; margin-bottom: 20rpx; }
.g-ic { width: 88rpx; height: 88rpx; }
.g-tx { font-size: 24rpx; margin-top: 8rpx; color: #39425a; }
.store { display: flex; flex-direction: row; padding: 20rpx; }
.st-img { width: 200rpx; height: 130rpx; border-radius: 12rpx; }
.st-info { margin-left: 20rpx; }
.st-name { font-size: 30rpx; font-weight: bold; }
.st-gap { margin-left: 16rpx; }
