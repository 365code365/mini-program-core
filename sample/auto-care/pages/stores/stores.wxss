.map-box { position: relative; height: 420rpx; }
.map { width: 100%; height: 420rpx; }
.map-btn { position: absolute; right: 24rpx; bottom: 24rpx; width: 88rpx; height: 88rpx; border-radius: 44rpx; background: #ffffff; display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15); }
.map-btn-tx { font-size: 24rpx; color: #1f6fff; }
.bar { background: #ffffff; padding: 20rpx 24rpx; }
.chip { font-size: 26rpx; color: #4b5567; background: #f3f5f9; border-radius: 30rpx; padding: 8rpx 24rpx; margin-right: 16rpx; }
.chip-on { color: #ffffff; background: #1f6fff; }
.tip { background: #fff7eb; color: #b45f06; font-size: 24rpx; padding: 12rpx 24rpx; }
.st { border: 2rpx solid #ffffff; }
.st-on { border-color: #1f6fff; }
.st-img { width: 180rpx; height: 130rpx; border-radius: 12rpx; }
.st-info { margin-left: 20rpx; }
.st-name { font-size: 30rpx; font-weight: bold; }
.st-dist { font-size: 26rpx; }
.st-gap { margin-left: 16rpx; }
.st-tags { margin-top: 16rpx; }
.st-ops { margin-top: 20rpx; }
.st-op { margin-left: 16rpx; }
