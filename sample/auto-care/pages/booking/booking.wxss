.it { padding: 6rpx 0; }
.f-row { min-height: 88rpx; border-bottom: 1rpx solid #f0f2f6; }
.f-label { width: 150rpx; color: #4b5567; }
.f-ipt { flex: 1; text-align: right; font-size: 28rpx; }
.days { white-space: nowrap; margin-bottom: 8rpx; }
.day { display: inline-flex; flex-direction: column; align-items: center; width: 132rpx; padding: 14rpx 0; margin-right: 16rpx; border-radius: 14rpx; background: #f3f5f9; }
.day-on { background: #1f6fff; }
.day-on .day-w, .day-on .day-d { color: #ffffff; }
.day-w { font-size: 26rpx; color: #1d2433; }
.day-d { font-size: 22rpx; color: #8a93a6; }
.remark { width: 100%; height: 140rpx; margin-top: 20rpx; background: #f6f8fc; border-radius: 12rpx; padding: 16rpx; box-sizing: border-box; font-size: 26rpx; }
.sb { width: 260rpx; }
