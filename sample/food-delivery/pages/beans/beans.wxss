.top {
  margin: 20rpx 24rpx 0;
  padding: 36rpx 32rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #ffb347, #ff7a1a);
  color: #ffffff;
}
.top-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}
.top-rule {
  font-size: 22rpx;
  padding: 0 18rpx;
  line-height: 40rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}
.top-num {
  display: block;
  font-size: 72rpx;
  line-height: 100rpx;
  font-weight: bold;
  margin-top: 8rpx;
}
.top-tip {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}
.tabs {
  margin: 20rpx 24rpx 0;
  height: 84rpx;
  border-radius: 20rpx;
  background: #ffffff;
}
.tab {
  position: relative;
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 28rpx;
  color: #5c6370;
  white-space: nowrap;
}
.tab-on {
  color: #1f2329;
  font-weight: bold;
}
.tab-line {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  border-radius: 3rpx;
  background: #ff7a1a;
}
.good {
  margin: 20rpx 24rpx 0;
  height: 160rpx;
  border-radius: 20rpx;
  background: #ffffff;
  overflow: hidden;
}
.g-left {
  width: 180rpx;
  height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #ff7a45, #ff3d3d);
  color: #ffffff;
  flex-shrink: 0;
}
.g-amount-row {
  align-items: flex-end;
}
.g-sym {
  font-size: 26rpx;
  font-weight: bold;
  padding-bottom: 8rpx;
}
.g-amount {
  font-size: 56rpx;
  font-weight: bold;
  line-height: 1.1;
}
.g-cond {
  font-size: 20rpx;
  margin-top: 4rpx;
  white-space: nowrap;
}
.g-mid {
  padding: 0 20rpx 0 24rpx;
}
.g-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
}
.g-beans {
  display: block;
  font-size: 24rpx;
  color: #ff7a1a;
  margin-top: 8rpx;
}
.g-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  margin-right: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(90deg, #ffb347, #ff7a1a);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  white-space: nowrap;
  flex-shrink: 0;
}
.g-btn-off {
  background: #e3e5e8;
  color: #8a8f99;
}
.to-coupons {
  margin: 24rpx 24rpx 0;
  padding: 0 24rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #fff6ec;
}
.link {
  color: #ff7a1a;
  font-size: 24rpx;
  font-weight: bold;
}
.log {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}
.log-title {
  display: block;
  font-size: 26rpx;
  line-height: 38rpx;
}
.log-time {
  display: block;
  line-height: 34rpx;
  margin-top: 4rpx;
}
.log-amt {
  font-size: 30rpx;
  font-weight: bold;
  margin-left: 16rpx;
  white-space: nowrap;
}
.log-in {
  color: #ff7a1a;
}
.none {
  padding: 40rpx 0;
  text-align: center;
}
.gap {
  height: 48rpx;
}
