<view class="tabs row">
  <view wx:for="{{tabs}}" wx:key="key" class="tab {{tab === item.key ? 'tab-on' : ''}}" data-key="{{item.key}}" bindtap="onTab">
    <text>{{item.name}}</text>
    <view wx:if="{{tab === item.key}}" class="tab-line"></view>
  </view>
</view>

<view class="list">
  <view class="card order" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onDetail">
    <view class="row between">
      <view class="row flex1">
        <view class="logo glyph" style="background: linear-gradient(135deg, {{item.shop.c1}}, {{item.shop.c2}});">{{item.shop.logo}}</view>
        <text class="shop-name ellipsis">{{item.shop.name}}</text>
        <view class="arrow"></view>
      </view>
      <text class="status status-{{item.status}}">{{item.statusText}}</text>
    </view>
    <view class="row goods">
      <text class="flex1 goods-text ellipsis">{{item.summary}}</text>
      <view class="goods-right">
        <text class="goods-pay">¥{{item.pay}}</text>
        <text class="sub">共 {{item.count}} 件</text>
      </view>
    </view>
    <view class="row between foot">
      <text class="sub">{{item.time}}</text>
      <view class="row">
        <view wx:if="{{item.status === 'delivering'}}" class="op op-primary" data-id="{{item.id}}" catchtap="onDetail">查看配送</view>
        <view wx:if="{{item.status === 'done'}}" class="op" data-id="{{item.id}}" catchtap="onReview">评价</view>
        <view class="op op-primary" data-shop="{{item.shopId}}" catchtap="onAgain">再来一单</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!list.length}}" class="empty">
    <view class="empty-icon"><view class="empty-line"></view><view class="empty-line short"></view></view>
    <text>暂无相关订单</text>
    <view class="btn-primary empty-btn" bindtap="onGoHome">去逛逛</view>
  </view>
</view>
