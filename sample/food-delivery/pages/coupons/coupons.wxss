.tabs {
  height: 88rpx;
  background: #ffffff;
}
.tab {
  position: relative;
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 27rpx;
  color: #5c6370;
  white-space: nowrap;
}
.tab-on {
  color: #1f2329;
  font-weight: bold;
}
.tab-line {
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  border-radius: 3rpx;
  background: #1677ff;
}
.redeem-entry {
  margin: 20rpx 24rpx 0;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: #e8f1ff;
  font-size: 26rpx;
}
.link {
  color: #1677ff;
  font-weight: bold;
  font-size: 24rpx;
}
.redeem {
  margin: 16rpx 24rpx 0;
  height: 84rpx;
  padding: 0 8rpx 0 28rpx;
  border-radius: 42rpx;
  background: #ffffff;
}
.redeem-input {
  flex: 1;
  height: 84rpx;
  font-size: 26rpx;
}
.ph {
  color: #b0b4bc;
}
.redeem-btn {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 36rpx;
  border-radius: 34rpx;
  background: #c8d6ee;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
}
.redeem-on {
  background: linear-gradient(90deg, #3d9bff, #1677ff);
}
.none-row {
  margin: 20rpx 24rpx 0;
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  font-size: 28rpx;
}
.radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  border: 2rpx solid #c8ccd4;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.radio-on {
  border-color: #1677ff;
  background: #1677ff;
}
.radio-in {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  background: #ffffff;
}
.list {
  padding: 4rpx 0 40rpx;
}
.coupon {
  position: relative;
  margin: 20rpx 24rpx 0;
  height: 180rpx;
  border-radius: 20rpx;
  background: #ffffff;
  overflow: hidden;
}
.c-left {
  width: 190rpx;
  height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #ff7a45, #ff3d3d);
  color: #ffffff;
}
.c-left-shop {
  background: linear-gradient(160deg, #3d9bff, #1677ff);
}
.c-amount-row {
  align-items: flex-end;
}
.c-sym {
  font-size: 26rpx;
  font-weight: bold;
  padding-bottom: 10rpx;
}
.c-amount {
  font-size: 60rpx;
  font-weight: bold;
  line-height: 1.1;
}
.c-cond {
  font-size: 20rpx;
  margin-top: 6rpx;
  opacity: 0.92;
}
.c-right {
  padding: 0 24rpx;
}
.c-vip {
  font-size: 18rpx;
  line-height: 30rpx;
  padding: 0 8rpx;
  margin-right: 8rpx;
  border-radius: 6rpx;
  background: #1f2329;
  color: #ffd36b;
  flex-shrink: 0;
}
.c-title {
  font-size: 30rpx;
  font-weight: bold;
  line-height: 44rpx;
}
.c-desc {
  display: block;
  font-size: 22rpx;
  color: #8a8f99;
  line-height: 34rpx;
}
.c-foot {
  margin-top: 12rpx;
}
.c-expire {
  font-size: 20rpx;
  color: #b0b4bc;
}
.c-gap {
  font-size: 22rpx;
  color: #ff8a00;
}
.c-use {
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 22rpx;
}
.coupon-off .c-left {
  background: #d4d7dd;
}
.coupon-off .c-title {
  color: #8a8f99;
}
.stamp {
  position: absolute;
  right: 24rpx;
  top: 20rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  border: 3rpx solid #d4d7dd;
  color: #b0b4bc;
  font-size: 22rpx;
  transform: rotate(-20deg);
}
.empty {
  text-align: center;
  padding-top: 120rpx;
}
