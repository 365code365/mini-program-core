<view class="head">
  <view class="row">
    <view class="avatar glyph">陈</view>
    <view class="flex1">
      <text class="nick">陈小饱</text>
      <view class="row">
        <text class="vip {{vip.active ? '' : 'vip-off'}}">{{vip.active ? '超级会员' : '普通会员'}}</text>
        <text class="phone">138****6620</text>
      </view>
    </view>
    <text class="setting" bindtap="onSetting">设置</text>
  </view>
  <view class="stats row">
    <view class="stat" wx:for="{{stats}}" wx:key="key" data-key="{{item.key}}" bindtap="onStat">
      <text class="stat-num">{{item.value}}</text>
      <text class="stat-name">{{item.name}}</text>
    </view>
  </view>
</view>

<view class="vip-card row" bindtap="onVip">
  <view class="flex1">
    <block wx:if="{{vip.active}}">
      <text class="vip-title">超级会员 · 本月已省 ¥{{saved}}</text>
      <text class="vip-desc">{{vipLeft ? '还有 ' + vipLeft + ' 张 ¥5 无门槛红包待使用，' + vipExpire + ' 到期' : '本月会员红包已用完，续费再得 4 张'}}</text>
    </block>
    <block wx:else>
      <text class="vip-title">开通超级会员 · 首月 ¥1</text>
      <text class="vip-desc">立得 4 张 ¥5 无门槛红包，本月已帮你省 ¥{{saved}}</text>
    </block>
  </view>
  <view wx:if="{{vip.active}}" class="vip-renew" catchtap="onRenew">续费</view>
  <view class="vip-btn">{{vip.active ? '去使用' : '立即开通'}}</view>
</view>

<view class="card">
  <view class="row between">
    <text class="title">我的订单</text>
    <view class="row all-orders" bindtap="onAllOrders"><text class="sub">全部订单</text><view class="arrow"></view></view>
  </view>
  <view class="row order-entries">
    <view class="entry" wx:for="{{orderEntries}}" wx:key="key" data-key="{{item.key}}" bindtap="onOrders">
      <view class="entry-icon glyph" style="background: {{item.color}};">{{item.glyph}}</view>
      <text class="entry-name">{{item.name}}</text>
      <view wx:if="{{item.badge}}" class="entry-badge">{{item.badge}}</view>
    </view>
  </view>
</view>

<view class="card menu">
  <view class="menu-item row" wx:for="{{menus}}" wx:key="key" data-key="{{item.key}}" bindtap="onMenu">
    <view class="menu-icon glyph" style="background: {{item.color}};">{{item.glyph}}</view>
    <text class="flex1">{{item.name}}</text>
    <text class="sub">{{item.extra}}</text>
    <view class="arrow"></view>
  </view>
</view>

<view class="card menu">
  <view class="menu-item row">
    <view class="menu-icon glyph" style="background: #13a89e;">推</view>
    <text class="flex1">订单状态通知</text>
    <switch checked="{{notify}}" color="#1677ff" bindchange="onNotify" />
  </view>
</view>

<view class="version">饱了么外卖 v3.8.2 · 杭州饱了么网络科技有限公司</view>
