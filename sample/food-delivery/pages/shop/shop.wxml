<view class="shop-head">
  <view class="row">
    <view class="logo glyph" style="background: linear-gradient(135deg, {{shop.c1}}, {{shop.c2}});">{{shop.logo}}</view>
    <view class="flex1 head-info">
      <text class="head-name ellipsis">{{shop.name}}</text>
      <view class="row head-meta">
        <text class="head-star">★ {{shop.rating}}</text>
        <text class="head-gap">月售 {{shop.sales}}</text>
        <text class="head-gap">约 {{shop.time}} 分钟</text>
        <text class="head-gap">{{shop.distance}}</text>
      </view>
    </view>
    <view class="fav {{faved ? 'fav-on' : ''}}" bindtap="onFav">{{faved ? '已收藏' : '+ 收藏'}}</view>
  </view>
  <text class="notice ellipsis">公告：{{shop.notice}}</text>
  <view class="row coupons">
    <view class="coupon" wx:for="{{shop.tags}}" wx:key="*this">{{item}}</view>
  </view>
</view>

<view class="tabs row">
  <view wx:for="{{tabs}}" wx:key="*this" class="tab {{tabIdx === index ? 'tab-on' : ''}}" data-idx="{{index}}" bindtap="onTab">
    <text>{{item}}</text>
    <view wx:if="{{tabIdx === index}}" class="tab-line"></view>
  </view>
</view>

<view wx:if="{{tabIdx === 0}}" class="body row" style="height: {{bodyHeight}}px;">
  <scroll-view class="cats" scroll-y="{{true}}" style="height: {{bodyHeight}}px;">
    <view wx:for="{{menu}}" wx:key="name" class="cat {{activeCat === index ? 'cat-on' : ''}}" data-idx="{{index}}" bindtap="onCat">
      <view wx:if="{{activeCat === index}}" class="cat-bar"></view>
      <text>{{item.name}}</text>
      <view wx:if="{{item.count}}" class="cat-badge">{{item.count}}</view>
    </view>
  </scroll-view>
  <scroll-view class="dishes" scroll-y="{{true}}" style="height: {{bodyHeight}}px;" scroll-into-view="{{intoView}}" bindscroll="onDishScroll">
    <view wx:for="{{menu}}" wx:key="name" wx:for-item="group" wx:for-index="gi" id="sec-{{gi}}">
      <view class="sec-title">{{group.name}}</view>
      <view class="dish row" wx:for="{{group.items}}" wx:key="id">
        <view class="dish-img glyph" style="background: linear-gradient(135deg, {{item.c1}}, {{item.c2}});">{{item.glyph}}</view>
        <view class="flex1 dish-info">
          <text class="dish-name ellipsis">{{item.name}}</text>
          <text class="dish-desc ellipsis">{{item.desc}}</text>
          <text class="dish-sales">月售 {{item.sales}}</text>
          <view class="row dish-bottom">
            <text class="price"><text class="price-sym">¥</text>{{item.price}}</text>
            <text wx:if="{{item.origin}}" class="origin">¥{{item.origin}}</text>
            <view class="flex1"></view>
            <view wx:if="{{item.spec}}" class="spec-btn" data-id="{{item.id}}" catchtap="onPlus">
              <text class="spec-btn-t">选规格</text>
              <view wx:if="{{counts[item.id]}}" class="spec-badge"><text>{{counts[item.id]}}</text></view>
            </view>
            <view wx:else class="stepper">
              <view wx:if="{{counts[item.id]}}" class="step-minus" data-id="{{item.id}}" catchtap="onMinus"><view class="minus-bar"></view></view>
              <text wx:if="{{counts[item.id]}}" class="step-num">{{counts[item.id]}}</text>
              <view class="step-plus" data-id="{{item.id}}" catchtap="onPlus">+</view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="dish-end">本店已展示全部商品</view>
  </scroll-view>
</view>

<view wx:if="{{tabIdx === 1}}" class="reviews">
  <view class="card score row">
    <view class="score-big">{{shop.rating}}</view>
    <view class="flex1">
      <text class="score-label">商家评分</text>
      <view class="row score-sub"><text>口味 4.9</text><text class="head-gap">包装 4.8</text><text class="head-gap">配送 4.7</text></view>
    </view>
  </view>
  <view class="card review" wx:for="{{reviews}}" wx:key="id">
    <view class="row">
      <view class="avatar glyph" style="background: {{item.color}};">{{item.short}}</view>
      <view class="flex1">
        <view class="row">
          <text class="review-name">{{item.name}}</text>
          <text wx:if="{{item.mine}}" class="mine-tag">我的评价</text>
        </view>
        <view class="row">
          <text wx:for="{{starList}}" wx:for-item="n" wx:key="*this" class="review-star {{n <= item.stars ? 'review-star-on' : ''}}">★</text>
        </view>
      </view>
      <text class="sub">{{item.date}}</text>
    </view>
    <text class="review-text">{{item.text}}</text>
  </view>
</view>

<view wx:if="{{tabIdx === 2}}" class="card info">
  <view class="info-row row between" bindtap="onNav">
    <text class="sub info-k">商家地址</text>
    <text class="flex1 info-v">{{shop.addr}}</text>
    <text class="link info-op">导航</text>
  </view>
  <view class="info-row row between"><text class="sub info-k">营业时间</text><text>{{shop.hours}}</text></view>
  <view class="info-row row between" bindtap="onCall">
    <text class="sub info-k">商家电话</text>
    <text class="link">{{shop.phone}}</text>
  </view>
  <view class="info-row row between"><text class="sub info-k">配送服务</text><text>饱了么专送 · 准时宝</text></view>
  <view class="info-row row between"><text class="sub info-k">食品安全</text><text>A 级（量化分级）</text></view>
</view>

<view wx:if="{{showCart && cart.count}}" class="mask" bindtap="onToggleCart"></view>
<view wx:if="{{showCart && cart.count}}" class="cart-panel" catchtap="noop">
  <view class="row between panel-head">
    <text class="title">已选商品</text>
    <text class="sub panel-clear" bindtap="onClearCart">清空购物车</text>
  </view>
  <view class="panel-item row" wx:for="{{cart.list}}" wx:key="key">
    <view class="flex1 panel-info">
      <text class="panel-name ellipsis">{{item.name}}</text>
      <text wx:if="{{item.spec}}" class="panel-spec ellipsis">{{item.spec}}</text>
    </view>
    <text class="price panel-price">¥{{item.total}}</text>
    <view class="stepper">
      <view class="step-minus" data-key="{{item.key}}" catchtap="onLineMinus"><view class="minus-bar"></view></view>
      <text class="step-num">{{item.qty}}</text>
      <view class="step-plus" data-key="{{item.key}}" catchtap="onLinePlus">+</view>
    </view>
  </view>
</view>

<view class="cart-bar row">
  <view class="cart-icon {{cart.count ? 'cart-icon-on' : ''}}" bindtap="onToggleCart">
    <view class="cart-basket"></view>
    <view wx:if="{{cart.count}}" class="cart-badge">{{cart.count}}</view>
  </view>
  <view class="flex1 cart-text" bindtap="onToggleCart">
    <text wx:if="{{cart.count}}" class="cart-amount">¥{{cart.amount}}</text>
    <text wx:else class="cart-empty">未选购商品</text>
    <text class="cart-fee">另需配送费 ¥{{shop.deliveryFee}}</text>
  </view>
  <view class="cart-go {{canSubmit ? 'cart-go-on' : ''}}" bindtap="onCheckout">{{goText}}</view>
</view>

<!-- 规格面板：遮罩与面板是兄弟节点，面板再 catchtap 一道 -->
<view wx:if="{{sheet}}" class="mask spec-mask" bindtap="onCloseSpec"></view>
<view wx:if="{{sheet}}" class="spec" catchtap="noop">
  <view class="row spec-head">
    <view class="spec-img glyph" style="background: linear-gradient(135deg, {{sheet.c1}}, {{sheet.c2}});">{{sheet.glyph}}</view>
    <view class="flex1">
      <text class="title spec-name ellipsis">{{sheet.name}}</text>
      <text class="sub spec-desc ellipsis">{{sheet.desc}}</text>
    </view>
    <view class="spec-x" bindtap="onCloseSpec"><view class="x1"></view><view class="x2"></view></view>
  </view>
  <view wx:for="{{sheet.groups}}" wx:for-item="g" wx:for-index="gi" wx:key="name" class="spec-group">
    <text class="spec-label">{{g.name}}</text>
    <view class="opts">
      <view wx:for="{{g.opts}}" wx:for-item="o" wx:for-index="oi" wx:key="n" class="opt {{picks[gi] === oi ? 'opt-on' : ''}}" data-g="{{gi}}" data-o="{{oi}}" bindtap="onSpecPick">
        <text class="opt-t">{{o.label}}</text>
      </view>
    </view>
  </view>
  <view class="spec-sel"><text class="sub">已选：{{specText}}</text></view>
  <view class="row between spec-foot">
    <text class="price spec-price"><text class="price-sym">¥</text>{{specTotal}}</text>
    <view class="stepper">
      <view class="step-minus {{specQty > 1 ? '' : 'step-off'}}" bindtap="onSpecMinus"><view class="minus-bar"></view></view>
      <text class="step-num">{{specQty}}</text>
      <view class="step-plus" bindtap="onSpecPlus">+</view>
    </view>
  </view>
  <view class="btn-primary spec-add" bindtap="onSpecAdd">加入购物车</view>
</view>
