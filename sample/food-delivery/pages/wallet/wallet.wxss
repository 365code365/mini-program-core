.bal {
  margin: 20rpx 24rpx 0;
  padding: 36rpx 32rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #3d9bff, #1677ff);
  color: #ffffff;
}
.bal-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}
.bal-rule {
  font-size: 22rpx;
  padding: 0 18rpx;
  line-height: 40rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}
.bal-num {
  display: block;
  font-size: 72rpx;
  line-height: 100rpx;
  font-weight: bold;
  margin-top: 8rpx;
}
.bal-tip {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}
.opts {
  margin-top: 20rpx;
}
.opt {
  flex: 1;
  height: 140rpx;
  margin-right: 18rpx;
  border-radius: 18rpx;
  border: 2rpx solid #e3e8f0;
  background: #f7f9fc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.opt:last-child {
  margin-right: 0;
}
.opt-on {
  border-color: #1677ff;
  background: #e8f1ff;
}
.opt-pay {
  font-size: 40rpx;
  font-weight: bold;
  color: #1f2329;
}
.opt-bonus {
  font-size: 22rpx;
  color: #ff4d2d;
  margin-top: 4rpx;
  white-space: nowrap;
}
.go {
  margin-top: 28rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
}
.log {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}
.log-type {
  width: 72rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 20rpx;
  margin-right: 18rpx;
  background: #fff1ec;
  color: #ff4d2d;
  flex-shrink: 0;
}
.log-recharge {
  background: #e8f1ff;
  color: #1677ff;
}
.log-refund {
  background: #e6f6ee;
  color: #1f9d5c;
}
.log-title {
  display: block;
  font-size: 26rpx;
  line-height: 38rpx;
}
.log-time {
  display: block;
  line-height: 34rpx;
  margin-top: 4rpx;
}
.log-amt {
  font-size: 30rpx;
  font-weight: bold;
  margin-left: 16rpx;
  white-space: nowrap;
}
.log-in {
  color: #1f9d5c;
}
.none {
  padding: 40rpx 0;
  text-align: center;
}
.gap {
  height: 48rpx;
}
