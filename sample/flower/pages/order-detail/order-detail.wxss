.head { margin: 24rpx 24rpx 0; padding: 32rpx; border-radius: 24rpx; background: linear-gradient(150deg, #ff8fa8, #e8466f); color: #ffffff; }
.head-shipping { background: linear-gradient(150deg, #ffb35c, #f07a2a); }
.head-done { background: linear-gradient(150deg, #5fd3a8, #20a37a); }
.head-cancel { background: linear-gradient(150deg, #b9b1ba, #8d848f); }
.h-status { display: block; font-size: 40rpx; font-weight: bold; }
.h-tip { display: block; margin-top: 8rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.88); }
.h-steps { margin-top: 28rpx; }
.h-step { flex: 1; margin-right: 8rpx; font-size: 22rpx; color: rgba(255, 255, 255, 0.6); }
.h-step:last-child { margin-right: 0; }
.h-bar { height: 8rpx; border-radius: 4rpx; background: rgba(255, 255, 255, 0.3); margin-bottom: 8rpx; }
.h-step-on { color: #ffffff; font-weight: bold; }
.h-step-on .h-bar { background: #ffffff; }
.h-acts { margin-top: 28rpx; flex-wrap: wrap; }
.h-op { height: 56rpx; padding: 0 24rpx; margin: 0 14rpx 10rpx 0; border-radius: 28rpx; border: 2rpx solid rgba(255, 255, 255, 0.7); font-size: 24rpx; display: flex; flex-direction: row; align-items: center; }
.h-op-main { background: #ffffff; border-color: #ffffff; color: #e8466f; font-weight: bold; }
.stars { margin-top: 14rpx; }
.star-text { font-size: 26rpx; color: #ef4f76; margin-left: 8rpx; }
.tags { flex-wrap: wrap; margin-top: 14rpx; }
.tag { height: 52rpx; line-height: 52rpx; padding: 0 20rpx; margin: 0 14rpx 14rpx 0; border-radius: 26rpx; background: #f6f2f4; border: 2rpx solid #f6f2f4; font-size: 24rpx; color: #6d6470; }
.tag-on { background: #fff0f4; border-color: #ef5b7e; color: #ef4f76; }
.rate-input { width: 100%; height: 140rpx; margin-top: 6rpx; padding: 16rpx 20rpx; box-sizing: border-box; border-radius: 14rpx; background: #faf8f9; font-size: 26rpx; }
.rate-btn { margin-top: 24rpx; height: 80rpx; font-size: 28rpx; }
.rate-text { display: block; margin-top: 10rpx; font-size: 26rpx; color: #4d4550; line-height: 40rpx; }
.anon { margin-left: 14rpx; font-size: 20rpx; color: #9b6bd8; background: #f4edff; padding: 2rpx 10rpx; border-radius: 6rpx; }
.r-line { margin-top: 18rpx; }
.r-name { font-size: 30rpx; font-weight: bold; margin-right: 14rpx; }
.r-addr { display: block; margin-top: 8rpx; font-size: 26rpx; color: #4d4550; line-height: 38rpx; }
.r-meta { margin-top: 16rpx; padding: 6rpx 20rpx; border-radius: 14rpx; background: #faf8f9; }
.m-row { height: 60rpx; }
.m-v { font-size: 24rpx; color: #26222a; }
.it { margin-top: 22rpx; align-items: flex-start; }
.it-img { width: 120rpx; height: 120rpx; border-radius: 14rpx; flex-shrink: 0; }
.it-main { margin-left: 20rpx; display: flex; flex-direction: column; }
.it-name { font-size: 28rpx; font-weight: bold; margin-bottom: 6rpx; }
.it-card { margin-top: 6rpx; font-size: 22rpx; color: #a3627a; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.it-p { font-size: 28rpx; margin-left: 12rpx; }
.lines { margin-top: 24rpx; padding-top: 12rpx; border-top: 1rpx solid #f3eef1; }
.ln { height: 58rpx; font-size: 26rpx; }
.ln-n { font-size: 26rpx; }
.paid { height: 70rpx; }
.paid-v { font-size: 36rpx; }
.i-row { height: 64rpx; font-size: 26rpx; }
.copy { margin-left: 16rpx; font-size: 22rpx; color: #ef4f76; padding: 0 14rpx; line-height: 36rpx; border-radius: 18rpx; border: 2rpx solid #ffc2d0; }
.gap { height: 48rpx; }
