.hero { width: 750rpx; height: 750rpx; display: block; }
.info { margin-top: -40rpx; position: relative; }
.price-row { align-items: baseline; }
.big { font-size: 48rpx; }
.origin { margin-left: 12rpx; font-size: 24rpx; color: #b9b1ba; text-decoration: line-through; }
.fav { display: flex; flex-direction: row; align-items: center; height: 52rpx; padding: 0 20rpx; border-radius: 26rpx; background: #f6f2f4; font-size: 22rpx; color: #6d6470; }
.fav.on { background: #fff0f4; color: #ef4f76; }
.heart { width: 20rpx; height: 20rpx; border-radius: 10rpx; border: 3rpx solid #6d6470; margin-right: 8rpx; box-sizing: border-box; }
.fav.on .heart { background: #ef4f76; border-color: #ef4f76; }
.name { display: block; margin-top: 14rpx; font-size: 34rpx; font-weight: bold; }
.flowers { display: block; margin-top: 10rpx; font-size: 24rpx; color: #7d747f; }
.promise { margin-top: 20rpx; background: #fff7f9; border-radius: 12rpx; padding: 14rpx 16rpx; justify-content: space-between; }
.pr { font-size: 22rpx; color: #c4486a; }
.opts { display: flex; flex-direction: row; justify-content: space-between; margin-top: 16rpx; }
.opt { width: 150rpx; margin: 0 0 14rpx 0; padding: 14rpx 0; border-radius: 14rpx; border: 2rpx solid #ece6ea; background: #faf8f9; display: flex; flex-direction: column; align-items: center; box-sizing: border-box; }
.opt.pk { width: 204rpx; }
.opt.on { border-color: #ef5b7e; background: #fff0f4; }
.o-name { font-size: 26rpx; font-weight: bold; color: #26222a; }
.o-sub { margin-top: 4rpx; font-size: 20rpx; color: #a39aa4; }
.opt.on .o-name { color: #ef4f76; }
.opt.on .o-sub { color: #f07f9b; }
.sub-sec { display: block; margin-top: 16rpx; }
.qty-row { margin-top: 12rpx; }
.stepper { border: 2rpx solid #ece6ea; border-radius: 30rpx; height: 60rpx; }
.st-btn { width: 64rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #26222a; }
.st-btn.dis { color: #cfc7d0; }
.st-n { width: 64rpx; text-align: center; font-size: 28rpx; font-weight: bold; }
.cell { padding: 26rpx 0 6rpx; }
.c-label { font-size: 28rpx; color: #4d4550; }
.c-val { font-size: 28rpx; color: #26222a; font-weight: bold; }
.ta { margin-top: 18rpx; width: 100%; height: 160rpx; background: #faf8f9; border-radius: 14rpx; padding: 18rpx 20rpx; box-sizing: border-box; font-size: 26rpx; line-height: 40rpx; color: #26222a; }
.tpls { margin-top: 18rpx; white-space: nowrap; }
.tpl { display: inline-block; height: 52rpx; line-height: 52rpx; padding: 0 20rpx; margin-right: 14rpx; border-radius: 26rpx; background: #fff0f4; color: #c4486a; font-size: 22rpx; }
.foot-gap { height: calc(140rpx + env(safe-area-inset-bottom)); }
.foot { position: fixed; left: 0; right: 0; bottom: 0; background: #ffffff; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05); }
.f-cart { width: 100rpx; display: flex; flex-direction: column; align-items: center; position: relative; }
.f-ic { width: 44rpx; height: 44rpx; }
.f-tx { font-size: 20rpx; color: #6d6470; }
.badge { position: absolute; right: 6rpx; top: -8rpx; min-width: 30rpx; height: 30rpx; padding: 0 8rpx; border-radius: 15rpx; background: #ef3f66; color: #ffffff; font-size: 18rpx; line-height: 30rpx; text-align: center; box-sizing: border-box; }
.f-add { flex: 1; margin-left: 16rpx; height: 84rpx; border-radius: 42rpx 0 0 42rpx; background: linear-gradient(90deg, #ffc46b, #ff9a3d); color: #ffffff; font-size: 28rpx; font-weight: bold; display: flex; align-items: center; justify-content: center; }
.f-buy { flex: 1.2; height: 84rpx; border-radius: 0 42rpx 42rpx 0; background: linear-gradient(90deg, #ff7f9c, #ef4f76); color: #ffffff; font-size: 28rpx; font-weight: bold; display: flex; align-items: center; justify-content: center; }
