<view class="card form">
  <view class="f row">
    <text class="f-l">收花人</text>
    <input class="f-in f-name" placeholder="收花人姓名" placeholder-class="ph" value="{{name}}" maxlength="16" bindinput="onName" />
  </view>
  <view class="f row">
    <text class="f-l">手机号</text>
    <input class="f-in f-phone" type="number" placeholder="11 位手机号" placeholder-class="ph" value="{{phone}}" maxlength="11" bindinput="onPhone" />
  </view>
  <picker mode="region" value="{{region}}" bindchange="onRegion">
    <view class="f row f-region">
      <text class="f-l">所在地区</text>
      <text class="f-in {{region.length ? '' : 'ph'}}">{{region.length ? region[0] + ' ' + region[1] + ' ' + region[2] : '省 / 市 / 区'}}</text>
      <view class="chev"></view>
    </view>
  </picker>
  <view class="f row last">
    <text class="f-l">详细地址</text>
    <input class="f-in f-detail" placeholder="街道、楼牌号、公司或医院名称" placeholder-class="ph" value="{{detail}}" maxlength="40" bindinput="onDetail" />
  </view>
</view>
<view class="card form">
  <view class="f row">
    <text class="f-l">标签</text>
    <view class="row flex1">
      <view wx:for="{{tags}}" wx:key="*this" class="chip {{tag === item ? 'chip-on' : ''}}" data-tag="{{item}}" bindtap="onTag"><text>{{item}}</text></view>
    </view>
  </view>
  <view class="f row last">
    <view class="flex1">
      <text class="d-t">设为默认地址</text>
      <text class="muted d-s">下单时优先送到这里</text>
    </view>
    <switch checked="{{isDefault}}" color="#ef5b7e" bindchange="onDefault" />
  </view>
</view>
<view class="btn-primary save" bindtap="onSave"><text>保存</text></view>
<view wx:if="{{id}}" class="del" bindtap="onDelete"><text>删除地址</text></view>
