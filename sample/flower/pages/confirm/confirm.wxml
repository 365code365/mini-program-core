<view class="steps row">
  <view class="stp on"><text class="stp-n">1</text><text class="stp-t">确认订单</text></view>
  <view class="stp-line"></view>
  <view class="stp"><text class="stp-n">2</text><text class="stp-t">花艺制作</text></view>
  <view class="stp-line"></view>
  <view class="stp"><text class="stp-n">3</text><text class="stp-t">准时送达</text></view>
</view>
<view class="card addr row" bindtap="onAddr">
  <view class="a-ic"><view class="a-pin"></view></view>
  <view wx:if="{{addr}}" class="flex1">
    <view class="row"><text class="a-name">{{addr.name}}</text><text class="a-phone">{{addr.phoneMask}}</text><text wx:if="{{addr.tag}}" class="pill">{{addr.tag}}</text></view>
    <text class="a-text">{{addr.text}}</text>
  </view>
  <view wx:else class="flex1"><text class="a-none">添加收花人地址</text></view>
  <view class="chev"></view>
</view>
<view class="card">
  <view class="row between"><text class="sec-title">配送时间</text><text class="muted">同城 3 小时达</text></view>
  <picker mode="date" value="{{date}}" start="{{minDate}}" end="{{maxDate}}" bindchange="onDate">
    <view class="f row"><text class="f-l">送达日期</text><text class="f-in f-val">{{date}}</text><view class="chev"></view></view>
  </picker>
  <picker mode="selector" range="{{slots}}" value="{{slotIdx}}" bindchange="onSlot">
    <view class="f row last"><text class="f-l">送达时段</text><text class="f-in f-val">{{slots[slotIdx]}}</text><view class="chev"></view></view>
  </picker>
</view>
<view class="card">
  <text class="sec-title">花束清单</text>
  <view class="line row" wx:for="{{lines}}" wx:key="key">
    <image class="l-img" src="{{item.img}}" mode="aspectFill" />
    <view class="l-main">
      <text class="l-name">{{item.name}}</text>
      <text class="l-spec">{{item.spec}} · ×{{item.qty}}</text>
      <view class="row l-card" data-i="{{index}}" bindtap="editCard">
        <text class="l-card-t flex1">{{item.card ? '贺卡：' + item.card : '添加贺卡留言（免费）'}}</text>
        <text class="l-card-edit">{{item.card ? '修改' : '添加'}}</text>
      </view>
    </view>
    <text class="price l-p">¥{{item.sum}}</text>
  </view>
</view>
<view class="card">
  <view class="sw row">
    <view class="sw-main"><text class="sw-t">匿名送花</text><text class="muted">贺卡不署名，配送员不透露订花人信息</text></view>
    <switch checked="{{anonymous}}" color="#ef5b7e" bindchange="onAnon" />
  </view>
  <view wx:if="{{!anonymous}}" class="f row"><text class="f-l">署名</text><input class="f-in f-sender" value="{{sender}}" maxlength="12" bindinput="onSender" placeholder="贺卡落款" /></view>
  <view class="sw row">
    <view class="sw-main"><text class="sw-t">送达前电话联系</text><text class="muted">关闭后配送员将直接送达，适合制造惊喜</text></view>
    <switch checked="{{callFirst}}" color="#ef5b7e" bindchange="onCall" />
  </view>
</view>
<view class="card">
  <view class="fee row between"><text class="fee-l">商品金额</text><text>¥{{p.goods}}</text></view>
  <view wx:if="{{p.activityCut}}" class="fee row between"><text class="fee-l">向日葵第二束半价</text><text class="price">-¥{{p.activityCut}}</text></view>
  <view class="fee row between"><text class="fee-l">{{p.memberName}} {{p.memberRate}}</text><text class="price">-¥{{p.memberCut}}</text></view>
  <view class="fee row between coupon" bindtap="onCoupon">
    <text class="fee-l">优惠券</text>
    <view class="row"><text class="{{p.couponCut ? 'price' : 'muted'}}">{{couponText}}</text><view class="chev"></view></view>
  </view>
  <view class="fee row between"><text class="fee-l">配送费</text><text class="free">免运费</text></view>
</view>
<view class="foot-gap"></view>
<view class="foot row">
  <view class="tot">
    <view class="row tot-row"><text class="tot-l">实付</text><text class="price yen">¥</text><text class="price tot-p">{{p.total}}</text></view>
    <text wx:if="{{saved}}" class="muted">已优惠 ¥{{saved}}</text>
  </view>
  <view class="pay" bindtap="submit"><text>提交订单</text></view>
</view>

<block wx:if="{{cardIdx >= 0}}">
  <view class="mask" bindtap="closeCard"></view>
  <view class="sheet" catchtap="noop">
    <text class="sheet-title">贺卡留言</text>
    <textarea id="card{{cardSeq}}" class="ta" value="{{cardText}}" maxlength="60" placeholder="写下想对 TA 说的话，花艺师会手写在贺卡上" bindinput="onCardInput" />
    <view class="tpls">
      <view class="tpl" wx:for="{{cardTpls}}" wx:key="*this" data-t="{{item}}" bindtap="useTpl"><text>{{item}}</text></view>
    </view>
    <view class="btn-primary card-ok" bindtap="saveCard"><text>保存贺卡</text></view>
  </view>
</block>
