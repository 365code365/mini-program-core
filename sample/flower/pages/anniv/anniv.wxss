.preview { margin: 24rpx 24rpx 0; padding: 36rpx 32rpx; border-radius: 24rpx; background: linear-gradient(150deg, #ff9fb4, #ef4f76); color: #ffffff; display: flex; flex-direction: column; }
.pv-name { font-size: 38rpx; font-weight: bold; }
.pv-date { margin-top: 8rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.88); }
.pv-left { margin-top: 18rpx; align-items: baseline; }
.pv-l { font-size: 26rpx; }
.pv-n { font-size: 60rpx; font-weight: bold; margin: 0 8rpx; }
.form { padding-top: 4rpx; padding-bottom: 4rpx; }
.f { min-height: 100rpx; border-bottom: 1rpx solid #f3eef1; }
.f.last { border-bottom: none; }
.f-date { border-top: 1rpx solid #f3eef1; }
.f-l { width: 150rpx; font-size: 28rpx; color: #4d4550; flex-shrink: 0; }
.f-in { flex: 1; min-width: 0; height: 64rpx; line-height: 64rpx; font-size: 28rpx; color: #26222a; }
.f-val { font-weight: bold; }
.ph { color: #c2bac3; }
.quick { display: flex; flex-direction: row; flex-wrap: wrap; padding: 18rpx 0 8rpx; }
.q-chip { height: 52rpx; padding: 0 20rpx; margin: 0 14rpx 14rpx 0; border-radius: 26rpx; background: #f6f2f4; border: 2rpx solid #f6f2f4; font-size: 24rpx; color: #6d6470; display: flex; flex-direction: row; align-items: center; }
.q-on { background: #fff0f4; border-color: #ef5b7e; color: #ef4f76; }
.kinds { flex-wrap: wrap; }
.k-chip { height: 52rpx; padding: 0 22rpx; margin: 8rpx 12rpx 8rpx 0; border-radius: 26rpx; background: #f6f2f4; border: 2rpx solid #f6f2f4; font-size: 24rpx; color: #6d6470; display: flex; flex-direction: row; align-items: center; }
.k-on { background: #fff0f4; border-color: #ef5b7e; color: #ef4f76; font-weight: bold; white-space: nowrap; }
.tip { padding: 20rpx 32rpx 0; }
.save { margin: 36rpx 24rpx 0; }
.del { margin: 24rpx 24rpx 0; height: 88rpx; border-radius: 44rpx; background: #ffffff; color: #ef4f76; font-size: 28rpx; display: flex; align-items: center; justify-content: center; }
