<view class="tabs">
  <view class="tab {{tab === item.k ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="k" data-k="{{item.k}}" bindtap="onTab"><text>{{item.n}}</text><view class="tab-line"></view></view>
</view>
<view class="cp row {{item.status !== 'valid' ? 'cp-off' : ''}}" wx:for="{{list}}" wx:key="id">
  <view class="cp-l">
    <view class="row cp-amt-row"><text class="cp-sym">¥</text><text class="cp-amt">{{item.amount}}</text></view>
    <text class="cp-min">满 {{item.min}} 可用</text>
  </view>
  <view class="flex1 cp-r">
    <text class="cp-title">{{item.title}}</text>
    <text class="muted cp-cond">{{item.cond}} · 可与会员折扣同享</text>
    <view class="row between cp-foot">
      <text class="muted">{{item.status === 'expired' ? '已于 ' + item.expire + ' 过期' : '有效期至 ' + item.expire}}</text>
      <view wx:if="{{item.status === 'valid'}}" class="cp-use" bindtap="onUse"><text>去使用</text></view>
      <text wx:else class="cp-stamp">{{item.status === 'used' ? '已使用' : '已过期'}}</text>
    </view>
  </view>
</view>
<view wx:if="{{!list.length}}" class="empty"><text>这里空空如也</text></view>
<view class="note"><text class="muted">一单限用一张券，结算时自动选最省的那张，也可以手动更换</text></view>
