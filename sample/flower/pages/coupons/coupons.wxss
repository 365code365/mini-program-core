.tabs { display: flex; flex-direction: row; background: #ffffff; height: 88rpx; }
.tab { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; font-size: 28rpx; color: #7d747f; }
.tab.on { color: #26222a; font-weight: bold; }
.tab-line { position: absolute; bottom: 10rpx; width: 40rpx; height: 6rpx; border-radius: 3rpx; }
.tab.on .tab-line { background: #ef5b7e; }
.cp { margin: 24rpx 24rpx 0; background: #ffffff; border-radius: 20rpx; overflow: hidden; height: 180rpx; }
.cp-l { width: 200rpx; height: 180rpx; background: linear-gradient(150deg, #ff9fb4, #ef4f76); display: flex; flex-direction: column; align-items: center; justify-content: center; color: #ffffff; flex-shrink: 0; }
.cp-off .cp-l { background: linear-gradient(150deg, #d9d1da, #b9b1ba); }
.cp-amt-row { align-items: baseline; }
.cp-sym { font-size: 28rpx; font-weight: bold; }
.cp-amt { font-size: 60rpx; font-weight: bold; }
.cp-min { font-size: 20rpx; margin-top: 4rpx; }
.cp-r { padding: 0 24rpx; display: flex; flex-direction: column; }
.cp-title { font-size: 30rpx; font-weight: bold; }
.cp-cond { margin-top: 6rpx; }
.cp-foot { margin-top: 18rpx; }
.cp-use { height: 52rpx; padding: 0 24rpx; border-radius: 26rpx; background: linear-gradient(90deg, #ff7f9c, #ef4f76); color: #ffffff; font-size: 24rpx; display: flex; flex-direction: row; align-items: center; flex-shrink: 0; }
.cp-stamp { font-size: 24rpx; color: #b9b1ba; font-weight: bold; }
.cp-off .cp-title { color: #a39aa4; }
.note { padding: 32rpx 24rpx; text-align: center; }
