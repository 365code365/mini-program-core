.top { background: #ffffff; padding: 16rpx 24rpx 20rpx; justify-content: space-between; }
.pin { width: 20rpx; height: 20rpx; border-radius: 10rpx 10rpx 10rpx 0; background: #ef5b7e; transform: rotate(-45deg); margin-right: 12rpx; }
.loc-tx { font-size: 28rpx; font-weight: bold; }
.pm { font-size: 22rpx; color: #ef5b7e; background: #fff0f4; padding: 4rpx 12rpx; border-radius: 8rpx; margin-left: 12rpx; }
.banner-wrap { margin: 20rpx 24rpx 0; height: 280rpx; border-radius: 24rpx; overflow: hidden; }
.banner { height: 280rpx; }
.b-item { height: 280rpx; display: flex; flex-direction: row; align-items: center; padding-left: 40rpx; overflow: hidden; }
.b-text { flex: 1; display: flex; flex-direction: column; }
.b-title { font-size: 36rpx; font-weight: bold; color: #ffffff; }
.b-sub { margin-top: 10rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.9); }
.b-btn { margin-top: 26rpx; width: 150rpx; height: 54rpx; border-radius: 27rpx; background: #ffffff; color: #e8466f; font-size: 24rpx; font-weight: bold; display: flex; align-items: center; justify-content: center; }
.b-img { width: 250rpx; height: 250rpx; border-radius: 125rpx; margin-right: 24rpx; flex-shrink: 0; border: 6rpx solid rgba(255, 255, 255, 0.5); }
.uses { display: flex; flex-direction: row; margin: 24rpx 24rpx 0; background: #ffffff; border-radius: 20rpx; padding: 28rpx 8rpx 24rpx; }
.use { flex: 1; display: flex; flex-direction: column; align-items: center; border-radius: 16rpx; padding: 8rpx 0; }
.use.on { background: #fff0f4; }
.use-ic { width: 92rpx; height: 92rpx; border-radius: 46rpx; display: flex; align-items: center; justify-content: center; color: #ffffff; font-size: 28rpx; font-weight: bold; }
.use-name { margin-top: 12rpx; font-size: 26rpx; font-weight: bold; color: #26222a; }
.use-sub { margin-top: 2rpx; font-size: 20rpx; color: #a39aa4; }
.use.on .use-name { color: #ef4f76; }
.sec { margin: 36rpx 24rpx 0; }
.sec-bar { width: 8rpx; height: 32rpx; border-radius: 4rpx; background: #ef5b7e; margin-right: 14rpx; }
.cols { display: flex; flex-direction: row; padding: 0 16rpx; }
.col { flex: 1; padding: 0 8rpx; display: flex; flex-direction: column; }
.goods { margin-top: 20rpx; background: #ffffff; border-radius: 20rpx; overflow: hidden; }
.g-img { width: 100%; height: 340rpx; display: block; }
.g-body { padding: 18rpx 20rpx 20rpx; }
.g-name { font-size: 27rpx; font-weight: bold; color: #26222a; line-height: 38rpx; }
.g-tags { margin-top: 8rpx; }
.g-tag { font-size: 20rpx; color: #ef4f76; border: 1rpx solid #ffb3c4; padding: 0 8rpx; border-radius: 6rpx; margin-right: 10rpx; }
.g-sold { font-size: 20rpx; color: #a39aa4; }
.g-foot { margin-top: 10rpx; }
.g-price { align-items: baseline; }
.g-p { font-size: 34rpx; }
.g-o { margin-left: 8rpx; font-size: 20rpx; color: #b9b1ba; text-decoration: line-through; }
.add { width: 48rpx; height: 48rpx; border-radius: 24rpx; background: linear-gradient(135deg, #ff8fa8, #ef4f76); color: #ffffff; font-size: 36rpx; line-height: 44rpx; text-align: center; }
.float-cart { position: fixed; right: 28rpx; bottom: calc(140rpx + env(safe-area-inset-bottom)); width: 96rpx; height: 96rpx; border-radius: 48rpx; background: #ffffff; box-shadow: 0 6rpx 20rpx rgba(140, 40, 70, 0.18); display: flex; align-items: center; justify-content: center; }
.fc-ic { width: 52rpx; height: 52rpx; }
.badge { position: absolute; right: 4rpx; top: 4rpx; min-width: 32rpx; height: 32rpx; padding: 0 8rpx; border-radius: 16rpx; background: #ef3f66; color: #ffffff; font-size: 20rpx; line-height: 32rpx; text-align: center; box-sizing: border-box; border: 2rpx solid #ffffff; }
