.bar {
  padding: 16rpx 24rpx;
  background: #1b1f2b;
}
.search {
  height: 68rpx;
  background: #ffffff;
  border-radius: 34rpx;
  padding: 0 24rpx;
}
.ic {
  font-size: 24rpx;
  margin-right: 10rpx;
}
.s-input {
  height: 68rpx;
  padding: 0 0 0 1rpx;
}
.s-clear {
  color: #a3a8b3;
  padding: 0 8rpx;
}
.sec {
  display: block;
  font-size: 22rpx;
  color: #8a8f9c;
  padding: 20rpx 32rpx 12rpx;
}
.list {
  background: #ffffff;
}
.s-row {
  height: 112rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #f3f4f7;
}
.s-name {
  display: block;
  font-size: 30rpx;
}
.s-code {
  display: block;
  font-size: 22rpx;
  color: #8a8f9c;
}
.s-quote {
  width: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-right: 28rpx;
}
.s-price {
  font-size: 28rpx;
}
.s-pct {
  font-size: 22rpx;
}
.s-add {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 32rpx;
  border: 2rpx solid #e93030;
  color: #e93030;
  font-size: 40rpx;
  box-sizing: border-box;
}
.s-added {
  width: 96rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a3a8b3;
}
.s-empty {
  padding: 120rpx 0;
  text-align: center;
  color: #8a8f9c;
}
