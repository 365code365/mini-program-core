.sides {
  margin: 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 6rpx;
}
.side {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: #5c6170;
  border-radius: 10rpx;
}
.side.on.buy {
  background: #e93030;
  color: #ffffff;
}
.side.on.sell {
  background: #12a35b;
  color: #ffffff;
}
.t-name {
  font-size: 32rpx;
  font-weight: bold;
}
.field {
  margin-top: 24rpx;
}
.f-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #5c6170;
}
.stepper {
  height: 76rpx;
  border: 2rpx solid #e3e5ea;
  border-radius: 10rpx;
}
.step {
  width: 88rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 34rpx;
  color: #5c6170;
  background: #f7f8fa;
}
.step-val {
  text-align: center;
  font-size: 30rpx;
}
.q-slider {
  margin: 28rpx 8rpx 8rpx;
}
.hint {
  margin-bottom: 12rpx;
}
.q-all {
  font-size: 24rpx;
  color: #3a6ff0;
  padding: 4rpx 12rpx;
}
.amount {
  margin: 12rpx 0;
}
.amount-val {
  font-size: 34rpx;
  font-weight: bold;
}
.error {
  display: block;
  margin-top: 12rpx;
  color: #e93030;
  font-size: 24rpx;
}
.submit {
  margin: 0 24rpx 24rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 14rpx;
  color: #ffffff;
  font-size: 32rpx;
}
.submit.buy {
  background: #e93030;
}
.submit.sell {
  background: #12a35b;
}
.last {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}
.last-text {
  font-size: 24rpx;
  color: #5c6170;
}
.go-pos {
  font-size: 24rpx;
  color: #3a6ff0;
}
