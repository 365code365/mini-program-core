<view class="tabs row">
  <view class="tab flex1 {{tab === index ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="*this" data-i="{{index}}" bindtap="onTab">
    <text class="tab-text">{{item}}（{{counts[index]}}）</text>
  </view>
</view>
<view class="order card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
  <view class="row">
    <text class="o-no flex1">{{item.no}} · {{item.from}} → {{item.to}}</text>
    <text class="o-state {{item.done ? 'done' : ''}} {{item.waiting ? 'wait' : ''}}">{{item.stateText}}</text>
  </view>
  <text class="o-line">{{item.dateText}} {{item.depText}} 开 · {{item.seat}} × {{item.count}}</text>
  <text class="o-line">乘车人：{{item.namesText}}</text>
  <text class="o-line" wx:if="{{item.seatsText}}">座位偏好：{{item.seatsText}}</text>
  <text class="o-line o-note" wx:if="{{item.waiting}}">候补排队中，有票后自动出票</text>
  <text class="o-line o-note" wx:if="{{item.changedText}}">{{item.changedText}}</text>
  <text class="o-line" wx:if="{{item.refundText}}">{{item.refundText}}</text>
  <view class="row o-foot">
    <text class="o-total flex1">{{item.waiting ? '预付' : '实付'}} ¥{{item.total}}</text>
    <view class="o-btn change-btn" wx:if="{{item.canChange}}" data-id="{{item.id}}" catchtap="onChange"><text>改签</text></view>
    <view class="o-btn cancel-btn" wx:if="{{!item.done}}" data-index="{{index}}" catchtap="onCancel"><text>{{item.waiting ? '取消候补' : '退票'}}</text></view>
    <view class="o-btn again-btn" wx:if="{{item.done}}" data-index="{{index}}" catchtap="onAgain"><text>再次购买</text></view>
  </view>
</view>
<view class="empty" wx:if="{{!list.length}}">
  <text>{{tab === 0 ? '暂无待出行的订单' : '暂无已完成的订单'}}</text>
  <view class="go" bindtap="onGo"><text class="go-text">去买票</text></view>
</view>
<view class="bottom-space"></view>
