<view class="head">
  <view class="row">
    <view class="hcol">
      <text class="htime">{{train.depText}}</text>
      <text class="hcity">{{train.from}}</text>
    </view>
    <view class="flex1 hmid">
      <text class="hno">{{train.no}}</text>
      <text class="hdur">{{train.durText}}</text>
    </view>
    <view class="hcol hcol-r">
      <text class="htime">{{train.arrText}}</text>
      <text class="hcity">{{train.to}}</text>
    </view>
  </view>
  <view class="row hdate-row">
    <text class="hdate flex1">{{dateText}}</text>
    <text class="stops-link" bindtap="onStops">经停站 ›</text>
  </view>
</view>
<view class="change-bar" wx:if="{{change}}">
  <text class="change-t">改签 · 原车票 {{change.no}} {{change.dateText}} {{change.depText}} {{change.seat}} ¥{{change.total}}</text>
</view>
<view class="card">
  <text class="sec">选择席别</text>
  <radio-group class="seat-group" bindchange="onSeat">
    <label class="seat-opt row {{seatIdx === index ? 'on' : ''}}" wx:for="{{train.seats}}" wx:key="name">
      <radio class="seat-radio" value="{{index}}" checked="{{seatIdx === index}}" disabled="{{change && item.left === 0}}" color="#2b6de8" />
      <text class="flex1 seat-name">{{item.name}}</text>
      <text class="seat-left {{item.left === 0 ? 'none' : ''}}" wx:if="{{item.left > 0 || change}}">{{item.leftText}}</text>
      <text class="seat-wait" wx:else>无票 · 可候补</text>
      <text class="seat-price">¥{{item.price}}</text>
    </label>
  </radio-group>
</view>
<view class="card" wx:if="{{change}}">
  <text class="sec">乘车人（{{count}} 位，改签不能增减）</text>
  <view class="p-item row" wx:for="{{passengers}}" wx:key="id">
    <view class="flex1 p-main">
      <text class="p-name">{{item.name}}<text class="tag" wx:if="{{item.type !== '成人票'}}"> {{item.type}} </text></text>
      <text class="sub">原座位 {{item.idText}}</text>
    </view>
  </view>
</view>
<view class="card" wx:else>
  <view class="row">
    <text class="sec flex1">乘车人（已选 {{count}} 位）</text>
    <text class="add-p" bindtap="onAddPassenger">+ 添加乘车人</text>
  </view>
  <checkbox-group class="p-group" bindchange="onPassengers">
    <label class="p-item row" wx:for="{{passengers}}" wx:key="id">
      <checkbox class="p-check" value="{{item.id}}" checked="{{item.checked}}" color="#2b6de8" />
      <view class="flex1 p-main">
        <text class="p-name">{{item.name}}<text class="tag" wx:if="{{item.self}}"> 本人 </text><text class="tag tag-type" wx:if="{{item.type !== '成人票'}}"> {{item.type}} </text></text>
        <text class="sub">身份证 {{item.idText}}</text>
      </view>
    </label>
  </checkbox-group>
</view>
<view class="card" wx:if="{{wait}}">
  <view class="row">
    <text class="sec flex1">候补购票</text>
    <text class="rule-link" bindtap="onWaitRule">候补说明</text>
  </view>
  <text class="wait-line">{{train.seats[seatIdx].name}}暂时无票，提交候补并预付票款，有票后系统自动出票。</text>
  <text class="wait-line">开车前未兑现全额退款，候补期间可随时取消。</text>
</view>
<view class="card" wx:else>
  <text class="sec">在线选座（已选 {{chosen.length}}/{{count}}）</text>
  <view class="letters row" wx:if="{{canChoose}}">
    <text class="win">窗</text>
    <view class="letter {{seatOn[item] ? 'on' : ''}} {{index === 2 ? 'aisle' : ''}}" wx:for="{{letters}}" wx:key="*this" data-l="{{item}}" bindtap="onLetter">{{item}}</view>
    <text class="win">窗</text>
  </view>
  <text class="sub" wx:else>普速列车不提供在线选座，出票时由系统分配座位</text>
</view>
<view class="bottom-space"></view>
<view class="footer row">
  <view class="flex1 sum">
    <view class="row sum-line">
      <text class="total-label">{{change ? '新票价 ' : wait ? '预付 ' : '合计 '}}</text>
      <text class="total">¥{{total}}</text>
    </view>
    <text class="sub sum-sub" wx:if="{{change}}">{{diffText}}</text>
    <text class="sub sum-sub" wx:elif="{{discountText}}">{{discountText}}</text>
    <text class="sub sum-sub" wx:else>{{count}} 人 × ¥{{price}}</text>
  </view>
  <view class="btn submit {{count ? '' : 'disabled'}}" bindtap="onSubmit"><text class="btn-text">{{change ? '确认改签' : wait ? '提交候补' : '提交订单'}}</text></view>
</view>
