.search {
  background: #ffffff;
  padding: 16rpx 24rpx;
}
.search-input {
  height: 72rpx;
  border-radius: 36rpx;
  background: #f3f5f9;
  padding: 0 28rpx;
  font-size: 26rpx;
}
.body {
  height: calc(100vh - 104rpx);
}
.sec {
  display: block;
  font-size: 24rpx;
  color: #8a909c;
  padding: 24rpx 32rpx 12rpx;
}
.chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 0 20rpx;
}
.chip {
  width: 150rpx;
  height: 64rpx;
  margin: 8rpx 12rpx;
  border-radius: 10rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}
.chip.on {
  background: #eaf1ff;
  color: #2b6de8;
}
.letter {
  display: block;
  font-size: 24rpx;
  color: #8a909c;
  padding: 16rpx 32rpx 8rpx;
}
.city-item,
.res-item {
  background: #ffffff;
  padding: 26rpx 32rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f0f1f5;
}
.index-bar {
  position: fixed;
  right: 8rpx;
  top: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.idx {
  font-size: 22rpx;
  color: #2b6de8;
  padding: 4rpx 12rpx;
}
