<view class="head" bindtap="onOrders">
  <view class="avatar"><text class="avatar-text">行</text></view>
  <view class="head-main flex1">
    <text class="nick">畅行旅客</text>
    <text class="head-sub">已购 {{orderCount}} 单 · 累计 ¥{{spent}}</text>
  </view>
  <text class="head-todo" wx:if="{{todo}}">{{todo}} 单待出行</text>
</view>
<view class="card">
  <view class="row">
    <text class="sec flex1">常用乘车人（{{passengers.length}}）</text>
    <text class="add" bindtap="onAdd">+ 添加</text>
  </view>
  <view class="p row" wx:for="{{passengers}}" wx:key="id" data-id="{{item.id}}" bindtap="onEdit">
    <view class="flex1 p-main">
      <text class="p-name">{{item.name}}<text class="tag" wx:if="{{item.self}}"> 本人 </text><text class="tag tag-type" wx:if="{{item.typeText}}"> {{item.typeText}} </text></text>
      <text class="sub">{{item.idText}} · {{item.phone}}</text>
    </view>
    <text class="p-del" wx:if="{{!item.self}}" data-index="{{index}}" catchtap="onRemove">删除</text>
    <view class="arrow"></view>
  </view>
</view>
<view class="card links">
  <view class="link row" bindtap="onCall">
    <text class="flex1">客服电话 12306</text>
    <view class="arrow"></view>
  </view>
  <view class="link row" bindtap="onRule">
    <text class="flex1">退改签规则</text>
    <view class="arrow"></view>
  </view>
  <view class="link row" bindtap="onAbout">
    <text class="flex1">关于畅行火车票</text>
    <text class="sub">v1.1</text>
    <view class="arrow"></view>
  </view>
</view>
<view class="bottom-space"></view>
