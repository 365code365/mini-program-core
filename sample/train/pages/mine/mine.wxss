.head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #4a8bff, #2b6de8);
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-text {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: bold;
}
.head-main {
  display: flex;
  flex-direction: column;
  margin-left: 28rpx;
}
.nick {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: bold;
}
.head-sub {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-top: 8rpx;
}
.sec {
  font-size: 28rpx;
  font-weight: bold;
}
.add {
  color: #2b6de8;
  font-size: 26rpx;
}
.p {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}
.p-main {
  display: flex;
  flex-direction: column;
}
.p-name {
  font-size: 28rpx;
}
.p-del {
  color: #f2453d;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
}
.links {
  display: flex;
  flex-direction: column;
}
.link {
  font-size: 26rpx;
  color: #5c6370;
  padding: 16rpx 0;
}
