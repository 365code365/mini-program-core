<view class="page">
  <view class="profile" bindtap="edit" hover-class="hover">
    <view class="avatar av" style="background: {{p.color}};"><text class="av-text">{{initial}}</text></view>
    <view class="pf-main">
      <view class="pf-row">
        <text class="pf-name">{{p.nickname}}</text>
        <view class="g-tag {{p.gender === 'female' ? 'g-f' : ''}}"><text class="g-text">{{genderText}}</text></view>
      </view>
      <text class="muted">轻聊号：qingliao_shenye</text>
      <text class="pf-sign">{{p.signature || '还没有签名'}}</text>
    </view>
    <view class="arrow"></view>
  </view>
  <view class="saved" wx:if="{{savedTip}}"><text class="saved-text">{{savedTip}}</text></view>
  <view class="card stats">
    <view class="stat" wx:for="{{stats}}" wx:key="k">
      <text class="stat-v">{{item.value}}</text>
      <text class="stat-l">{{item.label}}</text>
    </view>
  </view>
  <view class="card block">
    <view class="cell" bindtap="edit" hover-class="hover"><text class="label">个人资料</text><text class="value">{{p.city}} · {{p.birthday}}</text><view class="arrow"></view></view>
    <view class="cell cell-last" bindtap="toggleNotify">
      <text class="label">新消息通知</text>
      <view class="sw {{notify ? 'sw-on' : ''}}"><view class="knob"></view></view>
    </view>
  </view>
  <view class="card block">
    <view class="cell" bindtap="reset" hover-class="hover"><text class="label">恢复演示数据</text><view class="arrow"></view></view>
    <view class="cell cell-last" bindtap="clearAll" hover-class="hover"><text class="label danger">清空聊天记录</text></view>
  </view>
</view>
