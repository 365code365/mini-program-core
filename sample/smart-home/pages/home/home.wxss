.hero {
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #4361ee, #3a86ff);
  color: #ffffff;
}
.hello {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}
.sum-item {
  flex: 1;
}
.sum-v {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
}
.sum-k {
  display: block;
  font-size: 22rpx;
  opacity: 0.8;
}
.tabs {
  padding: 0 24rpx;
  height: 80rpx;
}
.tab {
  position: relative;
  margin-right: 36rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  color: #7a8291;
}
.tab.on {
  color: #1f2533;
  font-weight: bold;
  font-size: 32rpx;
}
.bar {
  position: absolute;
  left: 20%;
  right: 20%;
  bottom: 8rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #3a86ff;
}
.room-off {
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  font-size: 24rpx;
  color: #e63946;
}
.rooms {
  height: 620rpx;
}
.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 8rpx 12rpx 0;
}
.dev {
  width: 327rpx;
  height: 260rpx;
  box-sizing: border-box;
  margin: 12rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
}
.dev.is-on {
  background: #f2f6ff;
}
.dev.offline {
  opacity: 0.6;
}
.icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dev-name {
  display: block;
  margin: 24rpx 0 8rpx;
  font-size: 30rpx;
  font-weight: bold;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #c4c9d2;
  margin-right: 10rpx;
}
.dot.ok {
  background: #2ec4b6;
}
.dev-status {
  flex: 1;
  font-size: 24rpx;
  color: #7a8291;
}
.more {
  color: #b0b6c1;
  font-size: 32rpx;
}
.tip {
  text-align: center;
  font-size: 22rpx;
  color: #b0b6c1;
  padding: 16rpx 0 40rpx;
}
