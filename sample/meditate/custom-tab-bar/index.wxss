.tb { height: calc(100rpx + env(safe-area-inset-bottom)); background: #ffffff; display: flex; flex-direction: row; border-top: 1rpx solid #ecebf3; padding-bottom: env(safe-area-inset-bottom); }
.tb-dark { background: #1d1e35; border-top: 1rpx solid #2a2b45; }
.tb-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.tb-ic { width: 48rpx; height: 48rpx; }
.tb-tx { font-size: 20rpx; margin-top: 4rpx; }
