.hero { margin: 24rpx 32rpx 0; padding: 40rpx 36rpx; border-radius: 28rpx; background: linear-gradient(135deg, #8c84f0, #4b4fa8); display: flex; flex-direction: column; }
.dark .hero { background: linear-gradient(135deg, #3b3a7a, #22234a); }
.hero-date { font-size: 24rpx; color: rgba(255,255,255,0.75); }
.hero-hi { font-size: 44rpx; font-weight: 600; color: #ffffff; margin-top: 12rpx; }
.hero-tip { font-size: 26rpx; color: rgba(255,255,255,0.88); margin-top: 12rpx; }
.badge { width: 96rpx; height: 96rpx; border-radius: 48rpx; background: linear-gradient(135deg, #ffcf8a, #f59a5b); display: flex; align-items: center; justify-content: center; }
.badge-n { font-size: 40rpx; font-weight: 700; color: #ffffff; }
.streak-txt { display: flex; flex-direction: column; margin-left: 24rpx; }
.streak-t { font-size: 30rpx; font-weight: 600; margin-bottom: 6rpx; }
.done-tag { font-size: 24rpx; color: #3faa83; background: #e3f6ee; padding: 10rpx 24rpx; border-radius: 30rpx; }
.dark .done-tag { background: #1f3b35; }
.week { margin-top: 28rpx; justify-content: space-between; }
.day { display: flex; flex-direction: column; align-items: center; width: 70rpx; }
.dot { width: 28rpx; height: 28rpx; border-radius: 14rpx; background: #ecebf3; }
.dark .dot { background: #34355a; }
.dot-on { background: #f59a5b; }
.day-l { font-size: 22rpx; color: #8b8aa3; margin-top: 8rpx; }
.quick { margin: 24rpx 32rpx 0; justify-content: space-between; }
.q { display: flex; flex-direction: column; align-items: center; width: 150rpx; }
.q-ic { width: 96rpx; height: 96rpx; border-radius: 30rpx; display: flex; align-items: center; justify-content: center; }
.q-ic-t { color: #ffffff; font-size: 34rpx; font-weight: 600; }
.q-t { font-size: 24rpx; margin-top: 12rpx; }
.cont-img { width: 112rpx; height: 112rpx; border-radius: 20rpx; margin-right: 24rpx; }
.cont-k { font-size: 22rpx; color: #6c63d9; display: block; }
.cont-t { font-size: 30rpx; font-weight: 600; display: block; margin: 4rpx 0; }
.play-ic { width: 72rpx; height: 72rpx; border-radius: 36rpx; background: #6c63d9; display: flex; align-items: center; justify-content: center; }
.tri { width: 36rpx; height: 36rpx; margin-left: 4rpx; }
.rec { align-items: flex-start; }
.rec-img { width: 168rpx; height: 168rpx; border-radius: 20rpx; margin-right: 24rpx; }
.rec-body { display: flex; flex-direction: column; }
.rec-t { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.rec-d { font-size: 24rpx; color: #6f6e88; margin-top: 10rpx; line-height: 1.5; }
.dark .rec-d { color: #a3a3c2; }
