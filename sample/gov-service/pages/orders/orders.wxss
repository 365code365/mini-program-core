.tabs { background: #fff; padding: 0 12rpx; }
.t { flex: 1; text-align: center; font-size: 27rpx; color: #5b6575; padding: 24rpx 0 20rpx; border-bottom: 4rpx solid transparent; }
.t.on { color: #1d64d8; font-weight: 600; border-bottom-color: #1d64d8; }
.o-n { flex: 1; font-size: 29rpx; font-weight: 600; margin-right: 16rpx; }
.st { font-size: 22rpx; padding: 2rpx 12rpx; border: 1rpx solid; border-radius: 6rpx; }
.o-l { display: block; margin-top: 8rpx; }
.warn { margin-top: 14rpx; padding: 10rpx 14rpx; background: #fef2f2; border-radius: 8rpx; font-size: 23rpx; color: #b91c1c; }
.warn text { margin-left: 8rpx; }
.ast { font-size: 22rpx; padding: 2rpx 12rpx; border-radius: 6rpx; }
.ast.booked { background: #e8f0fe; color: #1d64d8; }
.ast.cancelled, .ast.expired { background: #eef1f6; color: #8a94a6; }
.ab { justify-content: flex-end; margin-top: 12rpx; }
.ac { font-size: 24rpx; color: #5b6575; padding: 8rpx 22rpx; border: 1rpx solid #c4cad6; border-radius: 26rpx; }
.empty { display: flex; flex-direction: column; align-items: center; }
.eb { width: 260rpx; margin-top: 24rpx; height: 68rpx; line-height: 68rpx; font-size: 26rpx; }
