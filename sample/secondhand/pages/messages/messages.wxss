.top { padding: 24rpx 28rpx 12rpx; }
.top-t { font-size: 30rpx; font-weight: bold; }
.top-a { font-size: 24rpx; color: #6b7280; }
.cv { display: flex; flex-direction: row; align-items: center; background: #ffffff; padding: 24rpx 28rpx; border-bottom: 1rpx solid #f0f1f3; }
.cv-av { position: relative; width: 96rpx; height: 96rpx; flex-shrink: 0; }
.cv-avimg { width: 96rpx; height: 96rpx; border-radius: 50%; }
.cv-dot { position: absolute; top: -4rpx; right: -4rpx; min-width: 32rpx; height: 32rpx; border-radius: 16rpx; background: #ff3b30; color: #ffffff; font-size: 20rpx; line-height: 32rpx; text-align: center; padding: 0 8rpx; box-sizing: border-box; }
.cv-mid { margin: 0 20rpx; }
.cv-name { font-size: 30rpx; font-weight: bold; }
.cv-last { display: block; font-size: 26rpx; color: #6b7280; margin-top: 8rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.cv-item { width: 96rpx; height: 96rpx; border-radius: 10rpx; flex-shrink: 0; background: #eef0f3; }
.tip { text-align: center; color: #b3b8bf; font-size: 22rpx; padding: 30rpx 0; }
