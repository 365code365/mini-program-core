.os-tabs { display: flex; flex-direction: row; background: #ffffff; }
.os-tab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 26rpx; color: #6b7280; }
.os-tab.on { color: #1f2329; font-weight: bold; border-bottom: 6rpx solid #ffda44; }
.os-top { margin-bottom: 16rpx; }
.os-st { font-size: 24rpx; color: #b26a00; }
.os-cover { width: 120rpx; height: 120rpx; border-radius: 12rpx; margin-right: 20rpx; }
.os-t { display: block; font-size: 26rpx; margin-bottom: 10rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
