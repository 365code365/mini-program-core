page { height: 100%; }
.ct-trade { position: fixed; left: 0; right: 0; top: 0; z-index: 10; display: flex; flex-direction: row; align-items: center; background: #ffffff; padding: 16rpx 24rpx; border-bottom: 1rpx solid #eceef1; }
.ct-cover { width: 96rpx; height: 96rpx; border-radius: 12rpx; margin-right: 18rpx; flex-shrink: 0; }
.ct-title { display: block; font-size: 26rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; margin-bottom: 6rpx; }
.ct-st { margin-left: 16rpx; }
.ct-buy { background: #ffda44; font-size: 24rpx; font-weight: bold; padding: 12rpx 24rpx; border-radius: 30rpx; margin-left: 16rpx; flex-shrink: 0; }
.ct-list { position: fixed; left: 0; right: 0; top: 129rpx; bottom: calc(112rpx + env(safe-area-inset-bottom)); padding: 0 24rpx; box-sizing: border-box; }
.ct-tip { margin: 24rpx 40rpx; font-size: 22rpx; color: #9aa0a8; text-align: center; background: #eceef1; border-radius: 12rpx; padding: 12rpx; }
.ct-sys { text-align: center; font-size: 22rpx; color: #8a9099; margin: 16rpx 0 4rpx; }
.ct-row { display: flex; flex-direction: row; align-items: flex-start; margin-top: 20rpx; }
.ct-row.me { flex-direction: row-reverse; }
.ct-bubble { max-width: 460rpx; margin: 0 16rpx; background: #ffffff; padding: 18rpx 22rpx; border-radius: 16rpx; font-size: 28rpx; line-height: 1.5; }
.ct-row.me .ct-bubble { background: #ffe680; }
.ct-offer { margin: 0 16rpx; background: #ffffff; border-radius: 16rpx; padding: 20rpx 24rpx; width: 300rpx; display: flex; flex-direction: column; border: 2rpx solid #ffe08a; }
.ct-ol { font-size: 22rpx; color: #8a9099; }
.ct-op { font-size: 40rpx; font-weight: bold; color: #ff4d2d; margin: 6rpx 0; }
.ct-os { font-size: 22rpx; }
.os-accepted { color: #1a8f5a; }
.os-declined { color: #9aa0a8; }
.os-pending, .os-counter { color: #b26a00; }
.ct-ob { margin-top: 14rpx; background: #ffda44; text-align: center; padding: 10rpx 0; border-radius: 24rpx; font-size: 24rpx; font-weight: bold; }
.ct-time { display: block; font-size: 20rpx; color: #b3b8bf; text-align: center; margin-top: 6rpx; }
.ct-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #f7f8fa; border-top: 1rpx solid #e6e8eb; display: flex; flex-direction: row; align-items: center; padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom)); }
.ct-offbtn { font-size: 26rpx; color: #b26a00; background: #fff4d6; padding: 14rpx 22rpx; border-radius: 30rpx; }
.ct-input { flex: 1; background: #ffffff; height: 72rpx; border-radius: 36rpx; padding: 0 24rpx; margin: 0 16rpx; font-size: 28rpx; }
.ct-send { font-size: 26rpx; color: #9aa0a8; padding: 14rpx 20rpx; border-radius: 30rpx; background: #e6e8eb; }
.ct-send.on { background: #ffda44; color: #1f2329; font-weight: bold; }
.ct-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.45); z-index: 90; }
.ct-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 91; background: #ffffff; border-radius: 28rpx 28rpx 0 0; padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; }
.ct-sh { font-size: 32rpx; font-weight: bold; margin-bottom: 8rpx; }
.ct-quick { margin: 24rpx 0 16rpx; }
.ct-q { flex: 1; text-align: center; margin-right: 16rpx; padding: 14rpx 0; border-radius: 12rpx; background: #f4f5f7; font-size: 26rpx; }
.ct-oin { height: 84rpx; background: #f4f5f7; border-radius: 12rpx; padding: 0 20rpx; font-size: 30rpx; margin-bottom: 28rpx; }
