.fv-t { display: block; font-size: 28rpx; margin-bottom: 12rpx; line-height: 1.4; }
.fv-tag { margin-left: 12rpx; }
.fv-seller { margin-top: 14rpx; }
.fv-av { width: 36rpx; height: 36rpx; border-radius: 18rpx; margin-right: 10rpx; }
