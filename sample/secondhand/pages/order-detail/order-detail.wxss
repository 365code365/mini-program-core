.dt-head { background: #1f2329; padding: 40rpx 32rpx; display: flex; flex-direction: column; }
.dt-st { color: #ffda44; font-size: 40rpx; font-weight: bold; }
.dt-sub { color: rgba(255, 255, 255, 0.75); font-size: 24rpx; margin-top: 10rpx; }
.dt-steps { justify-content: space-between; }
.dt-step { flex: 1; display: flex; flex-direction: column; align-items: center; }
.dt-dot { width: 44rpx; height: 44rpx; border-radius: 22rpx; background: #e6e8eb; color: #9aa0a8; font-size: 22rpx; display: flex; align-items: center; justify-content: center; }
.dt-dot.on { background: #ffda44; color: #1f2329; font-weight: bold; }
.dt-sn { font-size: 22rpx; color: #9aa0a8; margin-top: 10rpx; }
.dt-sn.on { color: #1f2329; }
.dt-exp { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #f0f1f4; font-size: 26rpx; }
.dt-an { display: block; font-weight: bold; margin-bottom: 6rpx; }
.dt-seller { padding-bottom: 20rpx; margin-bottom: 20rpx; border-bottom: 1rpx solid #f0f1f4; }
.dt-sname { margin-left: 16rpx; }
.dt-cover { width: 120rpx; height: 120rpx; border-radius: 12rpx; margin-right: 20rpx; }
.dt-t { display: block; font-size: 26rpx; margin-bottom: 10rpx; }
.dt-kv { padding: 12rpx 0; font-size: 26rpx; }
.dt-rt { display: block; font-weight: bold; margin-bottom: 12rpx; }
.dt-stars { margin-bottom: 16rpx; }
.dt-star { font-size: 52rpx; color: #e6e8eb; margin-right: 12rpx; }
.dt-star.on { color: #ffb400; }
.dt-in { background: #f4f5f7; height: 72rpx; border-radius: 12rpx; padding: 0 20rpx; font-size: 26rpx; margin-bottom: 24rpx; }
.dt-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #ffffff; display: flex; flex-direction: row; justify-content: flex-end; align-items: center; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05); }
.dt-ok { width: 220rpx; height: 64rpx; font-size: 26rpx; margin-left: 16rpx; }
