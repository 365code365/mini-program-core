.head { background: #ffda44; padding: 16rpx 24rpx 28rpx; }
.search { height: 72rpx; background: #ffffff; border-radius: 36rpx; display: flex; flex-direction: row; align-items: center; padding: 0 8rpx 0 24rpx; }
.s-ic { width: 22rpx; height: 22rpx; border: 4rpx solid #8a9099; border-radius: 50%; margin-right: 14rpx; }
.s-ph { flex: 1; color: #a3a8b0; font-size: 26rpx; }
.s-btn { background: #1f2329; color: #ffda44; font-size: 24rpx; height: 56rpx; line-height: 56rpx; padding: 0 26rpx; border-radius: 28rpx; }
.cats { background: #ffffff; margin: -12rpx 24rpx 0; border-radius: 20rpx; padding: 20rpx 0 4rpx; display: flex; flex-direction: row; flex-wrap: wrap; }
.cat { width: 25%; display: flex; flex-direction: column; align-items: center; margin-bottom: 18rpx; }
.cat-ic { width: 84rpx; height: 84rpx; }
.cat-tx { font-size: 22rpx; color: #4e5560; margin-top: 8rpx; }
.tabs { display: flex; flex-direction: row; align-items: center; padding: 26rpx 24rpx 8rpx; }
.tab { font-size: 28rpx; color: #6b7280; margin-right: 34rpx; padding-bottom: 6rpx; border-bottom: 6rpx solid transparent; }
.tab-on { color: #1f2329; font-weight: bold; font-size: 30rpx; border-bottom-color: #ffda44; }
.tab-tip { margin-left: auto; font-size: 20rpx; color: #b3b8bf; }
.feed { display: flex; flex-direction: row; padding: 0 16rpx; align-items: flex-start; }
.col-w { flex: 1; min-width: 0; padding: 0 8rpx; }
.fcard { background: #ffffff; border-radius: 16rpx; overflow: hidden; margin-top: 16rpx; }
.cimg { width: 100%; display: block; background: #eef0f3; opacity: 0; transition: opacity 0.4s ease; }
.cimg.on { opacity: 1; }
.cbody { padding: 14rpx 16rpx 18rpx; }
.ctitle { font-size: 26rpx; line-height: 36rpx; max-height: 72rpx; overflow: hidden; color: #1f2329; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.ctags { margin: 10rpx 0 8rpx; }
.price { font-size: 32rpx; }
.cseller { margin-top: 12rpx; }
.cav { width: 36rpx; height: 36rpx; border-radius: 50%; margin-right: 10rpx; }
.cname { font-size: 22rpx; color: #8a9099; }
.expose { text-align: center; font-size: 20rpx; color: #c4c8ce; }
.top-btn { position: fixed; right: 28rpx; bottom: calc(150rpx + env(safe-area-inset-bottom)); width: 84rpx; height: 84rpx; border-radius: 50%; background: #ffffff; box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.12); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.top-arrow { width: 18rpx; height: 18rpx; border-top: 4rpx solid #1f2329; border-left: 4rpx solid #1f2329; transform: rotate(45deg); margin-top: 8rpx; }
.top-tx { font-size: 18rpx; color: #1f2329; }
