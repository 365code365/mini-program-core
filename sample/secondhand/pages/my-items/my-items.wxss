.os-tabs { display: flex; flex-direction: row; background: #ffffff; }
.os-tab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: #6b7280; }
.os-tab.on { color: #1f2329; font-weight: bold; border-bottom: 6rpx solid #ffda44; }
.mi-cover { width: 160rpx; height: 160rpx; border-radius: 12rpx; margin-right: 20rpx; flex-shrink: 0; }
.mi-t { display: block; font-size: 28rpx; margin-bottom: 10rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.mi-ops { justify-content: flex-end; margin-top: 20rpx; }
.mi-dis { color: #b3b8bf; border-color: #eceef1; }
