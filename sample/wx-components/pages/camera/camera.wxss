.cam { width: 100%; height: 600rpx; background: #000; }
.kv { display: flex; flex-direction: row; justify-content: space-between; padding: 10rpx 0; font-size: 24rpx; }
.k { color: #8a8f99; }
.v { color: #1f2329; max-width: 520rpx; text-align: right; word-break: break-all; }
.err { display: block; margin-top: 8rpx; font-size: 24rpx; color: #e64340; }
.shot { width: 100%; height: 360rpx; margin-top: 12rpx; background: #f4f5f7; border-radius: 12rpx; }
