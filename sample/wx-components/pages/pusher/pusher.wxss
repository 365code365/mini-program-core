.pusher { width: 100%; height: 520rpx; background-color: #000; }
.url { height: 72rpx; padding: 0 16rpx; margin-bottom: 8rpx; font-size: 26rpx; background: #f4f5f7; border-radius: 10rpx; }
.state { margin-top: 8rpx; padding: 12rpx 16rpx; font-size: 24rpx; color: #8a8f99; background: #f4f5f7; border-radius: 10rpx; }
.state-on { color: #e64340; background: #fdeeee; font-weight: bold; }
.kv { display: flex; flex-direction: row; justify-content: space-between; padding: 10rpx 0; font-size: 24rpx; }
.k { color: #8a8f99; }
.v { color: #1f2329; }
.shot { width: 100%; height: 300rpx; margin-top: 12rpx; background: #f4f5f7; border-radius: 12rpx; }
