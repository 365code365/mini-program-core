page { background: #f4f6fa; color: #1d2330; font-size: 28rpx; }
.card { background: #ffffff; border-radius: 20rpx; margin: 24rpx 24rpx 0; padding: 28rpx; box-shadow: 0 4rpx 16rpx rgba(31, 60, 120, 0.05); }
.sec-title { font-size: 32rpx; font-weight: bold; color: #1d2330; }
.muted { color: #8a93a3; font-size: 24rpx; }
.row { display: flex; flex-direction: row; align-items: center; }
.between { justify-content: space-between; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 48rpx; display: flex; align-items: center; justify-content: center; color: #ffffff; font-size: 38rpx; font-weight: bold; flex-shrink: 0; }
.tag { font-size: 20rpx; color: #1f7cf0; background: #eaf2ff; padding: 4rpx 12rpx; border-radius: 8rpx; margin-right: 10rpx; }
.btn-primary { background: linear-gradient(90deg, #3b8cff, #1f7cf0); color: #ffffff; border-radius: 44rpx; height: 88rpx; line-height: 88rpx; text-align: center; font-size: 30rpx; font-weight: bold; }
.btn-primary.disabled { background: #c4cad4; }
.empty { padding: 120rpx 0; text-align: center; color: #a0a7b4; }
.safe-bottom { height: env(safe-area-inset-bottom); }
.chev { width: 14rpx; height: 14rpx; border-top: 3rpx solid #b8bfca; border-right: 3rpx solid #b8bfca; transform: rotate(45deg); margin-left: 10rpx; flex-shrink: 0; }
.link { display: flex; flex-direction: row; align-items: center; color: #8a93a3; font-size: 24rpx; }
