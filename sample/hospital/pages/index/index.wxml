<view class="hero">
  <view class="search" bindtap="goDept">
    <view class="search-icon"></view>
    <text class="search-ph">搜索科室、医生、疾病</text>
  </view>
  <view class="hos">
    <view class="hos-logo"><text>仁</text></view>
    <view class="hos-info">
      <view class="row">
        <text class="hos-name">{{hospital.name}}</text>
      </view>
      <view class="row hos-tags">
        <text class="lv">{{hospital.level}}</text>
        <text class="hos-branch">{{hospital.branch}}</text>
      </view>
      <text class="hos-addr">{{hospital.address}}</text>
    </view>
    <view class="hos-call" bindtap="callHos"><text>电话</text></view>
  </view>
  <view class="hos-hours"><text>{{hospital.hours}}</text></view>
</view>

<view class="grid card">
  <view class="cell" wx:for="{{entries}}" wx:key="key" data-key="{{item.key}}" bindtap="onEntry">
    <view class="cell-ic" style="background: {{item.bg}};"><text>{{item.ch}}</text></view>
    <text class="cell-tx">{{item.name}}</text>
  </view>
</view>

<view class="notice card row" bindtap="goOrders">
  <text class="notice-tag">提醒</text>
  <text class="notice-tx">{{noticeText}}</text>
  <view class="chev"></view>
</view>

<view class="banner-wrap"><swiper class="banner" autoplay="{{true}}" interval="4000" circular="{{true}}" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff">
  <swiper-item wx:for="{{banners}}" wx:key="title">
    <view class="banner-item" style="background: {{item.bg}};">
      <text class="b-title">{{item.title}}</text>
      <text class="b-sub">{{item.sub}}</text>
      <view class="b-btn"><text>{{item.btn}}</text></view>
      <view class="b-cross"><view class="cx"></view><view class="cy"></view></view>
    </view>
  </swiper-item>
</swiper></view>

<view class="card">
  <view class="row between">
    <text class="sec-title">推荐专家</text>
    <view class="link" bindtap="goDept"><text>全部科室</text><view class="chev"></view></view>
  </view>
  <scroll-view scroll-x="{{true}}" class="experts" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="expert" wx:for="{{experts}}" wx:key="id" data-id="{{item.id}}" bindtap="goDoctor">
      <view class="avatar" style="background: {{item.color}};"><text>{{item.sx}}</text></view>
      <text class="ex-name">{{item.name}}</text>
      <text class="ex-title">{{item.title}}</text>
      <text class="ex-dept">{{item.deptName}}</text>
    </view>
  </scroll-view>
</view>

<view class="card news">
  <text class="sec-title">健康资讯</text>
  <view class="news-item" wx:for="{{news}}" wx:key="id" data-title="{{item.title}}" bindtap="openNews">
    <view class="news-main">
      <text class="news-title">{{item.title}}</text>
      <view class="row news-meta">
        <text class="news-tag" style="color: {{item.color}}; border-color: {{item.color}};">{{item.tag}}</text>
        <text class="muted">{{item.read}} 阅读 · {{item.date}}</text>
      </view>
    </view>
    <view class="news-pic" style="background: linear-gradient(135deg, {{item.color}}, #b8e1ff);"><text>{{item.tag}}</text></view>
  </view>
</view>
<view style="height: 40rpx;"></view>
