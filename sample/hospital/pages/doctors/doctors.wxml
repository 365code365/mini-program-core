<view class="head">
  <view>
    <text class="h-name">{{head.name}}</text>
    <text class="h-desc">{{head.desc}}</text>
  </view>
  <view class="filters">
    <view class="f {{filter === item.key ? 'on' : ''}}" wx:for="{{filters}}" wx:key="key" data-key="{{item.key}}" bindtap="setFilter"><text>{{item.name}}</text></view>
  </view>
</view>
<view class="card doc" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
  <view class="avatar" style="background: linear-gradient(135deg, {{item.color}}, #9fd0ff);"><text>{{item.sx}}</text></view>
  <view class="doc-main">
    <view class="row">
      <text class="doc-name">{{item.name}}</text>
      <text class="doc-title">{{item.title}}</text>
      <text wx:if="{{mode !== 'dept'}}" class="doc-dept">{{item.deptName}}</text>
    </view>
    <view class="row tags" wx:if="{{item.tags.length}}">
      <text class="tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="t">{{t}}</text>
    </view>
    <text class="good">擅长：{{item.good}}</text>
    <view class="row between foot">
      <text class="muted foot-t">好评 {{item.rate}}% · 接诊 {{item.visitsText}}</text>
      <text class="fee-t">¥{{item.fee}}</text>
      <view class="left {{item.left ? '' : 'none'}}"><text>{{item.left ? (mode === 'today' ? '今日余 ' : '余号 ') + item.left : '已约满'}}</text></view>
    </view>
  </view>
</view>
<view wx:if="{{!list.length}}" class="empty">
  <text>{{emptyText}}</text>
  <view wx:if="{{mode !== 'dept'}}" class="btn-primary empty-btn" bindtap="goDept"><text>按科室预约</text></view>
</view>
<view style="height: 40rpx;"></view>
