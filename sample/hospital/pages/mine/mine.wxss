.hd { background: linear-gradient(160deg, #1f7cf0, #36b6e8); padding: 40rpx 32rpx 32rpx; }
.me-av { width: 112rpx; height: 112rpx; border-radius: 56rpx; background: rgba(255,255,255,0.25); border: 4rpx solid rgba(255,255,255,0.6); color: #fff; font-size: 44rpx; font-weight: bold; display: flex; align-items: center; justify-content: center; }
.me-main { flex: 1; margin-left: 24rpx; display: flex; flex-direction: column; }
.me-name { font-size: 36rpx; font-weight: bold; color: #ffffff; }
.me-sub { margin-top: 8rpx; font-size: 24rpx; color: rgba(255,255,255,0.85); }
.qr { width: 64rpx; height: 64rpx; position: relative; }
.qr-a, .qr-b, .qr-c { position: absolute; width: 22rpx; height: 22rpx; border: 5rpx solid #ffffff; border-radius: 4rpx; }
.qr-a { left: 0; top: 0; } .qr-b { right: 0; top: 0; } .qr-c { left: 0; bottom: 0; }
.qr-d { position: absolute; right: 4rpx; bottom: 4rpx; width: 18rpx; height: 18rpx; background: #ffffff; border-radius: 3rpx; }
.nums { display: flex; flex-direction: row; margin-top: 36rpx; background: rgba(255,255,255,0.15); border-radius: 20rpx; padding: 22rpx 0; }
.num { flex: 1; display: flex; flex-direction: column; align-items: center; }
.n-v { font-size: 36rpx; font-weight: bold; color: #ffffff; }
.n-k { margin-top: 4rpx; font-size: 22rpx; color: rgba(255,255,255,0.85); }
.menu { padding: 0 28rpx; }
.m-item { display: flex; flex-direction: row; align-items: center; height: 108rpx; border-bottom: 1rpx solid #f0f2f5; }
.m-item:last-child { border-bottom: none; }
.m-ic { width: 56rpx; height: 56rpx; border-radius: 16rpx; color: #fff; font-size: 26rpx; font-weight: bold; display: flex; align-items: center; justify-content: center; }
.m-tx { flex: 1; margin-left: 20rpx; font-size: 28rpx; color: #1d2330; }
.m-extra { font-size: 24rpx; color: #a0a7b4; }
.ver { display: block; text-align: center; margin: 48rpx 0; font-size: 22rpx; color: #b8bec8; }
