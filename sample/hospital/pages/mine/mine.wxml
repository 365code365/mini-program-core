<view class="hd">
  <view class="row">
    <view class="me-av"><text>{{me.sx}}</text></view>
    <view class="me-main">
      <text class="me-name">{{me.name}}</text>
      <text class="me-sub">就诊卡 {{me.card}}</text>
    </view>
    <view class="qr-btn" bindtap="showCard">
      <view class="qr"><view class="qr-a"></view><view class="qr-b"></view><view class="qr-c"></view><view class="qr-d"></view></view>
      <text class="qr-tx">就诊卡</text>
    </view>
  </view>
  <view class="nums">
    <view class="num" bindtap="goOrders"><text class="n-v">{{waitCount}}</text><text class="n-k">待就诊</text></view>
    <view class="num" bindtap="goPatients"><text class="n-v">{{patientCount}}</text><text class="n-k">就诊人</text></view>
    <view class="num" bindtap="goFollow"><text class="n-v">{{followCount}}</text><text class="n-k">关注医生</text></view>
    <view class="num" bindtap="goReports"><text class="n-v">{{reportCount}}</text><text class="n-k">电子报告</text></view>
  </view>
</view>
<view class="card menu">
  <view class="m-item" wx:for="{{menus}}" wx:key="key" data-key="{{item.key}}" bindtap="onMenu">
    <view class="m-ic" style="background: {{item.bg}};"><text>{{item.ch}}</text></view>
    <text class="m-tx">{{item.name}}</text>
    <text class="m-extra">{{item.extra}}</text>
    <view class="chev"></view>
  </view>
</view>
<view class="card menu">
  <view class="m-item">
    <view class="m-ic" style="background: linear-gradient(135deg, #ffb26b, #ff8240);"><text>提</text></view>
    <text class="m-tx">就诊前一天提醒</text>
    <switch checked="{{remind}}" color="#1f7cf0" bindchange="onRemind" />
  </view>
  <view class="m-item m-navi" bindtap="goNavi">
    <view class="m-ic" style="background: linear-gradient(135deg, #7fd88e, #13a8a8);"><text>导</text></view>
    <text class="m-tx">医院导航</text>
    <text class="m-extra">交通与院内楼层</text>
    <view class="chev"></view>
  </view>
  <view class="m-item m-call" bindtap="callService">
    <view class="m-ic" style="background: linear-gradient(135deg, #63c2ff, #2a9df4);"><text>客</text></view>
    <text class="m-tx">客服热线</text>
    <text class="m-extra">021-6438 2200</text>
    <view class="chev"></view>
  </view>
</view>
<text class="ver">健康挂号 v2.6.0 · 华康仁和医院官方服务</text>
<view wx:if="{{cardOpen}}" class="mask" bindtap="closeCard"></view>
<view wx:if="{{cardOpen}}" class="sheet" catchtap="noop">
  <view class="row between">
    <text class="sec-title">电子就诊卡</text>
    <text class="muted">到院自助机、诊室扫码使用</text>
  </view>
  <view class="people">
    <view class="person {{cardIdx === index ? 'on' : ''}}" wx:for="{{cardList}}" wx:key="id" data-i="{{index}}" bindtap="pickCard"><text class="person-tx">{{item.name}}</text></view>
  </view>
  <view class="ecard">
    <view class="big-qr">
      <view class="qf qf1"><view class="qi"></view></view>
      <view class="qf qf2"><view class="qi"></view></view>
      <view class="qf qf3"><view class="qi"></view></view>
      <view class="qd" wx:for="{{qr}}" wx:key="k" style="left: {{item.x}}rpx; top: {{item.y}}rpx;"></view>
    </view>
    <text class="ec-name">{{cardList[cardIdx].name}}（{{cardList[cardIdx].relation}}）</text>
    <text class="ec-no">{{cardList[cardIdx].card}}</text>
  </view>
  <view class="btn-primary card-ok" bindtap="closeCard"><text>完成</text></view>
</view>
