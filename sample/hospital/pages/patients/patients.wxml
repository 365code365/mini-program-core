<view class="tip"><text>已添加 {{list.length}}/{{max}} 位就诊人，就诊人信息需与身份证一致。点一位可编辑、设为默认或删除</text></view>
<view class="card pt" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onItem">
  <view class="pt-av" style="background: {{item.gender === '女' ? 'linear-gradient(135deg, #ff9fb5, #f2557a)' : 'linear-gradient(135deg, #5aa2ff, #1f7cf0)'}};"><text>{{item.sx}}</text></view>
  <view class="pt-main">
    <view class="row">
      <text class="pt-name">{{item.name}}</text>
      <text class="tag">{{item.relation}}</text>
      <text class="def" wx:if="{{item.isDefault}}">默认</text>
    </view>
    <text class="muted">{{item.gender}}{{item.birth ? ' · ' + item.birth : ''}} · 手机 {{item.phone}}</text>
    <text class="muted">身份证 {{item.idcard}}</text>
    <text class="muted">就诊卡 {{item.card}}</text>
  </view>
  <view class="chev"></view>
</view>
<view class="btn-primary add {{list.length >= max ? 'disabled' : ''}}" bindtap="goAdd"><text>{{list.length >= max ? '已达 ' + max + ' 位上限' : '+ 添加就诊人'}}</text></view>
<view style="height: 60rpx;"></view>
