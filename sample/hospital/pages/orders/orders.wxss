.tabs { display: flex; flex-direction: row; background: #ffffff; height: 88rpx; }
.tab { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 28rpx; color: #5a6475; position: relative; }
.tab.on { color: #1f7cf0; font-weight: bold; }
.tab-line { position: absolute; bottom: 8rpx; width: 48rpx; height: 6rpx; border-radius: 3rpx; background: #1f7cf0; }
.o-head { padding-bottom: 20rpx; border-bottom: 1rpx solid #eef0f4; }
.o-date { font-size: 28rpx; font-weight: bold; color: #1d2330; }
.o-st { font-size: 24rpx; }
.st-wait { color: #1f7cf0; }
.st-done { color: #13a8a8; }
.st-cancel { color: #a0a7b4; }
.o-body { padding-top: 20rpx; align-items: flex-start; }
.o-no { width: 112rpx; height: 112rpx; border-radius: 16rpx; background: #eaf2ff; display: flex; flex-direction: row; align-items: baseline; justify-content: center; padding-top: 22rpx; box-sizing: border-box; margin-right: 22rpx; flex-shrink: 0; }
.o-no-v { font-size: 48rpx; font-weight: bold; color: #1f7cf0; }
.o-no-k { font-size: 22rpx; color: #1f7cf0; margin-left: 4rpx; }
.o-main { flex: 1; display: flex; flex-direction: column; }
.o-dept { font-size: 28rpx; color: #1d2330; margin-bottom: 8rpx; }
.o-main .muted { margin-top: 4rpx; }
.o-foot { display: flex; flex-direction: row; justify-content: flex-end; margin-top: 24rpx; }
.o-btn { height: 60rpx; width: 168rpx; border-radius: 30rpx; border: 2rpx solid #d5dae2; color: #3a4252; font-size: 24rpx; display: flex; align-items: center; justify-content: center; margin-left: 20rpx; box-sizing: border-box; }
.o-btn.pri { border-color: #1f7cf0; color: #1f7cf0; }
.empty-box { display: flex; flex-direction: column; align-items: center; padding-top: 160rpx; }
.empty-ic { width: 160rpx; height: 190rpx; border-radius: 20rpx; background: #e3ecfa; position: relative; }
.e1, .e2, .e3 { position: absolute; left: 32rpx; height: 12rpx; border-radius: 6rpx; background: #bcd0f0; }
.e1 { top: 48rpx; width: 96rpx; } .e2 { top: 84rpx; width: 96rpx; } .e3 { top: 120rpx; width: 60rpx; }
.empty-tx { margin-top: 28rpx; color: #a0a7b4; font-size: 26rpx; }
.empty-btn { margin-top: 36rpx; width: 280rpx; height: 76rpx; line-height: 76rpx; font-size: 28rpx; }
