.page { height: 100vh; display: flex; flex-direction: column; background: #ffffff; }
.top { padding: 16rpx 24rpx; background: #ffffff; border-bottom: 1rpx solid #eef0f4; }
.search { height: 72rpx; background: #f2f4f8; border-radius: 36rpx; display: flex; flex-direction: row; align-items: center; padding: 0 28rpx; }
.search-icon { width: 22rpx; height: 22rpx; border: 4rpx solid #8a93a3; border-radius: 50%; margin-right: 14rpx; flex-shrink: 0; }
.search-in { flex: 1; height: 72rpx; font-size: 26rpx; padding: 0 0 0 1rpx; }
.clear { color: #1f7cf0; font-size: 26rpx; margin-left: 16rpx; }
.body { flex: 1; display: flex; flex-direction: row; min-height: 0; }
.left { width: 200rpx; height: 100%; background: #f5f7fa; }
.l-item { height: 104rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #5a6475; position: relative; }
.l-item.on { background: #ffffff; color: #1f7cf0; font-weight: bold; }
.l-bar { position: absolute; left: 0; top: 34rpx; width: 8rpx; height: 36rpx; border-radius: 0 6rpx 6rpx 0; background: #1f7cf0; }
.right { flex: 1; height: 100%; }
.sec { padding: 0 32rpx; }
.sec-h { display: block; padding: 32rpx 0 8rpx; font-size: 26rpx; color: #8a93a3; }
.d-item { display: flex; flex-direction: row; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.d-main { flex: 1; display: flex; flex-direction: column; }
.d-name { font-size: 30rpx; color: #1d2330; font-weight: bold; }
.d-desc { margin-top: 8rpx; font-size: 24rpx; color: #8a93a3; }
.result { flex: 1; padding: 0 32rpx; }
.r-item { padding: 28rpx 0; border-bottom: 1rpx solid #f0f2f5; display: flex; flex-direction: column; }
.r-name { font-size: 30rpx; font-weight: bold; color: #1d2330; }
.r-group { font-size: 22rpx; color: #1f7cf0; background: #eaf2ff; border-radius: 6rpx; padding: 2rpx 10rpx; margin-left: 12rpx; }
.r-desc { margin-top: 8rpx; font-size: 24rpx; color: #8a93a3; }
