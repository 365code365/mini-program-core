.head { margin: 24rpx 24rpx 0; padding: 32rpx; border-radius: 24rpx; background: linear-gradient(160deg, #3b8cff, #1f7cf0); color: #ffffff; }
.h-status { font-size: 40rpx; font-weight: bold; }
.h-no { font-size: 30rpx; font-weight: bold; color: #ffe08a; }
.h-tip { display: block; margin-top: 8rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.85); line-height: 36rpx; }
.h-steps { margin-top: 28rpx; }
.h-step { flex: 1; margin-right: 8rpx; font-size: 22rpx; color: rgba(255, 255, 255, 0.55); }
.h-step:last-child { margin-right: 0; }
.h-step-tx { white-space: nowrap; }
.h-bar { height: 8rpx; border-radius: 4rpx; background: rgba(255, 255, 255, 0.25); margin-bottom: 8rpx; }
.h-step-on { color: #ffffff; font-weight: bold; }
.h-step-on .h-bar { background: #ffe08a; }
.queue { margin-top: 24rpx; padding: 16rpx 20rpx; border-radius: 14rpx; background: rgba(255, 255, 255, 0.16); align-items: baseline; }
.q-k { font-size: 24rpx; color: rgba(255, 255, 255, 0.9); }
.q-v { font-size: 44rpx; font-weight: bold; color: #ffe08a; margin: 0 8rpx; }
.code { align-items: center; }
.qr { width: 212rpx; height: 212rpx; position: relative; background: #ffffff; border: 2rpx solid #e6ebf3; border-radius: 12rpx; flex-shrink: 0; box-sizing: border-box; }
.qf { position: absolute; width: 60rpx; height: 60rpx; border: 10rpx solid #1d2330; box-sizing: border-box; border-radius: 6rpx; }
.qi { position: absolute; left: 10rpx; top: 10rpx; width: 20rpx; height: 20rpx; background: #1d2330; }
.qf1 { left: 16rpx; top: 16rpx; }
.qf2 { left: 136rpx; top: 16rpx; }
.qf3 { left: 16rpx; top: 136rpx; }
.qd { position: absolute; width: 20rpx; height: 20rpx; background: #1d2330; }
.code-r { flex: 1; margin-left: 28rpx; display: flex; flex-direction: column; min-width: 0; }
.code-t { font-size: 30rpx; font-weight: bold; color: #1d2330; }
.code-s { margin-top: 8rpx; line-height: 34rpx; }
.code-no { margin-top: 16rpx; font-size: 24rpx; color: #1f7cf0; }
.kv { display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 18rpx 0 0; }
.k { font-size: 26rpx; color: #8a93a3; flex-shrink: 0; margin-right: 24rpx; }
.v { font-size: 26rpx; color: #1d2330; text-align: right; }
.desc { max-width: 460rpx; }
.price { color: #ff5a36; font-weight: bold; }
.go { margin-left: 12rpx; font-size: 22rpx; color: #13a8a8; background: #e8f8f6; padding: 2rpx 12rpx; border-radius: 16rpx; }
.copy { margin-left: 12rpx; font-size: 22rpx; color: #1f7cf0; border: 1rpx solid #b8d3fb; padding: 0 12rpx; border-radius: 16rpx; line-height: 34rpx; }
.b-st { font-size: 24rpx; color: #13a8a8; }
.b-unpaid { color: #ff5a36; }
.b-ops { justify-content: flex-end; margin-top: 20rpx; }
.mini { height: 56rpx; padding: 0 28rpx; border-radius: 28rpx; border: 2rpx solid #d5dae2; color: #3a4252; font-size: 24rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.mini.pri { border-color: #1f7cf0; color: #1f7cf0; }
.bar { position: fixed; left: 0; right: 0; bottom: 0; background: #ffffff; padding: 20rpx 32rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: row; align-items: center; box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05); }
.bar-btn { flex: 1; height: 84rpx; border-radius: 42rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: bold; }
.ghost { border: 2rpx solid #d5dae2; color: #3a4252; box-sizing: border-box; font-weight: normal; margin-right: 20rpx; }
.empty { padding-top: 240rpx; }
.buy { margin-left: 12rpx; font-size: 22rpx; color: #12a37f; border: 1rpx solid #9fdcc9; padding: 0 12rpx; border-radius: 16rpx; line-height: 34rpx; }
