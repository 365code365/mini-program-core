<view wx:if="{{svc}}">
  <image class="cover" src="{{svc.cover}}" mode="aspectFill"></image>
  <view class="card head">
    <text class="name">{{svc.name}}</text>
    <text class="desc">{{svc.desc}}</text>
    <view class="row between">
      <view class="row">
        <text class="price big">¥{{svc.price}}</text>
        <text class="mp" bindtap="goMember">{{levelName}} ¥{{memberPrice}}</text>
      </view>
      <text class="muted">{{svc.duration}} 分钟 · 已售 {{svc.sold}}</text>
    </view>
  </view>

  <view class="card">
    <view class="sec-head"><text class="sec-title">服务流程</text><text class="sec-more">约 {{svc.duration}} 分钟</text></view>
    <view class="step row" wx:for="{{steps}}" wx:key="*this">
      <view class="dot">{{index + 1}}</view>
      <text class="flex1">{{item}}</text>
    </view>
  </view>

  <view class="card">
    <view class="sec-head"><text class="sec-title">可选发型师</text><text class="sec-more">{{stylists.length}} 位</text></view>
    <view class="sty row" wx:for="{{stylists}}" wx:key="id" data-id="{{item.id}}" bindtap="goStylist" hover-class="press">
      <image class="av" src="{{item.avatar}}"></image>
      <view class="flex1">
        <view class="row"><text class="sn">{{item.name}}</text><text class="tag">{{item.title}}</text></view>
        <view class="row sr"><rating-stars value="{{item.rating}}" size="22" show-score="{{true}}"></rating-stars><text class="muted"> · 从业 {{item.years}} 年</text></view>
      </view>
      <view class="btn-line" data-id="{{item.id}}" catchtap="bookWith">约TA</view>
    </view>
  </view>

  <view class="card">
    <view class="sec-head"><text class="sec-title">预约须知</text></view>
    <view class="nt row" wx:for="{{notices}}" wx:key="*this"><icon type="info" size="14" color="#c0846a"></icon><text class="flex1 nt-tx">{{item}}</text></view>
  </view>

  <view class="card" wx:if="{{related.length}}">
    <view class="sec-head"><text class="sec-title">同类项目</text></view>
    <view class="rel row between" wx:for="{{related}}" wx:key="id" data-id="{{item.id}}" bindtap="goRelated" hover-class="press">
      <text>{{item.name}}</text>
      <view class="row"><text class="price">¥{{item.price}}</text><view class="chev"></view></view>
    </view>
  </view>
  <view style="height: 160rpx;"></view>

  <view class="bar row">
    <view class="flex1">
      <text class="price big">¥{{svc.price}}</text>
      <text class="muted"> 到店支付或储值卡抵扣</text>
    </view>
    <view class="btn-main bar-btn" hover-class="press" bindtap="book">立即预约</view>
  </view>
</view>
