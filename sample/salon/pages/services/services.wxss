.top { background: #ffffff; padding: 20rpx 0 4rpx; }
.search { margin: 0 24rpx 16rpx; background: #f6efea; border-radius: 36rpx; height: 72rpx; padding: 0 12rpx 0 28rpx; }
.s-in { font-size: 26rpx; height: 72rpx; }
.s-clear { font-size: 24rpx; color: #a39189; padding: 0 16rpx; }
.s-btn { font-size: 24rpx; color: #ffffff; background: #c0846a; border-radius: 28rpx; padding: 10rpx 24rpx; }
.cats { width: 100%; white-space: nowrap; }
.cat-row { display: flex; flex-direction: row; padding: 0 16rpx 16rpx; }
.cat { flex-shrink: 0; padding: 10rpx 30rpx; margin: 0 8rpx; font-size: 26rpx; color: #6f625c; border-radius: 30rpx; background: #f6efea; }
.cat-on { background: #2d2430; color: #f3d9c6; font-weight: bold; }
.item { align-items: flex-start; }
.cover { width: 168rpx; height: 168rpx; border-radius: 16rpx; margin-right: 24rpx; flex-shrink: 0; }
.name { font-size: 30rpx; font-weight: bold; }
.hot { font-size: 20rpx; color: #ffffff; background: #e86a4f; border-radius: 6rpx; padding: 2rpx 8rpx; margin-left: 12rpx; }
.desc { display: block; font-size: 24rpx; color: #6f625c; margin: 8rpx 0; line-height: 1.45; }
.foot { margin-top: 10rpx; }
.mp { font-size: 22rpx; color: #8a6a3a; background: #f8ecd6; border-radius: 6rpx; padding: 2rpx 8rpx; margin-left: 12rpx; }
.btn-book { font-size: 24rpx; color: #ffffff; background: #c0846a; border-radius: 26rpx; padding: 8rpx 28rpx; }
