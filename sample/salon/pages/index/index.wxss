.hero { position: relative; height: 360rpx; }
.hero-img { width: 750rpx; height: 360rpx; }
.hero-mask { position: absolute; left: 0; right: 0; bottom: 0; height: 200rpx; background: linear-gradient(180deg, rgba(45, 36, 48, 0), rgba(45, 36, 48, 0.85)); }
.hero-tx { position: absolute; left: 32rpx; bottom: 56rpx; display: flex; flex-direction: column; }
.hero-name { color: #ffffff; font-size: 40rpx; font-weight: bold; }
.hero-sub { margin-top: 10rpx; }
.hero-rv { color: #f3d9c6; font-size: 22rpx; margin-left: 16rpx; }
.info { margin-top: -32rpx; position: relative; }
.info-line { margin-bottom: 14rpx; font-size: 26rpx; }
.info-k { color: #a39189; width: 72rpx; flex-shrink: 0; }
.info-addr { line-height: 1.4; }
.info-open { color: #3aa776; font-size: 22rpx; }
.tags { flex-wrap: wrap; margin-top: 4rpx; }
.tags .tag { margin-bottom: 8rpx; }
.info-btns { margin-top: 16rpx; }
.ib { flex: 1; margin-right: 16rpx; height: 64rpx; line-height: 64rpx; text-align: center; font-size: 26rpx; border-radius: 32rpx; background: #f6efea; color: #6f4a3a; }
.ib-main { background: #c0846a; color: #ffffff; margin-right: 0; }
.next { display: flex; flex-direction: row; align-items: center; background: #fff7f1; border: 2rpx solid #f3d9c6; }
.next-tx { display: flex; flex-direction: column; margin-left: 20rpx; }
.next-t { font-size: 28rpx; font-weight: bold; margin-bottom: 6rpx; }
.grid { display: flex; flex-direction: row; padding: 24rpx 8rpx; }
.g { flex: 1; display: flex; flex-direction: column; align-items: center; font-size: 24rpx; color: #4a3d40; }
.g-ic { width: 88rpx; height: 88rpx; border-radius: 28rpx; margin-bottom: 12rpx; }
.works { height: 520rpx; }
.work { margin: 20rpx 12rpx; height: 480rpx; border-radius: 20rpx; overflow: hidden; position: relative; transform: scale(0.94); }
.work-on { transform: scale(1); }
.work-img { width: 100%; height: 480rpx; }
.work-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 20rpx 24rpx; background: rgba(45, 36, 48, 0.55); display: flex; flex-direction: row; justify-content: space-between; }
.work-t { color: #ffffff; font-size: 28rpx; }
.work-by { color: #f3d9c6; font-size: 24rpx; }
.svc { padding: 16rpx 0; border-bottom: 1rpx solid #f3ece8; }
.svc-img { width: 132rpx; height: 132rpx; border-radius: 16rpx; margin-right: 20rpx; flex-shrink: 0; }
.svc-n { font-size: 30rpx; font-weight: bold; display: block; }
.svc-d { display: block; margin: 6rpx 0 10rpx; }
.sty-scroll { width: 100%; }
.sty-row { display: flex; flex-direction: row; }
.sty { width: 168rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; margin-right: 12rpx; }
.sty-av { width: 120rpx; height: 120rpx; border-radius: 60rpx; margin-bottom: 10rpx; }
.sty-n { font-size: 26rpx; font-weight: bold; margin-bottom: 4rpx; }
