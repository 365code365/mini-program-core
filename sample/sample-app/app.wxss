/* 商城 · 全局样式（app.wxss 对所有页面生效） */
page {
  background-color: #F5F5F5;
}

/* ── 二级页统一顶部返回栏 ──
   小程序里 navigationStyle:custom 时导航栏由页面自绘，这里做成全局可复用的一套。 */
.nav-bar {
  background-color: #FF6B35;
  padding: 0 24rpx;
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-title {
  flex: 1;
  font-size: 34rpx;
  color: #fff;
  font-weight: bold;
  text-align: center;
}
.nav-action {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-bar-light {
  background-color: #fff;
  border-bottom: 1rpx solid #EDEDED;
}
.nav-bar-light .nav-title {
  color: #1a1a1a;
}

/* ── 通用卡片 / 行 / 文本 ── */
.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
}
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.col {
  display: flex;
  flex-direction: column;
}
.grow {
  flex: 1;
}
.h1 {
  font-size: 34rpx;
  color: #1a1a1a;
  font-weight: bold;
}
.h2 {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}
.muted {
  font-size: 24rpx;
  color: #999;
}
.price {
  font-size: 34rpx;
  color: #FF6B35;
  font-weight: bold;
}
.divider {
  height: 1rpx;
  background-color: #EDEDED;
}
.tag-mini {
  font-size: 20rpx;
  color: #FF6B35;
  background-color: #FFF0EA;
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
  margin-right: 10rpx;
}
.pill {
  background-color: #F5F5F5;
  border-radius: 28rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 16rpx;
}
.pill-on {
  background-color: #FFF0EA;
  color: #FF6B35;
}
.bottom-space {
  height: 160rpx;
}
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-tip {
  font-size: 28rpx;
  color: #999;
  margin: 32rpx 0;
}

/* ── 全局动画：入场淡入上移 / 脉冲 / 旋转 / 弹窗弹出 ── */
@keyframes fadeUp { from { opacity: 0; transform: translateY(24rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes popIn { 0% { opacity: 0; transform: scale(0.82); } 60% { opacity: 1; transform: scale(1.04); } 100% { opacity: 1; transform: scale(1); } }
@keyframes pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.14); } }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes breathe { 0%,100% { opacity: .35; } 50% { opacity: 1; } }
@keyframes slideUp { from { transform: translateY(60rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

.anim-fade-up { animation: fadeUp .45s ease-out both; }
.anim-pop { animation: popIn .32s ease-out both; }
.anim-pulse { animation: pulse 1.1s ease-in-out infinite; }
.anim-slide-up { animation: slideUp .28s ease-out both; }
.loading-ring {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #F0F0F0;
  border-top-color: #FF6B35;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

/* ── 全屏遮罩 ── */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.55);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 900;
}
