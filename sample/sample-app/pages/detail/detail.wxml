<view class="page">
  <!-- 顶部返回栏（navigationStyle:custom 时由页面自绘） -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="onBack">
      <icon type="back" size="20" color="#ffffff"></icon>
    </view>
    <text class="nav-title">商品详情</text>
    <view class="nav-action" bindtap="onGoHome">
      <icon type="success_no_circle" size="18" color="#ffffff"></icon>
    </view>
  </view>

  <view wx:if="{{!product}}" class="empty-box">
    <view class="loading-ring"></view>
    <text class="empty-tip">加载中…</text>
  </view>

  <view wx:if="{{product}}">
    <!-- 商品图轮播 -->
    <swiper class="gallery" indicator-dots="{{true}}" autoplay="{{false}}" circular="{{true}}"
            indicator-color="rgba(0,0,0,0.2)" indicator-active-color="#FF6B35">
      <swiper-item wx:for="{{gallery}}" wx:key="*this">
        <image class="gallery-img" src="{{item}}" mode="aspectFill"></image>
      </swiper-item>
    </swiper>

    <!-- 价格区 -->
    <view class="price-card">
      <view class="row">
        <text class="now-price">¥{{product.price}}</text>
        <text class="old-price">¥{{product.originalPrice}}</text>
        <text class="discount-tag">{{product.discount}}</text>
      </view>
      <text class="prod-name">{{product.name}}</text>
      <text class="prod-desc">{{product.desc}}</text>
      <view class="row-between meta-line">
        <text class="muted">已售 {{product.sales}}</text>
        <text class="muted">库存 {{product.stock}}</text>
        <text class="muted">顺丰包邮</text>
      </view>
    </view>

    <!-- 规格 / 数量 -->
    <view class="card">
      <view class="row-between" bindtap="onOpenSpec">
        <text class="h2">选择规格</text>
        <view class="row">
          <text class="muted">{{selectedSpec}} · {{quantity}}件</text>
          <icon type="arrow_right" size="12" color="#999"></icon>
        </view>
      </view>
      <view class="divider spec-divider"></view>
      <view class="row-between">
        <text class="h2">服务保障</text>
        <view class="row">
          <text class="tag-mini">7天无理由</text>
          <text class="tag-mini">正品保证</text>
          <text class="tag-mini">极速退款</text>
        </view>
      </view>
    </view>

    <!-- 评价 -->
    <view class="card">
      <view class="row-between">
        <text class="h2">商品评价（{{reviews.length}}）</text>
        <view class="row">
          <text class="muted">好评率 98%</text>
          <icon type="arrow_right" size="12" color="#999"></icon>
        </view>
      </view>
      <view class="review" wx:for="{{reviews}}" wx:key="id">
        <view class="row">
          <image class="review-avatar" src="/assets/avatar1.jpg" mode="aspectFill"></image>
          <text class="review-name">{{item.name}}</text>
          <view class="row stars">
            <icon wx:for="{{item.stars}}" wx:for-item="s" wx:key="*this" type="star" size="12" color="#FFB400"></icon>
          </view>
        </view>
        <text class="review-text">{{item.text}}</text>
      </view>
    </view>

    <!-- 图文详情：rich-text 富文本 -->
    <view class="card">
      <text class="h2">图文详情</text>
      <rich-text class="rich" nodes="{{detailNodes}}"></rich-text>
      <image class="detail-img" src="{{product.image}}" mode="widthFix"></image>
    </view>

    <view class="bottom-space"></view>
  </view>

  <!-- 底部操作栏（固定） -->
  <view class="action-bar" wx:if="{{product}}">
    <view class="action-icon" bindtap="onGoCart">
      <icon type="clock" size="20" color="#666"></icon>
      <text class="action-icon-text">购物车</text>
      <text wx:if="{{cartCount > 0}}" class="cart-badge">{{cartCount}}</text>
    </view>
    <view class="action-btn add-cart" bindtap="onAddCart">
      <text class="action-btn-text">加入购物车</text>
    </view>
    <view class="action-btn buy-now" bindtap="onBuyNow">
      <text class="action-btn-text">立即购买</text>
    </view>
  </view>

  <!-- 规格选择半屏弹层 -->
  <view wx:if="{{specVisible}}" class="sheet-mask" bindtap="onCloseSpec"></view>
  <view wx:if="{{specVisible}}" class="spec-sheet anim-slide-up">
    <view class="row-between">
      <text class="h1">选择规格</text>
      <view bindtap="onCloseSpec"><icon type="cancel" size="18" color="#cccccc"></icon></view>
    </view>
    <view class="row spec-row">
      <text class="pill {{item.selected ? 'pill-on' : ''}}" wx:for="{{specs}}" wx:key="id"
            bindtap="onSelectSpec" data-index="{{index}}">{{item.name}}</text>
    </view>
    <view class="row-between qty-line">
      <text class="h2">购买数量</text>
      <view class="row">
        <view class="qty-btn" bindtap="onDecrease"><icon type="minus" size="14" color="#666"></icon></view>
        <text class="qty-num">{{quantity}}</text>
        <view class="qty-btn qty-plus" bindtap="onIncrease"><icon type="plus" size="14" color="#ffffff"></icon></view>
      </view>
    </view>
    <button class="spec-confirm" type="primary" bindtap="onCloseSpec">确定</button>
  </view>
</view>
