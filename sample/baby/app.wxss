page { background: #f8f6f7; color: #2f2a2c; font-size: 28rpx; }
.page { padding: 24rpx 24rpx 40rpx; }
.tab-page { padding-bottom: 160rpx; }
.card { background: #ffffff; border-radius: 24rpx; padding: 28rpx; margin-bottom: 24rpx; }
.row { display: flex; flex-direction: row; align-items: center; }
.between { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.wrap { display: flex; flex-direction: row; flex-wrap: wrap; }
.flex1 { flex: 1; }
.sec-title { font-size: 32rpx; font-weight: bold; color: #2f2a2c; }
.sec-more { font-size: 24rpx; color: #9a9095; }
.muted { color: #9a9095; font-size: 24rpx; }
.pink { color: #ff6f82; }
.mint { color: #2fae93; }
.btn { background: #ff7a8a; color: #ffffff; border-radius: 44rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: bold; }
.btn-ghost { background: #fff0f2; color: #ff6f82; border-radius: 44rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.btn-hover { opacity: 0.75; }
.item-hover { background: #fdf3f5; }
.seg { display: flex; flex-direction: row; background: #f3eef0; border-radius: 40rpx; padding: 6rpx; }
.seg-item { flex: 1; height: 64rpx; border-radius: 34rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; color: #7a7075; }
.seg-on { background: #ffffff; color: #ff6f82; font-weight: bold; }
.field { display: flex; flex-direction: row; align-items: center; min-height: 96rpx; border-bottom: 1rpx solid #f3eef0; }
.field-label { width: 180rpx; color: #5a5055; font-size: 28rpx; }
.field-input { flex: 1; font-size: 28rpx; color: #2f2a2c; }
.field-value { flex: 1; font-size: 28rpx; color: #2f2a2c; text-align: right; }
.placeholder { color: #c0b6ba; }
.err { color: #f0506e; font-size: 22rpx; padding: 8rpx 0 0 180rpx; }
.empty { padding: 80rpx 0; display: flex; flex-direction: column; align-items: center; }
.empty-text { color: #a69ca0; font-size: 26rpx; margin-top: 16rpx; }
.tag { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 20rpx; background: #fff0f2; color: #ff6f82; }
.tag-mint { background: #e6f7f3; color: #2fae93; }
.tag-grey { background: #f1eef0; color: #8a8085; }
.tag-warn { background: #fff3e0; color: #f08a24; }
