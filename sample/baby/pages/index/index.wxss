.baby { display: flex; flex-direction: row; align-items: center; padding: 32rpx 28rpx; border-radius: 28rpx; margin-bottom: 24rpx; background: linear-gradient(135deg, #ffd9de 0%, #ffeedd 100%); }
.avatar { width: 120rpx; height: 120rpx; border-radius: 60rpx; margin-right: 24rpx; border: 4rpx solid #ffffff; }
.baby-name { font-size: 40rpx; font-weight: bold; color: #3a2a2e; }
.sex { font-size: 20rpx; color: #4a8ff0; background: #e4efff; padding: 4rpx 12rpx; border-radius: 16rpx; margin-left: 12rpx; }
.sex-girl { color: #ff6f9f; background: #ffe4ef; }
.baby-age { font-size: 28rpx; color: #6a5055; margin-top: 8rpx; }
.baby-birth { font-size: 22rpx; color: #9a8085; margin-top: 4rpx; }
.edit { font-size: 24rpx; color: #b07a85; }
.running { display: flex; flex-direction: row; align-items: center; background: #6c7cf0; color: #ffffff; font-size: 26rpx; padding: 20rpx 28rpx; border-radius: 20rpx; margin-bottom: 24rpx; }
.dot { width: 14rpx; height: 14rpx; border-radius: 7rpx; background: #7dffb2; margin-right: 14rpx; }
.sum { display: flex; flex-direction: row; margin-top: 24rpx; }
.sum-cell { flex: 1; display: flex; flex-direction: column; align-items: center; }
.sum-num { align-items: flex-end; }
.num { font-size: 40rpx; font-weight: bold; color: #ff6f82; }
.unit { font-size: 20rpx; color: #b09095; margin-left: 2rpx; margin-bottom: 8rpx; }
.sum-label { font-size: 22rpx; color: #9a9095; margin-top: 4rpx; }
.quick { margin-top: 16rpx; }
.q { width: 25%; display: flex; flex-direction: column; align-items: center; padding: 16rpx 0; }
.q-ic { width: 88rpx; height: 88rpx; }
.q-tx { font-size: 24rpx; color: #5a5055; margin-top: 10rpx; }
.vac { display: flex; flex-direction: row; align-items: center; }
.vac-ic { width: 72rpx; height: 72rpx; margin-right: 20rpx; }
.vac-title { font-size: 28rpx; font-weight: bold; margin-bottom: 6rpx; }
.vac-left { font-size: 26rpx; color: #2fae93; font-weight: bold; }
.over { color: #f08a24; }
.empty-ic { width: 96rpx; height: 96rpx; opacity: 0.6; }
.tl { display: flex; flex-direction: row; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #f5f0f2; }
.tl-time { width: 96rpx; font-size: 24rpx; color: #8a8085; }
.tl-dot { width: 18rpx; height: 18rpx; border-radius: 9rpx; margin-right: 20rpx; background: #ff7a8a; }
.tl-sleep { background: #6c7cf0; }
.tl-diaper { background: #ffa94d; }
.tl-title { font-size: 28rpx; color: #2f2a2c; margin-bottom: 4rpx; }
.art { display: flex; flex-direction: row; align-items: center; }
.art-title { font-size: 30rpx; font-weight: bold; margin: 8rpx 0; }
.art-cover { width: 180rpx; height: 120rpx; border-radius: 16rpx; margin-left: 20rpx; }
