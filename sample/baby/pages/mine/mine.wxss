.head { display: flex; flex-direction: row; align-items: center; padding: 36rpx 28rpx; border-radius: 28rpx; margin-bottom: 24rpx; background: linear-gradient(135deg, #ff9aa8 0%, #ffc3a0 100%); }
.av { width: 112rpx; height: 112rpx; border-radius: 56rpx; border: 4rpx solid #ffffff; margin-right: 24rpx; }
.h-name { font-size: 36rpx; font-weight: bold; color: #ffffff; }
.h-sub { font-size: 24rpx; color: rgba(255, 255, 255, 0.9); margin-top: 8rpx; }
.h-op { font-size: 24rpx; color: #ffffff; }
.stats { display: flex; flex-direction: row; padding: 24rpx 0; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 8rpx 0; }
.s-num { font-size: 40rpx; font-weight: bold; color: #ff6f82; margin-bottom: 4rpx; }
.menu { padding: 0 28rpx; }
.mi { display: flex; flex-direction: row; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid #f5f0f2; }
.mi-t { font-size: 29rpx; margin-bottom: 4rpx; }
.arrow { color: #c0b6ba; font-size: 34rpx; margin-left: 12rpx; }
.bar { margin: 24rpx 0 12rpx; }
.ops { margin-top: 24rpx; }
.danger { margin-left: 20rpx; color: #f0506e; background: #fff1f3; }
