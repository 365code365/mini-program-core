.head { background: linear-gradient(135deg, #4a9ef0 0%, #7cc4ff 100%); border-radius: 28rpx; padding: 32rpx; margin-bottom: 24rpx; color: #ffffff; }
.h-title { font-size: 34rpx; font-weight: bold; }
.h-pc { font-size: 34rpx; font-weight: bold; }
.h-bar { margin: 20rpx 0 24rpx; }
.clinic { display: flex; flex-direction: row; align-items: center; background: rgba(255, 255, 255, 0.18); border-radius: 16rpx; padding: 18rpx 20rpx; }
.clinic-name { font-size: 24rpx; }
.clinic-op { font-size: 24rpx; margin-left: 12rpx; }
.call { margin-top: 16rpx; height: 64rpx; border-radius: 32rpx; background: #ffffff; color: #4a9ef0; font-size: 26rpx; display: flex; align-items: center; justify-content: center; font-weight: bold; }
.seg { margin-bottom: 16rpx; }
.g-head { padding: 20rpx 8rpx 14rpx; }
.g-label { font-size: 30rpx; font-weight: bold; margin-right: 16rpx; }
.v { padding: 24rpx 28rpx; margin-bottom: 16rpx; }
.v-name { font-size: 28rpx; font-weight: bold; margin-right: 12rpx; margin-bottom: 6rpx; }
.st { font-size: 22rpx; padding: 6rpx 14rpx; border-radius: 18rpx; }
.st-done { background: #e6f7f3; color: #2fae93; }
.st-over { background: #fff3e0; color: #f08a24; }
.st-soon { background: #ffe8ec; color: #ff6f82; }
.st-later { background: #f1eef0; color: #8a8085; }
.detail { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx dashed #eee5e8; display: flex; flex-direction: column; }
.d-line { font-size: 24rpx; color: #5a5055; line-height: 1.7; }
.d-btn { margin-top: 20rpx; height: 72rpx; font-size: 26rpx; }
.foot { display: block; margin-top: 20rpx; line-height: 1.6; }
