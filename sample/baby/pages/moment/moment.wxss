.ok { background: #e6f7f3; border-radius: 20rpx; padding: 24rpx 28rpx; margin-bottom: 24rpx; display: flex; flex-direction: column; }
.ok-title { color: #2fae93; font-size: 30rpx; font-weight: bold; }
.ok-sub { color: #5aa894; font-size: 24rpx; margin-top: 6rpx; }
.photo { width: 702rpx; height: 560rpx; border-radius: 24rpx; margin-bottom: 24rpx; }
.date { font-size: 32rpx; font-weight: bold; }
.age { display: block; margin-top: 8rpx; }
.cap { display: block; font-size: 30rpx; line-height: 1.7; margin-top: 20rpx; color: #3a3033; }
.voice { display: flex; flex-direction: row; align-items: center; margin-top: 24rpx; background: #f4fbf9; border-radius: 40rpx; padding: 14rpx 28rpx 14rpx 14rpx; font-size: 26rpx; color: #2fae93; }
.v-ic { width: 56rpx; height: 56rpx; border-radius: 28rpx; background: #2fae93; color: #ffffff; font-size: 22rpx; display: flex; align-items: center; justify-content: center; margin-right: 16rpx; }
.v-on { background: #ff7a8a; }
.ops { margin-bottom: 24rpx; }
.del { margin-left: 20rpx; color: #f0506e; background: #fff1f3; }
.back { width: 300rpx; margin-top: 30rpx; }
