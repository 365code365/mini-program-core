<view class="ds-wrap {{uid}}-w">
  <!-- 拖动的归属由宿主仲裁（host::gesture，`bind:__dsheet` 是给它的标记，值是面板是否已到最大）：
       面板没到最大时上推、里面的列表在顶时下拉，这串触摸归面板（列表不滚，逻辑层的 touchmove 拖面板）；
       其余交给列表滚，宿主接管时补 touchcancel，面板退回按下时的大小 -->
  <view class="ds-sheet" style="height:{{size * 100}}%;" animation="{{anim}}" bind:__dsheet="{{atMax ? 'max' : 'mid'}}"
        capture-bind:touchstart="_ts" capture-bind:touchmove="_tm" capture-bind:touchend="_te" capture-bind:touchcancel="_tc">
    <slot></slot>
  </view>
</view>
