/target/
/.idea/
# 发布包：由 tools/package-mobile.sh 生成（android zip 约 35MB、ios zip 数百 MB），
# 走 GitHub Release 附件，不进仓库
/dist/
# tools/ 里的检查脚本互相 import，会生成字节码缓存
__pycache__/

# 本地 git worktree（并行开发用的工作区，不是仓库内容；误提交会变成一个指向旧提交的子模块指针）
.worktrees/
# 账号导出文件（含 accessToken / refreshToken）：曾被误提交进未推送的历史，推送前已清掉。
# 它不是 workflow，GitHub Actions 也不读 .json；留在本地即可，别再进仓库
.github/workflows/kiro-accounts-*.json

# 测试服务器的 root 与 mini-store 管理账户（明文），别提交
sample/测试服务器.txt

# 演示视频原片（1080p，33MB）；网页版压到 site/assets/video/showcase.mp4
doc/videos/showcase_*.mp4

# 小游戏夹具的生成素材（tools/gen-game-assets.py）
sample-game/g-audio/assets/

# ANGLE / SwiftShader 预编译库（tools/fetch-angle.sh 拉取，不入库）
third_party/angle/
