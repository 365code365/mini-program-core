<view class="hero" style="background-color: {{profile ? profile.color : '#c8c8cd'}};">
  <block wx:if="{{profile}}">
    <text class="hero-name">{{profile.name}} <text class="hero-lv">{{profile.level}}</text></text>
    <text class="hero-sub">{{profile.city}} · 已加入 {{profile.joinedDays}} 天</text>
  </block>
  <text wx:elif="{{errors.profile}}" class="hero-sub">资料加载失败：{{errors.profile}}</text>
  <block wx:else>
    <view class="sk-line sk-light sk-w40"></view>
    <view class="sk-line sk-light sk-w60"></view>
  </block>
</view>

<view class="card">
  <view class="head-row">
    <text class="title">我的数据</text>
    <text class="cost" wx:if="{{!loading}}">4 个接口并发，共 {{costMs}}ms</text>
    <text class="cost" wx:else>加载中…</text>
  </view>
  <view class="stats" wx:if="{{stats}}">
    <view class="stat"><text class="stat-num">{{stats.orders}}</text><text class="stat-k">订单</text></view>
    <view class="stat"><text class="stat-num">{{stats.amountText}}</text><text class="stat-k">消费</text></view>
    <view class="stat"><text class="stat-num">{{stats.coupons}}</text><text class="stat-k">优惠券</text></view>
    <view class="stat"><text class="stat-num">{{stats.points}}</text><text class="stat-k">积分</text></view>
  </view>
  <text wx:elif="{{errors.stats}}" class="err">{{errors.stats}}</text>
  <view wx:else class="stats">
    <view class="stat" wx:for="{{[1, 2, 3, 4]}}" wx:key="*this"><view class="sk-line sk-w60"></view></view>
  </view>
</view>

<view class="card">
  <text class="title">近 7 天活跃</text>
  <view class="chart" wx:if="{{trend.length}}">
    <view class="bar-col" wx:for="{{trend}}" wx:key="day">
      <text class="bar-v">{{item.value}}</text>
      <view class="bar" style="height: {{item.value * 240 / trendMax}}rpx;"></view>
      <text class="bar-k">{{item.day}}</text>
    </view>
  </view>
  <text wx:elif="{{errors.trend}}" class="err">{{errors.trend}}</text>
  <view wx:else class="chart-sk"></view>
</view>

<view class="card">
  <text class="title">最近订单</text>
  <view class="order" wx:for="{{orders}}" wx:key="no">
    <view class="order-l">
      <text class="order-name">{{item.name}}</text>
      <text class="order-no">{{item.no}}</text>
    </view>
    <view class="order-r">
      <text class="order-price">¥{{item.price}}</text>
      <text class="order-state">{{item.state}}</text>
    </view>
  </view>
  <text wx:if="{{errors.orders}}" class="err">{{errors.orders}}</text>
  <block wx:if="{{!orders.length && !errors.orders}}">
    <view class="sk-line sk-w100" wx:for="{{[1, 2, 3]}}" wx:key="*this"></view>
  </block>
</view>

<view class="card">
  <view class="btns">
    <view class="btn-s" bindtap="loadAll">全部刷新</view>
    <view class="btn-o" bindtap="realRequest">真实网络请求</view>
  </view>
  <view class="result"><text>{{real}}</text></view>
  <text class="hint">失败率与延迟在「模拟 HTTP · 信息流」页调，两页共用同一个模拟服务</text>
</view>
