.visits { display: flex; flex-direction: row; align-items: center; }
.visits-num { width: 140rpx; font-size: 72rpx; font-weight: bold; color: #07c160; text-align: center; }
.visits-label { flex: 1; font-size: 24rpx; line-height: 1.6; color: #888888; }
.field { display: flex; flex-direction: row; align-items: center; padding: 12rpx 0; }
.f-k { width: 100rpx; font-size: 26rpx; color: #666666; }
.f-v { flex: 1; height: 64rpx; padding: 0 12rpx; font-size: 26rpx; background-color: #fafafa; border-radius: 8rpx; }
.keys { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 8rpx; }
.key { margin: 0 12rpx 12rpx 0; padding: 4rpx 14rpx; font-size: 22rpx; color: #576b95; background-color: #eef1f6; border-radius: 6rpx; }
