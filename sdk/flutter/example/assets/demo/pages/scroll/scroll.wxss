.tabs { width: 100%; height: 80rpx; }
.tabs-inner { display: flex; flex-direction: row; height: 80rpx; align-items: center; }
.tab { padding: 10rpx 28rpx; margin-right: 12rpx; font-size: 26rpx; color: #666666; background-color: #f2f2f2; border-radius: 30rpx; white-space: nowrap; }
.tab-on { color: #ffffff; background-color: #07c160; }
.box { height: 420rpx; background-color: #fafafa; border-radius: 8rpx; }
.small { height: 300rpx; }
.item { display: flex; flex-direction: row; justify-content: space-between; padding: 22rpx 24rpx; border-bottom: 1rpx solid #eeeeee; font-size: 26rpx; }
.item-mark { background-color: #e8f8ee; }
.item-sub { color: #07c160; font-size: 22rpx; }
