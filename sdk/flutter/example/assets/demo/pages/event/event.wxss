.layer { display: flex; flex-direction: column; padding: 16rpx; border-radius: 10rpx; }
.outer { background-color: #e6f4ff; }
.middle { margin-top: 12rpx; background-color: #b8e0ff; }
.inner { margin-top: 12rpx; padding: 24rpx 16rpx; color: #ffffff; background-color: #10aeff; }
.inner:active { background-color: #0a8fd4; }
.layer-name { font-size: 22rpx; color: #576b95; }
.press-box { padding: 36rpx; text-align: center; background-color: #f2f2f2; border-radius: 12rpx; }
.press-on { background-color: #d9f5e4; }
.pad { position: relative; height: 320rpx; background-color: #1f1f1f; border-radius: 12rpx; overflow: hidden; }
.pad-tip { position: absolute; left: 24rpx; bottom: 20rpx; font-size: 22rpx; color: #888888; }
.finger { position: absolute; width: 40px; height: 40px; background-color: rgba(7, 193, 96, 0.8); border-radius: 20px; }
.hover-row { display: flex; flex-direction: row; justify-content: space-between; }
.hv { width: 300rpx; padding: 24rpx 0; text-align: center; font-size: 24rpx; background-color: #f2f2f2; border-radius: 10rpx; }
.hv-on { background-color: #ffd666; }
.hv-on2 { background-color: #8a5cf5; color: #ffffff; }
.hv-parent { display: flex; flex-direction: column; margin-top: 16rpx; padding: 16rpx; font-size: 24rpx; background-color: #f7f7f7; border-radius: 10rpx; }
.hv-child { width: auto; margin-top: 12rpx; padding: 20rpx; background-color: #e6e6e6; }
