.map { width: 100%; height: 320rpx; margin-top: 16rpx; background-color: #e8eef5; border-radius: 12rpx; }
.log { display: flex; flex-direction: column; margin-top: 12rpx; padding: 12rpx 16rpx; background-color: #1f1f1f; border-radius: 8rpx; }
.log-line { font-size: 22rpx; line-height: 1.7; color: #9fe6b8; }
/* 选到的图 / 视频封面：三列 */
.thumbs { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 16rpx; }
.thumb { position: relative; width: 200rpx; height: 200rpx; margin: 0 12rpx 12rpx 0; background-color: #e5e5e5; border-radius: 8rpx; overflow: hidden; }
.thumb-img { width: 200rpx; height: 200rpx; }
.thumb-tag { position: absolute; left: 8rpx; bottom: 8rpx; padding: 2rpx 10rpx; font-size: 20rpx; color: #ffffff; background-color: rgba(0, 0, 0, 0.5); border-radius: 6rpx; }
