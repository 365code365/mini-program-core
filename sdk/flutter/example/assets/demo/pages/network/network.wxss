.dl-row { display: flex; flex-direction: row; align-items: center; margin-top: 16rpx; }
.dl-img { width: 160rpx; height: 160rpx; margin-right: 20rpx; background-color: #f7f7f7; border-radius: 8rpx; }
.dl-empty { width: 160rpx; height: 160rpx; margin-right: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #b2b2b2; background-color: #f7f7f7; border-radius: 8rpx; }
.dl-info { flex: 1; font-size: 22rpx; line-height: 1.6; color: #555555; word-break: break-all; }
.remote { width: 100%; height: 300rpx; background-color: #f2f2f2; border-radius: 8rpx; }
