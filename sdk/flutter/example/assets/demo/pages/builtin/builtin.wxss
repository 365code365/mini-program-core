.pc-body { padding: 48rpx 40rpx; align-items: center; }
.pc-body-right { width: 520rpx; height: 100%; justify-content: center; }
.pc-title { font-size: 32rpx; font-weight: bold; color: #222222; }
.pc-desc { margin: 20rpx 0 32rpx 0; font-size: 26rpx; color: #888888; }

.portal { margin-top: 16rpx; padding: 24rpx; border-radius: 12rpx; background-color: #f2f2f2; }
/* 写 margin-top 而不是 margin: 0：引擎落地声明时细项总是盖过简写（doc/架构与实现原理.md「简写 vs 细项」），
   .portal 的 margin-top 会赢过这里的 margin 简写 */
.portal-on { margin-top: 0; border-radius: 0; background-color: #07c160; padding-top: 48rpx; }
.portal-t { font-size: 26rpx; color: #333333; }
.portal-on .portal-t { color: #ffffff; }

.mm { margin-top: 12rpx; padding: 20rpx; border-radius: 12rpx; }
.mm-a { background-color: #e8f8ee; }
.mm-b { background-color: #e8f0ff; }
.mm-c { background-color: #fff4e5; }

.ed { height: 200rpx; margin-top: 16rpx; border: 2rpx solid #e5e5e5; border-radius: 12rpx; }

.ph-map { position: relative; width: 100%; height: 300rpx; margin-top: 16rpx; }
.cv { position: absolute; left: 20rpx; top: 20rpx; flex-direction: row; align-items: center; padding: 12rpx 20rpx;
  border-radius: 32rpx; background-color: rgba(0, 0, 0, 0.6); }
.cv-img { width: 40rpx; height: 40rpx; border-radius: 20rpx; margin-right: 12rpx; }
.cv-t { font-size: 24rpx; color: #ffffff; }
.ph-cam { height: 240rpx; margin-top: 16rpx; }
.ph-live { width: 100%; height: 240rpx; margin-top: 16rpx; }

.span-b { font-size: 36rpx; font-weight: bold; color: #07c160; margin: 0 8rpx; }
