.hero { display: flex; flex-direction: column; padding: 40rpx 32rpx 32rpx 32rpx; background: linear-gradient(135deg, #07c160, #10aeff); color: #ffffff; }
.hero-title { font-size: 40rpx; font-weight: bold; }
.hero-sub { margin-top: 12rpx; font-size: 24rpx; line-height: 1.6; opacity: 0.9; }
.hero-stats { display: flex; flex-direction: row; margin-top: 28rpx; }
.stat { flex: 1; padding: 16rpx 0; margin-right: 16rpx; background-color: rgba(255, 255, 255, 0.18); border-radius: 12rpx; text-align: center; }
.stat:last-child { margin-right: 0; }
.stat-num { font-size: 32rpx; font-weight: bold; }
.stat-label { margin-top: 4rpx; font-size: 22rpx; opacity: 0.85; }
.footer { margin: 40rpx 0 48rpx 0; text-align: center; font-size: 24rpx; color: #b2b2b2; }
.footer-sub { margin-top: 6rpx; font-size: 20rpx; }
