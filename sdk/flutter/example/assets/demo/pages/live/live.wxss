.player { width: 100%; height: 422rpx; background-color: #000000; }
.src { display: flex; flex-direction: column; padding: 14rpx 16rpx; margin-top: 8rpx; border: 2rpx solid #eeeeee; border-radius: 10rpx; }
.src-on { border-color: #07c160; background-color: #f0fbf4; }
.src-name { font-size: 28rpx; color: #222222; }
.src-url { margin-top: 4rpx; font-size: 22rpx; color: #999999; word-break: break-all; }
.shot { width: 100%; height: 300rpx; margin-top: 16rpx; background-color: #f0f0f0; border-radius: 8rpx; }
.log { display: flex; flex-direction: column; margin-top: 12rpx; padding: 12rpx 16rpx; min-height: 120rpx; background-color: #1f1f1f; border-radius: 8rpx; }
.log-line { font-size: 22rpx; line-height: 1.7; color: #9fe6b8; }
