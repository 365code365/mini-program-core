.banner { display: flex; flex-direction: column; padding: 36rpx 32rpx; background: linear-gradient(135deg, #576b95, #10aeff); color: #ffffff; }
.banner-title { font-size: 38rpx; font-weight: bold; }
.banner-sub { margin-top: 10rpx; font-size: 24rpx; line-height: 1.6; opacity: 0.9; }
.icons { display: flex; flex-direction: row; justify-content: space-between; margin-top: 24rpx; }
.icon-cell { padding: 10rpx; background-color: rgba(255, 255, 255, 0.15); border-radius: 12rpx; }
.tail { height: 40rpx; }
