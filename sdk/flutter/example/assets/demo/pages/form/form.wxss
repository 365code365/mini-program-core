.gap { margin-top: 16rpx; }
.btn-row { display: flex; flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-top: 20rpx; }
.field { display: flex; flex-direction: row; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.f-k { width: 120rpx; font-size: 26rpx; color: #666666; }
.f-v { flex: 1; height: 64rpx; padding: 0 12rpx; font-size: 26rpx; background-color: #fafafa; border-radius: 8rpx; }
.ta { width: 100%; height: 180rpx; padding: 12rpx; font-size: 26rpx; background-color: #fafafa; border: 1rpx solid #eeeeee; border-radius: 8rpx; }
.line { display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 14rpx 0; }
.opts { display: flex; flex-direction: row; flex-wrap: wrap; }
.opt { display: flex; flex-direction: row; align-items: center; margin: 8rpx 32rpx 8rpx 0; }
.f-slider { width: 420rpx; }
