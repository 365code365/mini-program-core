.banner { height: 300rpx; border-radius: 12rpx; overflow: hidden; }
.banner-img { width: 100%; height: 300rpx; }
.banner-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 12rpx 20rpx 36rpx 20rpx; color: #ffffff; font-size: 26rpx; background: linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,0.55)); }
.cards { height: 220rpx; }
.slide { height: 220rpx; border-radius: 12rpx; color: #ffffff; font-size: 40rpx; font-weight: bold; text-align: center; line-height: 220rpx; }
.peek { height: 300rpx; }
.peek-item { display: flex; flex-direction: column; margin: 0 12rpx; height: 300rpx; background-color: #f7f7f7; border-radius: 12rpx; overflow: hidden; }
.peek-img { width: 100%; height: 240rpx; }
.peek-name { padding: 10rpx 16rpx; font-size: 26rpx; }
.multi { height: 220rpx; }
.multi-item { display: flex; flex-direction: column; align-items: center; margin: 0 8rpx; }
.multi-img { width: 180rpx; height: 160rpx; border-radius: 12rpx; }
.multi-name { margin-top: 8rpx; font-size: 24rpx; color: #666666; }
.notice { display: flex; flex-direction: row; align-items: center; height: 72rpx; padding: 0 16rpx; background-color: #fff7e6; border-radius: 8rpx; }
.notice-tag { margin-right: 16rpx; padding: 2rpx 12rpx; font-size: 22rpx; color: #ffffff; background-color: #fa9d3b; border-radius: 6rpx; }
.notice-swiper { flex: 1; height: 72rpx; }
.notice-text { font-size: 26rpx; line-height: 72rpx; color: #8a5a00; }
