.box { width: 300rpx; height: 100rpx; line-height: 100rpx; text-align: center; color: #ffffff; background-color: #8a5cf5; border-radius: 10rpx; }
.chips { display: flex; flex-direction: row; margin-top: 12rpx; }
.chip { height: 48rpx; margin-right: 10rpx; font-size: 20rpx; line-height: 48rpx; text-align: center; color: #576b95; background-color: #eef1f6; border-radius: 8rpx; }
.io { display: flex; flex-direction: column; border: 4rpx solid #e5e5e5; }
.io-on { border-color: #07c160; background-color: #e8f8ee; }
.filler { margin: 0 20rpx 16rpx 20rpx; padding: 40rpx 24rpx; font-size: 24rpx; color: #999999; background-color: #ffffff; border-radius: 12rpx; }
.target { margin: 0 20rpx 16rpx 20rpx; padding: 60rpx 24rpx; text-align: center; color: #ffffff; background-color: #07c160; border-radius: 12rpx; }
.bottom { padding: 30rpx 0 60rpx 0; text-align: center; font-size: 24rpx; color: #b2b2b2; }
.fab { position: fixed; right: 32rpx; bottom: 48rpx; width: 100rpx; height: 100rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #ffffff; background-color: rgba(0, 0, 0, 0.65); border-radius: 50rpx; }
.fab-arrow { font-size: 34rpx; line-height: 1; }
.fab-num { font-size: 18rpx; }
