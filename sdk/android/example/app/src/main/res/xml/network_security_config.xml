<?xml version="1.0" encoding="utf-8"?>
<!-- 测试用的小程序商店（tools/mini-store）走明文 HTTP：只对这台放行，其余照旧只许 HTTPS。
     换了商店地址（StoreActivity 的 intent 参数 store）的话这里跟着加一条 -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">64.83.22.217</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- 本机起的商店经 `adb reverse` 映射（tools/android-jank.sh 的 STORE_URL=http://127.0.0.1:…，量还没上架的示例） -->
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
